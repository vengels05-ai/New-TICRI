{"id":9098709,"docketId":66364978,"caseName":"In re Disbarment of Aulvin","caseNameFull":"In re Disbarment of Aulvin","slug":"in-re-disbarment-of-aulvin","docketNumber":"No. D-893","dateFiled":"1990-06-18","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9093016,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Aey\">John Lewis Aulvin, of Mount Carmel, III, having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on April 23, 1990 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./495/901/\">495 U. S. 901</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}