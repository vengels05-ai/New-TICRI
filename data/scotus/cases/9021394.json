{"id":9021394,"docketId":66287611,"caseName":"Chambers v. Texas","caseNameFull":"Chambers v. Texas Drake v. Georgia","slug":"chambers-v-texas","docketNumber":"No 78-517; No. 78-5901","dateFiled":"1979-02-21","dateArgued":null,"dateCertGranted":null,"year":1979,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9014605,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":663,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AIy\">Ct. Crim. App. Tex.; and</p>\n<p id=\"AaSC\">Sup. Ct. Ga. Certi-orari denied. Reported below: No. 78-517, <span class=\"citation\" data-id=\"9683398\"><a href=\"/opinion/1788269/chambers-v-state/\" aria-description=\"Citation for case: Chambers v. State\">568 S. W. 2d 313</a></span>; No. 78-5901, <span class=\"citation\" data-id=\"1334569\"><a href=\"/opinion/1334569/drake-v-state/\" aria-description=\"Citation for case: Drake v. State\">241 Ga. 583</a></span>, <span class=\"citation\" data-id=\"1334569\"><a href=\"/opinion/1334569/drake-v-state/\" aria-description=\"Citation for case: Drake v. State\">247 S. E. 2d 57</a></span>.</p>\n</opinion>"},{"id":9014606,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":605,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b870-15\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"ABJQ\">dissenting.</p>\n<p id=\"b870-16\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}