{"id":105797,"docketId":1643669,"caseName":"Universal Trades, Inc. v. Commonwealth of Pennsylvania","caseNameFull":"","slug":"universal-trades-inc-v-commonwealth-of-pennsylvania","docketNumber":"434","dateFiled":"1959-01-12","dateArgued":null,"dateCertGranted":null,"year":1959,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":105797,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1500,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8934427\"><a href=\"/opinion/8943878/universal-trades-inc-v-pennsylvania/\" aria-description=\"Citation for case: Universal Trades, Inc. v. Pennsylvania\">358 U.S. 129</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">79 S.Ct. 231</span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/L.Ed.2d/3/225/\">3 L.Ed.2d 225</a></span></p>\n    <p class=\"parties\">UNIVERSAL TRADES, Inc., appellant,<br>v.<br>COMMONWEALTH OF PENNSYLVANIA.</p>\n    <p class=\"docket\">No. 434.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">December 8, 1958</p>\n    <p class=\"date\">Rehearing Denied Jan. 12, 1959.</p>\n    <div class=\"prelims\">\n      <p>See <span class=\"citation multiple-matches\"><a href=\"/c/U.S./358/938/\">358 U.S. 938</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./79/311/\">79 S.Ct. 311</a></span>.</p>\n      <p class=\"indent\">Messrs. Manuel Kraus and Roy J. Keefer, for appellant.</p>\n      <p class=\"indent\">Messrs. Thomas D. McBride, Atty. Gen. of Pennsylvania and Edward Friedman, Deputy Atty. Gen., for appellee.</p>\n      <p class=\"indent\">PER CURIAM.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The motion to dismiss is granted and the appeal is dismissed. Treating the papers whereon the appeal was taken as a petition for writ of certiorari, certiorari is denied.</p>\n    </div>\n    "}],"citations":[]}