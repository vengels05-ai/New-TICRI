{"id":9095711,"docketId":66361973,"caseName":"In re Disbarment of Morrison","caseNameFull":"In re Disbarment of Morrison","slug":"in-re-disbarment-of-morrison","docketNumber":"No. D-850","dateFiled":"1990-03-19","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9089949,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":462,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ADgE\">James Robert Morrison III, of Alton, III, having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on January 16, 1990 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./493/1040/\">493 U. S. 1040</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}