{"id":9045946,"docketId":66312183,"caseName":"Magwood v. Alabama","caseNameFull":"Magwood v. Alabama Williams v. Georgia Zaragoza v. Arizona Yates v. South Carolina","slug":"magwood-v-alabama","docketNumber":"No. 82-6560. No. 82-6577. No. 82-6597. No. 82-6611","dateFiled":"1983-06-13","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":7,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9039321,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1272,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A8_V\">Sup. Ct. Ala.;</p>\n<p id=\"AN_\">Sup. Ct. Ga.;</p>\n<p id=\"Ak26\">Sup. Ct. Ariz.; and</p>\n<p id=\"AoLe\">Sup. Ct. S. C. Certiorari denied. Reported below: No. 82-6560, <span class=\"citation\" data-id=\"1694939\"><a href=\"/opinion/1694939/ex-parte-magwood/\" aria-description=\"Citation for case: Ex Parte Magwood\">426 So. 2d 929</a></span>; No. 82-6577, <span class=\"citation\" data-id=\"1305960\"><a href=\"/opinion/1305960/williams-v-state/\" aria-description=\"Citation for case: Williams v. State\">250 Ga. 553</a></span>, <span class=\"citation\" data-id=\"1305960\"><a href=\"/opinion/1305960/williams-v-state/\" aria-description=\"Citation for case: Williams v. State\">300 S. E. 2d 301</a></span>; No. 82-6597, <span class=\"citation\" data-id=\"1449708\"><a href=\"/opinion/1449708/state-v-zaragoza/\" aria-description=\"Citation for case: State v. Zaragoza\">135 Ariz. 63</a></span>, <span class=\"citation\" data-id=\"1449708\"><a href=\"/opinion/1449708/state-v-zaragoza/\" aria-description=\"Citation for case: State v. Zaragoza\">659 P. 2d 22</a></span>; No. 82-6611, 280 S. C. 29, <span class=\"citation\" data-id=\"1207118\"><a href=\"/opinion/1207118/state-v-yates/\" aria-description=\"Citation for case: State v. Yates\">310 S. E. 2d 805</a></span>.</p>\n</opinion>"},{"id":9039322,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1128-7\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AGN\">dissenting.</p>\n<p id=\"AHtp\">Adhering to our views that the\u2019death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}