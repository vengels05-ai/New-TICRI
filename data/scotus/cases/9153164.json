{"id":9153164,"docketId":66419464,"caseName":"In re Disbarment of Bain","caseNameFull":"In re Disbarment of Bain","slug":"in-re-disbarment-of-bain","docketNumber":"No. D-1507","dateFiled":"1995-03-06","dateArgued":null,"dateCertGranted":null,"year":1995,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9147853,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":457,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"APl_\">David Lee Bain, of San Diego, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on February 21, 1995 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./513/1143/\">513 U. S. 1143</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}