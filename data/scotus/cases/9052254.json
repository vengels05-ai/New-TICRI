{"id":9052254,"docketId":66318500,"caseName":"Caruthers v. Tennessee","caseNameFull":"Caruthers v. Tennessee Kennedy v. Florida","slug":"caruthers-v-tennessee","docketNumber":"No. 84-5817; No. 84-5864","dateFiled":"1985-01-21","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9045720,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":506,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AHM9\">Sup. Ct. Tenn.; and</p>\n<p id=\"Aq1iW\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 84-5817, <span class=\"citation\" data-id=\"1484187\"><a href=\"/opinion/1484187/state-v-caruthers/\" aria-description=\"Citation for case: State v. Caruthers\">676 S. W. 2d 935</a></span>; No. 84-5864, <span class=\"citation\" data-id=\"1719548\"><a href=\"/opinion/1719548/kennedy-v-state/\" aria-description=\"Citation for case: Kennedy v. State\">455 So. 2d 351</a></span>.</p>\n</opinion>"},{"id":9045721,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1131-7\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AfIX\">dissenting.</p>\n<p id=\"A0J6\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}