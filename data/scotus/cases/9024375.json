{"id":9024375,"docketId":66290596,"caseName":"Shaw v. South Carolina","caseNameFull":"Shaw v. South Carolina Jones v. Georgia Spivey v. Zant, Warden","slug":"shaw-v-south-carolina","docketNumber":"No. 79-5247; No. 79-5376; No. 79-5395","dateFiled":"1979-11-13","dateArgued":null,"dateCertGranted":null,"year":1979,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":9,"judges":"Brennan","jurisdictionType":"","opinions":[{"id":9017624,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":714,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AaB1\">Sup. Ct. S. C.;</p>\n<p id=\"As_a\">Sup. Ct. Ga.; and</p>\n<p id=\"Alu\">Super. Ct. Ga., Butts County. Certiorari denied. Reported below: No. 79-5247, 273 S. C. 194, <span class=\"citation\" data-id=\"1304670\"><a href=\"/opinion/1304670/state-v-shaw/\" aria-description=\"Citation for case: State v. Shaw\">255 S. E. 2d 799</a></span>; No. 79-5376, <span class=\"citation\" data-id=\"1397821\"><a href=\"/opinion/1397821/jones-v-state/\" aria-description=\"Citation for case: Jones v. State\">243 Ga. 820</a></span>, <span class=\"citation\" data-id=\"1397821\"><a href=\"/opinion/1397821/jones-v-state/\" aria-description=\"Citation for case: Jones v. State\">256 S. E. 2d 907</a></span>.</p>\n</opinion>"},{"id":9017625,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennan","joinedBy":"","pageCount":null,"textLength":573,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1027-8\">Mr. Justice Brennan,</author>\n<p id=\"ApvR\">dissenting.</p>\n<p id=\"b1027-9\">Adhering to my views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}