{"id":9060684,"docketId":66326935,"caseName":"In re Disbarment of Duke","caseNameFull":"In re Disbarment of Duke","slug":"in-re-disbarment-of-duke","docketNumber":"No. D-549","dateFiled":"1986-06-02","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9054284,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ABKN\">Charles Louis Duke, of Houston, Tex., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on March 24, 1986 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./475/1079/\">475 U. S. 1079</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}