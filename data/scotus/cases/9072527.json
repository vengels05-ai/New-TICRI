{"id":9072527,"docketId":66338779,"caseName":"In re Disbarment of Filsoof","caseNameFull":"In re Disbarment of Filsoof","slug":"in-re-disbarment-of-filsoof","docketNumber":"No. D-649","dateFiled":"1987-11-02","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9066328,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":450,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ARL\">Fred F. Filsoof, of Atlanta, Ga., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on July 29, 1987 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./488/1040/\">488 U. S. 1040</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}