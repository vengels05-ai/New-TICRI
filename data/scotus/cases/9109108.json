{"id":9109108,"docketId":66375381,"caseName":"Occhicone v. Florida","caseNameFull":"Occhicone v. Florida Williams v. Alabama","slug":"occhicone-v-florida","docketNumber":"No. 90-7541; No. 90-7549","dateFiled":"1991-05-20","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9103544,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":506,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"At3P\">Sup. Ct. Fla.; and</p>\n<p id=\"AgY0\">Sup. Ct. Ala. Certio-rari denied. Reported below: No. 90-7541, <span class=\"citation\" data-id=\"1754422\"><a href=\"/opinion/1754422/occhicone-v-state/\" aria-description=\"Citation for case: Occhicone v. State\">570 So. 2d 902</a></span>; No. 90-7549, <span class=\"citation\" data-id=\"1599822\"><a href=\"/opinion/1599822/ex-parte-williams/\" aria-description=\"Citation for case: Ex Parte Williams\">571 So. 2d 338</a></span>.</p>\n</opinion>"},{"id":9103545,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":567,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b754-7\">Justice Marshall,</author>\n<p id=\"A3S1\">dissenting.</p>\n<p id=\"b754-8\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}