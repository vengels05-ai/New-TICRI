{"id":1087657,"docketId":882240,"caseName":"O'Connor v. Ohio","caseNameFull":"O'Connor v. Ohio","slug":"oconnor-v-ohio","docketNumber":"281, Misc","dateFiled":"1965-12-13","dateArgued":null,"dateCertGranted":null,"year":1965,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":37,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":1087657,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":778,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b430-14\">\n  Per Curiam.\n </author>\n<p id=\"b430-15\">\n  The petition for rehearing is granted and the order of October 11, 1965, insofar as it denies certiorari, is vacated. Treating the papers whereon the appeal was taken as a petition for a writ of certiorari, certiorari, is granted and the judgment is vacated. The case is remanded to the Supreme Court of Ohio for further proceedings in light of\n  <em>\n   Griffin\n  </em>\n  v.\n  <em>\n   California,\n  </em>\n  <span class=\"citation\" data-id=\"6751630\"><a href=\"/opinion/6862140/griffin-v-california/\" aria-description=\"Citation for case: Griffin v. California\">380 U. S. 609</a></span>.\n </p>\n</opinion>"}],"citations":[]}