{"id":9029095,"docketId":66295316,"caseName":"Finney v. Balkcom","caseNameFull":"Finney v. Balkcom, Warden Steelman v. Arizona Antone v. Florida","slug":"finney-v-balkcom","docketNumber":"No. 80-5235; No. 80-5252; No. 80-5268","dateFiled":"1980-10-14","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":58,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9022366,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":718,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Aa0Y\">Super. Ct. Ga., Tattnall County;</p>\n<p id=\"AeTu\">Sup. Ct. Ariz.; and</p>\n<p id=\"AQaC\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 80-5252, <span class=\"citation\" data-id=\"2615951\"><a href=\"/opinion/2615951/state-v-steelman/\" aria-description=\"Citation for case: State v. Steelman\">120 Ariz. 301</a></span>, <span class=\"citation\" data-id=\"2615951\"><a href=\"/opinion/2615951/state-v-steelman/\" aria-description=\"Citation for case: State v. Steelman\">585 P. 2d 1213</a></span>; No. 80-5268, <span class=\"citation\" data-id=\"1667037\"><a href=\"/opinion/1667037/antone-v-state/\" aria-description=\"Citation for case: Antone v. State\">382 So. 2d 1205</a></span>.</p>\n</opinion>"},{"id":9022367,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":590,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"AUA3\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A83m\">dissenting.</p>\n<p id=\"ASm\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}