{"id":9064598,"docketId":66330849,"caseName":"Foster v. Oklahoma","caseNameFull":"Foster v. Oklahoma","slug":"foster-v-oklahoma","docketNumber":"No. 85-7152","dateFiled":"1986-10-06","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Certiorari, Grant, Set, Writ","jurisdictionType":"","opinions":[{"id":9058222,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":221,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ae_4\">Ct. Crim. App. Okla. Certiorari denied.</p>\n<judges id=\"AnOA\">Justice Marshall would grant the petition for writ of certiorari and set the case for oral argument.</judges>\n</opinion>"},{"id":9058223,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennan","joinedBy":"","pageCount":null,"textLength":562,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b811-7\">Justice Brennan,</author>\n<p id=\"AXn\">dissenting.</p>\n<p id=\"b811-8\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227</a></span> (1976), I would grant certiorari and vacate the death sentence in this ease.</p>\n</opinion>"}],"citations":[]}