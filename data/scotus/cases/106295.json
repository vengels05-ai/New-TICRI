{"id":106295,"docketId":1169181,"caseName":"American Chicle Co. v. State Tax Commission of New York","caseNameFull":"","slug":"american-chicle-co-v-state-tax-commission-of-new-york","docketNumber":"301","dateFiled":"1961-10-23","dateArgued":null,"dateCertGranted":null,"year":1961,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":106295,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1203,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8941525\"><a href=\"/opinion/8950723/american-chicle-co-v-state-tax-commission/\" aria-description=\"Citation for case: American Chicle Co. v. State Tax Commission\">368 U.S. 17</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./82/136/\">82 S.Ct. 136</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/L.Ed.2d/7/85/\">7 L.Ed.2d 85</a></span></p>\n    <p class=\"parties\">AMERICAN CHICLE CO.<br>v.<br>STATE TAX COMMISSION OF NEW YORK.</p>\n    <p class=\"docket\">No. 301.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">October 23, 1961</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Leo A. Diamond, for appellant.</p>\n      <p class=\"indent\">Louis J. Lefkowitz, Atty. Gen. of New York, Paxton Blair, Sol. Gen., and Robert W. Bush, Asst. Atty. Gen., for appellee.</p>\n      <p class=\"indent\">PER CURIAM.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The motion to dismiss is granted and the appeal is dismissed for want of a substantial federal question.</p>\n    </div>\n    "}],"citations":[]}