{"id":9032396,"docketId":66298618,"caseName":"Pickens v. Arkansas","caseNameFull":"Pickens v. Arkansas Peek v. Florida","slug":"pickens-v-arkansas","docketNumber":"No. 80-6299; No. 80-6369","dateFiled":"1981-04-27","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9025687,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":312,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AZGH\">Sup. Ct. Ark.; and</p>\n<p id=\"ABnC\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 80-6369, <span class=\"citation\" data-id=\"1720367\"><a href=\"/opinion/1720367/peek-v-state/\" aria-description=\"Citation for case: Peek v. State\">395 So. 2d 492</a></span>.</p>\n</opinion>"},{"id":9025688,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b924-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A3Om\">dissenting.</p>\n<p id=\"b924-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}