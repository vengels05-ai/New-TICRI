{"id":9109560,"docketId":66375832,"caseName":"Hernandez v. Texas","caseNameFull":"Hernandez v. Texas Holton v. Florida Castor v. Clark, Warden Nuckols v. Oklahoma","slug":"hernandez-v-texas","docketNumber":"No. 90-7315; No. 90-7757; No. 90-7786; No. 90-7882","dateFiled":"1991-06-03","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9104004,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":758,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AZdH\">Ct. Crim. App. Tex.;</p>\n<p id=\"AO2\">Sup. Ct. Fla.;</p>\n<p id=\"AMjN\">C. A. 7th Cir.; and</p>\n<p id=\"AzOq\">Ct. Crim. App. Okla. Certiorari denied. Reported below: No. 90-7315, <span class=\"citation\" data-id=\"2362845\"><a href=\"/opinion/2362845/hernandez-v-state/\" aria-description=\"Citation for case: Hernandez v. State\">805 S. W. 2d 409</a></span>; No. 90-7757, <span class=\"citation\" data-id=\"1116162\"><a href=\"/opinion/1116162/holton-v-state/\" aria-description=\"Citation for case: Holton v. State\">573 So. 2d 284</a></span>; No. 90-7882, <span class=\"citation\" data-id=\"9789469\"><a href=\"/opinion/2603657/nuckols-v-state/\" aria-description=\"Citation for case: Nuckols v. State\">805 P. 2d 672</a></span>.</p>\n</opinion>"},{"id":9104006,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":568,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b776-9\">Justice Marshall,</author>\n<p id=\"AKCr\">dissenting.</p>\n<p id=\"b776-10\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}