{"id":9039784,"docketId":66306010,"caseName":"Arango v. Florida","caseNameFull":"Arango v. Florida Krier v. Georgia","slug":"arango-v-florida","docketNumber":"No. 81-6570; No. 81-6598","dateFiled":"1982-06-21","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9033119,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1197,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AaC\">Sup. Ct. Fla.; and</p>\n<p id=\"Apbx\">Sup. Ct. Ga. Certiorari denied. Reported below: No. 81-6570, <span class=\"citation\" data-id=\"1731075\"><a href=\"/opinion/1731075/arango-v-state/\" aria-description=\"Citation for case: Arango v. State\">411 So. 2d 172</a></span>; No. 81-6598, <span class=\"citation\" data-id=\"1266680\"><a href=\"/opinion/1266680/krier-v-state/\" aria-description=\"Citation for case: Krier v. State\">249 Ga. 80</a></span>, <span class=\"citation\" data-id=\"1266680\"><a href=\"/opinion/1266680/krier-v-state/\" aria-description=\"Citation for case: Krier v. State\">287 S. E. 2d 531</a></span>.</p>\n<judges id=\"b1116-9\">Justice Brennan and Justice Marshall, dissenting.</judges>\n<p id=\"b1116-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}