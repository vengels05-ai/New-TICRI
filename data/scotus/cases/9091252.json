{"id":9091252,"docketId":66357514,"caseName":"Boyd v. Alabama","caseNameFull":"Boyd v. Alabama","slug":"boyd-v-alabama","docketNumber":"No. 89-5053","dateFiled":"1989-10-02","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Brennan, Certiorari, Marshall","jurisdictionType":"","opinions":[{"id":9085428,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":152,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Aq0e\">Sup. Ct. Ala. Certiorari denied.</p>\n<judges id=\"AZrS\">Justice White would grant certiorari. </judges>\n</opinion>"},{"id":9085429,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":592,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b821-7\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AetI\">dissenting.</p>\n<p id=\"b821-8\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}