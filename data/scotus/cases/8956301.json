{"id":8956301,"docketId":66222516,"caseName":"Reatz v. New York","caseNameFull":"REATZ v. NEW YORK","slug":"reatz-v-new-york","docketNumber":"No. 50","dateFiled":"1963-10-14","dateArgued":null,"dateCertGranted":null,"year":1963,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., William I. Siegel for respondent.","natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8947336,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1118,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b104-9\">Per Curiam.</author>\n<p id=\"b104-10\">The motion for leave to proceed <em>in forma pauperis </em>and the petition for a writ of certiorari are granted. The judgment is vacated and the case is remanded to the Appellate Division of the Supreme Court of New York, Second Judicial Department, for further consideration in light of <em>Griffin </em>v. <em>Illinois, </em><span class=\"citation\" data-id=\"9421263\"><a href=\"/opinion/105382/griffin-v-illinois/\" aria-description=\"Citation for case: Griffin v. Illinois\">351 U. S. 12</a></span>, <em>Eskridge </em>v. <em>Washington Prison Board, </em><span class=\"citation\" data-id=\"105722\"><a href=\"/opinion/105722/eskridge-v-washington-state-board-of-prison-terms-paroles/\" aria-description=\"Citation for case: Eskridge v. Washington State Board of Prison Terms &amp; Paroles\">357 U. S. 214</a></span>, and <em>Norvell </em>v. <em>Illinois, </em><span class=\"citation\" data-id=\"9422611\"><a href=\"/opinion/106621/norvell-v-illinois/\" aria-description=\"Citation for case: Norvell v. Illinois\">373 U. S. 420</a></span>.</p>\n</opinion>"}],"citations":[]}