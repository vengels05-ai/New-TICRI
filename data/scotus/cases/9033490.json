{"id":9033490,"docketId":66299712,"caseName":"Woods v. Texas","caseNameFull":"Woods v. Texas Bell v. Texas Brooks v. Texas Green v. Texas Demouchette v. Texas and Barefoot v. Texas","slug":"woods-v-texas","docketNumber":"No. 79-721; No. 79-5199; No. 79-5587; No. 79-6081; No. 79-6608; No. 80-5320","dateFiled":"1981-06-29","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":89,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9026792,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1192,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Abf\">Ct. Crim. App. Tex. Certiorari denied. Reported below: No. 79-721, <span class=\"citation\" data-id=\"2450776\"><a href=\"/opinion/2450776/woods-v-state/\" aria-description=\"Citation for case: Woods v. State\">569 S. W. 2d 901</a></span>; No. 79-5199, <span class=\"citation\" data-id=\"1522639\"><a href=\"/opinion/1522639/bell-v-state/\" aria-description=\"Citation for case: Bell v. State\">582 S. W. 2d 800</a></span>; No. 79-5587, <span class=\"citation\" data-id=\"1631101\"><a href=\"/opinion/1631101/brooks-v-state/\" aria-description=\"Citation for case: Brooks v. State\">599 S. W. 2d 312</a></span>; No. 79-6081, <span class=\"citation\" data-id=\"1519963\"><a href=\"/opinion/1519963/green-v-state/\" aria-description=\"Citation for case: Green v. State\">587 S. W. 2d 167</a></span>; No. 79-6608, <span class=\"citation\" data-id=\"1792548\"><a href=\"/opinion/1792548/demouchette-v-state/\" aria-description=\"Citation for case: Demouchette v. State\">591 S. W. 2d 488</a></span>; No. 80-5320, <span class=\"citation\" data-id=\"9643775\"><a href=\"/opinion/1509363/barefoot-v-state/\" aria-description=\"Citation for case: Barefoot v. State\">596 S. W. 2d 875</a></span>.</p>\n</opinion>"},{"id":9026793,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"AbLP\">Justice Brennan and Justice Marshall,</author>\n<p id=\"ACU\">dissenting.</p>\n<p id=\"b749-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}