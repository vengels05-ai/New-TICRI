{"id":9018179,"docketId":66284396,"caseName":"Smith v. Hopper","caseNameFull":"Smith v. Hopper, Warden","slug":"smith-v-hopper","docketNumber":"No. 77-6470","dateFiled":"1978-06-05","dateArgued":null,"dateCertGranted":null,"year":1978,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":4,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9011314,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":602,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b956-10\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"AbHr\">dissenting.</p>\n<p id=\"b956-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}