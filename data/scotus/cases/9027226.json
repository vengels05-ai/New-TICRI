{"id":9027226,"docketId":66293447,"caseName":"Burks v. Texas","caseNameFull":"Burks v. Texas Starvaggi v. Texas Barfield v. North Carolina","slug":"burks-v-texas","docketNumber":"No. 79-5533; No. 79-6099; No. 79-6350","dateFiled":"1980-06-30","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9020493,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":897,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ArF\">Ct. Crim. App. Tex.;</p>\n<p id=\"Arcv\">Ct. Crim. App. Tex.; and</p>\n<p id=\"AWB\">Sup. Ct. N. C. Certiorari denied. Reported below: No. 79-5533, <span class=\"citation\" data-id=\"9778431\"><a href=\"/opinion/2463584/burks-v-state/\" aria-description=\"Citation for case: Burks v. State\">583 S. W. 2d 389</a></span>; No. 79-6099, <span class=\"citation\" data-id=\"1721712\"><a href=\"/opinion/1721712/starvaggi-v-state/\" aria-description=\"Citation for case: Starvaggi v. State\">593 S. W. 2d 323</a></span>; No. 79-6350, <span class=\"citation\" data-id=\"1381583\"><a href=\"/opinion/1381583/state-v-barfield/\" aria-description=\"Citation for case: State v. Barfield\">298 N. C. 306</a></span>, <span class=\"citation\" data-id=\"1381583\"><a href=\"/opinion/1381583/state-v-barfield/\" aria-description=\"Citation for case: State v. Barfield\">259 S. E. 2d 510</a></span>.</p>\n</opinion>"},{"id":9020494,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":605,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b775-10\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"AmP_\">dissenting.</p>\n<p id=\"b775-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}