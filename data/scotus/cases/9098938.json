{"id":9098938,"docketId":66365207,"caseName":"Whisenhant v. Alabama","caseNameFull":"Whisenhant v. Alabama","slug":"whisenhant-v-alabama","docketNumber":"No. 89-7314","dateFiled":"1990-06-18","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9093248,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":590,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b771-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"ADKZ\">dissenting.</p>\n<p id=\"AxT\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}