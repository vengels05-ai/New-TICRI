{"id":9078506,"docketId":66344759,"caseName":"In re Disbarment of Seaman","caseNameFull":"In re Disbarment of Seaman","slug":"in-re-disbarment-of-seaman","docketNumber":"No. D-705","dateFiled":"1988-06-20","dateArgued":null,"dateCertGranted":null,"year":1988,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9072450,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AZ9\">Roger George Seaman, of Chicago, Ill., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on April 25, 1988 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./485/1019/\">485 U. S. 1019</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}