{"id":9048617,"docketId":66314859,"caseName":"Travaglia v. Pennsylvania","caseNameFull":"Travaglia v. Pennsylvania Lesko v. Pennsylvania Tokman v. Mississippi Dutton v. Oklahoma Willis v. Zant, Warden Guzman v. New Mexico","slug":"travaglia-v-pennsylvania","docketNumber":"No. 83-6260; No. 83-6266; No. 83-6452; No. 83-6500; No. 83-6608; No. 83-6636","dateFiled":"1984-06-18","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":51,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9042027,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1478,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AgJ\">Sup. Ct. Pa.;</p>\n<p id=\"ANjY\">Sup. Ct. Pa.;</p>\n<p id=\"AoR\">Sup. Ct. Miss.;</p>\n<p id=\"AHKi\">Ct. Crim. App. Okla.;</p>\n<p id=\"AZTg\">C. A. 11th Cir.; and</p>\n<p id=\"AOnJ\">Sup. Ct. N. M. Certiorari denied. Reported below: Nos. 83-6260 and 83-6266, <span class=\"citation\" data-id=\"9635346\"><a href=\"/opinion/1467488/commonwealth-v-travaglia/\" aria-description=\"Citation for case: Commonwealth v. Travaglia\">502 Pa. 474</a></span>, <span class=\"citation\" data-id=\"9635346\"><a href=\"/opinion/1467488/commonwealth-v-travaglia/\" aria-description=\"Citation for case: Commonwealth v. Travaglia\">467 A. 2d 288</a></span>; No. 83-6452, <span class=\"citation\" data-id=\"1731810\"><a href=\"/opinion/1731810/tokman-v-state/\" aria-description=\"Citation for case: Tokman v. State\">435 So. 2d 664</a></span>; No. 83-6500, <span class=\"citation\" data-id=\"1248400\"><a href=\"/opinion/1248400/dutton-v-state/\" aria-description=\"Citation for case: Dutton v. State\">674 P. 2d 1134</a></span>; No. 83-6608, <span class=\"citation\" data-id=\"427093\"><a href=\"/opinion/427093/henry-willis-iii-v-walter-b-zant-warden-georgia-diagnostic-and/\" aria-description=\"Citation for case: Henry Willis, III v. Walter B. Zant, Warden, Georgia...\">720 F. 2d 1212</a></span>; No. 83-6636, 100 N. M. 756, <span class=\"citation\" data-id=\"1316820\"><a href=\"/opinion/1316820/state-v-guzman/\" aria-description=\"Citation for case: State v. Guzman\">676 P. 2d 1321</a></span>.</p>\n</opinion>"},{"id":9042028,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":662,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1170-17\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A6v\">dissenting.</p>\n<p id=\"b1170-18\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, <page-number citation-index=\"1\" label=\"1257\">*1257</page-number>227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}