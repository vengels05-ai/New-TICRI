{"id":9287370,"docketId":66555775,"caseName":"Henderson v. Arkansas","caseNameFull":"Henderson v. Arkansas","slug":"henderson-v-arkansas","docketNumber":"No. 83-438","dateFiled":"1983-12-05","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9282230,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":591,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b886-12\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AJ1q\">dissenting.</p>\n<p id=\"ADaz\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}