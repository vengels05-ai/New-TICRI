{"id":9075913,"docketId":66342166,"caseName":"In re Disbarment of Cooper","caseNameFull":"In re Disbarment of Cooper","slug":"in-re-disbarment-of-cooper","docketNumber":"No. D-672","dateFiled":"1988-03-21","dateArgued":null,"dateCertGranted":null,"year":1988,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9069793,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":526,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AhO\">Edward Samuel Cooper, of Los Angeles, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be <page-number citation-index=\"1\" label=\"952\">*952</page-number>stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on January, 25, 1988 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./484/1040/\">484 U. S. 1040</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}