{"id":9119467,"docketId":66385747,"caseName":"In re Disbarment of Solowitch","caseNameFull":"In re Disbarment of Solowitch","slug":"in-re-disbarment-of-solowitch","docketNumber":"No. D-1065","dateFiled":"1992-03-30","dateArgued":null,"dateCertGranted":null,"year":1992,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9114008,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":472,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A2ks\">Eric Steven Solowitch, of University Heights, Ohio, having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on January 18, 1992 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./502/1026/\">502 U. S. 1026</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}