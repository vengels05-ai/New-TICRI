{"id":8178904,"docketId":65276487,"caseName":"Thorp v. Bonnifield","caseNameFull":"Thorp v. Bonnifield","slug":"thorp-v-bonnifield","docketNumber":"No. 270","dateFiled":"1897-10-18","dateArgued":null,"dateCertGranted":null,"year":1897,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":"<p>Certificate- from the United States Circuit Court of Appeals for the Ninth Circuit-.</p>","headnotes":null,"proceduralHistory":null,"attorneys":"Mr. John M. Thurston for plaintiff in error., Mr. E. S. Pillshury for defendants in error.","natureOfSuit":"","citationCount":1,"judges":"","jurisdictionType":"","opinions":[{"id":8140819,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":748,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"AMr\">\n<em>Per Curiam.</em>\n</author>\n<p id=\"A3K\">The question whether the United States Circuit Court of Appeals for the Ninth Circuit has jurisdiction of this case answered in the'negative on the authority of <em>Aztec Mining Company </em>v. <em>Ripley, </em><span class=\"citation\" data-id=\"93747\"><a href=\"/opinion/93747/aztec-mining-co-v-ripley/\" aria-description=\"Citation for case: Aztec Mining Co. v. Ripley\">151 U. S. 79</a></span>, and <em>Steamer Coquitlam </em>v. <em>United States, </em><span class=\"citation\" data-id=\"94492\"><a href=\"/opinion/94492/steamer-coquitlam-v-united-states/\" aria-description=\"Citation for case: Steamer Coquitlam v. United States\">163 U. S. 346</a></span>.</p>\n</opinion>"}],"citations":[]}