{"id":9120805,"docketId":66387085,"caseName":"In re Disbarment of Blank","caseNameFull":"In re Disbarment of Blank","slug":"in-re-disbarment-of-blank","docketNumber":"No. D-1104","dateFiled":"1992-05-18","dateArgued":null,"dateCertGranted":null,"year":1992,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9115350,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":449,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"APDt\">Gary L. Blank, of Chicago, Ill., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on March 30, 1992 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./503/956/\">503 U. S. 956</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}