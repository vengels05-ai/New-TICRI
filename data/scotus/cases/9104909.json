{"id":9104909,"docketId":66371181,"caseName":"Oxford v. Missouri","caseNameFull":"Oxford v. Missouri Antwine v. Missouri May v. Collins, Director, Texas Department of Criminal Justice, Institutional Division","slug":"oxford-v-missouri","docketNumber":"No. 90-6077; No. 90-6119; No. 90-6228","dateFiled":"1991-01-14","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9099305,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":644,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AsDM\">Sup. Ct. Mo.;</p>\n<p id=\"Ajdo\">Sup. Ct. Mo.; and</p>\n<p id=\"Acrj\">C. A. 5th Cir. Certiorari denied. Reported below: No. 90-6077, <span class=\"citation\" data-id=\"2446268\"><a href=\"/opinion/2446268/thurston-v-state/\" aria-description=\"Citation for case: Thurston v. State\">791 S. W. 2d 896</a></span>; No. 90-6119, <span class=\"citation\" data-id=\"9774656\"><a href=\"/opinion/2446255/antwine-v-state/\" aria-description=\"Citation for case: Antwine v. State\">791 S. W. 2d 403</a></span>; No. 90-6228, <span class=\"citation multiple-matches\"><a href=\"/c/F.%202d/904/228/\">904 F. 2d 228</a></span>.</p>\n</opinion>"},{"id":9099306,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":570,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1021-9\">Justice Marshall,</author>\n<p id=\"ABBF\">dissenting.</p>\n<p id=\"b1021-10\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}