{"id":105705,"docketId":198742,"caseName":"Hill v. United States","caseNameFull":"Hill v. United States","slug":"hill-v-united-states","docketNumber":"287, Misc","dateFiled":"1958-06-02","dateArgued":null,"dateCertGranted":null,"year":1958,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":"<p>Mise.</p>","headnotes":null,"proceduralHistory":null,"attorneys":"Howard Adler, Jr. for petitioner., Solicitor General Rankin, Acting Assistant Attorney General McLean and Beatrice Rosenberg for the United States.","natureOfSuit":"","citationCount":8,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":105705,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":1259,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"6\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b760-9\">\n  Per Curiam.\n </author>\n<p id=\"b760-10\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for writ of certiorari are granted. The judgment of the United States Court of Appeals for the District of Columbia Circuit is vacated and the case is remanded to that court for consideration in light of\n  <em>\n   Ellis\n  </em>\n  v.\n  <em>\n   United States,\n  </em>\n  <span class=\"citation\" data-id=\"105701\"><a href=\"/opinion/105701/ellis-v-united-states/\" aria-description=\"Citation for case: Ellis v. United States\">356 U. S. 674</a></span>, decided May 26,1958, and also in light of\n  <em>\n   Farley\n  </em>\n  v.\n  <em>\n   United States,\n  </em>\n  <span class=\"citation\" data-id=\"105550\"><a href=\"/opinion/105550/farley-v-united-states/\" aria-description=\"Citation for case: Farley v. United States\">354 U. S. 521</a></span>; and\n  <em>\n   Johnson\n  </em>\n  v.\n  <em>\n   United States,\n  </em>\n  <span class=\"citation\" data-id=\"105464\"><a href=\"/opinion/105464/johnson-v-united-states/\" aria-description=\"Citation for case: Johnson v. United States\">352 U. S. 565</a></span>.\n </p>\n</opinion>"}],"citations":[]}