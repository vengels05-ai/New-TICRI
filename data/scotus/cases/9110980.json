{"id":9110980,"docketId":66377260,"caseName":"In re Disbarment of Bolton","caseNameFull":"In re Disbarment of Bolton","slug":"in-re-disbarment-of-bolton","docketNumber":"No. D-1010","dateFiled":"1991-10-07","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9105475,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":462,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A2s\">George J. Bolton, of North Miami Beach, Fla., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 17, 1991 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./501/1215/\">501 U. S. 1215</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}