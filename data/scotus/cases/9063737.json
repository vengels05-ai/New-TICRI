{"id":9063737,"docketId":66329988,"caseName":"In re Disbarment of Sodowick","caseNameFull":"In re Disbarment of Sodowick","slug":"in-re-disbarment-of-sodowick","docketNumber":"No. D-556","dateFiled":"1986-10-06","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9057357,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":464,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A1T\">Michael Samuel Sodowick, of West Caldwell, N. J., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on May 5, 1986 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./476/1102/\">476 U. S. 1102</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}