{"id":9055462,"docketId":66321710,"caseName":"In re Disbarment of Slone","caseNameFull":"In re Disbarment of Slone","slug":"in-re-disbarment-of-slone","docketNumber":"No. D-498","dateFiled":"1985-10-07","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9048983,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":514,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ADO\">Harold G. Slone, of New York, N. Y., having requested to resign as a member of <page-number citation-index=\"1\" label=\"808\">*808</page-number>the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 3, 1985 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./471/1134/\">471 U. S. 1134</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}