{"id":9060670,"docketId":66326921,"caseName":"Keeten v. Garrison","caseNameFull":"Keeten v. Garrison, Warden","slug":"keeten-v-garrison","docketNumber":"No. 84-6187","dateFiled":"1986-05-27","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":14,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9054269,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":633,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1099-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Alo\">dissenting as to petitioner Larry Darnell Williams.</p>\n<p id=\"b1099-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}