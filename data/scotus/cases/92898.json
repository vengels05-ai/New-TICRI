{"id":92898,"docketId":1953272,"caseName":"Ex Parte Pennsylvania Co","caseNameFull":"","slug":"ex-parte-pennsylvania-co","docketNumber":"","dateFiled":"1890-12-08","dateArgued":null,"dateCertGranted":null,"year":1890,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"","jurisdictionType":"","opinions":[{"id":92898,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1116,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"1215783\"><a href=\"/opinion/1215783/in-re-pennsylvania-company/\" aria-description=\"Citation for case: In Re Pennsylvania Company\">137 U.S. 457</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./11/143/\">11 S.Ct. 143</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/L.Ed./34/741/\">34 L.Ed. 741</a></span></p>\n    <p class=\"parties\"><i>Ex parte</i> PENNSYLVANIA CO.</p>\n    <p class=\"date\">December 8, 1890.</p>\n    <div class=\"prelims\">\n      <p class=\"indent\"><i>Danl. Davenport</i> and <i>William H. O'Hara</i>, for petitioner.</p>\n      <p class=\"indent\"><i>Lewis E. Stanton</i>, for respondent.</p>\n      <p class=\"indent\">BRADLEY, J.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">This case in all material respects is identical with the case of Ex parte Pennsylvania Co., ante, 141, (just decided,) and the same conclusion is reached as in that case. The petition for <i>mandamus</i> is denied.</p>\n    </div>\n    "}],"citations":[]}