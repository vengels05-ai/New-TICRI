{"id":103073,"docketId":2246699,"caseName":"A. K. Fowler, Administrator, Etc. v. Russell B. Seymour, Trustee, Etc.","caseNameFull":"","slug":"a-k-fowler-administrator-etc-v-russell-b-seymour-trustee-etc","docketNumber":"1049","dateFiled":"1938-05-31","dateArgued":null,"dateCertGranted":null,"year":1938,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":103073,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1873,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./304/580/\">304 U.S. 580</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./58/1060/\">58 S.Ct. 1060</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">82 L.Ed. 1542</span></p>\n    <p class=\"parties\">A. K. FOWLER, Administrator, etc., et al., petitioners,<br>v.<br>Russell B. SEYMOUR, Trustee, etc.<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a></p>\n    <p class=\"docket\">No. 1049.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">May 31, 1938</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Messrs. Franklin P. Bull and Homer C. Compton, both of Los Angeles, Cal. (Mr. Calvin S. Mauk, of Los Angeles, Cal., of counsel), for petitioners.</p>\n      <p class=\"indent\">Mr. Thomas S. Tobin, of Los Angeles, Cal. (Mr. Raphael Dechter, of Los Angeles, Cal., of counsel), for respondent.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">For opinion below, see In re McIntosh, <span class=\"citation\" data-id=\"6873228\"><a href=\"/opinion/6975508/fowler-v-seymour/\" aria-description=\"Citation for case: Fowler v. Seymour\">95 F.2d 627</a></span>.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">The petition for writ of certiorari to the United States Circuit Court of Appeals for the Ninth Circuit is denied.</p>\n    </div>\n    <div class=\"footnotes\">\n      <div class=\"footnote\" id=\"fn-s\">\n        <a class=\"footnote\" href=\"#fn-s_ref\">*</a>\n        <p> Rehearing denied <span class=\"citation\" data-id=\"8153698\"><a href=\"/opinion/8191765/ex-parte-rubin/\" aria-description=\"Citation for case: Ex parte Rubin\">59 S.Ct. 60</a></span>, 83 L.Ed. &#8212;&#8212;.</p>\n      </div>\n    </div>\n    "}],"citations":[]}