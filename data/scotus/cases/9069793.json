{"id":9069793,"docketId":66336044,"caseName":"In re Disbarment of Benedict","caseNameFull":"In re Disbarment of Benedict","slug":"in-re-disbarment-of-benedict","docketNumber":"No. D-589","dateFiled":"1987-06-26","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9063534,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":453,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AXK\">Mark J. Benedict, of Austin, Tex., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on November 17, 1986 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./479/958/\">479 U. S. 958</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}