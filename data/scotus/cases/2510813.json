{"id":2510813,"docketId":1093089,"caseName":"Howell v. Ohio","caseNameFull":"Howell v. Ohio","slug":"howell-v-ohio","docketNumber":"789","dateFiled":"1965-05-17","dateArgued":null,"dateCertGranted":null,"year":1965,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Bernard A. Berkman for petitioner., Thomas H. Sutherland for respondent.","natureOfSuit":"","citationCount":4,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":2510813,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":663,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion type=\"majority\">\n<author id=\"b353-12\">\n  Per Curiam.\n </author>\n<p id=\"b353-13\">\n  The petition for writ of certiorari is granted. The judgment is vacated and the case is remanded to the Supreme Court of Ohio for further consideration in light of\n  <em>\n   Griffin\n  </em>\n  v.\n  <em>\n   California,\n  </em>\n  <span class=\"citation\" data-id=\"6751630\"><a href=\"/opinion/6862140/griffin-v-california/\" aria-description=\"Citation for case: Griffin v. California\">380 U. S. 609</a></span>.\n </p>\n<judges id=\"b353-14\">\n  The Chief Justice took no part in the consideration or decision of this case.\n </judges>\n</opinion>"}],"citations":[]}