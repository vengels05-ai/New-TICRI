{"id":9068908,"docketId":66335159,"caseName":"West v. Texas","caseNameFull":"West v. Texas Cooks v. Oklahoma","slug":"west-v-texas","docketNumber":"No. 86-6451; No. 86-6723","dateFiled":"1987-05-26","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9062614,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":326,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AXE8\">Ct. Crim. App. Tex; and</p>\n<p id=\"AVMJ\">Ct. Crim. App. Okla. Certiorari denied. Reported below: No. 86-6451, <span class=\"citation\" data-id=\"9647585\"><a href=\"/opinion/1525845/west-v-state/\" aria-description=\"Citation for case: West v. State\">720 S. W. 2d 511</a></span>.</p>\n</opinion>"},{"id":9062615,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1000-14\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AW1x\">dissenting.</p>\n<p id=\"A7F\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}