{"id":8613232,"docketId":65876026,"caseName":"Manzanillo v. United States","caseNameFull":"LEON O. MANZANILLO v. United States","slug":"manzanillo-v-united-states","docketNumber":"No. 49386","dateFiled":"1958-03-03","dateArgued":null,"dateCertGranted":null,"year":1958,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8591909,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":689,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"b953-18\">Jurisdiction; claims from Philippines. Petition dismissed on authority of <em>Logronio </em>v. <em>United States, </em><span class=\"citation\" data-id=\"9704656\"><a href=\"/opinion/1981398/logronio-v-united-states/\" aria-description=\"Citation for case: Logronio v. United States\">132 C. Cls. 596</a></span>.</p>\n<p id=\"b954-3\"><page-number citation-index=\"1\" label=\"924\">*924</page-number>Plaintiff\u2019s petition for writ of certiorari was <em>granted </em>by the Supreme Court October 14, 1957, but the writ was subsequently dismissed on March 3, 1958, for failure to comply with paragraph 1 of Rule 36 of the Rules of the Supreme Court.</p>\n</opinion>"}],"citations":[]}