{"id":9047722,"docketId":66313964,"caseName":"Harris v. Florida","caseNameFull":"Harris v. Florida Johnson v. Florida Hyman v. South Carolina Johnson v. Florida","slug":"harris-v-florida","docketNumber":"No. 83-6230; No. 83-6390; No. 83-6397; No. 83-6456","dateFiled":"1984-04-30","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9041116,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":769,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AZBd\">Sup. Ct. Fla.;</p>\n<p id=\"A1sL\">Sup. Ct. Fla.;</p>\n<p id=\"AEbj\">Ct. Common Pleas, Charleston County, S. C.; and</p>\n<p id=\"AI3t\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 83-6230, <span class=\"citation\" data-id=\"1840457\"><a href=\"/opinion/1840457/harris-v-state/\" aria-description=\"Citation for case: Harris v. State\">438 So. 2d 787</a></span>; No. 83-6390, <span class=\"citation\" data-id=\"1108149\"><a href=\"/opinion/1108149/johnson-v-state/\" aria-description=\"Citation for case: Johnson v. State\">442 So. 2d 193</a></span>; No. 83-6456, <span class=\"citation\" data-id=\"1108089\"><a href=\"/opinion/1108089/johnson-v-state/\" aria-description=\"Citation for case: Johnson v. State\">442 So. 2d 185</a></span>.</p>\n</opinion>"},{"id":9041117,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b957-12\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A_uS\">dissenting.</p>\n<p id=\"b957-13\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}