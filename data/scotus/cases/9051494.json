{"id":9051494,"docketId":66317740,"caseName":"Fisher v. Arizona","caseNameFull":"Fisher v. Arizona Melson v. Tennessee Groseclose v. Tennessee","slug":"fisher-v-arizona","docketNumber":"No. 84-5425; No. 84-5491; No. 84-5530","dateFiled":"1984-11-26","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":63,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9044950,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":526,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AWeF\">Sup. Ct. Ariz.;</p>\n<p id=\"A2Xj\">Ct. Crim. App. Tenn.; and</p>\n<p id=\"A5f0\">Ct. Crim. App. Tenn. Certiorari denied. Reported below: No. 84-5425, <span class=\"citation\" data-id=\"2607859\"><a href=\"/opinion/2607859/state-v-fisher/\" aria-description=\"Citation for case: State v. Fisher\">141 Ariz. 227</a></span>, <span class=\"citation\" data-id=\"2607859\"><a href=\"/opinion/2607859/state-v-fisher/\" aria-description=\"Citation for case: State v. Fisher\">686 P. 2d 750</a></span>.</p>\n</opinion>"},{"id":9044951,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":599,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1000-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A_rA\">dissenting.</p>\n<p id=\"b1000-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}