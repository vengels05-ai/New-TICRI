{"id":8415519,"docketId":65611362,"caseName":"Settle v. United States","caseNameFull":"Kelvin SETTLE v. UNITED STATES.","slug":"settle-v-united-states","docketNumber":"13-8315","dateFiled":"2014-02-24","dateArgued":null,"dateCertGranted":null,"year":2014,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8385863,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1740,"isHtml":true,"text":"<opinion type=\"majority\"><p id=\"p-5\">Motion of petitioner for leave to proceed <em>in forma pauperis</em> denied, and petition for writ of certiorari to the United States Court of Appeals for the Eighth Circuit dismissed. See Rule 39.8. As petitioner has repeatedly abused this Court's process, the Clerk is directed not to accept any further petitions in noncriminal matters from petitioner unless the docketing fee required by Rule 38(a) is paid and petition submitted in compliance with Rule 33.1. See <em>Martin v. District of Columbia Court of Appeals,</em> <extracted-citation case-ids=\"11924825\" index=\"0\" url=\"https://cite.case.law/us/506/1/\"><span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">506 U.S. 1</a></span></extracted-citation>, <extracted-citation case-ids=\"11924825\" index=\"1\" url=\"https://cite.case.law/us/506/1/\"><span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">113 S.Ct. 397</a></span></extracted-citation>, <extracted-citation case-ids=\"11924825\" index=\"2\" url=\"https://cite.case.law/us/506/1/\"><span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">121 L.Ed.2d 305</a></span></extracted-citation> (1992) ( <em>per curiam</em> ).</p><p id=\"p-6\"><strong>Justice KAGAN took no part in the consideration or decision of this motion and this petition.</strong></p></opinion>"}],"citations":[]}