{"id":107500,"docketId":1424839,"caseName":"Rosenbloom v. Virginia","caseNameFull":"Rosenbloom v. Virginia","slug":"rosenbloom-v-virginia","docketNumber":"366","dateFiled":"1967-10-09","dateArgued":null,"dateCertGranted":null,"year":1967,"scdbId":"1966-143","direction":"Liberal","votesMajority":8,"votesMinority":1,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Seymour Horwits and Melvin L. Wulf for petitioner., James B. Wilkinson for respondent.","natureOfSuit":"","citationCount":16,"judges":"Roth, Massachusetts","jurisdictionType":"","opinions":[{"id":107500,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":1309,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion type=\"majority\">\n<author id=\"b486-10\">\n  Per Curiam.\n </author>\n<p id=\"b486-11\">\n  The petition for a writ of certiorari is granted and the judgment of the Supreme Court of Appeals of Virginia is reversed.\n  <em>\n   Sunshine Book Co.\n  </em>\n  v.\n  <em>\n   Summerfield,\n  </em>\n  <span class=\"citation\" data-id=\"105614\"><a href=\"/opinion/105614/sunshine-book-co-v-summerfield/\" aria-description=\"Citation for case: Sunshine Book Co. v. Summerfield\">355 U. S. 372</a></span>.\n </p>\n<judges id=\"b486-12\">\n  Mr. Justice Harlan adheres to the views expressed in his separate opinions in\n  <em>\n   Roth\n  </em>\n  v.\n  <em>\n   United States,\n  </em>\n  <span class=\"citation\" data-id=\"9421496\"><a href=\"/opinion/105547/roth-v-united-states/#496\" aria-description=\"Citation for case: Roth v. United States\">354 U. S. 476, 496</a></span>, and\n  <em>\n   Memoirs\n  </em>\n  v.\n  <em>\n   Massachusetts,\n  </em>\n  <span class=\"citation\" data-id=\"9423171\"><a href=\"/opinion/107187/a-book-named-john-clelands-memoirs-of-a-woman-of-pleasure-v-attorney/#455\" aria-description=\"Citation for case: A Book Named &quot;John Cleland&#x27;s Memoirs of a Woman of...\">383 U. S. 413, 455</a></span>, and on the basis of the reasoning set forth therein would affirm.\n </judges>\n</opinion>"}],"citations":[]}