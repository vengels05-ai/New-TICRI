{"id":9053864,"docketId":66320110,"caseName":"Roscoe v. Arizona","caseNameFull":"Roscoe v. Arizona Campbell v. Washington Vereen v. North Carolina","slug":"roscoe-v-arizona","docketNumber":"No. 84-6302; No. 84-6306; No. 84-6364","dateFiled":"1985-04-29","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":212,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9047361,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1208,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Af0D\">Sup. Ct. Ariz.;</p>\n<p id=\"Aa1\">Sup. Ct. Wash.; and</p>\n<p id=\"AbJT\">Sup. Ct. N. C. Certiorari denied. Reported below: No. 84-6302, <span class=\"citation\" data-id=\"1194797\"><a href=\"/opinion/1194797/state-v-roscoe/\" aria-description=\"Citation for case: State v. Roscoe\">145 Ariz. 212</a></span>, <span class=\"citation\" data-id=\"1194797\"><a href=\"/opinion/1194797/state-v-roscoe/\" aria-description=\"Citation for case: State v. Roscoe\">700 P. 2d 1312</a></span>; No. 84-6306, <span class=\"citation\" data-id=\"9623665\"><a href=\"/opinion/1408462/state-v-campbell/\" aria-description=\"Citation for case: State v. Campbell\">103 Wash. 2d 1</a></span>, <span class=\"citation\" data-id=\"9623665\"><a href=\"/opinion/1408462/state-v-campbell/\" aria-description=\"Citation for case: State v. Campbell\">691 P. 2d 929</a></span>; No. 84-6364, <span class=\"citation\" data-id=\"1157221\"><a href=\"/opinion/1157221/state-v-vereen/\" aria-description=\"Citation for case: State v. Vereen\">312 N. C. 499</a></span>, <span class=\"citation\" data-id=\"1157221\"><a href=\"/opinion/1157221/state-v-vereen/\" aria-description=\"Citation for case: State v. Vereen\">324 S. E. 2d 250</a></span>.</p>\n</opinion>"},{"id":9047362,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1028-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AMgr\">dissenting.</p>\n<p id=\"b1028-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}