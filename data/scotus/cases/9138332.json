{"id":9138332,"docketId":66404627,"caseName":"Moran v. Pennsylvania","caseNameFull":"Moran v. Pennsylvania Espinosa v. Florida George v. Murray, Director, Virginia Department of Corrections","slug":"moran-v-pennsylvania","docketNumber":"No. 93-8151; No. 93-8207; No. 93-8636","dateFiled":"1994-06-06","dateArgued":null,"dateCertGranted":null,"year":1994,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Blackmun","jurisdictionType":"","opinions":[{"id":9132992,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":118,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AK1-\">Sup. Ct. Pa.; Sup. Ct. Fla.; and Sup. Ct. Va. Certiorari denied.</p>\n</opinion>"},{"id":9132993,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Blackmun","joinedBy":"","pageCount":null,"textLength":642,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1112-12\">Justice Blackmun,</author>\n<p id=\"AZot\">dissenting.</p>\n<p id=\"b1112-13\">Adhering to my view that the death penalty cannot be imposed fairly within the constraints of our Constitution, see my dissent in <em>Callins </em>v. <em>Collins, </em><span class=\"citation\" data-id=\"9432964\"><a href=\"/opinion/117187/callins-v-collins-director-texas-department-of-criminal-justice/#1143\" aria-description=\"Citation for case: Callins v. Collins, Director, Texas Department of...\">510 U. S. 1141, 1143</a></span> (1994), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}