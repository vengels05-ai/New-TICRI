{"id":9103260,"docketId":66369532,"caseName":"Clark v. California","caseNameFull":"Clark v. California Peoples v. Alabama Petary v. Missouri Smith v. Missouri","slug":"clark-v-california","docketNumber":"No. 90-5677; No. 90-5772; No. 90-5873; No. 90-5882","dateFiled":"1990-11-13","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":4,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9097635,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1026,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ammn\">Sup. Ct. Cal.;</p>\n<p id=\"AikW\">Ct. Crim. App. Ala.;</p>\n<p id=\"AiXM\">Sup. Ct. Mo.; and</p>\n<p id=\"AfMD\">Sup. Ct. Mo. Certiorari denied. Reported below: No. 90-5677, <span class=\"citation\" data-id=\"9591237\"><a href=\"/opinion/1345745/people-v-clark/\" aria-description=\"Citation for case: People v. Clark\">50 Cal. 3d 583</a></span>, <span class=\"citation\" data-id=\"9591237\"><a href=\"/opinion/1345745/people-v-clark/\" aria-description=\"Citation for case: People v. Clark\">789 P. 2d 127</a></span>; No. 90-5772, <span class=\"citation\" data-id=\"1822057\"><a href=\"/opinion/1822057/peoples-v-state/\" aria-description=\"Citation for case: Peoples v. State\">565 So. 2d 1177</a></span>; No. 90-5873, <span class=\"citation\" data-id=\"1577071\"><a href=\"/opinion/1577071/state-v-petary/\" aria-description=\"Citation for case: State v. Petary\">790 S. W. 2d 243</a></span>; No. 90-5882, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20W.%202d/790/241/\">790 S. W. 2d 241</a></span>.</p>\n</opinion>"},{"id":9097636,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":569,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b939-9\">Justice Marshall,</author>\n<p id=\"AC8mQ\">dissenting.</p>\n<p id=\"b939-10\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}