{"id":9151672,"docketId":66417971,"caseName":"In re Disbarment of Wong","caseNameFull":"In re Disbarment of Wong","slug":"in-re-disbarment-of-wong","docketNumber":"No. D-1455","dateFiled":"1995-02-21","dateArgued":null,"dateCertGranted":null,"year":1995,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9146361,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":466,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ANNW\">Allan Yon Kwong Wong, of Somerville, Mass., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on September 14, 1994 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./512/1282/\">512 U. S. 1282</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}