{"id":9079544,"docketId":66345800,"caseName":"In re Disbarment of Alfieri","caseNameFull":"In re Disbarment of Alfieri","slug":"in-re-disbarment-of-alfieri","docketNumber":"No. D-717","dateFiled":"1988-10-03","dateArgued":null,"dateCertGranted":null,"year":1988,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9073513,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":466,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AqP\">Richard Joseph Alfieri, of Fort Lauderdale, Fla., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 20, 1988 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./487/1202/\">487 U. S. 1202</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}