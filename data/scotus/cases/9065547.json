{"id":9065547,"docketId":66331798,"caseName":"In re Disbarment of Christakis","caseNameFull":"In re Disbarment of Christakis","slug":"in-re-disbarment-of-christakis","docketNumber":"No. D-569","dateFiled":"1986-12-15","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9059201,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AvdA\">Lee J. Christakis, of Gary, Ind., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on September 11, 1986 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./478/1038/\">478 U. S. 1038</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}