{"id":9058331,"docketId":66324582,"caseName":"Cannon v. Texas","caseNameFull":"Cannon v. Texas Nethery v. Texas Perez v. Illinois","slug":"cannon-v-texas","docketNumber":"No. 85-5687; No. 85-5825; No. 85-5946","dateFiled":"1986-01-27","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":175,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9051889,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":889,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AbWy\">Ct. Crim. App. Tex.;</p>\n<p id=\"A270\">Ct. Crim. App. Tex.; and</p>\n<p id=\"AEvC\">Sup. Ct. Ill. Certiorari denied. Reported below: No. 85-5687, <span class=\"citation\" data-id=\"1564923\"><a href=\"/opinion/1564923/cannon-v-state/\" aria-description=\"Citation for case: Cannon v. State\">691 S. W. 2d 664</a></span>; No. 85-5825, <span class=\"citation\" data-id=\"1782068\"><a href=\"/opinion/1782068/nethery-v-state/\" aria-description=\"Citation for case: Nethery v. State\">692 S. W. 2d 686</a></span>; No. 85-5946, <span class=\"citation\" data-id=\"9526441\"><a href=\"/opinion/2037974/people-v-perez/\" aria-description=\"Citation for case: People v. Perez\">108 Ill. 2d 70</a></span>, <span class=\"citation\" data-id=\"9526441\"><a href=\"/opinion/2037974/people-v-perez/\" aria-description=\"Citation for case: People v. Perez\">483 N. E. 2d 250</a></span>.</p>\n</opinion>"},{"id":9051890,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b976-12\">Justice Brennan and Justice Marshall,</author>\n<p id=\"At0h\">dissenting.</p>\n<p id=\"b976-13\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentehces in these cases.</p>\n</opinion>"}],"citations":[]}