{"id":9054175,"docketId":66320421,"caseName":"Herrera v. Texas","caseNameFull":"Herrera v. Texas Cervi v. Kemp, Warden Gaines v. Illinois Stewart v. Illinois","slug":"herrera-v-texas","docketNumber":"No. 84-6395; No. 84-6399; No. 84-6505; No. 84-6534","dateFiled":"1985-05-28","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9047681,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1155,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AKsW\">Ct. Crim. App. Tex.;</p>\n<p id=\"AuTT\">Sup. Ct. Ga.;</p>\n<p id=\"AYdR\">Sup. Ct. Ill.; and</p>\n<p id=\"ArGq\">Sup. Ct. Ill. Certiorari denied. Reported below: No. 84-6395, <span class=\"citation\" data-id=\"2460940\"><a href=\"/opinion/2460940/herrera-v-state/\" aria-description=\"Citation for case: Herrera v. State\">682 S. W. 2d 313</a></span>; No. 84-<page-number citation-index=\"1\" label=\"1132\">*1132</page-number>6505, <span class=\"citation\" data-id=\"9524033\"><a href=\"/opinion/2032139/people-v-gaines/\" aria-description=\"Citation for case: People v. Gaines\">105 Ill. 2d 79</a></span>, <span class=\"citation\" data-id=\"9524033\"><a href=\"/opinion/2032139/people-v-gaines/\" aria-description=\"Citation for case: People v. Gaines\">473 N. E. 2d 868</a></span>; No. 84-6534, <span class=\"citation\" data-id=\"9524027\"><a href=\"/opinion/2032120/people-v-stewart/\" aria-description=\"Citation for case: People v. Stewart\">105 Ill. 2d 22</a></span>, <span class=\"citation\" data-id=\"9524027\"><a href=\"/opinion/2032120/people-v-stewart/\" aria-description=\"Citation for case: People v. Stewart\">473 N. E. 2d 840</a></span>.</p>\n</opinion>"},{"id":9047682,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1066-4\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AUmq\">dissenting.</p>\n<p id=\"Aluy\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}