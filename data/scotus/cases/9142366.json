{"id":9142366,"docketId":66408661,"caseName":"In re Disbarment of Steffen","caseNameFull":"In re Disbarment of Steffen","slug":"in-re-disbarment-of-steffen","docketNumber":"No. D-1323","dateFiled":"1994-02-22","dateArgued":null,"dateCertGranted":null,"year":1994,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9137045,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":453,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A7kJ\">Albert Joseph Steffen, of Cincinnati, Ohio, having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the <page-number citation-index=\"1\" label=\"1104\">*1104</page-number>Bar of this Court. The rule to show cause, heretofore issued on November 8, 1993 <em>[ante, </em>p. 961], is hereby discharged.</p>\n</opinion>"}],"citations":[]}