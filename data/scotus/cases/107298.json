{"id":107298,"docketId":2566052,"caseName":"Hall v. Mississippi","caseNameFull":"Hall v. Mississippi","slug":"hall-v-mississippi","docketNumber":"672, Misc","dateFiled":"1966-11-21","dateArgued":null,"dateCertGranted":null,"year":1966,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":6,"judges":"Harlan, White, Douglas, Fortas","jurisdictionType":"","opinions":[{"id":107298,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":535,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b202-8\">\n  Per Curiam.\n </author>\n<p id=\"b202-9\">\n  The appeal is dismissed.\n </p>\n<judges id=\"b202-10\">\n  The Chief Justice, Mr. Justice Harlan, and Mr. Justice White are of the opinion that the appeal should be dismissed for want of jurisdiction.\n </judges>\n<judges id=\"b202-11\">\n  Mr. Justice Douglas and Mr. Justice Fortas are of the opinion that probable jurisdiction should be noted.\n </judges>\n</opinion>"}],"citations":[]}