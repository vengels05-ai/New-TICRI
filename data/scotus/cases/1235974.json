{"id":1235974,"docketId":1551399,"caseName":"Guerrieri v. United States","caseNameFull":"Guerrieri v. United States","slug":"guerrieri-v-united-states","docketNumber":"1969, Misc","dateFiled":"1970-06-29","dateArgued":null,"dateCertGranted":null,"year":1970,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":1235974,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":612,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b559-15\">\n  Per Curiam.\n </author>\n<p id=\"b559-16\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are granted. The judgment is vacated and the case is remanded to the United States District Court for the Western District of Pennsylvania for findings as to whether or not petitioner is in fact an indigent and proceeding in good faith pursuant to <span class=\"citation no-link\">28 U. S. C. \u00a7 1915</span>.\n </p>\n</opinion>"}],"citations":[]}