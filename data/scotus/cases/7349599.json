"><page-number citation-index=\"1\" label=\"477\">*477</page-number>Same case below, <span class=\"citation\" data-id=\"205735\"><a href=\"/opinion/205735/daniel-spuck-v-ammerman-fredric/\" aria-description=\"Citation for case: Daniel Spuck v. Ammerman Fredric\">415 Fed. Appx. 358</a></span>.</p>\n</opinion>"}],"citations":[]}