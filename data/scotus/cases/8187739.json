{"id":8187739,"docketId":65285417,"caseName":"Board of Supervisors v. Board of Supervisors","caseNameFull":"Board of Supervisors of Harrison County, Iowa v. Board of Supervisors of Pottawattamie County, Iowa","slug":"board-of-supervisors-v-board-of-supervisors","docketNumber":"No. 922","dateFiled":"1933-05-15","dateArgued":null,"dateCertGranted":null,"year":1933,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"","jurisdictionType":"","opinions":[{"id":8149670,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1887,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AaT\">Further consideration of the question of the jurisdiction of this Court in this case is postponed to the hearing on the merits. The attention of counsel is directed to the question of the right of the appellants to raise the questions presented under the Federal Constitution. <em>Hunter </em>v. <em>Pittsburgh, </em><span class=\"citation\" data-id=\"96718\"><a href=\"/opinion/96718/hunter-v-city-of-pittsburgh/#178\" aria-description=\"Citation for case: Hunter v. City of Pittsburgh\">207 U.S. 161, 178-181</a></span>; <em>Pawhuska </em>v. <em>Pawhuska Oil &amp; Gas Co., </em><span class=\"citation\" data-id=\"99439\"><a href=\"/opinion/99439/city-of-pawhuska-v-pawhuska-oil-gas-co/\" aria-description=\"Citation for case: City of Pawhuska v. Pawhuska Oil &amp; Gas Co.\">250 U.S. 394</a></span>; <em>Trenton </em>v. <em>New Jersey, </em><span class=\"citation\" data-id=\"100208\"><a href=\"/opinion/100208/city-of-trenton-v-new-jersey/#185\" aria-description=\"Citation for case: City of Trenton v. New Jersey\">262 U.S. 182, 185, 188, 191, 192</a></span>; <em>Railroad Commission </em>v. <em>Los Angeles R. Co., </em><span class=\"citation\" data-id=\"9418687\"><a href=\"/opinion/101483/railroad-commission-v-los-angeles-railway-corp/#156\" aria-description=\"Citation for case: Railroad Commission v. Los Angeles Railway Corp.\">280 U.S. 145, 156</a></span>; <em>Chicago </em>v. <em>Chicago Rapid Transit Co., </em><span class=\"citation\" data-id=\"8148718\"><a href=\"/opinion/8186791/chicago-v-chicago-rapid-transit-co/#578\" aria-description=\"Citation for case: Chicago v. Chicago Rapid Transit Co.\">284 U.S. 577, 578</a></span>; <em>Greenville </em>v. <em>Query, </em><span class=\"citation\" data-id=\"101946\"><a href=\"/opinion/101946/gregg-dyeing-co-v-query/#482\" aria-description=\"Citation for case: Gregg Dyeing Co. v. Query\">286 U.S. 472, 482</a></span>.</p>\n</opinion>"}],"citations":[]}