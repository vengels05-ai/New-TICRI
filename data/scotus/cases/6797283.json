{"id":6797283,"docketId":63778679,"caseName":"Gardner v. Utah","caseNameFull":"Ronnie Lee Gardner v. Utah","slug":"gardner-v-utah","docketNumber":"09-11378","dateFiled":"2010-06-17","dateArgued":null,"dateCertGranted":null,"year":2010,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":6682157,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1248,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ArXN\">Application for stay of execution of sentence of death, presented to Justice Sotomayor, and by her referred to the Court, denied. Petition for writ of certiorari to the Supreme Court of Utah denied.</p>\n<p id=\"b400-9\">Justice Stevens and Justice Breyer would grant the application for stay of execution. See Johnson v. Bredesen, <span class=\"citation\" data-id=\"1921234\"><a href=\"/opinion/1921234/johnson-v-bredesen/#1067\" aria-description=\"Citation for case: Johnson v. Bredesen\">558 U.S. 1067, 1067-1068</a></span>, <span class=\"citation\" data-id=\"1921234\"><a href=\"/opinion/1921234/johnson-v-bredesen/\" aria-description=\"Citation for case: Johnson v. Bredesen\">130 S. Ct. 541</a></span>, <span class=\"citation no-link\">175 L. Ed. 2d 552</span> (2009) (Stevens, J., joined by Breyer, J., respecting denial of certiorari).</p>\n<p id=\"b400-11\">Same case below, <span class=\"citation\" data-id=\"2512053\"><a href=\"/opinion/2512053/state-v-gardner/\" aria-description=\"Citation for case: State v. Gardner\">234 P.3d 1104</a></span> and <span class=\"citation\" data-id=\"2511886\"><a href=\"/opinion/2511886/gardner-v-state/\" aria-description=\"Citation for case: Gardner v. State\">234 P.3d 1115</a></span>.</p>\n</opinion>"}],"citations":[]}