{"id":9078067,"docketId":66344320,"caseName":"Wiley v. Mississippi","caseNameFull":"Wiley v. Mississippi Banks v. Oklahoma Bell v. Alabama Musgrove v. Alabama Collier v. Nevada","slug":"wiley-v-mississippi","docketNumber":"No. 87-1520; No. 87-6472; No. 87-6686; No. 87-6744; No. 87-6758","dateFiled":"1988-05-31","dateArgued":null,"dateCertGranted":null,"year":1988,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9071990,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1125,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AHm\">Sup. Ct. Miss.;</p>\n<p id=\"AYWj\">Ct. Crim. App. Okla.;</p>\n<p id=\"AWc\">Ct. Crim. App. Ala.;</p>\n<p id=\"Aj_j\">Sup. Ct. Ala.; and</p>\n<p id=\"ABuv\">Sup. Ct. Nev. Certiorari denied. Reported below: No. 87-1520, <span class=\"citation\" data-id=\"1148183\"><a href=\"/opinion/1148183/wiley-v-state/\" aria-description=\"Citation for case: Wiley v. State\">517 So. 2d 1373</a></span>; No. 87-6686, <span class=\"citation\" data-id=\"1953794\"><a href=\"/opinion/1953794/bell-v-state/\" aria-description=\"Citation for case: Bell v. State\">518 So. 2d 840</a></span>; No. 87-6744, <span class=\"citation\" data-id=\"1736255\"><a href=\"/opinion/1736255/ex-parte-musgrove/\" aria-description=\"Citation for case: Ex Parte Musgrove.\">519 So. 2d 586</a></span>; No. 87-6758, <span class=\"citation\" data-id=\"1220108\"><a href=\"/opinion/1220108/collier-v-state/\" aria-description=\"Citation for case: Collier v. State\">103 Nev. 563</a></span>, <span class=\"citation\" data-id=\"1220108\"><a href=\"/opinion/1220108/collier-v-state/\" aria-description=\"Citation for case: Collier v. State\">747 P. 2d 225</a></span>.</p>\n</opinion>"},{"id":9071991,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b996-13\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AQr9\">dissenting.</p>\n<p id=\"b996-14\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}