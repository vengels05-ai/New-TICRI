{"id":9030132,"docketId":66296354,"caseName":"Hance v. Georgia","caseNameFull":"Hance v. Georgia Clark v. Arizona Witt v. Florida","slug":"hance-v-georgia","docketNumber":"No. 80-5561; No. 80-5632; No. 80-5645","dateFiled":"1980-12-15","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9023413,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1019,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AXLC\">Sup. Ct. Ga.;</p>\n<p id=\"AKqh\">Sup. Ct. Ariz.; and</p>\n<p id=\"An7c\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 80-5561, <span class=\"citation\" data-id=\"1261399\"><a href=\"/opinion/1261399/hance-v-state/\" aria-description=\"Citation for case: Hance v. State\">245 Ga. 856</a></span>, <span class=\"citation\" data-id=\"1261399\"><a href=\"/opinion/1261399/hance-v-state/\" aria-description=\"Citation for case: Hance v. State\">268 S. E. 2d 339</a></span>; No. 80-5632, <span class=\"citation\" data-id=\"9623319\"><a href=\"/opinion/1407214/state-v-clark/\" aria-description=\"Citation for case: State v. Clark\">126 Ariz. 428</a></span>, <span class=\"citation\" data-id=\"9623319\"><a href=\"/opinion/1407214/state-v-clark/\" aria-description=\"Citation for case: State v. Clark\">616 P. 2d 888</a></span>; No. 80-5645, <span class=\"citation\" data-id=\"1761978\"><a href=\"/opinion/1761978/witt-v-state/\" aria-description=\"Citation for case: Witt v. State\">387 So. 2d 922</a></span>.</p>\n</opinion>"},{"id":9023414,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":599,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1081-11\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A_jK\">dissenting.</p>\n<p id=\"b1081-12\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}