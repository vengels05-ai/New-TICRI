{"id":96037,"docketId":1388886,"caseName":"Arabella D. Huntington, Appt. v. City of New York","caseNameFull":"","slug":"arabella-d-huntington-appt-v-city-of-new-york","docketNumber":"173","dateFiled":"1904-03-21","dateArgued":null,"dateCertGranted":null,"year":1904,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"","jurisdictionType":"","opinions":[{"id":96037,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1198,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"1639543\"><a href=\"/opinion/1639543/huntington-v-city-of-new-york/\" aria-description=\"Citation for case: Huntington v. City of New York\">193 U.S. 441</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./24/505/\">24 S.Ct. 505</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"1639543\"><a href=\"/opinion/1639543/huntington-v-city-of-new-york/\" aria-description=\"Citation for case: Huntington v. City of New York\">48 L.Ed. 741</a></span></p>\n    <p class=\"parties\">ARABELLA D. HUNTINGTON, <i>Appt.</i>,<br>v.<br>CITY OF NEW YORK <i>et al</i>.</p>\n    <p class=\"docket\">No. 173.</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">Argued March 3, 1904 Decided March 21, 1904.</p>\n    </div>\n    <p class=\"indent\">THE CHIEF JUSTICE:</p>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">This case is governed by the decision just announced [<i>Barney</i> v. <i>New York</i>, 193 U. S. &#8212;&#8212;, <i>ante</i>, 502, 24 Sup. Ct. Rep. 502], and the decree is accordingly <i>affirmed</i>.</p>\n    </div>\n    "}],"citations":[]}