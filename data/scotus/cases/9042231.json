{"id":9042231,"docketId":66308458,"caseName":"In re Disbarment of Spiro","caseNameFull":"In re Disbarment of Spiro","slug":"in-re-disbarment-of-spiro","docketNumber":"No. D-290","dateFiled":"1982-11-08","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9035577,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":518,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AYG\">Demetri M. Spiro, of Chicago, Ill., having requested to resign as a member of the Bar of this Court, it is ordered that his name be <page-number citation-index=\"1\" label=\"985\">*985</page-number>stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on September 9, 1982 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./458/1128/\">458 U. S. 1128</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}