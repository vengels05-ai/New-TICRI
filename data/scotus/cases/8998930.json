{"id":8998930,"docketId":66265146,"caseName":"Cote v. United States","caseNameFull":"Cote v. United States","slug":"cote-v-united-states","docketNumber":"No. 73-908","dateFiled":"1974-07-25","dateArgued":null,"dateCertGranted":null,"year":1974,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8991376,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":589,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A7I\">C. A. 5th Cir. Certiorari denied. Mr. Justice Douglas, being of the view that any federal ban on obscenity is prohibited by the First Amendment (see <em>United States </em>v. <em>12 200-ft. Reels of Film, </em><span class=\"citation\" data-id=\"9425385\"><a href=\"/opinion/108841/united-states-v-12-200-ft-reels-of-super-8mm-film/#130\" aria-description=\"Citation for case: United States v. 12 200-Ft. Reels of Super 8MM. Film\">413 U. S. 123, 130</a></span> (1973) (Douglas, J., dissenting)), would grant certiorari and reverse the judgment.</p>\n</opinion>"}],"citations":[]}