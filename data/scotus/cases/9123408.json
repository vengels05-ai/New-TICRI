{"id":9123408,"docketId":66389692,"caseName":"In re Disbarment of Ragano","caseNameFull":"In re Disbarment of Ragano","slug":"in-re-disbarment-of-ragano","docketNumber":"No. D-1121","dateFiled":"1992-10-05","dateArgued":null,"dateCertGranted":null,"year":1992,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9117971,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":443,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AdZ\">Frank Ragano, of Tampa, Fla., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on May 18, 1992 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./504/904/\">504 U. S. 904</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}