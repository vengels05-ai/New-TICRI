{"id":103076,"docketId":2217793,"caseName":"United States, Ex Rel. Iver Schmidt and James R. Rucker v. Charles W. Miles, United States Marshal.","caseNameFull":"","slug":"united-states-ex-rel-iver-schmidt-and-james-r-rucker-v-charles-w-miles-united-st","docketNumber":"1007","dateFiled":"1938-05-31","dateArgued":null,"dateCertGranted":null,"year":1938,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":103076,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1998,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./304/583/\">304 U.S. 583</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./58/1057/\">58 S.Ct. 1057</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"8153657\"><a href=\"/opinion/8191724/united-states-ex-rel-schmidt-v-miles/\" aria-description=\"Citation for case: United States ex rel. Schmidt v. Miles\">82 L.Ed. 1545</a></span></p>\n    <p class=\"parties\">UNITED STATES, ex rel. Iver SCHMIDT and James R.  Rucker, petitioners,<br>v.<br>Charles W. MILES, United States Marshal.<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a></p>\n    <p class=\"docket\">No. 1007.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">May 31, 1938</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Messrs. W. G. Cavett and Hal S. Buchanan, both of Memphis, Tenn., for petitioners.</p>\n      <p class=\"indent\">Messrs. Robert H. Jackson, Sol. Gen., and Hugh A. Fisher, both of Washington, D. C., and William W. Barron, Sp. Asst. to Atty. Gen., and George F. Kneip and W. Marvin Smith, both of Washington, D. C.