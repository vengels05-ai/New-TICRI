{"id":9050911,"docketId":66317157,"caseName":"In re Disbarment of Winner","caseNameFull":"In re Disbarment of Winner","slug":"in-re-disbarment-of-winner","docketNumber":"No. D-446","dateFiled":"1984-10-29","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9044354,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":458,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AJqS\">David Lee Winner, of Wooster, Ohio, having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on September 18, 1984 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./468/1248/\">468 U. S. 1248</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}