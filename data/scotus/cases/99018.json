{"id":99018,"docketId":1396765,"caseName":"Hendrickson, County Judge v. Creager","caseNameFull":"","slug":"hendrickson-county-judge-v-creager","docketNumber":"Nos. 428-431","dateFiled":"1917-11-05","dateArgued":null,"dateCertGranted":null,"year":1917,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"","jurisdictionType":"","opinions":[{"id":99018,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1733,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"1525533\"><a href=\"/opinion/1525533/hendrickson-v-creager/\" aria-description=\"Citation for case: Hendrickson v. Creager\">245 U.S. 115</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"99014\"><a href=\"/opinion/99014/gauzon-v-compania-general-de-tabacos-de-filipinas/\" aria-description=\"Citation for case: Gauzon v. Compa\u00f1ia General De Tabacos De Filipinas\">38 S.Ct. 46</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"99019\"><a href=\"/opinion/99019/kelley-v-gill/\" aria-description=\"Citation for case: Kelley v. Gill\">62 L.Ed. 185</a></span></p>\n    <p class=\"parties\">HENDRICKSON, County Judge,<br>v.<br>CREAGER.</p>\n    <p class=\"docket\">Nos. 428-431.</p>\n    <p class=\"date\">Argued Oct. 11, 1917.</p>\n    <p class=\"date\">Decided Nov. 5, 1917.</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Mr. Helm Bruce, of Louisville, Ky., for petitioner.</p>\n      <p class=\"indent\">Mr. L. A. Faurest, of Elizabethtown, Ky., for respondents.</p>\n      <p class=\"indent\">PER CURIAM.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The essential questions involved in these cases are the same as those considered and decided in Hendrickson v. Apperson. (No. 427) <span class=\"citation\" data-id=\"99017\"><a href=\"/opinion/99017/hendrickson-v-apperson/\" aria-description=\"Citation for case: Hendrickson v. Apperson\">245 U. S. 105</a></span>, 38 Sup. Ct. 44, 62 L. Ed. &#8212;&#8212;. The judgment of the Circuit Court of Appeals in each of them is accordingly</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">Affirmed.</p>\n    </div>\n    "}],"citations":[]}