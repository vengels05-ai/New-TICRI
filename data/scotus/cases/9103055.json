{"id":9103055,"docketId":66369327,"caseName":"Siebert v. Alabama","caseNameFull":"Siebert v. Alabama","slug":"siebert-v-alabama","docketNumber":"No. 90-5641","dateFiled":"1990-11-05","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":4,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9097425,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":566,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b929-11\">Justice Marshall,</author>\n<p id=\"AH4Y\">dissenting.</p>\n<p id=\"b929-12\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}