{"id":9107958,"docketId":66374231,"caseName":"Rodden v. Missouri","caseNameFull":"Rodden v. Missouri Robins v. Nevada","slug":"rodden-v-missouri","docketNumber":"No. 90-6614; No. 90-7116","dateFiled":"1991-04-15","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9102375,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":657,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AuMM\">Sup. Ct. Mo.; and</p>\n<p id=\"AEjZ\">Sup. Ct. Nev. Certiorari denied. Reported below: No. 90-6614, <span class=\"citation\" data-id=\"9760362\"><a href=\"/opinion/2368867/rodden-v-state/\" aria-description=\"Citation for case: Rodden v. State\">795 S. W. 2d 393</a></span>; No. 90-7116, <span class=\"citation\" data-id=\"1258858\"><a href=\"/opinion/1258858/robins-v-state/\" aria-description=\"Citation for case: Robins v. State\">106 Nev. 611</a></span>, <span class=\"citation\" data-id=\"1258858\"><a href=\"/opinion/1258858/robins-v-state/\" aria-description=\"Citation for case: Robins v. State\">798 P. 2d 558</a></span>.</p>\n</opinion>"},{"id":9102376,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":568,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b790-7\">Justice Marshall,</author>\n<p id=\"AqUxZ\">dissenting.</p>\n<p id=\"b790-8\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}