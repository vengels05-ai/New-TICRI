{"id":7341422,"docketId":64329914,"caseName":"Stanko v. Davis","caseNameFull":"Rudy Stanko v. Blake Davis, Warden","slug":"stanko-v-davis","docketNumber":"10-7804","dateFiled":"2011-01-10","dateArgued":null,"dateCertGranted":null,"year":2011,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":7259350,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1524,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AOZSY\">Motion of petitioner for leave to proceed in forma pauperis denied, and petition for writ of certiorari to the United States Court of Appeals for the Tenth Circuit dismissed. See Rule <page-number citation-index=\"1\" label=\"743\">*743</page-number>39.8. As petitioner has repeatedly abused this Court\u2019s process, the Clerk is directed not to accept any further petitions in noncriminal matters from petitioner unless the docketing fee required by Rule 38(a) is paid and petition submitted in compliance with Rule 33.1. See Martin v. District of Columbia Court of Appeals, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">506 U.S. 1</a></span>, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">113 S. Ct. 397</a></span>, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">121 L. Ed. 2d 305</a></span> (1992) (per curiam).</p>\n<p id=\"b845-3\">Same case below, <span class=\"citation\" data-id=\"152651\"><a href=\"/opinion/152651/stanko-v-davis/\" aria-description=\"Citation for case: Stanko v. Davis\">617 F.3d 1262</a></span>.</p>\n</opinion>"}],"citations":[]}