{"id":9047532,"docketId":66313774,"caseName":"Cheadle v. New Mexico","caseNameFull":"Cheadle v. New Mexico Godfrey v. Francis, Warden Meanes v. Texas Daugherty v. Wainwright, Secretary, Florida Department of Corrections Gilmore v. Missouri Flowers v. Louisiana","slug":"cheadle-v-new-mexico","docketNumber":"No. 83-6141; No. 83-6215; No. 83-6231; No. 83-6281; No. 83-6285; No. 83-6318","dateFiled":"1984-04-16","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":117,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9040923,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1424,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AlP\">Sup. Ct. N. M.;</p>\n<p id=\"AWeJ\">Sup. Ct. Ga.;</p>\n<p id=\"Aq6x\">Ct. Crim. App. Tex.;</p>\n<p id=\"AGO\">Sup. Ct. Fla.;</p>\n<p id=\"AlX\">Sup. Ct. Mo.; and</p>\n<p id=\"A8hN\">Sup. Ct. La. Certiorari denied. Reported below: No. 83-6141, 101 N. M. 282, <span class=\"citation\" data-id=\"9619555\"><a href=\"/opinion/1397664/state-v-cheadle/\" aria-description=\"Citation for case: State v. Cheadle\">681 P. 2d 708</a></span>; No. 83-6215, <span class=\"citation\" data-id=\"9854607\"><a href=\"/opinion/1295140/godfrey-v-francis/\" aria-description=\"Citation for case: Godfrey v. Francis\">251 Ga. 652</a></span>, <span class=\"citation\" data-id=\"9854607\"><a href=\"/opinion/1295140/godfrey-v-francis/\" aria-description=\"Citation for case: Godfrey v. Francis\">308 S. E. 2d 806</a></span>; No. 83-6231, <span class=\"citation\" data-id=\"9764259\"><a href=\"/opinion/2388785/meanes-v-state/\" aria-description=\"Citation for case: Meanes v. State\">668 S. W. 2d 366</a></span>; No. 83-6281, <span class=\"citation no-link\">443 So. 2d 979</span>; No. 83-6285, <span class=\"citation\" data-id=\"1787663\"><a href=\"/opinion/1787663/state-v-gilmore/\" aria-description=\"Citation for case: State v. Gilmore\">661 S. W. 2d 519</a></span>; No. 83-6318, <span class=\"citation\" data-id=\"1737008\"><a href=\"/opinion/1737008/state-v-flowers/\" aria-description=\"Citation for case: State v. Flowers\">441 So. 2d 707</a></span>.</p>\n</opinion>"},{"id":9040924,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b939-12\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AyoT\">dissenting.</p>\n<p id=\"b939-13\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}