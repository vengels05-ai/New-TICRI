{"id":2620998,"docketId":2569957,"caseName":"Bryant v. Wainwright","caseNameFull":"","slug":"bryant-v-wainwright","docketNumber":"1136, Misc","dateFiled":"1963-06-17","dateArgued":null,"dateCertGranted":null,"year":1963,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":6,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":2620998,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":849,"isHtml":true,"text":"<div>\n<center><b><span class=\"citation multiple-matches\"><a href=\"/c/U.S./374/492/\">374 U.S. 492</a></span> (1963)</b></center>\n<center><h1>KOVNER<br>\nv.<br>\nWAINWRIGHT, CORRECTIONS DIRECTOR.</h1></center>\n<center>No. 1136, Misc.</center>\n<center><p><b>Supreme Court of United States.</b></p></center>\n<center>Decided June 17, 1963.</center>\nON PETITION FOR WRIT OF CERTIORARI TO THE SUPREME COURT OF FLORIDA.\n<p>PER CURIAM.</p>\n<p>The motion for leave to proceed <i>in forma pauperis</i> and the petition for writ of certiorari are granted. The judgment is vacated and the case is remanded for further consideration in light of <i>Gideon</i> v. <i>Wainwright,</i> <span class=\"citation\" data-id=\"8945501\"><a href=\"/opinion/8954562/gideon-v-wainwright/\" aria-description=\"Citation for case: Gideon v. Wainwright\">372 U. S. 335</a></span>.</p>\n</div>"}],"citations":[]}