{"id":9069786,"docketId":66336037,"caseName":"In re Disbarment of Hoagland","caseNameFull":"In re Disbarment of Hoagland","slug":"in-re-disbarment-of-hoagland","docketNumber":"No. D-637","dateFiled":"1987-06-26","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9063527,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":455,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ABD\">Robert D. Hoagland, of Charlotte, N. C., having requested to. resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 1, 1987 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./482/903/\">482 U. S. 903</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}