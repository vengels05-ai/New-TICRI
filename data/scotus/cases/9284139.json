{"id":9284139,"docketId":66552476,"caseName":"In re Disbarment of Peavy","caseNameFull":"In re Disbarment of Peavy","slug":"in-re-disbarment-of-peavy","docketNumber":"No. D-1723","dateFiled":"1996-12-16","dateArgued":null,"dateCertGranted":null,"year":1996,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9278982,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":444,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Av5R\">Don E. Peavy, Sr., of Fort Worth, Tex., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on September 20, 1996 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./518/1052/\">518 U. S. 1052</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}