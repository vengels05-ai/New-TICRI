{"id":7355634,"docketId":64344131,"caseName":"U.S. Bancorp Mortgage Co. v. Bonner Mall Partnership","caseNameFull":"U.S. BANCORP MORTGAGE COMPANY v. BONNER MALL PARTNERSHIP","slug":"us-bancorp-mortgage-co-v-bonner-mall-partnership","docketNumber":"No. 93-714","dateFiled":"1994-03-28","dateArgued":null,"dateCertGranted":null,"year":1994,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"","jurisdictionType":"","opinions":[{"id":7274239,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1080,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"b1176-4\"><page-number citation-index=\"1\" label=\"1368\">*1368</page-number>This ease is removed from the April 1994 argument calendar. The memorandum of respondent suggesting that the case is moot filed March 15, 1994 is set for briefing and argue the following question: Should the rule announced in <em>United States v. Munsingwear, </em><span class=\"citation\" data-id=\"104822\"><a href=\"/opinion/104822/united-states-v-munsingwear-inc/\" aria-description=\"Citation for case: United States v. Munsingwear, Inc.\">340 U.S. 36</a></span>, <span class=\"citation\" data-id=\"104822\"><a href=\"/opinion/104822/united-states-v-munsingwear-inc/\" aria-description=\"Citation for case: United States v. Munsingwear, Inc.\">71 S.Ct. 104</a></span>, <span class=\"citation\" data-id=\"104822\"><a href=\"/opinion/104822/united-states-v-munsingwear-inc/\" aria-description=\"Citation for case: United States v. Munsingwear, Inc.\">95 L.Ed. 36</a></span> (1950), extend to cases that become moot in this Court because of the voluntary settlement of the parties?</p>\n</opinion>"}],"citations":[]}