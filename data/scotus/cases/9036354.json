{"id":9036354,"docketId":66302576,"caseName":"Austin v. Tennessee","caseNameFull":"Austin v. Tennessee Smith v. Morris","slug":"austin-v-tennessee","docketNumber":"No. 81-598; No. 81-5390","dateFiled":"1981-12-14","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9029667,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":385,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ASU7\">Sup. Ct. Tenn.; and</p>\n<p id=\"Ad-j\">Sup. Ct. Va. Certio-rari denied. Reported below: No. 81-598, <span class=\"citation\" data-id=\"1527452\"><a href=\"/opinion/1527452/state-v-austin/\" aria-description=\"Citation for case: State v. Austin\">618 S. W. 2d 738</a></span>; No. 81-5390, <span class=\"citation no-link\">221 Va. cxliii</span>.</p>\n</opinion>"},{"id":9029668,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":598,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1016-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AAfP\">dissenting.</p>\n<p id=\"b1016-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}