{"id":8196926,"docketId":65294733,"caseName":"McNabb v. United States","caseNameFull":"McNabb v. United States","slug":"mcnabb-v-united-states","docketNumber":"No. 25","dateFiled":"1943-06-07","dateArgued":null,"dateCertGranted":null,"year":1943,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":8,"judges":"Application, Consideration, Disposition, Took","jurisdictionType":"","opinions":[{"id":8158861,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":667,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AIn\">The motion for leave to file petition for rehearing is granted. The petition for rehearing is denied. As the case is for retrial in the district court, it will be open to all parties to adduce all evidence relevant to the admissibility of the confessions, whether adduced in the previous trial or not.</p>\n<judges id=\"A7O_\">Mr. Justice Rutledge took no part in the consideration or disposition of this application.</judges>\n<p id=\"AVh\"><span class=\"citation\" data-id=\"9419320\"><a href=\"/opinion/103791/mcnabb-v-united-states/\" aria-description=\"Citation for case: McNabb v. United States\">318 U. S. 332</a></span>.</p>\n</opinion>"}],"citations":[]}