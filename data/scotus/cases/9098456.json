{"id":9098456,"docketId":66364725,"caseName":"Pierce v. Texas","caseNameFull":"Pierce v. Texas Freeman v. Alabama","slug":"pierce-v-texas","docketNumber":"No. 89-6716; No. 89-7146","dateFiled":"1990-06-04","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9092755,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":435,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ALQA\">Ct. Crim. App. Tex.; and</p>\n<p id=\"AfDA\">Sup. Ct. Ala. Certiorari denied. Reported below: No. 89-6716, <span class=\"citation\" data-id=\"1749420\"><a href=\"/opinion/1749420/pierce-v-state/\" aria-description=\"Citation for case: Pierce v. State\">777 S. W. 2d 399</a></span>; No. 89-7146, <span class=\"citation multiple-matches\"><a href=\"/c/So.%202d/555/215/\">555 So. 2d 215</a></span>.</p>\n</opinion>"},{"id":9092756,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b741-4\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AX6D\">dissenting.</p>\n<p id=\"b741-5\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}