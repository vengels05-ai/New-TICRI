{"id":9047159,"docketId":66313401,"caseName":"In re O'Bryan","caseNameFull":"In re O'Bryan","slug":"in-re-obryan","docketNumber":"","dateFiled":"1984-03-26","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9040542,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":120,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AII\">Motion for leave to file petition for writ of habeas corpus denied.</p>\n</opinion>"},{"id":9040543,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":652,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b895-12\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Aznc\">dissenting.</p>\n<p id=\"AZr\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth <page-number citation-index=\"1\" label=\"902\">*902</page-number>and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant the motion and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}