{"id":102548,"docketId":1699100,"caseName":"Georgia M. Spruill v. William T. Ballard, Abram R. Serven, William D. Buck","caseNameFull":"","slug":"georgia-m-spruill-v-william-t-ballard-abram-r-serven-william-d-buck","docketNumber":"317","dateFiled":"1935-10-14","dateArgued":null,"dateCertGranted":null,"year":1935,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":102548,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2985,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./296/575/\">296 U.S. 575</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./56/130/\">56 S.Ct. 130</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">80 L.Ed. 406</span></p>\n    <p class=\"parties\">Georgia M. SPRUILL, petitioner,<br>v.<br>William T. BALLARD, Abram R. Serven, William D.  Buck, et al.<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a></p>\n    <p class=\"docket\">No. 317.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">October 14, 1935</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">Georgia M. Spruill, pro se.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">On petition for writ of certiorari to the United States Court of Appeals for the District of Columbia.</p>\n    </div>\n    <div class=\"num\" id=\"p3\">\n      <span class=\"num\">3</span>\n      <p class=\"indent\">See, also, <span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./293/625/\">293 U. S. 625</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20Ct./55/349/\">55 S. Ct. 349</a></span>, <span class=\"citation\" data-id=\"8151092\"><a href=\"/opinion/8189161/cantor-v-cherry/\" aria-description=\"Citation for case: Cantor v. Cherry\">79 L. Ed. 712</a></span>; Spruill v. Supreme Court of District of Columbia, <span class=\"citation\" data-id=\"8151088\"><a href=\"/opinion/8189157/spruill-v-supreme-court/\" aria-description=\"Citation for case: Spruill v. Supreme Court\">293 U. S. 625</a></span>, <span class=\"citation\" data-id=\"8151088\"><a href=\"/opinion/8189157/spruill-v-supreme-court/\" aria-description=\"Citation for case: Spruill v. Supreme Court\">55 S. Ct. 350</a></span>, <span class=\"citation\" data-id=\"8151092\"><a href=\"/opinion/8189161/cantor-v-cherry/\" aria-description=\"Citation for case: Cantor v. Cherry\">79 L. Ed. 712</a></span>.</p>\n    </div>\n    <div class=\"num\" id=\"p4\">\n      <span class=\"num\">4</span>\n      <p class=\"indent\">The motion for leave to proceed further herein in forma pauperis is denied for the reason that the Court, upon examination of the papers herein submitted, finds no ground upon which writ of certiorari should be granted. The petition for writ of certiorari is therefore also denied.</p>\n    </div>\n    <div class=\"footnotes\">\n      <div class=\"footnote\" id=\"fn-s\">\n        <a class=\"footnote\" href=\"#fn-s_ref\">*</a>\n        <p> Rehearing denied <span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./296/662/\">296 U. S. 662</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20Ct./56/168/\">56 S. Ct. 168</a></span>, <span class=\"citation\" data-id=\"8404079\"><a href=\"/opinion/8433718/evans-v-missouri-state-life-insurance/\" aria-description=\"Citation for case: Evans v. Missouri State Life Insurance\">80 L. Ed. 472</a></span>.</p>\n      </div>\n    </div>\n    "}],"citations":[]}