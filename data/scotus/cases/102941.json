{"id":102941,"docketId":43478,"caseName":"Catherine Schultz v. Live Stock National Bank of Chicago, Administrator, Etc.","caseNameFull":"","slug":"catherine-schultz-v-live-stock-national-bank-of-chicago-administrator-etc","docketNumber":"671","dateFiled":"1938-01-17","dateArgued":null,"dateCertGranted":null,"year":1938,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":102941,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2446,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./302/766/\">302 U.S. 766</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./58/481/\">58 S.Ct. 481</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">82 L.Ed. 595</span></p>\n    <p class=\"parties\">Catherine SCHULTZ, petitioner,<br>v.<br>LIVE STOCK NATIONAL BANK OF CHICAGO, Administrator, etc.<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a></p>\n    <p class=\"docket\">No. 671.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">January 17, 1938</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">Miss Catherine Schultz, pro se.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">On petition for writ of certiorari to the Appellate Court of the State of Illinois, First District.</p>\n    </div>\n    <div class=\"num\" id=\"p3\">\n      <span class=\"num\">3</span>\n      <p class=\"indent\">For opinion below, see <span class=\"citation multiple-matches\"><a href=\"/c/Ill.App./289/626/\">289 Ill.App. 626</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/N.E.2d/7/636/\">7 N.E.2d 636</a></span>.</p>\n    </div>\n    <div class=\"num\" id=\"p4\">\n      <span class=\"num\">4</span>\n      <p class=\"indent\">The motion for leave to proceed further herein in forma pauperis is denied for the reason that the Court, upon examination of the papers herein submitted, finds no ground upon which writ of certiorari should be issued. The petition for writ of certiorari is therefore also denied.</p>\n    </div>\n    <div class=\"footnotes\">\n      <div class=\"footnote\" id=\"fn-s\">\n        <a class=\"footnote\" href=\"#fn-s_ref\">*</a>\n        <p> Rehearing denied <span class=\"citation multiple-matches\"><a href=\"/c/U.S./303/666/\">303 U.S. 666</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./58/609/\">58 S.Ct. 609</a></span>, 82 L.Ed. &#8212;&#8212;; 304 U.S. &#8212;&#8212;, <span class=\"citation\" data-id=\"8153684\"><a href=\"/opinion/8191751/schultz-v-live-stock-national-bank/\" aria-description=\"Citation for case: Schultz v. Live Stock National Bank\">58 S.Ct. 1052</a></span>, 82 L.Ed. &#8212;&#8212;; 305 U.S. &#8212;&#8212;, <span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./59/98/\">59 S.Ct. 98</a></span>, 83 L.Ed. &#8212;&#8212;.</p>\n      </div>\n    </div>\n    "}],"citations":[]}