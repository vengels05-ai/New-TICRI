{"id":9054185,"docketId":66320431,"caseName":"In re Disbarment of Delk","caseNameFull":"In re Disbarment of Delk","slug":"in-re-disbarment-of-delk","docketNumber":"No. D-486","dateFiled":"1985-06-03","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9047692,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":460,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Adsb\">Leonard Adolph Delk, of Long Beach, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on March 25, 1985 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./470/1081/\">470 U. S. 1081</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}