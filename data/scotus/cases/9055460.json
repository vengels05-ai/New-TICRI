{"id":9055460,"docketId":66321708,"caseName":"In re Disbarment of Hyter","caseNameFull":"In re Disbarment of Hyter","slug":"in-re-disbarment-of-hyter","docketNumber":"No. D-496","dateFiled":"1985-10-07","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9048981,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":459,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A8O\">Charles Kilburn Hyter, of Hutchinson, Kan., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 3, 1985 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./471/1133/\">471 U. S. 1133</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}