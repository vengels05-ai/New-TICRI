{"id":9031530,"docketId":66297752,"caseName":"Gall v. Kentucky","caseNameFull":"Gall v. Kentucky King v. Florida","slug":"gall-v-kentucky","docketNumber":"No. 80-6034; No. 80-6151","dateFiled":"1981-03-09","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9024818,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":499,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A79\">Sup. Ct. Ky.; and</p>\n<p id=\"A1uP\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 80-6034, <span class=\"citation\" data-id=\"1787233\"><a href=\"/opinion/1787233/gall-v-commonwealth/\" aria-description=\"Citation for case: Gall v. Commonwealth\">607 S. W. 2d 97</a></span>; No. 80-6151, <span class=\"citation\" data-id=\"1902406\"><a href=\"/opinion/1902406/king-v-state/\" aria-description=\"Citation for case: King v. State\">390 So. 2d 315</a></span>.</p>\n</opinion>"},{"id":9024819,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b965-7\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A5CN\">dissenting.</p>\n<p id=\"AvV\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (.1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n