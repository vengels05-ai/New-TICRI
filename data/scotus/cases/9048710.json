{"id":9048710,"docketId":66314952,"caseName":"In re Disbarment of Mann","caseNameFull":"In re Disbarment of Mann","slug":"in-re-disbarment-of-mann","docketNumber":"No. D-435","dateFiled":"1984-07-02","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9042123,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":452,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AGH\">William Davis Mann, of Akron, Ohio, having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 11, 1984 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./467/1237/\">467 U. S. 1237</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}