{"id":9038053,"docketId":66304279,"caseName":"Ruffin v. Austin","caseNameFull":"Ruffin v. Austin, Warden, Georgia State Prison Evans v. Virginia Rook v. North Carolina Cunningham v. Georgia","slug":"ruffin-v-austin","docketNumber":"No. 81-6082; No. 81-6131; No. 81-6143; No. 81-6151","dateFiled":"1982-03-22","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":57,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9031375,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1278,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AZ2K\">Super. Ct. Ga., Tatnall County;</p>\n<p id=\"Aipy\">Sup. Ct. Va.;</p>\n<p id=\"A3lY\">Sup. Ct. N. C.; and</p>\n<p id=\"Am16\">Sup. Ct. Ga. Certiorari denied. Reported below: No. 81-6131, <span class=\"citation\" data-id=\"1302182\"><a href=\"/opinion/1302182/evans-v-commonwealth/\" aria-description=\"Citation for case: Evans v. Commonwealth\">222 Va. 766</a></span>, <span class=\"citation\" data-id=\"1302182\"><a href=\"/opinion/1302182/evans-v-commonwealth/\" aria-description=\"Citation for case: Evans v. Commonwealth\">284 S. E. 2d 816</a></span>; No. 81-6143, <span class=\"citation\" data-id=\"9583998\"><a href=\"/opinion/1330707/state-v-rook/\" aria-description=\"Citation for case: State v. Rook\">304 N. C. 201</a></span>, <span class=\"citation\" data-id=\"9583998\"><a href=\"/opinion/1330707/state-v-rook/\" aria-description=\"Citation for case: State v. Rook\">283 S. E. 2d 732</a></span>; No. 81-6151, <span class=\"citation\" data-id=\"1302218\"><a href=\"/opinion/1302218/cunningham-v-state/\" aria-description=\"Citation for case: Cunningham v. State\">248 Ga. 558</a></span>, <span class=\"citation\" data-id=\"1302218\"><a href=\"/opinion/1302218/cunningham-v-state/\" aria-description=\"Citation for case: Cunningham v. State\">284 S. E. 2d 390</a></span>.</p>\n</opinion>"},{"id":9031376,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":585,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1002-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AU3g\">dissenting.</p>\n<p id=\"Ab-_\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. Georgia, <span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}