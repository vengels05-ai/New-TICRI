{"id":9027125,"docketId":66293346,"caseName":"Franklin v. Georgia","caseNameFull":"Franklin v. Georgia Dobbs v. Hopper, Warden","slug":"franklin-v-georgia","docketNumber":"No. 79-6470; No. 79-6614","dateFiled":"1980-06-16","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9020391,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":430,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A9kz\">Sup. Ct. Ga.; and</p>\n<p id=\"AH5n\">Super. Ct. Ga., Tattnall County. Certiorari denied. Reported below: No. 79-6470, <span class=\"citation multiple-matches\"><a href=\"/c/Ga./245/141/\">245 Ga. 141</a></span>, <span class=\"citation\" data-id=\"1323367\"><a href=\"/opinion/1323367/franklin-v-state/\" aria-description=\"Citation for case: Franklin v. State\">263 S. E. 2d 666</a></span>.</p>\n</opinion>"},{"id":9020392,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":602,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b910-8\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"AAV\">dissenting.</p>\n<p id=\"b910-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}