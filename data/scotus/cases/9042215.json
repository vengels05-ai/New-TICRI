{"id":9042215,"docketId":66308442,"caseName":"Elledge v. Florida","caseNameFull":"Elledge v. Florida Berryhill v. Georgia Riley v. Florida Brown v. Zant, Superintendent, Georgia Diagnostic and Classification Center","slug":"elledge-v-florida","docketNumber":"No. 81-6813; No. 82-5317; No. 82-5348; No. 82-5373","dateFiled":"1982-11-01","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9035560,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":929,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AqEu\">Sup. Ct. Fla.;</p>\n<p id=\"AUDD\">Sup. Ct. Ga.;</p>\n<p id=\"ATIg\">Sup. Ct. Fla.; and</p>\n<p id=\"AaKa\">Super. Ct. Ga., Butts County. Certiorari denied. Reported below: No. 81-6813, <span class=\"citation\" data-id=\"1842856\"><a href=\"/opinion/1842856/elledge-v-state/\" aria-description=\"Citation for case: Elledge v. State\">408 So. 2d 1021</a></span>; No. 82-5317, <span class=\"citation\" data-id=\"1332896\"><a href=\"/opinion/1332896/berryhill-v-state/\" aria-description=\"Citation for case: Berryhill v. State\">249 Ga. 442</a></span>, <span class=\"citation\" data-id=\"1332896\"><a href=\"/opinion/1332896/berryhill-v-state/\" aria-description=\"Citation for case: Berryhill v. State\">291 S. E. 2d 685</a></span>; No. 82-5348, <span class=\"citation\" data-id=\"1749619\"><a href=\"/opinion/1749619/riley-v-state/\" aria-description=\"Citation for case: Riley v. State\">413 So. 2d 1173</a></span>.</p>\n</opinion>"},{"id":9035561,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b915-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AdYc\">dissenting.</p>\n<p id=\"b915-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}