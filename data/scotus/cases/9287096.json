{"id":9287096,"docketId":66555486,"caseName":"Dick v. Kemp","caseNameFull":"Dick v. Kemp, Superintendent, Georgia Diagnostic and Classification Center Moore v. Louisiana Richmond v. Arizona Womack v. Alabama Jernigan v. Texas Elledge v. Florida","slug":"dick-v-kemp","docketNumber":"No. 83-5339; No. 83-5367; No. 83-5449; No. 83-5454; No. 83-5457; No. 83-5463","dateFiled":"1983-11-14","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":138,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9281951,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1340,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AetjV\">Sup. Ct. Ga.;</p>\n<p id=\"AlDK\">Sup. Ct. La.;</p>\n<p id=\"AWuq\">Sup. Ct. Ariz.;</p>\n<p id=\"A_CX\">Sup. Ct. Ala.;</p>\n<p id=\"AZVn\">Ct. Crim. App. Tex.; and</p>\n<p id=\"A0U0\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 83-5367, <span class=\"citation\" data-id=\"1676591\"><a href=\"/opinion/1676591/state-v-moore/\" aria-description=\"Citation for case: State v. Moore\">432 So. 2d 209</a></span>; No. 83-5449, <span class=\"citation\" data-id=\"9537040\"><a href=\"/opinion/1142659/state-v-richmond/\" aria-description=\"Citation for case: State v. Richmond\">136 Ariz. 312</a></span>, <span class=\"citation\" data-id=\"9537040\"><a href=\"/opinion/1142659/state-v-richmond/\" aria-description=\"Citation for case: State v. Richmond\">666 P. 2d 57</a></span>; No. 83-5454, <span class=\"citation\" data-id=\"1732311\"><a href=\"/opinion/1732311/ex-parte-womack/\" aria-description=\"Citation for case: Ex Parte Womack\">435 So. 2d 766</a></span>; No. 83-5457, <span class=\"citation\" data-id=\"1787629\"><a href=\"/opinion/1787629/jernigan-v-state/\" aria-description=\"Citation for case: Jernigan v. State\">661 S. W. 2d 936</a></span>; No. 83-5463, <span class=\"citation\" data-id=\"1676678\"><a href=\"/opinion/1676678/elledge-v-graham/\" aria-description=\"Citation for case: Elledge v. Graham\">432 So. 2d 35</a></span>.</p>\n</opinion>"},{"id":9281952,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b861-4\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AZqB\">dissenting.</p>\n<p id=\"b861-5\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}