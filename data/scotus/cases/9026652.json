{"id":9026652,"docketId":66292873,"caseName":"Coleman v. Montana","caseNameFull":"Coleman v. Montana Bowen v. Georgia","slug":"coleman-v-montana","docketNumber":"No. 79-1553; No. 79-5975","dateFiled":"1980-05-27","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":63,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9019915,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":487,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AmMG\">Sup. Ct. Mont.; and</p>\n<p id=\"Aj9O\">Sup. Ct. Ga. Certio-rari denied. Reported below: No. 79-1553, -Mont. -, <span class=\"citation\" data-id=\"9507105\"><a href=\"/opinion/876790/state-v-coleman/\" aria-description=\"Citation for case: State v. Coleman\">605 P. 2d 1000</a></span>; No. 79-5975, <span class=\"citation multiple-matches\"><a href=\"/c/Ga./244/495/\">244 Ga. 495</a></span>, <span class=\"citation no-link\">260 S. E. 2d 855</span>.</p>\n</opinion>"},{"id":9019916,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":603,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b898-8\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"Aaeq\">dissenting.</p>\n<p id=\"b898-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}