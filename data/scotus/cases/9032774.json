{"id":9032774,"docketId":66298996,"caseName":"Milton v. Texas","caseNameFull":"Milton v. Texas Briley v. Virginia","slug":"milton-v-texas","docketNumber":"No. 80-6324; No. 80-6367","dateFiled":"1981-05-26","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":4,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9026070,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":757,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Anqx\">Ct. Crim. App. Tex.; and</p>\n<p id=\"AWJ6\">Sup. Ct. Va. Certio-<page-number citation-index=\"1\" label=\"1032\">*1032</page-number>rari denied. Reported below: No. 80-6324, <span class=\"citation\" data-id=\"9661751\"><a href=\"/opinion/1631608/milton-v-state/\" aria-description=\"Citation for case: Milton v. State\">599 S. W. 2d 824</a></span>; No. 80-6367, <span class=\"citation\" data-id=\"1368919\"><a href=\"/opinion/1368919/briley-v-commonwealth/\" aria-description=\"Citation for case: Briley v. Commonwealth\">221 Va. 532</a></span>, <span class=\"citation\" data-id=\"1368919\"><a href=\"/opinion/1368919/briley-v-commonwealth/\" aria-description=\"Citation for case: Briley v. Commonwealth\">273 S. E. 2d 48</a></span>.</p>\n</opinion>"},{"id":9026071,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b992-5\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AD9A\">dissenting.</p>\n<p id=\"Atuy\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}