{"id":8609725,"docketId":65872510,"caseName":"Cahn v. United States","caseNameFull":"BERTRAM J. CAHN, EXTR. v. UNITED STATES","slug":"cahn-v-united-states","docketNumber":"","dateFiled":"1936-01-13","dateArgued":null,"dateCertGranted":null,"year":1936,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8588093,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":526,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"b722-9\">Certiorari to review a judgment of the Court of Claims, on a claim for refund of estate tax.</p>\n<p id=\"b722-10\">Judgment was rendered in favor of the United States in the Court of Claims. Upon certiorari the judgment was. reversed, January 13, 1936, on authority of <em>Knox </em>v. <em>Mc</em>Elligott, <span class=\"citation\" data-id=\"99981\"><a href=\"/opinion/99981/knox-v-mcelligott/\" aria-description=\"Citation for case: Knox v. McElligott\">258 U. S. 546</a></span>.</p>\n</opinion>"}],"citations":[]}