{"id":9044420,"docketId":66310647,"caseName":"Smith v. Mississippi","caseNameFull":"Smith v. Mississippi Harris v. Pulley, Warden, California State Prison at San Quentin Morris v. Tennessee","slug":"smith-v-mississippi","docketNumber":"No. 82-5922; No. 82-6019; No. 82-6089","dateFiled":"1983-03-21","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":7,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9037782,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":764,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AJ-m\">Sup. Ct. Miss.; C. A. 9th Cir.; and Sup. Ct. Tenn. Certiorari denied. Reported below: No. 82-5922, <span class=\"citation\" data-id=\"1914341\"><a href=\"/opinion/1914341/smith-v-state/\" aria-description=\"Citation for case: Smith v. State\">419 So. 2d 563</a></span>; No. 82-6019, <span class=\"citation\" data-id=\"9469929\"><a href=\"/opinion/410972/robert-alton-harris-v-r-pulley-warden-of-the-california-state-prison-at/\" aria-description=\"Citation for case: Robert Alton Harris v. R. Pulley, Warden of the...\">692 F. 2d 1189</a></span>; No. 82-6089, <span class=\"citation\" data-id=\"9773638\"><a href=\"/opinion/2440380/state-v-morris/\" aria-description=\"Citation for case: State v. Morris\">641 S. W. 2d 883</a></span>.</p>\n</opinion>"},{"id":9037783,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b978-4\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AFR\">dissenting.</p>\n<p id=\"b978-5\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}