{"id":106667,"docketId":1374444,"caseName":"Howard Tempy Dearhart, Jr. v. Virginia","caseNameFull":"","slug":"howard-tempy-dearhart-jr-v-virginia","docketNumber":"48 M","dateFiled":"1963-06-17","dateArgued":null,"dateCertGranted":null,"year":1963,"scdbId":"1962-156","direction":"Liberal","votesMajority":7,"votesMinority":2,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":17,"judges":"","jurisdictionType":"","opinions":[{"id":106667,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2312,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8946625\"><a href=\"/opinion/8955642/dearhart-v-virginia/\" aria-description=\"Citation for case: Dearhart v. Virginia\">374 U.S. 498</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"8946814\"><a href=\"/opinion/8955831/willoughby-v-indiana/\" aria-description=\"Citation for case: Willoughby v. Indiana\">83 S.Ct. 1876</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/L.Ed.2d/10/1044/\">10 L.Ed.2d 1044</a></span></p>\n    <p class=\"parties\">Howard Tempy DEARHART, Jr.<br>v.<br>VIRGINIA.</p>\n    <p class=\"docket\">No. 48, Misc.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">June 17, 1963</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Howard Tempy Dearhart, Jr., pro se.</p>\n      <p class=\"indent\">Reno S. Harp III, Asst. Atty. Gen., of Virginia, for respondent.</p>\n      <p class=\"indent\">On Petition for Writ of Certiorari to the Supreme Court of Appeals of Virginia.</p>\n      <p class=\"indent\">PER CURIAM.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The motion for leave to proceed <i>in forma pauperis</i> and the petition for writ of certiorari are granted. The judgment is vacated and the case is remanded for further consideration in light of Douglas v. California, <span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U.S. 353</a></span>, <span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">83 S.Ct. 814</a></span>, <span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">9 L.Ed.2d 811</a></span>.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">Mr. Justice CLARK and Mr. Justice HARLAN dissent for the reasons stated in their dissenting opinions in Douglas v. California, <span class=\"citation multiple-matches\"><a href=\"/c/U.S./372/358/\">372 U.S. 358</a></span>, 360, <span class=\"citation no-link\">83 S.Ct. 817</span>, 818.</p>\n    </div>\n    "}],"citations":[]}