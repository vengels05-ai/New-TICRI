{"id":9026976,"docketId":66293197,"caseName":"Dobbert v. Florida","caseNameFull":"Dobbert v. Florida","slug":"dobbert-v-florida","docketNumber":"No. 79-6362","dateFiled":"1980-06-09","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9020242,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":600,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b892-5\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"AiZa\">dissenting.</p>\n<p id=\"b892-6\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}