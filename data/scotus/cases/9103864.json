{"id":9103864,"docketId":66370136,"caseName":"Delong v. Thompson","caseNameFull":"Delong v. Thompson, Warden Hamm v. Alabama","slug":"delong-v-thompson","docketNumber":"No. 90-5948; No. 90-5969","dateFiled":"1990-12-03","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9098252,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":295,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"APlu\">Sup. Ct. Va.; and Sup. Ct. Ala. Certiorari denied. Reported below: No. 90-5969, <span class=\"citation\" data-id=\"1707626\"><a href=\"/opinion/1707626/ex-parte-hamm/\" aria-description=\"Citation for case: Ex Parte Hamm\">564 So. 2d 469</a></span>.</p>\n</opinion>"},{"id":9098253,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":567,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b974-8\">Justice Marshall,</author>\n<p id=\"AmUC\">dissenting.</p>\n<p id=\"b974-9\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}