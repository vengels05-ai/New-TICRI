{"id":9110062,"docketId":66376335,"caseName":"Riley v. Delaware","caseNameFull":"Riley v. Delaware McDougall v. Dixon, Warden","slug":"riley-v-delaware","docketNumber":"No. 90-7506; No. 90-7767","dateFiled":"1991-06-17","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9104522,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":114,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A1M\">Sup. Ct. Del.; and C. <em>A. </em>4th Cir. Certiorari denied.</p>\n</opinion>"},{"id":9104523,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":571,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1217-10\">Justice Marshall,</author>\n<p id=\"As3i\">dissenting.</p>\n<p id=\"b1217-11\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}