{"id":9022059,"docketId":66288276,"caseName":"Washington v. Mississippi","caseNameFull":"Washington v. Mississippi Finney v. Georgia","slug":"washington-v-mississippi","docketNumber":"No. 78-6091; No. 78-6253","dateFiled":"1979-04-16","dateArgued":null,"dateCertGranted":null,"year":1979,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":14,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9015277,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":121,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AKA\">Sup. Ct. Miss.; and</p>\n<p id=\"App\">Sup. Ct. Ga. Certio-rari denied.</p>\n</opinion>"},{"id":9015278,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":665,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b868-9\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"ApD\">dissenting.</p>\n<p id=\"b868-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the <page-number citation-index=\"1\" label=\"917\">*917</page-number>Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}