{"id":9055464,"docketId":66321712,"caseName":"In re Disbarment of Walters","caseNameFull":"In re Disbarment of Walters","slug":"in-re-disbarment-of-walters","docketNumber":"No. D-500","dateFiled":"1985-10-07","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9048985,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":453,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ama\">Harris N. Walters, of Boynton, Fla., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 10, 1985 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./472/1005/\">472 U. S. 1005</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}