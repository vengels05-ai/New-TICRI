{"id":9087945,"docketId":66354202,"caseName":"In re Disbarment of Graves","caseNameFull":"In re Disbarment of Graves","slug":"in-re-disbarment-of-graves","docketNumber":"No. D-775","dateFiled":"1989-06-05","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9082071,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":457,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AYfs\">David Hardin Graves, of Houston, Tex., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on March 20, 1989 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./489/1075/\">489 U. S. 1075</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}