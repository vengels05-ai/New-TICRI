{"id":108673,"docketId":21970,"caseName":"In the Matter of the Disbarment of Seymour R. Thaler. No. D-9","caseNameFull":"","slug":"in-the-matter-of-the-disbarment-of-seymour-r-thaler-no-d-9","docketNumber":"","dateFiled":"1973-02-20","dateArgued":null,"dateCertGranted":null,"year":1973,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":108673,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1017,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./409/921/\">409 U.S. 921</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./93/1350/\">93 S.Ct. 1350</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"8984117\"><a href=\"/opinion/8991909/in-re-disbarment-of-thaler/\" aria-description=\"Citation for case: In re Disbarment of Thaler\">35 L.Ed.2d 583</a></span></p>\n    <p class=\"parties\">In the Matter of the Disbarment of Seymour R. THALER.<br>No. D-9.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">February 20, 1973</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">It is ordered that Seymour R. Thaler of New York, New York, be suspended from the practice of law in this Court and that a rule issue returnable within forty days requiring him to show cause why he should not be disbarred from the practice of law in this Court.</p>\n    </div>\n    "}],"citations":[]}