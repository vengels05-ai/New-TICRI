{"id":9057285,"docketId":66323536,"caseName":"East v. Texas","caseNameFull":"East v. Texas","slug":"east-v-texas","docketNumber":"No. 85-5561","dateFiled":"1985-11-18","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":20,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9050830,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":592,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b866-7\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Ad5V\">dissenting.</p>\n<p id=\"b866-8\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}