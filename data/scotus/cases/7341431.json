{"id":7341431,"docketId":64329923,"caseName":"Tapia v. United States","caseNameFull":"Alejandra Tapia v. United States","slug":"tapia-v-united-states","docketNumber":"No. 10-5400","dateFiled":"2011-01-10","dateArgued":null,"dateCertGranted":null,"year":2011,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":7259359,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":363,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ADEq6\">Stephanos Bibas, Esquire, of Philadelphia, Pennsylvania, is invited to brief and argue this case, as amicus curiae, in support of the position that <span class=\"citation no-link\">18 U.S.C. \u00a7 3582</span>(a) allows district courts to consider rehabilitative need in setting the length and term of imprisonment.</p>\n</opinion>"}],"citations":[]}