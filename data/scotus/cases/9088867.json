{"id":9088867,"docketId":66355125,"caseName":"Westley v. Texas","caseNameFull":"Westley v. Texas Bennett v. Texas","slug":"westley-v-texas","docketNumber":"No. 88-6897; No. 88-7090","dateFiled":"1989-06-26","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9083011,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":513,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AFA4\">Ct. Crim. App. Tex.; and</p>\n<p id=\"A4Z\">Ct. Crim. App. Tex. Certiorari denied. Reported below: No. 88-6897, <span class=\"citation\" data-id=\"1780532\"><a href=\"/opinion/1780532/westley-v-state/\" aria-description=\"Citation for case: Westley v. State\">754 S. W. 2d 224</a></span>; No. 88-7090, <span class=\"citation\" data-id=\"9640584\"><a href=\"/opinion/1495889/bennett-v-state/\" aria-description=\"Citation for case: Bennett v. State\">766 S. W. 2d 227</a></span>.</p>\n</opinion>"},{"id":9083012,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b741-14\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AFtT\">dissenting.</p>\n<p id=\"b741-15\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}