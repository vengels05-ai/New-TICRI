{"id":9139028,"docketId":66405323,"caseName":"In re Disbarment of Bear","caseNameFull":"In re Disbarment of Bear","slug":"in-re-disbarment-of-bear","docketNumber":"No. D-1281","dateFiled":"1993-10-04","dateArgued":null,"dateCertGranted":null,"year":1993,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9133704,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":515,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AAq\">F. James Bear, of National City, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken <page-number citation-index=\"1\" label=\"805\">*805</page-number>from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on July 22, 1993 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./509/936/\">509 U. S. 936</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}