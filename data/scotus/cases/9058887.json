{"id":9058887,"docketId":66325138,"caseName":"In re Disbarment of Romano","caseNameFull":"In re Disbarment of Romano","slug":"in-re-disbarment-of-romano","docketNumber":"No. D-535","dateFiled":"1986-02-24","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9052448,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":468,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AEqG\">Salvatore L. Romano, Jr., of Providence, R. I., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on December 9, 1985 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./474/1017/\">474 U. S. 1017</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}