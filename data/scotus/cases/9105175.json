{"id":9105175,"docketId":66371448,"caseName":"Burrell v. Louisiana","caseNameFull":"Burrell v. Louisiana Truesdale v. South Carolina Guinan v. Armontrout, Warden Boyd v. Tennessee","slug":"burrell-v-louisiana","docketNumber":"No. 90-5836; No. 90-5851; No. 90-6072; No. 90-6318","dateFiled":"1991-01-22","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9099573,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":980,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A9BD\">Sup. Ct. La.;</p>\n<p id=\"A8FI\">Sup. Ct. S. C.;</p>\n<p id=\"AyNq\">C. A. 8th Cir.; and</p>\n<p id=\"A01Q\">Sup. Ct. Tenn. Certiorari denied. Reported below: No. 90-5836, <span class=\"citation\" data-id=\"1867424\"><a href=\"/opinion/1867424/state-v-burrell/\" aria-description=\"Citation for case: State v. Burrell\">561 So. 2d 692</a></span>; No. 90-5851, 301 S. C. 546, <span class=\"citation\" data-id=\"9579057\"><a href=\"/opinion/1242745/state-v-truesdale/\" aria-description=\"Citation for case: State v. Truesdale\">393 S. E. 2d 168</a></span>; No. 90-6072, <span class=\"citation\" data-id=\"545569\"><a href=\"/opinion/545569/frank-j-guinan-v-william-armontrout/\" aria-description=\"Citation for case: Frank J. Guinan v. William Armontrout\">909 F. 2d 1224</a></span>; No. 90-6318, <span class=\"citation\" data-id=\"2417054\"><a href=\"/opinion/2417054/state-v-boyd/\" aria-description=\"Citation for case: State v. Boyd\">797 S. W. 2d 589</a></span>.</p>\n</opinion>"},{"id":9099574,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":569,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1040-8\">Justice Marshall,</author>\n<p id=\"AHkr\">dissenting.</p>\n<p id=\"b1040-9\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}