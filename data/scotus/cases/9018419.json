{"id":9018419,"docketId":66284636,"caseName":"Denney v. Texas","caseNameFull":"Denney v. Texas","slug":"denney-v-texas","docketNumber":"No. 77-6539","dateFiled":"1978-06-19","dateArgued":null,"dateCertGranted":null,"year":1978,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9011568,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":639,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Alr\">Ct. Crim. App. Tex. Certiorari denied.</p>\n<judges id=\"b761-7\">Mr. Justice Brennan and Mr. Justice Marshall, dissenting.</judges>\n<p id=\"b761-8\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}