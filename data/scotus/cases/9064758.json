{"id":9064758,"docketId":66331009,"caseName":"Compton v. New Mexico","caseNameFull":"Compton v. New Mexico Kennedy v. Wainwright, Secretary, Florida Department of Corrections Bowers v. Maryland Gilreath v. Kemp, Warden","slug":"compton-v-new-mexico","docketNumber":"No. 85-6753; No. 85-7122; No. 86-5021; No. 86-5327","dateFiled":"1986-10-14","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9058385,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":985,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AjXx\">Sup. Ct. N. M.;</p>\n<p id=\"A-Y\">Sup. Ct. Fla.;</p>\n<p id=\"Aqz\">Ct. App. Md.; and</p>\n<p id=\"AVYB\">Sup. Ct. Ga. Certiorari denied. Reported below: No. 85-6753, 104 N. M. 683, <page-number citation-index=\"1\" label=\"891\">*891</page-number><span class=\"citation\" data-id=\"9607692\"><a href=\"/opinion/1374515/state-v-compton/\" aria-description=\"Citation for case: State v. Compton\">726 P. 2d 837</a></span>; No. 85-7122, <span class=\"citation\" data-id=\"1097643\"><a href=\"/opinion/1097643/kennedy-v-wainwright/\" aria-description=\"Citation for case: Kennedy v. Wainwright\">483 So. 2d 424</a></span>; No. 86-5021, <span class=\"citation\" data-id=\"9765403\"><a href=\"/opinion/2394901/bowers-v-state/\" aria-description=\"Citation for case: Bowers v. State\">306 Md. 120</a></span>, <span class=\"citation\" data-id=\"9765403\"><a href=\"/opinion/2394901/bowers-v-state/\" aria-description=\"Citation for case: Bowers v. State\">507 A. 2d 1072</a></span>.</p>\n</opinion>"},{"id":9058386,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b829-5\">Justice Brennan and Justice Marshall,</author>\n<p id=\"ATDI\">dissenting.</p>\n<p id=\"b829-6\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}