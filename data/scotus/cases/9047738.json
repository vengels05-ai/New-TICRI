{"id":9047738,"docketId":66313980,"caseName":"In re Disbarment of Pracht","caseNameFull":"In re Disbarment of Pracht","slug":"in-re-disbarment-of-pracht","docketNumber":"No. D-400","dateFiled":"1984-05-14","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9041135,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":458,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AqGX\">Andrew White Pracht, of Eglin, Fla., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on February 21, 1984 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./465/1017/\">465 U. S. 1017</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}