{"id":9026750,"docketId":66292971,"caseName":"Otey v. Nebraska","caseNameFull":"Otey v. Nebraska Blake v. Georgia O'Bryan v. Texas Gray v. Mississippi Burger v. Georgia","slug":"otey-v-nebraska","docketNumber":"No. 79-1438; No. 79-5921; No. 79-6194; No. 79-6250; No. 79-6422","dateFiled":"1980-06-02","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9020014,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1611,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AYnm\">Sup. Ct. Neb.;</p>\n<p id=\"Axc\">Sup. Ct. Ga.;</p>\n<p id=\"Aqiv\">Ct. Crim. App. Tex.;</p>\n<p id=\"ARV\">Sup. Ct. Miss.; and</p>\n<p id=\"AOiX\">Sup. Ct. Ga. Certio-rari denied. Reported below: No. 79-1438, <span class=\"citation\" data-id=\"9685995\"><a href=\"/opinion/1810903/state-v-otey/\" aria-description=\"Citation for case: State v. Otey\">205 Neb. 90</a></span>, <span class=\"citation\" data-id=\"9685995\"><a href=\"/opinion/1810903/state-v-otey/\" aria-description=\"Citation for case: State v. Otey\">287 N. W. 2d 36</a></span>; No. 79-5921, <span class=\"citation\" data-id=\"1334502\"><a href=\"/opinion/1334502/blake-v-state/\" aria-description=\"Citation for case: Blake v. State\">244 Ga. 466</a></span>, <span class=\"citation\" data-id=\"1334502\"><a href=\"/opinion/1334502/blake-v-state/\" aria-description=\"Citation for case: Blake v. State\">260 S. E. 2d 876</a></span>; No. 79-6194, <span class=\"citation\" data-id=\"1793039\"><a href=\"/opinion/1793039/obryan-v-state/\" aria-description=\"Citation for case: O&#x27;BRYAN v. State\">591 S. W. 2d 464</a></span>; No. 79-6250, <span class=\"citation\" data-id=\"1758494\"><a href=\"/opinion/1758494/gray-v-state/\" aria-description=\"Citation for case: Gray v. State\">375 So. 2d 994</a></span>; No. 79-6422, <span class=\"citation\" data-id=\"1246416\"><a href=\"/opinion/1246416/burger-v-state/\" aria-description=\"Citation for case: Burger v. State\">245 Ga. 458</a></span>, <span class=\"citation\" data-id=\"1246416\"><a href=\"/opinion/1246416/burger-v-state/\" aria-description=\"Citation for case: Burger v. State\">265 S. E. 2d 796</a></span>.</p>\n</opinion>"},{"id":9020015,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":604,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b916-12\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"AOEg\">dissenting.</p>\n<p id=\"b916-13\">Adhering to our view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}