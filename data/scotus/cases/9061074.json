{"id":9061074,"docketId":66327325,"caseName":"Phillips v. Texas","caseNameFull":"Phillips, aka Bashir v. Texas James v. Wainwright, Secretary, Florida Department of Corrections Mathenia v. Missouri Jones v. Missouri Peede v. Florida","slug":"phillips-v-texas","docketNumber":"No. 85-6523; No. 85-6545; No. 85-6696; No. 85-6963; No. 85-6974","dateFiled":"1986-06-23","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9054684,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1145,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A2-\">Ct. Crim. App. Tex.;</p>\n<p id=\"ANi\">Sup. Ct. Fla.;</p>\n<p id=\"AZbCe\">Sup. Ct. Mo.;</p>\n<p id=\"Ahf7\">Sup. Ct. Mo.; and</p>\n<p id=\"AxbU\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 85-6523, <span class=\"citation\" data-id=\"2436959\"><a href=\"/opinion/2436959/phillips-v-state/\" aria-description=\"Citation for case: Phillips v. State\">701 S. W. 2d 875</a></span>; No. 85-6545, <span class=\"citation\" data-id=\"1748502\"><a href=\"/opinion/1748502/james-v-wainwright/\" aria-description=\"Citation for case: James v. Wainwright\">484 So. 2d 1235</a></span>; No. 85-6696, <span class=\"citation\" data-id=\"9676494\"><a href=\"/opinion/1745121/state-v-mathenia/\" aria-description=\"Citation for case: State v. Mathenia\">702 S. W. 2d 840</a></span>; No. 85-6963, <span class=\"citation\" data-id=\"9667197\"><a href=\"/opinion/1671133/state-v-jones/\" aria-description=\"Citation for case: State v. Jones\">705 S. W. 2d 19</a></span>; No. 85-6974, <span class=\"citation\" data-id=\"1900328\"><a href=\"/opinion/1900328/peede-v-state/\" aria-description=\"Citation for case: Peede v. State\">474 So. 2d 808</a></span>.</p>\n</opinion>"},{"id":9054685,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":596,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b685-12\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AXI\">dissenting.</p>\n<p id=\"b685-13\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}