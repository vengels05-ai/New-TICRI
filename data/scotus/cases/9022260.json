{"id":9022260,"docketId":66288477,"caseName":"In re Disbarment of Fodiman","caseNameFull":"In re Disbarment of Fodiman","slug":"in-re-disbarment-of-fodiman","docketNumber":"No. D-160","dateFiled":"1979-05-14","dateArgued":null,"dateCertGranted":null,"year":1979,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9015480,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":454,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A4P\">Aaron R. Fodiman of Arlington, Va., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on February 26, 1979 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./440/932/\">440 U. S. 932</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}