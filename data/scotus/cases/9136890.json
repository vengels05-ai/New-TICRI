{"id":9136890,"docketId":66403185,"caseName":"In re Disbarment of Venable","caseNameFull":"In re Disbarment of Venable","slug":"in-re-disbarment-of-venable","docketNumber":"No. D-1351","dateFiled":"1994-04-04","dateArgued":null,"dateCertGranted":null,"year":1994,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9131521,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":461,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"As6U\">William H. C. Venable, of Richmond, Va., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on January 10, 1994 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./510/1036/\">510 U. S. 1036</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}