{"id":101046,"docketId":2170333,"caseName":"Timken Roller Bearing v. Pennsylvania Railroad","caseNameFull":"Timken Roller Bearing Company, in Error v. The Pennsylvania Railroad Company, and Thomas P. Goodbody, as Receiver of the Hydraulic Steel Company, in Error v. The Pennsylvania Railroad Company","slug":"timken-roller-bearing-v-pennsylvania-railroad","docketNumber":"Nos. 168, 178","dateFiled":"1926-10-18","dateArgued":null,"dateCertGranted":null,"year":1926,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":101046,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":3545,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./273/665/\">273 U.S. 665</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./47/454/\">47 S.Ct. 454</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/L.Ed./71/829/\">71 L.Ed. 829</a></span></p>\n    <p class=\"parties\">TIMKEN ROLLER BEARING COMPANY, plaintiff in error,<br>v.<br>The PENNSYLVANIA RAILROAD COMPANY,<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a>  and  Thomas P. GOODBODY, as Receiver of the Hydraulic Steel  Company, plaintiff in error,  v.  The PENNSYLVANIA RAILROAD COMPANY.</p>\n    <p class=\"docket\">Nos. 168, 178.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">February 28, 1927</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Messrs. Luther Day and Rufus S. Day, both of Cleveland, Ohio (Donald W. Kling, of Cleveland, Ohio, of counsel), for plaintiff in error.</p>\n      <p class=\"indent\">Messrs. Andrew Squire, Thomas M. Kirby and