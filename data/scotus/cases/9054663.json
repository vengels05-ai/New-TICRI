{"id":9054663,"docketId":66320910,"caseName":"Bowen v. Oklahoma","caseNameFull":"Bowen v. Oklahoma Stafford v. Oklahoma Cartwright v. Oklahoma Ingram v. Georgia Mills v. Florida","slug":"bowen-v-oklahoma","docketNumber":"No. 84-1741; No. 84-6700; No. 84-6714; No. 84-6728; No. 84-6808","dateFiled":"1985-07-01","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9048179,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1314,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ASib\">Ct. Crim. App. Okla.;</p>\n<p id=\"APrK\">Ct. Crim. App. Okla.;</p>\n<p id=\"AGUh\">Ct. Crim. App. Okla.;</p>\n<p id=\"AKH7\">Sup. Ct. Ga.; and</p>\n<p id=\"Adg\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 84-1741, <span class=\"citation\" data-id=\"1387626\"><a href=\"/opinion/1387626/bowen-v-state/\" aria-description=\"Citation for case: Bowen v. State\">715 P. 2d 1093</a></span>; No. 84-6700, <span class=\"citation\" data-id=\"1128342\"><a href=\"/opinion/1128342/stafford-v-state/\" aria-description=\"Citation for case: Stafford v. State\">697 P. 2d 165</a></span>; No. 84-6714, <span class=\"citation\" data-id=\"1169326\"><a href=\"/opinion/1169326/cartwright-v-state/\" aria-description=\"Citation for case: Cartwright v. State\">695 P. 2d 548</a></span>; No. 84-6728, <span class=\"citation\" data-id=\"1298276\"><a href=\"/opinion/1298276/ingram-v-state/\" aria-description=\"Citation for case: Ingram v. State\">253 Ga. 622</a></span>, <span class=\"citation\" data-id=\"1298276\"><a href=\"/opinion/1298276/ingram-v-state/\" aria-description=\"Citation for case: Ingram v. State\">323 S. E. 2d 801</a></span>; No. 84-6808, <span class=\"citation\" data-id=\"1092253\"><a href=\"/opinion/1092253/mills-v-state/\" aria-description=\"Citation for case: Mills v. State\">462 So. 2d 1075</a></span>.</p>\n</opinion>"},{"id":9048180,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b887-14\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AORo\">dissenting.</p>\n<p id=\"b887-15\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}