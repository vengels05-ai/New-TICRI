{"id":100512,"docketId":2565825,"caseName":"Endicott Johnson Corp. v. Smith","caseNameFull":"Endicott Johnson Corporation v. Smith","slug":"endicott-johnson-corp-v-smith","docketNumber":"64","dateFiled":"1924-11-17","dateArgued":null,"dateCertGranted":null,"year":1924,"scdbId":"1924-009","direction":"Conservative","votesMajority":9,"votesMinority":0,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Mr. Maurice E. Page for plaintiff in error., Mr. Moe Goldstein appeared for defendant in error.","natureOfSuit":"","citationCount":3,"judges":"Sanford","jurisdictionType":"","opinions":[{"id":100512,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"Sanford","joinedBy":"","pageCount":null,"textLength":1144,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion type=\"majority\">\n<author id=\"b347-12\">\n  Mr. Justice Sanford\n </author>\n<p id=\"Akqu\">\n  delivered the opinion of the Court.\n </p>\n<p id=\"b347-13\">\n  This case, like\n  <em>\n   Endicott Johnson Corporation\n  </em>\n  v.\n  <em>\n   Encyclopedia Press, Inc.,\n  </em>\n  No. 41, just decided,\n  <em>\n   ante,\n  </em>\n  285, involves the constitutional validity of \u00a7 139\u00cd of the New York Code of Civil Procedure. <span class=\"citation no-link\">189 N. Y. Supp. 673</span>; <span class=\"citation\" data-id=\"5263570\"><a href=\"/opinion/5425616/smith-v-endicott-johnson-corp/\" aria-description=\"Citation for case: Smith v. Endicott-Johnson Corp.\">199 App. Div. 194</a></span>; <span class=\"citation\" data-id=\"3596996\"><a href=\"/opinion/3614765/smith-v-endicott-johnson-corporation/\" aria-description=\"Citation for case: Smith v. . Endicott-Johnson Corporation\">234 N. Y. 628</a></span>. It is in all respects similar to the\n  <em>\n   Encyclopedia Press Case\n  </em>\n  and governed by the decision therein.\n </p>\n<p id=\"b347-14\">\n  The judgment is\n </p>\n<p id=\"b347-15\">\n<em>\n   Affirmed.\n  </em>\n</p>\n</opinion>"}],"citations":[]}