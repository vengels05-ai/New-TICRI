{"id":9043845,"docketId":66310072,"caseName":"Fitzgerald v. Virginia","caseNameFull":"Fitzgerald v. Virginia Johnson v. Zant, Warden, Georgia Diagnostic and Classification Center Daugherty v. Florida Stevens v. Florida Peek v. Florida","slug":"fitzgerald-v-virginia","docketNumber":"No. 82-5853; No. 82-5877; No. 82-5879; No. 82-5902; No. 82-5909","dateFiled":"1983-02-22","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":60,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9037202,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1325,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AKbb\">Sup. Ct. Va.;</p>\n<p id=\"Aicm\">Sup. Ct. Ga.;</p>\n<p id=\"AHJm\">Sup. Ct. Fla.;</p>\n<p id=\"A4vN\">Sup. Ct. Fla.; and</p>\n<p id=\"Ag2F\">Sup. Ct. Fla. Certio-rari denied. Reported below: No. 82-5853, <span class=\"citation\" data-id=\"1363213\"><a href=\"/opinion/1363213/fitzgerald-v-commonwealth/\" aria-description=\"Citation for case: Fitzgerald v. Commonwealth\">223 Va. 615</a></span>, <span class=\"citation\" data-id=\"1363213\"><a href=\"/opinion/1363213/fitzgerald-v-commonwealth/\" aria-description=\"Citation for case: Fitzgerald v. Commonwealth\">292 S. E. 2d 798</a></span>; No. 82-5877, <span class=\"citation\" data-id=\"1342161\"><a href=\"/opinion/1342161/johnson-v-zant/\" aria-description=\"Citation for case: Johnson v. Zant\">249 Ga. 812</a></span>, <span class=\"citation\" data-id=\"1342161\"><a href=\"/opinion/1342161/johnson-v-zant/\" aria-description=\"Citation for case: Johnson v. Zant\">295 S. E. 2d 63</a></span>; No. 82-5879, <span class=\"citation\" data-id=\"1914387\"><a href=\"/opinion/1914387/daugherty-v-state/\" aria-description=\"Citation for case: Daugherty v. State\">419 So. 2d 1067</a></span>; No. 82-5902, <span class=\"citation multiple-matches\"><a href=\"/c/So.%202d/419/1058/\">419 So. 2d 1058</a></span>; No. 82-5909, <span class=\"citation no-link\">422 So. 2d 843</span>.</p>\n</opinion>"},{"id":9037203,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1162-11\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AO9s\">dissenting.</p>\n<p id=\"AYL1\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}