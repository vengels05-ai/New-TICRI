{"id":9046072,"docketId":66312309,"caseName":"Hernandez v. Texas","caseNameFull":"Hernandez v. Texas","slug":"hernandez-v-texas","docketNumber":"No. 82-6448","dateFiled":"1983-06-20","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9039450,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1148-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AO2\">dissenting.</p>\n<p id=\"b1148-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}