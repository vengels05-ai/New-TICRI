{"id":9013810,"docketId":66280027,"caseName":"Richmond v. Arizona","caseNameFull":"Richmond v. Arizona","slug":"richmond-v-arizona","docketNumber":"No. 76-6720","dateFiled":"1977-06-27","dateArgued":null,"dateCertGranted":null,"year":1977,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":7,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9006801,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":579,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b729-8\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"AZpj\">dissenting.</p>\n<p id=\"b729-9\">Adhering to our views that the death'penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}