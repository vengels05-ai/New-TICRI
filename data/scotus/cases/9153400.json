{"id":9153400,"docketId":66419700,"caseName":"In re Disbarment of Hotze","caseNameFull":"In re Disbarment of Hotze","slug":"in-re-disbarment-of-hotze","docketNumber":"No. D-1496","dateFiled":"1995-03-20","dateArgued":null,"dateCertGranted":null,"year":1995,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9148089,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":454,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AEP\">T. Wilson Hotze, of Richmond, Va., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on January 17, 1995 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./513/1108/\">513 U. S. 1108</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}