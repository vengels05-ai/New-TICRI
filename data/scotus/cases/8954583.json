{"id":8954583,"docketId":66220798,"caseName":"Collins v. California","caseNameFull":"COLLINS v. CALIFORNIA","slug":"collins-v-california","docketNumber":"No. 599","dateFiled":"1963-04-15","dateArgued":null,"dateCertGranted":null,"year":1963,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"California, Clark, Harlan, Opinions, Stated","jurisdictionType":"","opinions":[{"id":8945524,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":865,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b773-9\">Per Curiam.</author>\n<p id=\"b773-10\">The motion for leave, to proceed <em>in forma pauperis </em>and the petition for writ of certiorari are granted. The judgment is vacated and the case is remanded for further consideration in light of <em>Douglas </em>v. <em>California, </em><span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U. S. 353</a></span>.</p>\n<judges id=\"b773-11\">Mr. Justice Clark and Mr. Justice Harlan dissent for the reasons stated in their opinions in <em>Douglas </em>v. <em>California, </em><span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/#358\" aria-description=\"Citation for case: Douglas v. California\">372 U. S., at 358, 360</a></span>.</judges>\n</opinion>"}],"citations":[]}