{"id":9108236,"docketId":66374509,"caseName":"Moon v. Georgia","caseNameFull":"Moon v. Georgia Moore v. California Bassette v. Thompson, Warden Cole v. Texas","slug":"moon-v-georgia","docketNumber":"No. 88-6833; No. 90-7093; No. 90-7155; No. 90-7411","dateFiled":"1991-04-22","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9102654,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":885,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AakM\">Sup. Ct. Ga.;</p>\n<p id=\"AnO\">Sup. Ct. Cal.;</p>\n<p id=\"AhRn\">C. A. 4th Cir.; and</p>\n<p id=\"AN2y\">Ct. Crim. App. Tex. Certiorari denied. Reported below: No. 88-6833, <span class=\"citation\" data-id=\"1259185\"><a href=\"/opinion/1259185/moon-v-state/\" aria-description=\"Citation for case: Moon v. State\">258 Ga. 748</a></span>, <span class=\"citation\" data-id=\"1259185\"><a href=\"/opinion/1259185/moon-v-state/\" aria-description=\"Citation for case: Moon v. State\">375 S. E. 2d 442</a></span>; No. 90-7155, <span class=\"citation\" data-id=\"548951\"><a href=\"/opinion/548951/herbert-russell-bassette-v-charles-e-thompson-mary-sue-terry-attorney/\" aria-description=\"Citation for case: Herbert Russell Bassette v. Charles E. Thompson, Mary Sue...\">915 F. 2d 932</a></span>; No. 90-7411, <span class=\"citation no-link\">795 S. W. 2d 207</span>.</p>\n</opinion>"},{"id":9102655,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":631,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b802-16\">Justice Marshall,</author>\n<p id=\"AL7q\">dissenting.</p>\n<p id=\"b802-17\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, <page-number citation-index=\"1\" label=\"983\">*983</page-number>231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}