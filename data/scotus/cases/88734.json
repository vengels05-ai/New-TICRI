{"id":88734,"docketId":2485932,"caseName":"Crilley v. Burrows","caseNameFull":"","slug":"crilley-v-burrows","docketNumber":"129","dateFiled":"1873-04-28","dateArgued":null,"dateCertGranted":null,"year":1873,"scdbId":"1872-191","direction":"Liberal","votesMajority":9,"votesMinority":0,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":5,"judges":"","jurisdictionType":"","opinions":[{"id":88734,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":939,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation no-link\">84 U.S. 167</span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"88736\"><a href=\"/opinion/88736/collector-v-beggs/\" aria-description=\"Citation for case: Collector v. Beggs\">21 L.Ed. 624</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">17 Wall. 167</span></p>\n    <p class=\"parties\">CRILLEY<br>v.<br>BURROWS</p>\n    <p class=\"date\">December Term, 1872</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">At the same time with the preceding was adjudged another, <i>Crilley</i> v. <i>Burrows</i>, which the court said (Mr. Justice DAVIS delivering the opinion) was 'in no essential respect different from it;' and had 'no principle which had not already been passed upon by this court in some one of the suits relating to this protracted litigation.' On this account it is no further reported.</p>\n    </div>\n    "}],"citations":[]}