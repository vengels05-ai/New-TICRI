{"id":8604835,"docketId":65867555,"caseName":"Wallace v. United States","caseNameFull":"LEWIS WALLACE v. United States","slug":"wallace-v-united-states","docketNumber":"","dateFiled":"1890-01-27","dateArgued":null,"dateCertGranted":null,"year":1890,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":"<p>\nOn the claimants Appeal.\n</p>","headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Blatcheobd","jurisdictionType":"","opinions":[{"id":8583060,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"Blatcheobd","joinedBy":"","pageCount":null,"textLength":611,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"b792-7\">The court below dismissed the petition for salary of a minister abroad on the authority of its decision in <em>Frances </em>v. <em>The United States </em>(<span class=\"citation\" data-id=\"8582079\"><a href=\"/opinion/8603854/francis-v-united-states/\" aria-description=\"Citation for case: Francis v. United States\">22 C. Cls. R., 403</a></span>).</p>\n<p id=\"b792-8\">The decision of the court below is affirmed on the same grounds.</p>\n<author id=\"b792-9\">Mr. Justice Blatcheobd</author>\n<p id=\"ACP\">delivered the opinion of the Supreme Court January 27, 1890.</p>\n</opinion>"}],"citations":[]}