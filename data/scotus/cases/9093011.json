{"id":9093011,"docketId":66359273,"caseName":"Rogers v. Texas","caseNameFull":"Rogers v. Texas Morales v. California Nolte v. Oklahoma Mendyk v. Florida Blanks v. Kemp, Warden","slug":"rogers-v-texas","docketNumber":"No. 89-5460; No. 89-5534; No. 89-5575; No. 89-5707; No. 89-5798","dateFiled":"1989-11-27","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9087212,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":971,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AS8Q\">Ct. Crim. App. Tex.;</p>\n<p id=\"Ab_V\">Sup. Ct. Cal.;</p>\n<p id=\"AISM\">Ct. Crim. App. Okla.;</p>\n<p id=\"ASSZ\">Sup. Ct. Fla.; and</p>\n<p id=\"AF8Z\">Super. Ct. Ga., Butts County. Certiorari denied. Reported below: No. 89-5460, <span class=\"citation\" data-id=\"9767479\"><a href=\"/opinion/2405635/rogers-v-state/\" aria-description=\"Citation for case: Rogers v. State\">774 S. W. 2d 247</a></span>; No. 89-5534, <span class=\"citation\" data-id=\"9534148\"><a href=\"/opinion/1129438/people-v-morales/\" aria-description=\"Citation for case: People v. Morales\">48 Cal. 3d 527</a></span>, <span class=\"citation\" data-id=\"9534148\"><a href=\"/opinion/1129438/people-v-morales/\" aria-description=\"Citation for case: People v. Morales\">770 P. 2d 244</a></span>; No. 89-5707, <span class=\"citation\" data-id=\"1749801\"><a href=\"/opinion/1749801/mendyk-v-state/\" aria-description=\"Citation for case: Mendyk v. State\">545 So. 2d 846</a></span>.</p>\n</opinion>"},{"id":9087213,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b922-11\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Azp-\">dissenting.</p>\n<p id=\"b922-12\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}