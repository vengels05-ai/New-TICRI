{"id":9068967,"docketId":66335218,"caseName":"In re Disbarment of Ernst","caseNameFull":"In re Disbarment of Ernst","slug":"in-re-disbarment-of-ernst","docketNumber":"No. D-625","dateFiled":"1987-06-01","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9062678,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":450,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ACo\">Thomas J. Ernst, of Clayton, Mo., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on April 6, 1987 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./481/1002/\">481 U. S. 1002</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}