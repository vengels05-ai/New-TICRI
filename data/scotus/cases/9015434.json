{"id":9015434,"docketId":66281651,"caseName":"Witt v. Florida","caseNameFull":"Witt v. Florida Burns v. Texas Shippy v. Texas Pryor v. Georgia","slug":"witt-v-florida","docketNumber":"No. 77-5026; No. 77-5305; No. 77-5355; No. 77-5464","dateFiled":"1977-10-31","dateArgued":null,"dateCertGranted":null,"year":1977,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9008500,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1022,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ACbg\">Sup. Ct. Fla.;</p>\n<p id=\"AMv6\">Ct. Crim. App. Tex.;</p>\n<p id=\"AYkm\">Ct. Crim. App. Tex.; and</p>\n<p id=\"Adu3\">Sup. Ct. Ga. Certio-rari denied. Reported below: No. 77-5026, <span class=\"citation\" data-id=\"1126044\"><a href=\"/opinion/1126044/witt-v-state/\" aria-description=\"Citation for case: Witt v. State\">342 So. 2d 497</a></span>; No. 77-5305, <span class=\"citation\" data-id=\"9684252\"><a href=\"/opinion/1794489/burns-v-state/\" aria-description=\"Citation for case: Burns v. State\">556 S. W. 2d 270</a></span>; No. 77-5355, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20W.%202d/556/246/\">556 S. W. 2d 246</a></span> ; No. 77-5464, <span class=\"citation\" data-id=\"1259852\"><a href=\"/opinion/1259852/pryor-v-state/\" aria-description=\"Citation for case: Pryor v. State\">238 Ga. 698</a></span>, <span class=\"citation\" data-id=\"1259852\"><a href=\"/opinion/1259852/pryor-v-state/\" aria-description=\"Citation for case: Pryor v. State\">234 S. E. 2d 918</a></span>.</p>\n</opinion>"},{"id":9008501,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":602,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b915-6\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"Aij\">dissenting.</p>\n<p id=\"b915-7\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}