{"id":9030043,"docketId":66296265,"caseName":"Swindler v. Arkansas","caseNameFull":"Swindler v. Arkansas Davis v. Georgia","slug":"swindler-v-arkansas","docketNumber":"No. 80-5488; No. 80-5602","dateFiled":"1980-12-08","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9023323,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":851,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Atda\">Sup. Ct. Ark.; and</p>\n<p id=\"AtQP\">Sup. Ct. Ga. Certiorari denied. Reported below: No. 80-5488, <span class=\"citation\" data-id=\"1566200\"><a href=\"/opinion/1566200/swindler-v-state/\" aria-description=\"Citation for case: Swindler v. State\">267 Ark. 418</a></span>, <span class=\"citation\" data-id=\"1566200\"><a href=\"/opinion/1566200/swindler-v-state/\" aria-description=\"Citation for case: Swindler v. State\">592 S. W. 2d 91</a></span>; No. 80-5602, <span class=\"citation\" data-id=\"9854183\"><a href=\"/opinion/1293488/state-of-ga-v-davis/\" aria-description=\"Citation for case: State of Ga. v. Davis\">246 Ga. 200</a></span>, <span class=\"citation\" data-id=\"9854183\"><a href=\"/opinion/1293488/state-of-ga-v-davis/\" aria-description=\"Citation for case: State of Ga. v. Davis\">269 S. E. 2d 461</a></span>.</p>\n</opinion>"},{"id":9023324,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1071-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AI4N\">dissenting.</p>\n<p id=\"AkWY\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}