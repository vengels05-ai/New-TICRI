{"id":9015529,"docketId":66281746,"caseName":"In re Disbarment of Ooms","caseNameFull":"In re Disbarment of Ooms","slug":"in-re-disbarment-of-ooms","docketNumber":"No. D-100","dateFiled":"1977-11-14","dateArgued":null,"dateCertGranted":null,"year":1977,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9008596,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":452,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Am2O\">Owen Jennings Ooms, of Chicago, Ill., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause heretofore issued on April 4, 1977 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./430/952/\">430 U. S. 952</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}