{"id":9051290,"docketId":66317536,"caseName":"Reeves v. Nebraska","caseNameFull":"Reeves v. Nebraska Martin v. Maggio, Warden","slug":"reeves-v-nebraska","docketNumber":"No. 84-5271; No. 84-5370","dateFiled":"1984-11-13","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9044744,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":997,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Aee2\">Sup. Ct. Neb.; and</p>\n<p id=\"AcYa\">C. A. 5th Cir. Certiorari denied. Reported below: No. 84-5271, <span class=\"citation\" data-id=\"9581312\"><a href=\"/opinion/1246598/state-v-reeves/\" aria-description=\"Citation for case: State v. Reeves\">216 Neb. 206</a></span>, <span class=\"citation\" data-id=\"9581312\"><a href=\"/opinion/1246598/state-v-reeves/\" aria-description=\"Citation for case: State v. Reeves\">344 N. W. 2d 433</a></span>; No. 84-5370, <span class=\"citation\" data-id=\"421667\"><a href=\"/opinion/421667/david-dene-martin-v-ross-maggio-jr-warden-louisiana-state/\" aria-description=\"Citation for case: David Dene Martin v. Ross Maggio, Jr., Warden, Louisiana...\">711 F. 2d 1273</a></span> and <span class=\"citation\" data-id=\"438872\"><a href=\"/opinion/438872/david-dene-martin-v-ross-maggio-jr-warden-louisiana-state/\" aria-description=\"Citation for case: David Dene Martin v. Ross Maggio, Jr., Warden, Louisiana...\">739 F. 2d 184</a></span>.</p>\n</opinion>"},{"id":9044745,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":596,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b962-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A9AU\">dissenting.</p>\n<p id=\"b962-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}