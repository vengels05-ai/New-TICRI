{"id":102420,"docketId":1668939,"caseName":"James Steele v. The People of the State of New York.","caseNameFull":"","slug":"james-steele-v-the-people-of-the-state-of-new-york","docketNumber":"644","dateFiled":"1935-02-11","dateArgued":null,"dateCertGranted":null,"year":1935,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":102420,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1975,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./294/710/\">294 U.S. 710</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./55/510/\">55 S.Ct. 510</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/L.Ed./79/1244/\">79 L.Ed. 1244</a></span></p>\n    <p class=\"parties\">James STEELE, petitioner,<br>v.<br>The PEOPLE OF THE STATE OF NEW YORK.<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a></p>\n    <p class=\"docket\">No. 644.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">February 4, 1935</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">Mr. James Steele, pro se.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">On petition for writ of certiorari to the Supreme Court of the State of New York.</p>\n    </div>\n    <div class=\"num\" id=\"p3\">\n      <span class=\"num\">3</span>\n      <p class=\"indent\">For decision below, see <span class=\"citation multiple-matches\"><a href=\"/c/App.%20Div./241/875/\">241 App. Div. 875</a></span>, 271 N. Y. S. 979.</p>\n    </div>\n    <div class=\"num\" id=\"p4\">\n      <span class=\"num\">4</span>\n      <p class=\"indent\">The motions for leave to proceed further herein in forma pauperis are denied for the reason that the Court, upon examination of the papers herein submitted, finds no ground upon which writs of certiorari should be issued. The petitions for writs of certiorari are therefore also denied.</p>\n    </div>\n    <div class=\"footnotes\">\n      <div class=\"footnote\" id=\"fn-s\">\n        <a class=\"footnote\" href=\"#fn-s_ref\">*</a>\n        <p> Rehearing denied <span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./294/733/\">294 U. S. 733</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20Ct./55/544/\">55 S. Ct. 544</a></span>, 79 L. Ed.</p>\n      </div>\n    </div>\n    "}],"citations":[]}