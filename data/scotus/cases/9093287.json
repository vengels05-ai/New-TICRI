{"id":9093287,"docketId":66359549,"caseName":"In re Disbarment of Singer","caseNameFull":"In re Disbarment of Singer","slug":"in-re-disbarment-of-singer","docketNumber":"No. D-817","dateFiled":"1989-12-11","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9087495,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":449,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A1ax\">Phillip Singer, of Beverly Hills, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from <page-number citation-index=\"1\" label=\"1000\">*1000</page-number>the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on November 6, 1989 <em>[ante, </em>p. 949], is hereby discharged.</p>\n</opinion>"}],"citations":[]}