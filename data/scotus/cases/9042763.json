{"id":9042763,"docketId":66308990,"caseName":"Otey v. Nebraska","caseNameFull":"Otey v. Nebraska Brown v. North Carolina","slug":"otey-v-nebraska","docketNumber":"No. 82-5308; No. 82-5542","dateFiled":"1982-12-06","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":124,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9036113,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":815,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AhH2\">Sup. Ct. Neb.; and</p>\n<p id=\"AGtqx\">Sup. Ct. N. C. Certiorari denied. Reported below: No. 82-5308, <span class=\"citation\" data-id=\"1586198\"><a href=\"/opinion/1586198/state-v-otey/\" aria-description=\"Citation for case: State v. Otey\">212 Neb. 103</a></span>, <span class=\"citation\" data-id=\"1586198\"><a href=\"/opinion/1586198/state-v-otey/\" aria-description=\"Citation for case: State v. Otey\">321 N. W. 2d 453</a></span>; No. 82-5542, <span class=\"citation\" data-id=\"9587969\"><a href=\"/opinion/1339444/state-v-brown/\" aria-description=\"Citation for case: State v. Brown\">306 N. C. 151</a></span>, <span class=\"citation\" data-id=\"9587969\"><a href=\"/opinion/1339444/state-v-brown/\" aria-description=\"Citation for case: State v. Brown\">293 S. E. 2d 569</a></span>.</p>\n</opinion>"},{"id":9036114,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":663,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1014-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AWfQ\">dissenting.</p>\n<p id=\"b1014-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 <page-number citation-index=\"1\" label=\"1081\">*1081</page-number>U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}