{"id":9031298,"docketId":66297520,"caseName":"Clark v. Florida","caseNameFull":"Clark v. Florida Baker v. Georgia Green v. Georgia","slug":"clark-v-florida","docketNumber":"No. 79-6309; No. 80-5856; No. 80-5986","dateFiled":"1981-02-23","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":5,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9024584,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1017,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Aiq\">Sup. Ct. Fla.;</p>\n<p id=\"A9r\">Sup. Ct. Ga.; and</p>\n<p id=\"ArxP\">Sup. Ct. Ga. Certio-rari denied. Reported below: No. 79-6309, <span class=\"citation\" data-id=\"1687937\"><a href=\"/opinion/1687937/clark-v-state/\" aria-description=\"Citation for case: Clark v. State\">379 So. 2d 97</a></span>; No. 80-5856, <span class=\"citation\" data-id=\"5597245\"><a href=\"/opinion/5745421/baker-v-state/\" aria-description=\"Citation for case: Baker v. State\">246 Ga. 259</a></span>, <span class=\"citation\" data-id=\"5597245\"><a href=\"/opinion/5745421/baker-v-state/\" aria-description=\"Citation for case: Baker v. State\">272 S. E. 2d 61</a></span>; No. 80-5986, <span class=\"citation\" data-id=\"9588118\"><a href=\"/opinion/1339789/green-v-state/\" aria-description=\"Citation for case: Green v. State\">246 Ga. 598</a></span>, <span class=\"citation\" data-id=\"9588118\"><a href=\"/opinion/1339789/green-v-state/\" aria-description=\"Citation for case: Green v. State\">272 S. E. 2d 475</a></span>.</p>\n</opinion>"},{"id":9024585,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b912-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Af_Y\">dissenting.</p>\n<p id=\"b912-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}