{"id":6795655,"docketId":63777009,"caseName":"Genevier v. Superior Court of California","caseNameFull":"Pierre Genevier v. Superior Court of California, Los Angeles County","slug":"genevier-v-superior-court-of-california","docketNumber":"09-9780","dateFiled":"2010-04-26","dateArgued":null,"dateCertGranted":null,"year":2010,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":6680475,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2013,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AbfaO\">Motion of petitioner for leave to proceed in forma pauperis denied, and petition for writ of certiorari to the Court of appeals of California, Second Appellate District, dismissed. See Rule 39.8. As the petitioner has repeatedly abused this Court\u2019s process, the Clerk is directed not to accept any further petitions in noncriminal matters from petitioner unless the docketing fee required by Rule 38(a) is paid and petition submitted in compliance with Rule 33.1. See Martin v. District of Columbia Court of Appeals, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">506 U.S. 1</a></span>, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">113 S. Ct. 397</a></span>, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">121 L. Ed. 2d 305</a></span> (1992) (per curiam). Justice Stevens dissents. See <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/#4\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">id., at 4</a></span>, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">113 S. Ct. 397</a></span>, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">121 L. Ed. 2d 305</a></span>, and cases cited therein.</p>\n</opinion>"}],"citations":[]}