{"id":9054270,"docketId":66320516,"caseName":"Rose v. Florida","caseNameFull":"Rose v. Florida Nash, aka Henderson v. Arizona","slug":"rose-v-florida","docketNumber":"No. 84-6449; No. 84-6639","dateFiled":"1985-06-03","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":120,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9047777,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":645,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AgSc\">Sup. Ct. Fla.; and</p>\n<p id=\"Ah5V\">Sup. Ct. Ariz. Certiorari denied. Reported below: No. 84-6449, <span class=\"citation\" data-id=\"1104414\"><a href=\"/opinion/1104414/rose-v-state/\" aria-description=\"Citation for case: Rose v. State\">461 So. 2d 84</a></span>; No. 84-6639, <span class=\"citation\" data-id=\"1421711\"><a href=\"/opinion/1421711/state-v-nash/\" aria-description=\"Citation for case: State v. Nash\">143 Ariz. 392</a></span>, <span class=\"citation\" data-id=\"1421711\"><a href=\"/opinion/1421711/state-v-nash/\" aria-description=\"Citation for case: State v. Nash\">694 P. 2d 222</a></span>.</p>\n</opinion>"},{"id":9047778,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":599,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1077-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AzLV\">dissenting.</p>\n<p id=\"b1077-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}