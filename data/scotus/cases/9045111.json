{"id":9045111,"docketId":66311339,"caseName":"Gray v. Lucas","caseNameFull":"Gray v. Lucas, Warden","slug":"gray-v-lucas","docketNumber":"No. 82-6172","dateFiled":"1983-04-25","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9038477,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":590,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b864-14\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AWe\">dissenting.</p>\n<p id=\"A_5o\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}