{"id":116273,"docketId":1501514,"caseName":"Bush v. Singletary, Secretary, Florida Department of Corrections","caseNameFull":"","slug":"bush-v-singletary-secretary-florida-department-of-corrections","docketNumber":"93-6431","dateFiled":"1994-01-10","dateArgued":null,"dateCertGranted":null,"year":1994,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":116273,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1449,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./510/1065/\">510 U.S. 1065</a></span></p>\n    <p class=\"parties\">Bush<br>v.<br>Singletary, Secretary, Florida Department of Corrections.</p>\n    <p class=\"docket\">No. 93-6431.</p>\n    <p class=\"court\">Supreme Court of United States.</p>\n    <p class=\"date\">January 10, 1994.</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Appeal from the C. A. 11th Cir.</p>\n      <p class=\"indent\">Certiorari denied. Reported below: <span class=\"citation\" data-id=\"9484034\"><a href=\"/opinion/602457/john-earl-bush-v-harry-k-singletary-secretary-florida-department-of/\" aria-description=\"Citation for case: John Earl Bush v. Harry K. Singletary, Secretary, Florida...\">988 F. 2d 1082</a></span>.</p>\n      <p class=\"indent\">Justice Blackmun, dissenting.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">I am inclined to agree with Judge Kravitch, <span class=\"citation\" data-id=\"9484034\"><a href=\"/opinion/602457/john-earl-bush-v-harry-k-singletary-secretary-florida-department-of/#1093\" aria-description=\"Citation for case: John Earl Bush v. Harry K. Singletary, Secretary, Florida...\">988 F. 2d 1082, 1093</a></span> (CA11 1993) (opinion concurring in part and in part), and would grant certiorari on the issue whether counsel rendered effective assistance as required by the Sixth and Fourteenth Amendments.</p>\n    </div>\n    "}],"citations":[]}