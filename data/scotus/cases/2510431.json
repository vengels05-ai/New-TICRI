{"id":2510431,"docketId":623237,"caseName":"McLeod v. Ohio","caseNameFull":"","slug":"mcleod-v-ohio","docketNumber":"1117, Misc","dateFiled":"1965-05-24","dateArgued":null,"dateCertGranted":null,"year":1965,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":2510431,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":939,"isHtml":true,"text":"<div>\n<center><b><span class=\"citation\" data-id=\"107070\"><a href=\"/opinion/107070/mcleod-v-ohio/\" aria-description=\"Citation for case: McLEOD v. OHIO\">381 U.S. 356</a></span> (1965)</b></center>\n<center><h1>McLEOD<br>\nv.<br>\nOHIO.</h1></center>\n<center>No. 1117, Misc.</center>\n<center><p><b>Supreme Court of United States.</b></p></center>\n<center>Decided May 24, 1965.</center>\nON PETITION FOR WRIT OF CERTIORARI TO THE SUPREME COURT OF OHIO.\n<p>Petitioner <i>pro se.</i></p>\n<p><i>James V. Barbuto</i> and <i>John D. Smith</i> for respondent.</p>\n<p>PER CURIAM.</p>\n<p>The motion for leave to proceed <i>in forma pauperis</i> and the petition for writ of certiorari are granted. The judgment is reversed. <i>Massiah</i> v. <i>United States,</i> <span class=\"citation\" data-id=\"9422796\"><a href=\"/opinion/106822/massiah-v-united-states/\" aria-description=\"Citation for case: Massiah v. United States\">377 U. S. 201</a></span>.</p>\n</div>"}],"citations":[]}