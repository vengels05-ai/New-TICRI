{"id":9140723,"docketId":66407018,"caseName":"In re Disbarment of Pohlmann","caseNameFull":"In re Disbarment of Pohlmann","slug":"in-re-disbarment-of-pohlmann","docketNumber":"No. D-1301","dateFiled":"1993-11-01","dateArgued":null,"dateCertGranted":null,"year":1993,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9135401,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":462,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AqF7\">John Milton Pohlmann, of Lafayette, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on September 24, 1993 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./509/949/\">509 U. S. 949</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}