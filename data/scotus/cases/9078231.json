{"id":9078231,"docketId":66344484,"caseName":"James v. Butler","caseNameFull":"James v. Butler, Warden Johns v. Missouri Foster v. Illinois","slug":"james-v-butler","docketNumber":"No. 87-6233; No. 87-6869; No. 87-6905","dateFiled":"1988-06-06","dateArgued":null,"dateCertGranted":null,"year":1988,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9072159,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1153,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A8yD\"><page-number citation-index=\"1\" label=\"1046\">*1046</page-number>C. A. 5th Cir.;</p>\n<p id=\"ABI\">Ct. App. Mo., Eastern Dist.; and</p>\n<docketnumber id=\"AtHu\"><page-number citation-index=\"1\" label=\"1047\">*1047</page-number>No. 87-6905.</docketnumber>\n<p id=\"AMD\">Sup. Ct. Ill. Certiorari denied. Reported below: No. 87-6233, <span class=\"citation\" data-id=\"493633\"><a href=\"/opinion/493633/antonio-james-v-robert-h-butler-sr-warden-louisiana-state/\" aria-description=\"Citation for case: Antonio James v. Robert H. Butler, Sr., Warden, Louisiana...\">827 F. 2d 1006</a></span>; No. 87-6869, <span class=\"citation\" data-id=\"1730904\"><a href=\"/opinion/1730904/johns-v-state/\" aria-description=\"Citation for case: Johns v. State\">741 S. W. 2d 771</a></span>; No. 87-6905, <span class=\"citation\" data-id=\"9520474\"><a href=\"/opinion/2020271/people-v-foster/\" aria-description=\"Citation for case: People v. Foster\">119 Ill. 2d 69</a></span>, <span class=\"citation\" data-id=\"9520474\"><a href=\"/opinion/2020271/people-v-foster/\" aria-description=\"Citation for case: People v. Foster\">518 N. E. 2d 82</a></span>.</p>\n</opinion>"},{"id":9072160,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1007-5\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AcE7\">dissenting.</p>\n<p id=\"b1007-6\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}