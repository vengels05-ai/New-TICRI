{"id":9029685,"docketId":66295907,"caseName":"In re Williams","caseNameFull":"In re Williams","slug":"in-re-williams","docketNumber":"No. 80-5385","dateFiled":"1980-11-17","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9022962,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":574,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1005-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Ae4v\">dissenting.</p>\n<p id=\"b1005-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}