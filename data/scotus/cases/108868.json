{"id":108868,"docketId":2436975,"caseName":"Doris Jimerson v. New York State Department of Social Services","caseNameFull":"","slug":"doris-jimerson-v-new-york-state-department-of-social-services","docketNumber":"72-5939","dateFiled":"1973-06-25","dateArgued":null,"dateCertGranted":null,"year":1973,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":108868,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2217,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8986126\"><a href=\"/opinion/8993863/jimerson-v-new-york-state-department-of-social-services/\" aria-description=\"Citation for case: Jimerson v. New York State Department of Social Services\">413 U.S. 910</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./93/3070/\">93 S.Ct. 3070</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"8986126\"><a href=\"/opinion/8993863/jimerson-v-new-york-state-department-of-social-services/\" aria-description=\"Citation for case: Jimerson v. New York State Department of Social Services\">37 L.Ed.2d 1021</a></span></p>\n    <p class=\"parties\">Doris JIMERSON et al., appellants,<br>v.<br>NEW YORK STATE DEPARTMENT OF SOCIAL SERVICES, et al.</p>\n    <p class=\"docket\">No. 72-5939.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">June 25, 1973</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">Motion for leave to proceed <i>in forma pauperis</i> granted. Judgment vacated and case remanded to the United States District Court for the Western District of New York for further consideration in light of New York State Dept. of Social Services v. Dublino, <span class=\"citation\" data-id=\"9425409\"><a href=\"/opinion/108849/new-york-state-department-of-social-services-v-dublino/\" aria-description=\"Citation for case: New York State Department of Social Services v. Dublino\">413 U.S. 405</a></span>, <span class=\"citation\" data-id=\"9425409\"><a href=\"/opinion/108849/new-york-state-department-of-social-services-v-dublino/\" aria-description=\"Citation for case: New York State Department of Social Services v. Dublino\">93 S.Ct. 2507</a></span>, <span class=\"citation\" data-id=\"9425409\"><a href=\"/opinion/108849/new-york-state-department-of-social-services-v-dublino/\" aria-description=\"Citation for case: New York State Department of Social Services v. Dublino\">37 L.Ed.2d 688</a></span> (1973).</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">Mr. Justice DOUGLAS would note probable jurisdiction and set case for oral argument.</p>\n    </div>\n    "}],"citations":[]}