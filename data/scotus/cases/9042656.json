{"id":9042656,"docketId":66308883,"caseName":"Knapp v. Cardwell","caseNameFull":"Knapp v. Cardwell Simon v. Tennessee Morgan v. Florida White v. Florida","slug":"knapp-v-cardwell","docketNumber":"No. 82-530; No. 82-5319; No. 82-5519; No. 82-5534","dateFiled":"1982-11-29","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":106,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9036005,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1012,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AAU7\">C. A. 9th Cir.;</p>\n<p id=\"AAHv\">Sup. Ct. Tenn.;</p>\n<p id=\"A1B\">Sup. Ct. Fla.; and</p>\n<p id=\"ARPt\">Sup. Ct. Fla. Certio-rari denied. Reported below: No. 82-530, <span class=\"citation\" data-id=\"9468759\"><a href=\"/opinion/398618/john-henry-knapp-arizona-state-prison-inmate-no-33659-and-all-inmates-of/\" aria-description=\"Citation for case: John Henry Knapp, Arizona State Prison Inmate No. 33659,...\">667 F. 2d 1253</a></span>; No. 82-5319, <span class=\"citation\" data-id=\"2410219\"><a href=\"/opinion/2410219/state-v-simon/\" aria-description=\"Citation for case: State v. Simon\">635 S. W. 2d 498</a></span>; No. 82-5519, <span class=\"citation\" data-id=\"1100021\"><a href=\"/opinion/1100021/morgan-v-state/\" aria-description=\"Citation for case: Morgan v. State\">415 So. 2d 6</a></span>; No. 82-5534, <span class=\"citation\" data-id=\"1100040\"><a href=\"/opinion/1100040/white-v-state/\" aria-description=\"Citation for case: White v. State\">415 So. 2d 719</a></span>.</p>\n</opinion>"},{"id":9036006,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b989-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AMUg\">dissenting.</p>\n<p id=\"b989-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}