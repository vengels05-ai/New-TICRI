{"id":106475,"docketId":2480203,"caseName":"Kenneth Barton v. District Court of Iowa, Etc","caseNameFull":"","slug":"kenneth-barton-v-district-court-of-iowa-etc","docketNumber":"31, Misc","dateFiled":"1962-10-08","dateArgued":null,"dateCertGranted":null,"year":1962,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":106475,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1491,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8944296\"><a href=\"/opinion/8953382/barton-v-district-court-ex-rel-union-county/\" aria-description=\"Citation for case: Barton v. District Court ex rel. Union County\">371 U.S. 15</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"8944296\"><a href=\"/opinion/8953382/barton-v-district-court-ex-rel-union-county/\" aria-description=\"Citation for case: Barton v. District Court ex rel. Union County\">83 S.Ct. 52</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/L.Ed.2d/9/50/\">9 L.Ed.2d 50</a></span></p>\n    <p class=\"parties\">Kenneth BARTON<br>v.<br>DISTRICT COURT OF IOWA, etc.</p>\n    <p class=\"docket\">No. 31, Misc.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">October 8, 1962</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Barton, pro se.</p>\n      <p class=\"indent\">Evan Hultman, Atty. Gen. of Iowa, for appellee.</p>\n      <p class=\"indent\">PER CURIAM.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The motion to dismiss is granted and the appeal is dismissed. Treating the papers whereon the appeal was taken as a petition