{"id":9286706,"docketId":66555077,"caseName":"Booker v. Wainwright","caseNameFull":"Booker v. Wainwright, Secretary, Florida Department of Corrections Sullivan v. Wainwright, Secretary, Florida Department of Corrections","slug":"booker-v-wainwright","docketNumber":"No. 83-5209; No. 83-5267","dateFiled":"1983-10-17","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":44,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9281554,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":647,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AKtC\">C. A. 11th Cir.; and</p>\n<p id=\"A5D4\">C. A. 11th Cir. Certiorari denied. Reported below: No. 83-5209, <span class=\"citation\" data-id=\"416534\"><a href=\"/opinion/416534/stephen-todd-booker-v-louie-l-wainwright-secretary-department-of/\" aria-description=\"Citation for case: Stephen Todd Booker v. Louie L. Wainwright, Secretary,...\">703 F. 2d 1251</a></span>; No. 83-5267, <span class=\"citation\" data-id=\"9470063\"><a href=\"/opinion/411950/robert-a-sullivan-v-louie-l-wainwright-etc/\" aria-description=\"Citation for case: Robert A. Sullivan v. Louie L. Wainwright, Etc.\">695 F. 2d 1306</a></span>.</p>\n</opinion>"},{"id":9281555,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":658,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b796-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A0x_\">dissenting.</p>\n<p id=\"b796-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth <page-number citation-index=\"1\" label=\"923\">*923</page-number>and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}