{"id":105764,"docketId":431145,"caseName":"Hansford v. United States","caseNameFull":"Hansford v. United States","slug":"hansford-v-united-states","docketNumber":"826, Misc","dateFiled":"1958-06-30","dateArgued":null,"dateCertGranted":null,"year":1958,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., Solicitor General Rankin for the United States.","natureOfSuit":"","citationCount":15,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":105764,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":787,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"6\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b626-11\">\n  Per Curiam.\n </author>\n<p id=\"b626-12\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for writ of certiorari are granted. The judgment of the United States Court of Appeals for the District of Columbia Circuit is vacated and the case is remanded to that court for consideration in light of\n  <em>\n   Ellis\n  </em>\n  v.\n  <em>\n   United States,\n  </em>\n  <span class=\"citation\" data-id=\"105701\"><a href=\"/opinion/105701/ellis-v-united-states/\" aria-description=\"Citation for case: Ellis v. United States\">356 U. S. 674</a></span>. It is ordered that the judgment in this case issue forthwith.\n </p>\n</opinion>"}],"citations":[]}