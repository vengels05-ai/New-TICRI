{"id":7343083,"docketId":64331576,"caseName":"In re Rothschild","caseNameFull":"In the Matter of John David Rothschild","slug":"in-re-rothschild","docketNumber":"No. D-2577","dateFiled":"2011-02-22","dateArgued":null,"dateCertGranted":null,"year":2011,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":7261024,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":892,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"aov-dedup-1\">John David Rothschild, of Sonoma, California, having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys permitted to the practice of law before this Court. The Rule to Show Cause, issued on November 15, 2010, is discharged.</p>\n<p id=\"b471-18\">Former order, <span class=\"citation multiple-matches\"><a href=\"/c/U.S./562/1039/\">562 U.S. 1039</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20Ct./131/629/\">131 S. Ct. 629</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/L.%20Ed.%202d/178/457/\">178 L. Ed. 2d 457</a></span>, <span class=\"citation\" data-id=\"7258505\"><a href=\"/opinion/7340582/in-re-discipline-of-rothschild/\" aria-description=\"Citation for case: In re Discipline of Rothschild\">2010 U.S. LEXIS 9010</a></span>.</p>\n</opinion>"}],"citations":[]}