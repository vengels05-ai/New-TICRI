{"id":9045567,"docketId":66311795,"caseName":"Zettlemoyer v. Pennsylvania","caseNameFull":"Zettlemoyer v. Pennsylvania Gretzler v. Arizona","slug":"zettlemoyer-v-pennsylvania","docketNumber":"No. 82-6514; No. 82-6556","dateFiled":"1983-05-31","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":19,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9038938,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1043,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A7F\"><page-number citation-index=\"1\" label=\"970\">*970</page-number>Sup. Ct. Pa.; and</p>\n<docketnumber id=\"Ae7\"><page-number citation-index=\"1\" label=\"971\">*971</page-number>No. 82-6556.</docketnumber>\n<p id=\"Ai4\">Sup. Ct. Ariz. Certiorari denied. Reported below: No. 82-6514, <span class=\"citation\" data-id=\"9760032\"><a href=\"/opinion/2367165/commonwealth-v-zettlemoyer/\" aria-description=\"Citation for case: Commonwealth v. Zettlemoyer\">500 Pa. 16</a></span>, <span class=\"citation\" data-id=\"9760032\"><a href=\"/opinion/2367165/commonwealth-v-zettlemoyer/\" aria-description=\"Citation for case: Commonwealth v. Zettlemoyer\">454 A. 2d 937</a></span>; No. 82-6556, <span class=\"citation\" data-id=\"9632537\"><a href=\"/opinion/1449368/state-v-gretzler/\" aria-description=\"Citation for case: State v. Gretzler\">135 Ariz. 42</a></span>, <span class=\"citation\" data-id=\"9632537\"><a href=\"/opinion/1449368/state-v-gretzler/\" aria-description=\"Citation for case: State v. Gretzler\">659 P. 2d 1</a></span>.</p>\n</opinion>"},{"id":9038939,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b925-5\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AxzR\">dissenting.</p>\n<p id=\"AVSJ\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}