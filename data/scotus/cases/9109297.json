{"id":9109297,"docketId":66375570,"caseName":"Gray v. Thompson","caseNameFull":"Gray v. Thompson, Warden","slug":"gray-v-thompson","docketNumber":"No. 90-7733","dateFiled":"1991-05-28","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":41,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9103741,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":559,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b765-5\">Justice Marshall,</author>\n<p id=\"A7BN\">dissenting.</p>\n<p id=\"b765-6\">Adhering to r\u00f1y view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. Georgia, <span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}