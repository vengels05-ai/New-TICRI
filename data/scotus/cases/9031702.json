{"id":9031702,"docketId":66297924,"caseName":"Chaney v. Oklahoma","caseNameFull":"Chaney v. Oklahoma Anderson v. Nebraska Hochstein v. Nebraska McDowell v. North Carolina","slug":"chaney-v-oklahoma","docketNumber":"No. 80-947; No. 80-1204; No. 80-5862; No. 80-6127","dateFiled":"1981-03-23","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":88,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9024991,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1118,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AqLe\">Ct. Crim. App. Okla.;</p>\n<p id=\"AaxO\">Sup. Ct. Neb.;</p>\n<p id=\"AMKc\">Sup. Ct. Neb.; and</p>\n<p id=\"Autz\">Sup. Ct.</p>\n<p id=\"AUEr\">N. C. Certiorari denied. Reported below: No. 80-947, <span class=\"citation\" data-id=\"1270202\"><a href=\"/opinion/1270202/chaney-v-state/\" aria-description=\"Citation for case: Chaney v. State\">612 P. 2d 269</a></span>; Nos. 80-1204 and 80-5862, <span class=\"citation\" data-id=\"2163994\"><a href=\"/opinion/2163994/state-v-anderson/\" aria-description=\"Citation for case: State v. Anderson\">207 Neb. 51</a></span>, <span class=\"citation\" data-id=\"2163994\"><a href=\"/opinion/2163994/state-v-anderson/\" aria-description=\"Citation for case: State v. Anderson\">296 N. W. 2d 440</a></span>; No. 80-6127, <span class=\"citation\" data-id=\"1308648\"><a href=\"/opinion/1308648/state-v-mcdowell/\" aria-description=\"Citation for case: State v. McDowell\">301 N. C. 279</a></span>, <span class=\"citation\" data-id=\"1308648\"><a href=\"/opinion/1308648/state-v-mcdowell/\" aria-description=\"Citation for case: State v. McDowell\">271 S. E. 2d 286</a></span>.</p>\n</opinion>"},{"id":9024992,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":599,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1001-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Ajso\">dissenting.</p>\n<p id=\"b1001-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}