{"id":9038416,"docketId":66304642,"caseName":"Vanderbilt v. Texas","caseNameFull":"Vanderbilt v. Texas Christopher v. Florida","slug":"vanderbilt-v-texas","docketNumber":"No. 81-6158; No. 81-6172","dateFiled":"1982-03-29","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9031741,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":519,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"As-\">Ct. Crim. App. Tex.; and</p>\n<p id=\"AnDk\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 81-6158, <span class=\"citation\" data-id=\"2459138\"><a href=\"/opinion/2459138/vanderbilt-v-state/\" aria-description=\"Citation for case: Vanderbilt v. State\">629 S. W. 2d 709</a></span>; No. 81-6172, <span class=\"citation\" data-id=\"1106529\"><a href=\"/opinion/1106529/christopher-v-state/\" aria-description=\"Citation for case: Christopher v. State\">407 So. 2d 198</a></span>.</p>\n</opinion>"},{"id":9031742,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b954-11\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A5NJ\">dissenting.</p>\n<p id=\"A47\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}