{"id":2466402,"docketId":2549828,"caseName":"Lookretis v. United States","caseNameFull":"Lookretis v. United States","slug":"lookretis-v-united-states","docketNumber":"913","dateFiled":"1968-03-11","dateArgued":null,"dateCertGranted":null,"year":1968,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Maurice J. Walsh for petitioner., Solicitor General Griswold for the United States.","natureOfSuit":"","citationCount":13,"judges":"White","jurisdictionType":"","opinions":[{"id":2466402,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":743,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion type=\"majority\">\n<author id=\"b422-10\">\n  Per Curiam.\n </author>\n<p id=\"b422-11\">\n  The petition for a writ of certiorari is granted, the judgment is vacated, and the case is remanded for further consideration in the light of\n  <em>\n   Chapman\n  </em>\n  v.\n  <em>\n   California,\n  </em>\n  <span class=\"citation\" data-id=\"9423348\"><a href=\"/opinion/107359/chapman-v-california/\" aria-description=\"Citation for case: Chapman v. California\">386 U. S. 18</a></span>, and\n  <em>\n   Marchetti\n  </em>\n  v.\n  <em>\n   United States, ante,\n  </em>\n  p. 39.\n </p>\n<judges id=\"b422-12\">\n  Mr. Justice White is of the opinion that the petition for a writ of certiorari should be denied.\n </judges>\n</opinion>"}],"citations":[]}