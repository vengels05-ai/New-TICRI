{"id":8996196,"docketId":66262412,"caseName":"In re Disbarment of Stanton","caseNameFull":"In re Disbarment of Stanton","slug":"in-re-disbarment-of-stanton","docketNumber":"No. D-18","dateFiled":"1974-01-07","dateArgued":null,"dateCertGranted":null,"year":1974,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8988541,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":453,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A1Ft\">John J. Stanton, of Boston, Massachusetts, having requested <page-number citation-index=\"1\" label=\"1125\">*1125</page-number>to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause heretofore issued on November 12, 1973 <em>[ante, </em>p. 1020], is hereby discharged.</p>\n</opinion>"}],"citations":[]}