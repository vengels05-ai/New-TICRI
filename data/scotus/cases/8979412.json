{"id":8979412,"docketId":66245628,"caseName":"Higgins v. United States","caseNameFull":"HIGGINS v. UNITED STATES","slug":"higgins-v-united-states","docketNumber":"No. 1183","dateFiled":"1970-06-01","dateArgued":null,"dateCertGranted":null,"year":1970,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Consideration, Took","jurisdictionType":"","opinions":[{"id":8971227,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":665,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b335-16\">Per Curiam.</author>\n<p id=\"b335-17\">The motion for leave to proceed <em>in forma pauperis </em>and the petition for a writ of certiorari are granted. The judgment is vacated and the case is remanded to the Court of Appeals for further consideration in light of <em>Gutknecht </em>v. <em>United States, </em><span class=\"citation\" data-id=\"9424137\"><a href=\"/opinion/108025/gutknecht-v-united-states/\" aria-description=\"Citation for case: Gutknecht v. United States\">396 U. S. 295</a></span>.</p>\n<judges id=\"b335-18\">Mr. Justice Marshall took no part in the consideration or decision of this case.</judges>\n</opinion>"}],"citations":[]}