{"id":9016699,"docketId":66282916,"caseName":"King v. Texas","caseNameFull":"King v. Texas Freeman v. Texas Gaddis v. Georgia","slug":"king-v-texas","docketNumber":"No. 77-5687; No. 77-5715; No. 77-5921","dateFiled":"1978-02-21","dateArgued":null,"dateCertGranted":null,"year":1978,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9009784,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":882,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ATcr\">Ct. Crim. App. Tex.;</p>\n<p id=\"AebL\">Ct. Crim. App. Tex.; and</p>\n<p id=\"AsXV\">Sup. Ct. Ga. Certio-rari denied. Reported below: No. 77-5687, <span class=\"citation\" data-id=\"9777135\"><a href=\"/opinion/2458130/king-v-state/\" aria-description=\"Citation for case: King v. State\">553 S. W. 2d 105</a></span>; No. 77-5715, <span class=\"citation\" data-id=\"9684218\"><a href=\"/opinion/1794272/freeman-v-state/\" aria-description=\"Citation for case: Freeman v. State\">556 S. W. 2d 287</a></span>; No. 77-5921, <span class=\"citation\" data-id=\"1365383\"><a href=\"/opinion/1365383/gaddis-v-state/\" aria-description=\"Citation for case: Gaddis v. State\">239 Ga. 238</a></span>, <span class=\"citation\" data-id=\"1365383\"><a href=\"/opinion/1365383/gaddis-v-state/\" aria-description=\"Citation for case: Gaddis v. State\">236 S. E. 2d 594</a></span>.</p>\n</opinion>"},{"id":9009785,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":606,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1068-9\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"A724\">dissenting.</p>\n<p id=\"b1068-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}