{"id":9137287,"docketId":66403582,"caseName":"Gay v. California","caseNameFull":"Gay v. California","slug":"gay-v-california","docketNumber":"No. 93-6134","dateFiled":"1994-04-18","dateArgued":null,"dateCertGranted":null,"year":1994,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Blackmun","jurisdictionType":"","opinions":[{"id":9131920,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":167,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ArIU\">Sup. Ct. Cal. Motion of petitioner for leave to amend petition for writ of certiorari granted. Certiorari denied.</p>\n</opinion>"},{"id":9131921,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Blackmun","joinedBy":"","pageCount":null,"textLength":631,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"AION\">Justice Blackmun,</author>\n<p id=\"Aul7\">dissenting.</p>\n<p id=\"AaDU\">Adhering to my view that the death penalty cannot be imposed fairly within the constraints of our Constitution, see my dissent in <em>Callins </em>v. <em>Collins, </em><span class=\"citation\" data-id=\"9432964\"><a href=\"/opinion/117187/callins-v-collins-director-texas-department-of-criminal-justice/#1143\" aria-description=\"Citation for case: Callins v. Collins, Director, Texas Department of...\">510 U. S. 1141, 1143</a></span> (1994), I would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}