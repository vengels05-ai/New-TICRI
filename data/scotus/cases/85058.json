{"id":85058,"docketId":1117737,"caseName":"Gracie v. The Mary'd. Ins. Comp'y","caseNameFull":"","slug":"gracie-v-the-maryd-ins-compy","docketNumber":"","dateFiled":"1814-02-25","dateArgued":null,"dateCertGranted":null,"year":1814,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"","jurisdictionType":"","opinions":[{"id":85058,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2387,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./12/84/\">12 U.S. 84</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"1390946\"><a href=\"/opinion/1390946/richards-v-maryland-insurance-co/\" aria-description=\"Citation for case: Richards v. Maryland Insurance Co.\">8 Cranch 84</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">3 L.Ed. 495</span></p>\n    <p class=\"parties\">GRACIE<br>v.<br>THE MARY'D. INS. COMP'Y.</p>\n    <p class=\"date\">Feb. Term, 1814</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p>This case differs from that against the Marine Insurance</p>\n    </div>\n    <p class=\"center\">Company of Baltimore<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a> only in one particular. A part of the cargo</p>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p>remained on board the ship until the arrival of the French troops</p>\n    </div>\n    <div class=\"num\" id=\"p3\">\n      <span class=\"num\">3</span>\n      <p>when the departure of the vessel was prohibited by the general and</p>\n    </div>\n    <div class=\"num\" id=\"p4\">\n      <span class=\"num\">4</span>\n      <p>the ransom made.</p>\n    </div>\n    <div class=\"num\" id=\"p5\">\n      <span class=\"num\">5</span>\n      <p>This circumstance does not, in the opinion of the Court, vary</p>\n    </div>\n    <div class=\"num\" id=\"p6\">\n      <span class=\"num\">6</span>\n      <p>the case; because, omitting all other considerations, the loss, within the risk, being on only a part of the cargo, is a partial loss, and is affected by the warranty against particular average loss.</p>\n    </div>\n    <div class=\"num\" id=\"p7\">\n      <span class=\"num\">7</span>\n      <p class=\"indent\"><i>This judgment is also to be affirmed with costs</i>.</p>\n    </div>\n    <div class=\"footnotes\">\n      <div class=\"footnote\" id=\"fn-s\">\n        <a class=\"footnote\" href=\"#fn-s_ref\">*</a>\n        <p> See <span class=\"citation\" data-id=\"85057\"><a href=\"/opinion/85057/gracie-v-marine-ins-co-of-baltimore/\" aria-description=\"Citation for case: Gracie v. Marine Ins. Co. of Baltimore\">12 U.S. 75</a></span>, <span class=\"citation\" data-id=\"85057\"><a href=\"/opinion/85057/gracie-v-marine-ins-co-of-baltimore/\" aria-description=\"Citation for case: Gracie v. Marine Ins. Co. of Baltimore\">8 Cranch 75</a></span>.</p>\n      </div>\n    </div>\n    "}],"citations":[]}