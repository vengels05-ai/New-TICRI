{"id":9020130,"docketId":66286347,"caseName":"Jones v. Texas","caseNameFull":"Jones v. Texas Raulerson v. Florida","slug":"jones-v-texas","docketNumber":"No. 78-5250; No. 78-5311","dateFiled":"1978-11-06","dateArgued":null,"dateCertGranted":null,"year":1978,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9013331,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":507,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A_TU\">Ct. Crim. App. Tex.; and</p>\n<p id=\"APaH\">Sup. Ct. Fla. Cer-tiorari denied. Reported below: No. 78-5250, <span class=\"citation\" data-id=\"1787993\"><a href=\"/opinion/1787993/jones-v-state/\" aria-description=\"Citation for case: Jones v. State\">568 S. W. 2d 847</a></span>; No. 78-5311, <span class=\"citation\" data-id=\"1713312\"><a href=\"/opinion/1713312/raulerson-v-state/\" aria-description=\"Citation for case: Raulerson v. State\">358 So. 2d 826</a></span>.</p>\n</opinion>"},{"id":9013332,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":605,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b903-11\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"AhT3\">dissenting.</p>\n<p id=\"b903-12\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}