{"id":9138020,"docketId":66404315,"caseName":"Williamson v. Oklahoma","caseNameFull":"Williamson v. Oklahoma Beltran-Lopez v. Florida Towns v. Illinois Arbelaez v. Florida Sam v. Pennsylvania","slug":"williamson-v-oklahoma","docketNumber":"No. 93-5893; No. 93-7957; No. 93-8089; No. 93-8229; No. 93-8376","dateFiled":"1994-05-23","dateArgued":null,"dateCertGranted":null,"year":1994,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":19,"judges":"Blackmun","jurisdictionType":"","opinions":[{"id":9132671,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":224,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AXDr\">Ct. Crim. App. Okla.;</p>\n<p id=\"ACYK\">Sup. Ct. Fla.;</p>\n<p id=\"AFvu\">Sup. Ct. 111.;</p>\n<p id=\"AuIk\">Sup. Ct. Fla.; and</p>\n<p id=\"Agj7\">Sup. Ct. Pa. Certiorari denied.</p>\n</opinion>"},{"id":9132672,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Blackmun","joinedBy":"","pageCount":null,"textLength":642,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1075-14\">Justice Blackmun,</author>\n<p id=\"AURt\">dissenting.</p>\n<p id=\"b1075-15\">Adhering to my view that the death penalty cannot be imposed fairly within the constraints of our Constitution, see my dissent in <em>Callins </em>v. <em>Collins, </em><span class=\"citation\" data-id=\"9432964\"><a href=\"/opinion/117187/callins-v-collins-director-texas-department-of-criminal-justice/#1143\" aria-description=\"Citation for case: Callins v. Collins, Director, Texas Department of...\">510 U. S. 1141, 1143</a></span> (1994), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}