{"id":9065878,"docketId":66332129,"caseName":"Bell v. Texas","caseNameFull":"Bell v. Texas Carter v. Tennessee Boyd v. Indiana","slug":"bell-v-texas","docketNumber":"No. 86-5420; No. 86-5614; No. 86-5844","dateFiled":"1987-01-12","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":4,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9059536,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":648,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"APbH\">Ct. Crim. App. Tex.;</p>\n<p id=\"A6YM\">Sup. Ct. Tenn.; and</p>\n<p id=\"APy1\">Sup. Ct. Ind. Certiorari denied. Reported below: No. 86-5420, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20W.%202d/707/52/\">707 S. W. 2d 52</a></span>; No. 86-5614, <span class=\"citation\" data-id=\"9676993\"><a href=\"/opinion/1748185/state-v-carter/\" aria-description=\"Citation for case: State v. Carter\">714 S. W. 2d 241</a></span>; No. 86-5844, <span class=\"citation\" data-id=\"2033069\"><a href=\"/opinion/2033069/boyd-v-state/\" aria-description=\"Citation for case: Boyd v. State\">494 N. E. 2d 284</a></span>.</p>\n</opinion>"},{"id":9059537,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b984-12\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A6HW\">dissenting.</p>\n<p id=\"b984-13\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}