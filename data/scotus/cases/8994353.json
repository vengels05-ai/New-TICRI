{"id":8994353,"docketId":66260569,"caseName":"Lee v. United States","caseNameFull":"Lee v. United States","slug":"lee-v-united-states","docketNumber":"No. 72-6690","dateFiled":"1973-10-09","dateArgued":null,"dateCertGranted":null,"year":1973,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8986674,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":959,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A4f\">C. A. 5th Cir. Motion for leave to proceed <em>in forma pauperis </em>and certio<page-number citation-index=\"1\" label=\"808\">*808</page-number>rari granted. Judgment vacated and case remanded to the United States District Court for the Southern District of Florida with directions to dismiss the indictment. The Chief Justice and Mr. Justice Blackmun dissent for the reasons stated in the dissenting opinion of Mr. Justice Blackmun in <em>Durham </em>v. <em>United States, </em><span class=\"citation\" data-id=\"9424482\"><a href=\"/opinion/108288/durham-v-united-states/#483\" aria-description=\"Citation for case: Durham v. United States\">401 U. S. 481, 483</a></span> (1971). See <em>Bradley </em>v. <em>United States, </em><span class=\"citation\" data-id=\"108441\"><a href=\"/opinion/108441/bradley-v-united-states/\" aria-description=\"Citation for case: Bradley v. United States\">404 U. S. 567</a></span> (1972).</p>\n</opinion>"}],"citations":[]}