{"id":9060053,"docketId":66326304,"caseName":"Andrade v. Texas","caseNameFull":"Andrade v. Texas Wise v. Virginia","slug":"andrade-v-texas","docketNumber":"No. 85-6376; No. 85-6439","dateFiled":"1986-04-07","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":53,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9053629,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":687,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AqiN\">Ct. Crim. App. Tex.; and</p>\n<p id=\"AvGx\">Sup. Ct. Va. Certiorari denied. Reported below: No. 85-6376, <span class=\"citation\" data-id=\"9769681\"><a href=\"/opinion/2419290/andrade-v-state/\" aria-description=\"Citation for case: Andrade v. State\">700 S. W. 2d 585</a></span>; No. 85-6439, <span class=\"citation\" data-id=\"1256269\"><a href=\"/opinion/1256269/wise-v-commonwealth/\" aria-description=\"Citation for case: Wise v. Commonwealth\">230 Va. 322</a></span>, <span class=\"citation\" data-id=\"1256269\"><a href=\"/opinion/1256269/wise-v-commonwealth/\" aria-description=\"Citation for case: Wise v. Commonwealth\">337 S. E. 2d 715</a></span>.</p>\n</opinion>"},{"id":9053630,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1086-6\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AVP\">dissenting.</p>\n<p id=\"AzjFr\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}