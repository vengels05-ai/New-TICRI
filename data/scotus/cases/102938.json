{"id":102938,"docketId":2056281,"caseName":"Georgia M. Spruill v. William T. Ballard","caseNameFull":"","slug":"georgia-m-spruill-v-william-t-ballard","docketNumber":"652","dateFiled":"1938-01-10","dateArgued":null,"dateCertGranted":null,"year":1938,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":102938,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1810,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./302/764/\">302 U.S. 764</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./58/477/\">58 S.Ct. 477</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"8153200\"><a href=\"/opinion/8191268/blevins-v-bank-of-america-national-trust-savings-assn/\" aria-description=\"Citation for case: Blevins v. Bank of America National Trust &amp; Savings Ass&#x27;n\">82 L.Ed. 594</a></span></p>\n    <p class=\"parties\">Georgia M. SPRUILL, petitioner,<br>v.<br>William T. BALLARD et al.</p>\n    <p class=\"docket\">No. 652.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">January 10, 1938</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">Miss Georgia M. Spruill, pro se.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">On petition for writ of certiorari to the United States Circuit Court of Appeals for the District of Columbia.</p>\n    </div>\n    <div class=\"num\" id=\"p3\">\n      <span class=\"num\">3</span>\n      <p class=\"indent\">The motion for leave to proceed further herein in forma pauperis is denied for the reason that the Court, upon examination of the papers herein submitted, finds no ground upon which writ of certiorari should be issued. The petition for writ of certiorari is therefore also denied.</p>\n    </div>\n    <div class=\"num\" id=\"p4\">\n      <span class=\"num\">4</span>\n      <p class=\"indent\">Rehearing denied <span class=\"citation multiple-matches\"><a href=\"/c/U.S./303/666/\">303 U.S. 666</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./58/526/\">58 S.Ct. 526</a></span>, 82 L.Ed. &#8212;&#8212;.</p>\n    </div>\n    "}],"citations":[]}