{"id":9001768,"docketId":66267984,"caseName":"In re Disbarment of Ketcham","caseNameFull":"In re Disbarment of Ketcham","slug":"in-re-disbarment-of-ketcham","docketNumber":"No. D-26","dateFiled":"1975-02-18","dateArgued":null,"dateCertGranted":null,"year":1975,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8994332,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":453,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ap0\">Frank S. Ketcham, of Potomac, Md., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause heretofore issued on January 13, 1975 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./419/1101/\">419 U. S. 1101</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}