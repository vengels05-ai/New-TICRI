{"id":9106624,"docketId":66372897,"caseName":"Gordon v. California","caseNameFull":"Gordon v. California Clozza v. Murray, Director, Virginia Department of Corrections Wainwright v. Arkansas","slug":"gordon-v-california","docketNumber":"No. 90-6383; No. 90-6540; No. 90-6628","dateFiled":"1991-03-04","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9101035,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1147,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AQG\">Sup. Ct. Cal.;</p>\n<p id=\"A7JA\">C. A. 4th Cir.; and</p>\n<p id=\"A3Bu\">Sup. Ct. Ark. Certiorari denied. Reported below: No. 90-6383, <span class=\"citation\" data-id=\"9627509\"><a href=\"/opinion/1427406/people-v-gordon/\" aria-description=\"Citation for case: People v. Gordon\">50 Cal. 3d 1223</a></span>, <span class=\"citation\" data-id=\"9627509\"><a href=\"/opinion/1427406/people-v-gordon/\" aria-description=\"Citation for case: People v. Gordon\">792 P. 2d 251</a></span>; No. 90-6540, <span class=\"citation\" data-id=\"547613\"><a href=\"/opinion/547613/albert-j-clozza-v-edward-w-murray-director-virginia-department-of/\" aria-description=\"Citation for case: Albert J. Clozza v. Edward W. Murray, Director, Virginia...\">913 F. 2d 1092</a></span>; No. 90-6628, <span class=\"citation\" data-id=\"1577469\"><a href=\"/opinion/1577469/wainwright-v-state/\" aria-description=\"Citation for case: Wainwright v. State\">302 Ark. 371</a></span>, <span class=\"citation\" data-id=\"1577469\"><a href=\"/opinion/1577469/wainwright-v-state/\" aria-description=\"Citation for case: Wainwright v. State\">790 S. W. 2d 420</a></span>.</p>\n</opinion>"},{"id":9101036,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":568,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b733-9\">Justice Marshall,</author>\n<p id=\"AXZ6\">dissenting.</p>\n<p id=\"b733-10\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}