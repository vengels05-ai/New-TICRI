{"id":9065016,"docketId":66331267,"caseName":"Peek v. Kemp","caseNameFull":"Peek v. Kemp, Warden","slug":"peek-v-kemp","docketNumber":"No. 85-7111","dateFiled":"1986-11-03","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Brennan, Certiorari, Marshall, Set","jurisdictionType":"","opinions":[{"id":9058653,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":187,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AcqB\">C. A. 11th Cir. Certiorari denied.</p>\n<judges id=\"AFJ0\">Justice Blackmun would grant certiorari and set case for oral argument.</judges>\n</opinion>"},{"id":9058654,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":592,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b877-6\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AOyz\">dissenting.</p>\n<p id=\"b877-7\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}