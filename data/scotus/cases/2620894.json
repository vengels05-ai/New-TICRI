{"id":2620894,"docketId":31179,"caseName":"Fontaine v. California","caseNameFull":"Fontaine v. California","slug":"fontaine-v-california","docketNumber":"50, Misc","dateFiled":"1967-03-13","dateArgued":null,"dateCertGranted":null,"year":1967,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":"<p>Mise.</p>","headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Stewart","jurisdictionType":"","opinions":[{"id":2620894,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":725,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b341-16\">\n  Per Curiam.\n </author>\n<p id=\"b341-17\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are granted. The judgment is vacated and the case remanded for further consideration in light of\n  <em>\n   Chapman\n  </em>\n  v.\n  <em>\n   California, ante,\n  </em>\n  p. 18.\n </p>\n<judges id=\"b341-19\">\n  Mr. Justice Stewart would grant certiorari and reverse the judgment for the reasons stated in his opinion concurring in the result in\n  <em>\n   Chapman\n  </em>\n  v.\n  <em>\n   California, ante, at\n  </em>\n  42..\n </judges>\n</opinion>"}],"citations":[]}