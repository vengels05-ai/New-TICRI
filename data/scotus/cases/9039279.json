{"id":9039279,"docketId":66305505,"caseName":"Lewis v. Illinois","caseNameFull":"Lewis v. Illinois Mikenas v. Florida","slug":"lewis-v-illinois","docketNumber":"No. 81-1776; No. 81-6419","dateFiled":"1982-06-01","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":5,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9032613,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":664,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AEhU\">Sup. Ct. Ill.; and</p>\n<p id=\"ABph\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 81-1776, <span class=\"citation\" data-id=\"9521678\"><a href=\"/opinion/2025114/people-v-lewis/\" aria-description=\"Citation for case: People v. Lewis\">88 Ill. 2d 129</a></span>, <span class=\"citation\" data-id=\"9521678\"><a href=\"/opinion/2025114/people-v-lewis/\" aria-description=\"Citation for case: People v. Lewis\">430 N. E. 2d 1346</a></span>; No. 81-6419, <span class=\"citation\" data-id=\"1106716\"><a href=\"/opinion/1106716/mikenas-v-state/\" aria-description=\"Citation for case: Mikenas v. State\">407 So. 2d 892</a></span>.</p>\n</opinion>"},{"id":9032614,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":599,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1055-13\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AmU2\">dissenting.</p>\n<p id=\"b1055-14\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}