{"id":9091648,"docketId":66357910,"caseName":"In re Disbarment of McManus","caseNameFull":"In re Disbarment of McManus","slug":"in-re-disbarment-of-mcmanus","docketNumber":"No. D-804","dateFiled":"1989-10-16","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9085832,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":460,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A-Of\">George W. McManus, Jr., of Baltimore, Md., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on August 11, 1989 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./492/932/\">492 U. S. 932</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}