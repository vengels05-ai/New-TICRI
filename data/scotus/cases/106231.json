{"id":106231,"docketId":415916,"caseName":"Anderson v. Alabama","caseNameFull":"","slug":"anderson-v-alabama","docketNumber":"326","dateFiled":"1961-05-01","dateArgued":null,"dateCertGranted":null,"year":1961,"scdbId":"1960-088","direction":"Liberal","votesMajority":9,"votesMinority":0,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":106231,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":1489,"isHtml":true,"text":"<div>\n<center><b><span class=\"citation\" data-id=\"8940665\"><a href=\"/opinion/8949927/anderson-v-alabama/\" aria-description=\"Citation for case: Anderson v. Alabama\">366 U.S. 208</a></span> (1961)</b></center>\n<center><h1>ANDERSON<br>\nv.<br>\nALABAMA.</h1></center>\n<center>No. 326.</center>\n<center><p><b>Supreme Court of United States.</b></p></center>\n<center>Argued April 25-26, 1961.</center>\n<center>Decided May 1, 1961.</center>\nCERTIORARI TO THE COURT OF APPEALS OF ALABAMA.\n<p><i>Jack Greenberg</i> argued the cause for petitioner. With him on the briefs were <i>Peter A. Hall, Fred D. Gray, Orzell Billingsley</i> and <i>Thurgood Marshall.</i></p>\n<p><i>David W. Clark,</i> Assistant Attorney General of Alabama, argued the cause for respondent. With him on the briefs was <i>MacDonald Gallion,</i> Attorney General.</p>\n<p>PER CURIAM.</p>\n<p>The judgment is reversed. <i>Pierre</i> v. <i>Louisiana,</i> <span class=\"citation\" data-id=\"103162\"><a href=\"/opinion/103162/pierre-v-louisiana/\" aria-description=\"Citation for case: Pierre v. Louisiana\">306 U. S. 354</a></span>; <i>Cassell</i> v. <i>Texas,</i> <span class=\"citation\" data-id=\"9420469\"><a href=\"/opinion/104785/cassell-v-texas/\" aria-description=\"Citation for case: Cassell v. Texas\">339 U. S. 282</a></span>; <i>Hernandez</i> v. <i>Texas,</i> <span class=\"citation\" data-id=\"105220\"><a href=\"/opinion/105220/hernandez-v-texas/\" aria-description=\"Citation for case: Hernandez v. Texas\">347 U. S. 475</a></span>.</p>\n</div>"}],"citations":[]}