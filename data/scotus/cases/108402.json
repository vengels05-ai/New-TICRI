{"id":108402,"docketId":353460,"caseName":"Camp v. Arkansas","caseNameFull":"Camp v. Arkansas","slug":"camp-v-arkansas","docketNumber":"70-353","dateFiled":"1971-11-16","dateArgued":null,"dateCertGranted":null,"year":1971,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":23,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":108402,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":1024,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion type=\"majority\">\n<author id=\"b209-8\">\n  Per Curiam.\n </author>\n<p id=\"b209-9\">\n  The petition for writ of certiorari is granted. Petitioner\u2019s alleged procedural default does not bar consideration of his constitutional claim in the circumstances of this case. See\n  <em>\n   Henry\n  </em>\n  v.\n  <em>\n   Mississippi,\n  </em>\n  <span class=\"citation\" data-id=\"9422929\"><a href=\"/opinion/106962/henry-v-mississippi/#447\" aria-description=\"Citation for case: Henry v. Mississippi\">379 U. S. 443, 447-449</a></span> (1965). The judgment of the Supreme Court of Arkansas is reversed.\n  <em>\n   Griffin\n  </em>\n  v.\n  <em>\n   California,\n  </em>\n  <span class=\"citation\" data-id=\"6751630\"><a href=\"/opinion/6862140/griffin-v-california/\" aria-description=\"Citation for case: Griffin v. California\">380 U. S. 609</a></span> (1965). The case is remanded for further proceedings not inconsistent with this opinion.\n </p>\n<p id=\"b209-10\">\n<em>\n   It is so ordered.\n  </em>\n</p>\n</opinion>"}],"citations":[]}