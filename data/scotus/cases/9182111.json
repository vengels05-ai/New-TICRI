{"id":9182111,"docketId":66448421,"caseName":"In re Disbarment of Sadler","caseNameFull":"In re Disbarment of Sadler","slug":"in-re-disbarment-of-sadler","docketNumber":"No. D-1934","dateFiled":"1999-01-19","dateArgued":null,"dateCertGranted":null,"year":1999,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9176842,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":435,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A5sx\">Gerald A. Sadler, of Houston, Tex., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on April 20,1998 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./528/1069/\">528 U. S. 1069</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}