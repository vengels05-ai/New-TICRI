{"id":9029250,"docketId":66295471,"caseName":"Hulsey v. Arkansas","caseNameFull":"Hulsey v. Arkansas Dampier v. Georgia Mata v. Arizona","slug":"hulsey-v-arkansas","docketNumber":"No. 80-5204; No. 80-5215; No. 80-5228","dateFiled":"1980-10-20","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9022522,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1326,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AKEU\">Sup. Ct. Ark.;</p>\n<p id=\"A7ln\">Sup. Ct. Ga.; and</p>\n<p id=\"Aqk3\">Sup. Ct. Ariz. Certiorari denied. Reported below: No. 80-5204, <span class=\"citation\" data-id=\"7821026\"><a href=\"/opinion/7875613/hulsey-v-state/\" aria-description=\"Citation for case: Hulsey v. State\">268 Ark. 312</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20W.%202d/595/934/\">595 S. W. 2d 934</a></span>; No. 80-5215, <span class=\"citation\" data-id=\"1246229\"><a href=\"/opinion/1246229/patrick-v-state/\" aria-description=\"Citation for case: Patrick v. State\">245 Ga. 426</a></span>, <span class=\"citation\" data-id=\"1246615\"><a href=\"/opinion/1246615/dampier-v-state/\" aria-description=\"Citation for case: Dampier v. State\">265 S. E. 2d 565</a></span>, and <span class=\"citation multiple-matches\"><a href=\"/c/Ga./245/882/\">245 Ga. 882</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20E.%202d/268/349/\">268 S. E. 2d 349</a></span>; No. 80-5228, <span class=\"citation\" data-id=\"1430698\"><a href=\"/opinion/1430698/state-v-mata/\" aria-description=\"Citation for case: State v. Mata\">125 Ariz. 233</a></span>, <span class=\"citation\" data-id=\"1430698\"><a href=\"/opinion/1430698/state-v-mata/\" aria-description=\"Citation for case: State v. Mata\">609 P. 2d 48</a></span>.</p>\n</opinion>"},{"id":9022523,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":596,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b952-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AAt0\">dissenting.</p>\n<p id=\"b952-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}