{"id":9056412,"docketId":66322661,"caseName":"Poyner v. Virginia","caseNameFull":"Poyner v. Virginia","slug":"poyner-v-virginia","docketNumber":"No. 85-5102","dateFiled":"1985-10-07","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Certiorari, Marshall","jurisdictionType":"","opinions":[{"id":9049938,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":152,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A4OQ\">Sup. Ct. Va. Certiorari denied.</p>\n<judges id=\"A6ql\">Justice Brennan would grant certiorari.</judges>\n</opinion>"},{"id":9049939,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":565,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b754-9\">Justice Marshall,</author>\n<p id=\"AJJg\">dissenting.</p>\n<p id=\"b754-10\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}