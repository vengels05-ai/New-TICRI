{"id":9102390,"docketId":66368662,"caseName":"McKenna v. Nevada","caseNameFull":"McKenna v. Nevada Bennett v. Nevada Porter v. Pennsylvania Herrera v. Collins, Director, Texas Department of Criminal Justice","slug":"mckenna-v-nevada","docketNumber":"No. 89-7634; No. 90-5047; No. 90-5101; No. 90-5403","dateFiled":"1990-10-15","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9096746,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1310,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AFpZ\">Sup. Ct. Nev.;</p>\n<p id=\"ADjX\">Sup. Ct. Nev.;</p>\n<p id=\"ARFH\">Sup. Ct. Pa.; and</p>\n<p id=\"AXrn\">C. A. 5th Cir. Certiorari denied. Reported below: No. 89-7634, <span class=\"citation no-link\">106 Nev. 1032</span>; No. 90-5047, <page-number citation-index=\"1\" label=\"926\">*926</page-number><span class=\"citation\" data-id=\"1443420\"><a href=\"/opinion/1443420/bennett-v-state/\" aria-description=\"Citation for case: Bennett v. State\">106 Nev. 135</a></span>, <span class=\"citation\" data-id=\"1443420\"><a href=\"/opinion/1443420/bennett-v-state/\" aria-description=\"Citation for case: Bennett v. State\">787 P. 2d 797</a></span>; No. 90-5101, <span class=\"citation\" data-id=\"1982079\"><a href=\"/opinion/1982079/commonwealth-v-porter/\" aria-description=\"Citation for case: Commonwealth v. Porter\">524 Pa. 162</a></span>, <span class=\"citation\" data-id=\"1982079\"><a href=\"/opinion/1982079/commonwealth-v-porter/\" aria-description=\"Citation for case: Commonwealth v. Porter\">569 A. 2d 942</a></span>; No. 90-5403, <span class=\"citation\" data-id=\"542872\"><a href=\"/opinion/542872/leonel-torres-herrera-v-james-a-collins-director-texas-department-of/\" aria-description=\"Citation for case: Leonel Torres Herrera v. James A. Collins, Director,...\">904 F. 2d 944</a></span>.</p>\n</opinion>"},{"id":9096747,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":567,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b892-5\">Justice Marshall,</author>\n<p id=\"AK4V\">dissenting.</p>\n<p id=\"b892-6\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}