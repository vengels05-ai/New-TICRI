{"id":9139029,"docketId":66405324,"caseName":"In re Disbarment of Becker","caseNameFull":"In re Disbarment of Becker","slug":"in-re-disbarment-of-becker","docketNumber":"No. D-1269","dateFiled":"1993-10-04","dateArgued":null,"dateCertGranted":null,"year":1993,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9133705,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AMC\">Virgil Victor Becker, of Atascadero, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on May 24, 1993 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./508/936/\">508 U. S. 936</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}