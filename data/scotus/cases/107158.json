{"id":107158,"docketId":2392048,"caseName":"Annie E. Harper v. Virginia State Board of Elections","caseNameFull":"","slug":"annie-e-harper-v-virginia-state-board-of-elections","docketNumber":"48","dateFiled":"1965-12-13","dateArgued":null,"dateCertGranted":null,"year":1965,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":107158,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1080,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./382/951/\">382 U.S. 951</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"8954117\"><a href=\"/opinion/8962886/ginzburg-v-united-states/\" aria-description=\"Citation for case: Ginzburg v. United States\">86 S.Ct. 425</a></span></p>\n    <p class=\"parties\">Annie E. HARPER et al., appellants,<br>v.<br>VIRGINIA STATE BOARD OF ELECTIONS et al.</p>\n    <p class=\"docket\">No. 48.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">December 13, 1965</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">Solicitor General Marshall, for movant.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">The motion of the Solicitor General for leave to participate in the oral argument, as <i>amicus curiae</i>, is granted and thirty minutes are allotted for that purpose. Counsel for the appellees are allotted an additional thirty minutes for oral argument.</p>\n    </div>\n    "}],"citations":[]}