{"id":9091841,"docketId":66358103,"caseName":"Hulsey v. Sargent","caseNameFull":"Hulsey v. Sargent, Warden Banda v. Texas Clark v. New Mexico Magwood v. Alabama Rogers v. Kemp, Warden","slug":"hulsey-v-sargent","docketNumber":"No. 89-48; No. 89-5068; No. 89-5117; No. 89-5397; No. 89-5421","dateFiled":"1989-10-16","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9086025,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":992,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Aqam\">C. A. 8th Cir.;</p>\n<p id=\"ADS3\">Ct. Crim. App. Tex.;</p>\n<p id=\"AbBL\">Sup. Ct. N. M.;</p>\n<p id=\"AD_U\">Sup. Ct. Ala.; and</p>\n<p id=\"A4iE\">Sup. Ct. Ga. Certiorari denied. Reported below: No. 89-48, <span class=\"citation\" data-id=\"516987\"><a href=\"/opinion/516987/dewayne-hulsey-v-willis-sargent-superintendent-cummins-unit-arkansas/\" aria-description=\"Citation for case: Dewayne Hulsey v. Willis Sargent, Superintendent, Cummins...\">865 F. 2d 954</a></span>; No. 89-5068, <span class=\"citation\" data-id=\"9682864\"><a href=\"/opinion/1784583/banda-v-state/\" aria-description=\"Citation for case: Banda v. State\">768 S. W. 2d 294</a></span>; No. 89-5117, 108 N. M. 288, <span class=\"citation\" data-id=\"9624824\"><a href=\"/opinion/1414258/state-v-clark/\" aria-description=\"Citation for case: State v. Clark\">772 P. 2d 322</a></span>; No. 89-5397, <span class=\"citation multiple-matches\"><a href=\"/c/So.%202d/548/516/\">548 So. 2d 516</a></span>.</p>\n</opinion>"},{"id":9086026,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b861-16\">Justice Brennan and Justice Marshall,</author>\n<p id=\"ALmh\">dissenting.</p>\n<p id=\"b861-17\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}