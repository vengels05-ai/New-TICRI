{"id":107213,"docketId":2539536,"caseName":"Hollingshead v. Wainwright","caseNameFull":"Hollingshead v. Wainwright, Corrections Director","slug":"hollingshead-v-wainwright","docketNumber":"457, Misc","dateFiled":"1966-04-18","dateArgued":null,"dateCertGranted":null,"year":1966,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., Earl Faircloth, Attorney General of Florida, and James G. Mahorner, Assistant Attorney General, for respondent.","natureOfSuit":"","citationCount":8,"judges":"Harlan, Stewart","jurisdictionType":"","opinions":[{"id":107213,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":741,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"6\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b129-11\">\n  Per Curiam.\n </author>\n<p id=\"b129-12\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are granted. The judgment is reversed.\n  <em>\n   Douglas\n  </em>\n  v.\n  <em>\n   California,\n  </em>\n  <span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U. S. 353</a></span>.\n </p>\n<judges id=\"b129-13\">\n  Mr. Justice Harlan and Mr. Justice Stewart are of the opinion that the petition for a writ of certiorari should be denied.\n </judges>\n</opinion>"}],"citations":[]}