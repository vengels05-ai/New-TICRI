{"id":9098682,"docketId":66364951,"caseName":"Bittaker v. California","caseNameFull":"Bittaker v. California Ruiz v. Illinois Blackmon v. Texas Coleman v. Oklahoma Elmore v. South Carolina McCollum v. Indiana","slug":"bittaker-v-california","docketNumber":"No. 89-6223; No. 89-6886; No. 89-7056; No. 89-7201; No. 89-7253; No. 89-7275","dateFiled":"1990-06-11","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9092985,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1421,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AI09\">Sup. Ct. Cal;</p>\n<p id=\"AfZl\">Sup. Ct. Ill.;</p>\n<p id=\"A6n4\">Ct. Crim. App. Tex.;</p>\n<p id=\"AQY\">Ct. Crim. App. Okla.;</p>\n<p id=\"AGn\">Sup. Ct. S. C.; and</p>\n<p id=\"A3ic\">Sup. Ct. Ind. Certiorari denied. Reported below: No. 89-6223, <span class=\"citation\" data-id=\"1179588\"><a href=\"/opinion/1179588/people-v-bittaker/\" aria-description=\"Citation for case: People v. Bittaker\">48 Cal. 3d 1046</a></span>, <span class=\"citation\" data-id=\"1179588\"><a href=\"/opinion/1179588/people-v-bittaker/\" aria-description=\"Citation for case: People v. Bittaker\">774 P. 2d 659</a></span>; No. 89-6886, <span class=\"citation\" data-id=\"2119553\"><a href=\"/opinion/2119553/people-v-ruiz/\" aria-description=\"Citation for case: People v. Ruiz\">132 Ill. 2d 1</a></span>, <span class=\"citation\" data-id=\"2119553\"><a href=\"/opinion/2119553/people-v-ruiz/\" aria-description=\"Citation for case: People v. Ruiz\">547 N. E. 2d 170</a></span>; No. 89-7056, <span class=\"citation no-link\">775 S. W. 2d 649</span>; No. 89-7253, 300 S. C. 130, <span class=\"citation\" data-id=\"9614790\"><a href=\"/opinion/1388002/state-v-elmore/\" aria-description=\"Citation for case: State v. Elmore\">386 S. E. 2d 769</a></span>; No. 89-7275, <span class=\"citation\" data-id=\"2132098\"><a href=\"/opinion/2132098/townsend-v-state/\" aria-description=\"Citation for case: Townsend v. State\">533 N. E. 2d 1215</a></span>.</p>\n</opinion>"},{"id":9092986,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b759-13\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AjkG\">dissenting.</p>\n<p id=\"b759-14\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}