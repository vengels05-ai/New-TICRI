{"id":9349730,"docketId":66663101,"caseName":"Harper v. Nebraska","caseNameFull":"Harper v. Nebraska Jackson v. Florida Harding v. Arizona Michael v. Florida","slug":"harper-v-nebraska","docketNumber":"No. 83-5815; No. 83-5840; No. 83-5912; No. 83-5945","dateFiled":"1984-01-23","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9345189,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1248,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ao_n\">Sup. Ct. Neb.;</p>\n<p id=\"AXg\">Sup. Ct. Fla.;</p>\n<p id=\"ACf\">Sup. Ct. Ariz.; and</p>\n<p id=\"AS-\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 83-5815, <span class=\"citation\" data-id=\"2034259\"><a href=\"/opinion/2034259/state-v-harper/\" aria-description=\"Citation for case: State v. Harper\">214 Neb. 911</a></span>, <span class=\"citation\" data-id=\"2034259\"><a href=\"/opinion/2034259/state-v-harper/\" aria-description=\"Citation for case: State v. Harper\">336 N. W. 2d 597</a></span>; No. 83-5840, <span class=\"citation\" data-id=\"7528014\"><a href=\"/opinion/7598288/jackson-v-state/\" aria-description=\"Citation for case: Jackson v. State\">437 So. 2d 147</a></span>; No. 83-5912, <span class=\"citation\" data-id=\"9789933\"><a href=\"/opinion/2604831/state-v-harding/\" aria-description=\"Citation for case: State v. Harding\">137 Ariz. 278</a></span>, <span class=\"citation\" data-id=\"9789933\"><a href=\"/opinion/2604831/state-v-harding/\" aria-description=\"Citation for case: State v. Harding\">670 P. 2d 383</a></span>; No. 83-5945, <span class=\"citation\" data-id=\"1669058\"><a href=\"/opinion/1669058/michael-v-state/\" aria-description=\"Citation for case: Michael v. State\">437 So. 2d 138</a></span>.</p>\n</opinion>"},{"id":9345190,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b989-14\">Justice Brennan and Justice Marshall,</author>\n<p id=\"ArWs\">dissenting.</p>\n<p id=\"b989-15\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}