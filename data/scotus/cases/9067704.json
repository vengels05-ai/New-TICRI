{"id":9067704,"docketId":66333955,"caseName":"In re Disbarment of Lopez","caseNameFull":"In re Disbarment of Lopez","slug":"in-re-disbarment-of-lopez","docketNumber":"No. D-610","dateFiled":"1987-04-20","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9061393,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":455,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A32\">Vincent Cabrera Lopez, of Chicago, Ill., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on March 2, 1987 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./480/902/\">480 U. S. 902</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}