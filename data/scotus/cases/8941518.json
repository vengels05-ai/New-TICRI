{"id":8941518,"docketId":66207731,"caseName":"Morgan v. Ohio","caseNameFull":"Morgan v. Ohio","slug":"morgan-v-ohio","docketNumber":"No. 206","dateFiled":"1957-06-24","dateArgued":null,"dateCertGranted":null,"year":1957,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Ann Fagan Ginger and Thelma C. Furry for appellant.","natureOfSuit":"","citationCount":0,"judges":"Clark, Disposition, From, Hampshire, Jurisdiction, Opinions, Set, Stated, Supra, Watkins, Would","jurisdictionType":"","opinions":[{"id":8931986,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1369,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"AYG\">\n<em>Per Curiam:</em>\n</author>\n<p id=\"A9Wq\">The judgment of the Supreme Court of Ohio is vacated and the case is remanded for consideration in the light of <em>Sweezy </em>v. <em>New Hampshire, </em><span class=\"citation\" data-id=\"9421472\"><a href=\"/opinion/105533/sweezy-v-new-hampshire-ex-rel-wyman/\" aria-description=\"Citation for case: Sweezy v. New Hampshire Ex Rel. Wyman\">354 U. S. 234</a></span>, and <em>Watkins </em>v. <em>United States, </em><span class=\"citation\" data-id=\"9421469\"><a href=\"/opinion/105532/watkins-v-united-states/\" aria-description=\"Citation for case: Watkins v. United States\">354 U. S. 178</a></span>.</p>\n<judges id=\"AGX\">Mr. Justice Burton would note probable jurisdiction and set the case for argument. Mr. Justice Clark dissents from this disposition of the case for the reasons stated in his dissenting opinions in <em>Sweezy </em>v. <em><span class=\"citation\" data-id=\"9421472\"><a href=\"/opinion/105533/sweezy-v-new-hampshire-ex-rel-wyman/\" aria-description=\"Citation for case: Sweezy v. New Hampshire Ex Rel. Wyman\">New Hampshire</a></span> </em>and <em>Watkins </em>v. <em>United <span class=\"citation\" data-id=\"9421469\"><a href=\"/opinion/105532/watkins-v-united-states/\" aria-description=\"Citation for case: Watkins v. United States\">States, supra.</a></span></em></judges>\n</opinion>"}],"citations":[]}