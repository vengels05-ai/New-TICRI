{"id":9081584,"docketId":66347840,"caseName":"Torres-Arboledo v. Florida","caseNameFull":"Torres-Arboledo v. Florida","slug":"torres-arboledo-v-florida","docketNumber":"No. 88-5135","dateFiled":"1988-10-11","dateArgued":null,"dateCertGranted":null,"year":1988,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Certiorari, Marshall","jurisdictionType":"","opinions":[{"id":9075576,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":151,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AqHI\">Sup. Ct. Fla. Certiorari denied.</p>\n<judges id=\"ANcR\">Justice White would grant certiorari.</judges>\n</opinion>"},{"id":9075577,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":583,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b823-7\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A8T\">dissenting.</p>\n<p id=\"b823-8\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and' Fourteenth Amendments, <em>Gregg </em>v. Georgia, <span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}