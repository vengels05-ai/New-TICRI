{"id":9039656,"docketId":66305882,"caseName":"In re Disbarment of Moritz","caseNameFull":"In re Disbarment of Moritz","slug":"in-re-disbarment-of-moritz","docketNumber":"No. D-270","dateFiled":"1982-06-21","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9032991,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":454,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AOgK\">Andrew Bruce Moritz, of San Diego, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on May 3, 1982 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./456/957/\">456 U. S. 957</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}