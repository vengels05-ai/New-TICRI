{"id":9091285,"docketId":66357547,"caseName":"In re Disbarment of Ripes","caseNameFull":"In re Disbarment of Ripes","slug":"in-re-disbarment-of-ripes","docketNumber":"No. D-797","dateFiled":"1989-10-10","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9085465,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":454,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ajg8\">Lawrence Ripes, of Northbrook, Ill., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on August 11, 1989 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./492/931/\">492 U. S. 931</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}