{"id":6803217,"docketId":63784688,"caseName":"Ford v. United States","caseNameFull":"Mason FORD v. UNITED STATES","slug":"ford-v-united-states","docketNumber":"No. 92-6036","dateFiled":"1992-11-16","dateArgued":null,"dateCertGranted":null,"year":1992,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Stevens","jurisdictionType":"","opinions":[{"id":6688355,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":324,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AJ8W\">The motion of petitioner for leave to proceed <em>in forma pauperis </em>is denied. Petitioner is allowed until December 7, 1992, within which to pay the docketing fee required by Rule 38(a) and to submit a petition in compliance with Rule 33 of the Rules of this Court.</p>\n</opinion>"},{"id":6688356,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Stevens","joinedBy":"","pageCount":null,"textLength":979,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b898-10\">Justice STEVENS,</author>\n<p id=\"Ahb\">dissenting:</p>\n<p id=\"b898-11\">For the reasons expressed in <em>Brown v. Herald Co., Inc., </em><span class=\"citation\" data-id=\"9429454\"><a href=\"/opinion/111075/theodis-brown-v-herald-co-inc-etc/\" aria-description=\"Citation for case: Theodis Brown v. Herald Co., Inc., Etc\">464 U.S. 928</a></span>, <span class=\"citation\" data-id=\"9429454\"><a href=\"/opinion/111075/theodis-brown-v-herald-co-inc-etc/\" aria-description=\"Citation for case: Theodis Brown v. Herald Co., Inc., Etc\">104 S.Ct. 331</a></span>, <span class=\"citation\" data-id=\"9281586\"><a href=\"/opinion/9286737/bose-corp-v-consumers-union-of-united-states-inc/\" aria-description=\"Citation for case: Bose Corp. v. Consumers Union of United States, Inc.\">78 L.Ed.2d 301</a></span> (1983), I would deny the petition for a writ of certiorari without reaching the merits of the motion to proceed <em>in forma pauperis.</em></p>\n</opinion>"}],"citations":[]}