{"id":8959142,"docketId":66225357,"caseName":"McIlvaine v. Louisiana","caseNameFull":"McILVAINE v. LOUISIANA","slug":"mcilvaine-v-louisiana","docketNumber":"No. 21","dateFiled":"1964-10-12","dateArgued":null,"dateCertGranted":null,"year":1964,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Maurice R. Woulfe for petitioners., Jim Garrison for respondent.","natureOfSuit":"","citationCount":1,"judges":"Black","jurisdictionType":"","opinions":[{"id":8950257,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":590,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b110-18\">Per Curiam.</author>\n<p id=\"b110-19\">The motion for leave to proceed <em>in forma pauperis </em>and the petition for writ of certiorari are granted. The judgment is vacated and the case is remanded to the Supreme Court of Louisiana for further consideration in light of <em>Aguilar </em>v. <em>Texas, </em><span class=\"citation\" data-id=\"9422845\"><a href=\"/opinion/106865/aguilar-v-texas/\" aria-description=\"Citation for case: Aguilar v. Texas\">378 U. S. 108</a></span>.</p>\n<judges id=\"b110-20\">Mr. Justice Black dissents.</judges>\n</opinion>"}],"citations":[]}