{"id":9066113,"docketId":66332364,"caseName":"Peterkin v. Pennsylvania","caseNameFull":"Peterkin v. Pennsylvania Bevins v. Kentucky Fugitt v. Georgia Romero v. Texas","slug":"peterkin-v-pennsylvania","docketNumber":"No. 86-5819; No. 86-5833; No. 86-5901; No. 86-6061","dateFiled":"1987-01-27","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":26,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9059776,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1295,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A7YW\">Sup. Ct. Pa.;</p>\n<p id=\"ASoh\">Sup. Ct. Ky.;</p>\n<p id=\"A-a-\">Sup. Ct. Ga.; and</p>\n<p id=\"Aql\">Ct. Crim. App. Tex. Certiorari denied. Reported below: No. 86-5819, <span class=\"citation\" data-id=\"9714627\"><a href=\"/opinion/2087959/commonwealth-v-peterkin/\" aria-description=\"Citation for case: Commonwealth v. Peterkin\">511 Pa. 299</a></span>, <span class=\"citation\" data-id=\"9714627\"><a href=\"/opinion/2087959/commonwealth-v-peterkin/\" aria-description=\"Citation for case: Commonwealth v. Peterkin\">513 A. 2d 373</a></span>; No. 86-5833, <span class=\"citation\" data-id=\"2437494\"><a href=\"/opinion/2437494/bevins-v-commonwealth/\" aria-description=\"Citation for case: Bevins v. Commonwealth\">712 S. W. 2d 932</a></span>; No. 86-5901, <span class=\"citation\" data-id=\"1341969\"><a href=\"/opinion/1341969/fugitt-v-state/\" aria-description=\"Citation for case: Fugitt v. State\">256 Ga. 292</a></span>, <span class=\"citation\" data-id=\"1341969\"><a href=\"/opinion/1341969/fugitt-v-state/\" aria-description=\"Citation for case: Fugitt v. State\">348 S. E. 2d 451</a></span>; No. 86-6061, <span class=\"citation\" data-id=\"1776991\"><a href=\"/opinion/1776991/romero-v-state/\" aria-description=\"Citation for case: Romero v. State\">716 S. W. 2d 519</a></span>.</p>\n</opinion>"},{"id":9059777,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":599,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1008-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Ak7e\">dissenting.</p>\n<p id=\"b1008-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}