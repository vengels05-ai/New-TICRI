{"id":8988834,"docketId":66255050,"caseName":"McKenzie v. Director","caseNameFull":"McKenzie v. Director, Patuxent Institution","slug":"mckenzie-v-director","docketNumber":"No. 71-5040","dateFiled":"1972-06-26","dateArgued":null,"dateCertGranted":null,"year":1972,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8980939,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1033,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ALr\">Ct. Sp. App. Md. Petition for rehearing granted and order of November 22, 1971 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./404/979/\">404 U. S. 979</a></span>], denying petition for writ of certiorari vacated. Motion for leave to proceed <em>in forma pauperis </em>and certiorari granted. Judgment vacated and case remanded for further consideration in light of <em>McNeil </em>v. <em>Director, Patuxent Institution, </em><span class=\"citation\" data-id=\"9424947\"><a href=\"/opinion/108579/mcneil-v-director-patuxent-institution/\" aria-description=\"Citation for case: McNeil v. Director, Patuxent Institution\">407 U. S. 245</a></span>. Mr. Justice Douglas would grant certiorari and reverse in light of <em>McNeil </em>v. <em>Director, Patuxent <span class=\"citation\" data-id=\"9424947\"><a href=\"/opinion/108579/mcneil-v-director-patuxent-institution/\" aria-description=\"Citation for case: McNeil v. Director, Patuxent Institution\">Institution, supra.</a></span></em></p>\n</opinion>"}],"citations":[]}