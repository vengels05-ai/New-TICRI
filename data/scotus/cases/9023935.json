{"id":9023935,"docketId":66290156,"caseName":"Hanson v. Circuit Court of the First Judicial Circuit of Illinois","caseNameFull":"Hanson v. Circuit Court of the First Judicial Circuit of Illinois","slug":"hanson-v-circuit-court-of-the-first-judicial-circuit-of-illinois","docketNumber":"No. 78-6596","dateFiled":"1979-10-09","dateArgued":null,"dateCertGranted":null,"year":1979,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Certiorari, White","jurisdictionType":"","opinions":[{"id":9017181,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":158,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A6IJ\">C. A. 7th Cir. Certiorari denied.</p>\n<judges id=\"ATq_\">Mr. Justice Brennan would grant certiorari.</judges>\n</opinion>"},{"id":9017182,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"White","joinedBy":"","pageCount":null,"textLength":1645,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b977-8\">Mr. Justice White,</author>\n<p id=\"AsB\">dissenting.</p>\n<p id=\"b977-9\">I dissent from the denial of certiorari and would vote to grant the petition to resolve the conflict in the decided cases. It is apparent that some federal courts would have entertained petitioner\u2019s <span class=\"citation no-link\">42 U. S. C. \u00a7 1983</span> action, see <em>Strader </em>v. <em>Troy, </em><span class=\"citation\" data-id=\"9464592\"><a href=\"/opinion/353865/franklin-d-strader-v-anthony-f-troy-attorney-general-of-virginia-and/\" aria-description=\"Citation for case: Franklin D. Strader v. Anthony F. Troy, Attorney General...\">571 F. 2d 1263</a></span> (CA4 1978); <em>Shipp </em>v. <em>Todd, </em><span class=\"citation\" data-id=\"351888\"><a href=\"/opinion/351888/paul-l-shipp-v-hardin-e-todd-clerk-of-the-13th-judicial-district-court/\" aria-description=\"Citation for case: Paul L. Shipp v. Hardin E. Todd, Clerk of the 13th...\">568 F. 2d 133</a></span> (CA9 <page-number citation-index=\"1\" label=\"908\">*908</page-number>1978) (per <em>curiam); Pueschel </em>v. <em>Leuba, </em><span class=\"citation\" data-id=\"2245400\"><a href=\"/opinion/2245400/pueschel-v-leuba/\" aria-description=\"Citation for case: Pueschel v. Leuba\">383 F. Supp. 576</a></span> (Conn. 1974), while another, like the court below, would not. <em>Cavett </em>v. Ellis, <span class=\"citation\" data-id=\"357255\"><a href=\"/opinion/357255/joe-oliver-cavett-v-tom-ellis-county-clerk-of-dallas-county-and-bill/\" aria-description=\"Citation for case: Joe Oliver Cavett v. Tom Ellis, County Clerk of Dallas...\">578 F. 2d 567</a></span> (CA5 1978).</p>\n</opinion>"}],"citations":[]}