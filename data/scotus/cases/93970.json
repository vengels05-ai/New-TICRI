{"id":93970,"docketId":2345950,"caseName":"William R. Dutton v. John G. Plairet","caseNameFull":"","slug":"william-r-dutton-v-john-g-plairet","docketNumber":"184","dateFiled":"1869-11-08","dateArgued":null,"dateCertGranted":null,"year":1869,"scdbId":"1868-091","direction":"Unspecifiable","votesMajority":8,"votesMinority":0,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":93970,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1450,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8140656\"><a href=\"/opinion/8178741/dutton-v-palairet/\" aria-description=\"Citation for case: Dutton v. Palairet\">154 U.S. 563</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./14/1200/\">14 S.Ct. 1200</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"88018\"><a href=\"/opinion/88018/the-diana/\" aria-description=\"Citation for case: The Diana\">19 L.Ed. 165</a></span></p>\n    <p class=\"parties\">WILLIAM R. DUTTON<br>v.<br>JOHN G. PLAIRET et al.</p>\n    <p class=\"docket\">No. 184.</p>\n    <p class=\"date\">November 8, 1869.</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Mr. Chief Justice CHASE delivered the opinion of the court.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The same questions substantially are presented in this case as in the case of Bronson v. Rhodes (heretofore decided at this term) <span class=\"citation\" data-id=\"9416746\"><a href=\"/opinion/88001/bronson-v-rodes/\" aria-description=\"Citation for case: Bronson v. Rodes\">7 Wall. 229</a></span>. The principles settled by that judgment require that the judgment of the supreme court of Pennsylvania be affirmed, and it is so ordered.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">David W. Sellers, for plaintiff in error.</p>\n    </div>\n    "}],"citations":[]}