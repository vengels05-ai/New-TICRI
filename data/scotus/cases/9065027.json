{"id":9065027,"docketId":66331278,"caseName":"Roberts v. Missouri","caseNameFull":"Roberts v. Missouri Marlowe v. Kentucky","slug":"roberts-v-missouri","docketNumber":"No. 86-5310; No. 86-5482","dateFiled":"1986-11-03","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":62,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9058666,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":513,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ADJk\">Sup. Ct. Mo.; and</p>\n<p id=\"ARN\">Sup. Ct. Ky. Certiorari denied. Reported below: No. 86-5310, <span class=\"citation\" data-id=\"9777997\"><a href=\"/opinion/2461829/state-v-roberts/\" aria-description=\"Citation for case: State v. Roberts\">709 S. W. 2d 857</a></span>; No. 86-5482, <span class=\"citation\" data-id=\"2461850\"><a href=\"/opinion/2461850/marlowe-v-commonwealth/\" aria-description=\"Citation for case: Marlowe v. Commonwealth\">709 S. W. 2d 424</a></span>.</p>\n</opinion>"},{"id":9058667,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b884-5\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AYZ1\">dissenting.</p>\n<p id=\"AvEu\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}