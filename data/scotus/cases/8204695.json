{"id":8204695,"docketId":65302520,"caseName":"Baskin v. Industrial Accident Commission","caseNameFull":"Baskin v. Industrial Accident Commission","slug":"baskin-v-industrial-accident-commission","docketNumber":"No. 224","dateFiled":"1949-10-24","dateArgued":null,"dateCertGranted":null,"year":1949,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Franklin C. Stark and Samuel B. Horovitz for petitioner. Everett A. Corten for the Industrial Accident Commission; and Oliver Dibble for the Kaiser Company et al., respondents.","natureOfSuit":"","citationCount":40,"judges":"","jurisdictionType":"","opinions":[{"id":8166636,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1883,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"Adcs\">\n<em>Per Curiam:</em>\n</author>\n<p id=\"AOh\">The petition for writ of certiorari is granted. It appears that the decision of this Court in <em>Bethlehem Steel Co. </em>v. <em>Moores, </em><span class=\"citation\" data-id=\"8165385\"><a href=\"/opinion/8203444/bethlehem-steel-co-v-moores/\" aria-description=\"Citation for case: Bethlehem Steel Co. v. Moores\">335 U. S. 874</a></span>, affirming the decision of the Supreme Judicial Court of Massachusetts, <span class=\"citation\" data-id=\"6445961\"><a href=\"/opinion/6572208/mooress-case/\" aria-description=\"Citation for case: Moores&#x27;s Case\">323 Mass. 162</a></span>, <span class=\"citation\" data-id=\"6445961\"><a href=\"/opinion/6572208/mooress-case/\" aria-description=\"Citation for case: Moores&#x27;s Case\">80 N. E. 2d 478</a></span>, was not available to the District Court of Appeal at the time of its consideration of this cause. The judgment is vacated and the cause remanded to the District Court of Appeal for reconsideration in the light of <em>Bethlehem Steel Co. </em>v. <em>Moores, supra, </em>and <em>Davis </em>v. <em>Department of Labor, </em><span class=\"citation\" data-id=\"9419272\"><a href=\"/opinion/103733/davis-v-department-of-labor-and-industries-of-wash/\" aria-description=\"Citation for case: Davis v. Department of Labor and Industries of Wash.\">317 U. S. 249</a></span>. See <em>Minnesota </em>v. <em>National Tea Co., </em><span class=\"citation\" data-id=\"9419097\"><a href=\"/opinion/103332/minnesota-v-national-tea-co/\" aria-description=\"Citation for case: Minnesota v. National Tea Co.\">309 U. S. 551</a></span>; <em>State Tax Comm\u2019n </em>v. <em>Van Cott, </em><span class=\"citation\" data-id=\"103175\"><a href=\"/opinion/103175/state-tax-commission-v-van-cott/\" aria-description=\"Citation for case: State Tax Commission v. Van Cott\">306 U. S. 511</a></span>.</p>\n</opinion>"}],"citations":[]}