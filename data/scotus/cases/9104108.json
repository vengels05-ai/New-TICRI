{"id":9104108,"docketId":66370380,"caseName":"In re Disbarment of Standard","caseNameFull":"In re Disbarment of Standard","slug":"in-re-disbarment-of-standard","docketNumber":"No. D-934","dateFiled":"1991-01-07","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9098501,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":465,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AEZx\">R. Michael Standard, of Los Angeles, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on September 21, 1990 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./497/1056/\">497 U. S. 1056</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}