{"id":9013412,"docketId":66279629,"caseName":"Woodkins v. Texas","caseNameFull":"Woodkins v. Texas","slug":"woodkins-v-texas","docketNumber":"No. 76-6571","dateFiled":"1977-06-06","dateArgued":null,"dateCertGranted":null,"year":1977,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9006388,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":621,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AH_D\">Ct. Crim. App. Tex. Certiorari denied.</p>\n<judges id=\"b1008-6\">Mr. Justice Brennan and Mr. Justice Marshall, dissenting.</judges>\n<p id=\"b1008-7\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}