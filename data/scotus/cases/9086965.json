{"id":9086965,"docketId":66353222,"caseName":"Caro v. California","caseNameFull":"Caro v. California","slug":"caro-v-california","docketNumber":"No. 88-6728","dateFiled":"1989-04-24","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9081071,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1048-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AWi8\">dissenting.</p>\n<p id=\"b1048-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}