{"id":106651,"docketId":2489212,"caseName":"Donald Allen Bentley, Jr. v. Alaska","caseNameFull":"","slug":"donald-allen-bentley-jr-v-alaska","docketNumber":"647, Misc","dateFiled":"1963-06-10","dateArgued":null,"dateCertGranted":null,"year":1963,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":106651,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":3027,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8946606\"><a href=\"/opinion/8955623/bentley-v-alaska/\" aria-description=\"Citation for case: Bentley v. Alaska\">374 U.S. 106</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./83/1689/\">83 S.Ct. 1689</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"8946600\"><a href=\"/opinion/8955617/lublin-v-james-t-barnes-co/\" aria-description=\"Citation for case: Lublin v. James T. Barnes &amp; Co.\">10 L.Ed.2d 1027</a></span></p>\n    <p class=\"parties\">Donald Allen BENTLEY, Jr.<br>v.<br>ALASKA.</p>\n    <p class=\"docket\">No. 647, Misc.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">June 10, 1963</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Donald Allen Bentley, Jr., pro se.</p>\n      <p class=\"indent\">George N. Hayes, Atty. Gen. of Alaska, and John K. Brubaker, Asst. Atty. Gen., for respondent.</p>\n      <p class=\"indent\">On Petition for Writ of Certiorari to the Supreme Court of Alaska.</p>\n      <p class=\"indent\">PER CURIAM.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The motion for leave to proceed <i>in forma pauperis</i> and the petition for writ of certiorari are granted. The judgment is vacated and the case is remanded to the Supreme Court of Alaska for reconsideration in light of Douglas v. California, <span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U.S. 353</a></span>, <span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">83 S.Ct. 814</a></span>, <span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">9 L.Ed.2d 811</a></span>; Lane v. Brown, <span class=\"citation\" data-id=\"9422557\"><a href=\"/opinion/106549/lane-v-brown/\" aria-description=\"Citation for case: Lane v. Brown\">372 U.S. 477</a></span>, <span class=\"citation\" data-id=\"9422557\"><a href=\"/opinion/106549/lane-v-brown/\" aria-description=\"Citation for case: Lane v. Brown\">83 S.Ct. 768</a></span>, <span class=\"citation\" data-id=\"9422557\"><a href=\"/opinion/106549/lane-v-brown/\" aria-description=\"Citation for case: Lane v. Brown\">9 L.Ed.2d 892</a></span>, and Draper et al. v. Washington et al., <span class=\"citation\" data-id=\"9422559\"><a href=\"/opinion/106550/draper-v-washington/\" aria-description=\"Citation for case: Draper v. Washington\">372 U.S. 487</a></span>, <span class=\"citation\" data-id=\"9422559\"><a href=\"/opinion/106550/draper-v-washington/\" aria-description=\"Citation for case: Draper v. Washington\">83 S.Ct. 774</a></span>, <span class=\"citation\" data-id=\"9422559\"><a href=\"/opinion/106550/draper-v-washington/\" aria-description=\"Citation for case: Draper v. Washington\">9 L.Ed.2d 899</a></span>.</p>\n    </div>\n    "}],"citations":[]}