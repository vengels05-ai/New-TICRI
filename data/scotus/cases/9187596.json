{"id":9187596,"docketId":66453907,"caseName":"In re Disbarment of McCallum","caseNameFull":"In re Disbarment of McCallum","slug":"in-re-disbarment-of-mccallum","docketNumber":"No. D-2044","dateFiled":"1999-06-01","dateArgued":null,"dateCertGranted":null,"year":1999,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9182345,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":510,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ApWk\">William C. MeCallum, of Framingham, Mass., having requested to resign as a member of the Bar of this Court, it is ordered that his name <page-number citation-index=\"1\" label=\"1143\">*1143</page-number>be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on February 22, 1999 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./525/1136/\">525 U. S. 1136</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}