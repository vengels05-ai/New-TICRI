{"id":9052905,"docketId":66319151,"caseName":"Lindsey v. Alabama","caseNameFull":"Lindsey v. Alabama","slug":"lindsey-v-alabama","docketNumber":"No. 84-5969","dateFiled":"1985-02-25","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":20,"judges":"Brennan","jurisdictionType":"","opinions":[{"id":9046377,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":127,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A7F\">Sup. Ct. Ala. Certio-rari denied. Justice Marshall would grant certiorari.</p>\n</opinion>"},{"id":9046378,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennan","joinedBy":"","pageCount":null,"textLength":627,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b985-8\">Justice Brennan,</author>\n<p id=\"Aiyf\">dissenting.</p>\n<p id=\"b985-9\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, <page-number citation-index=\"1\" label=\"1024\">*1024</page-number>227</a></span> (1976), I would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}