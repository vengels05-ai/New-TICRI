{"id":9287803,"docketId":66556208,"caseName":"Mitchell v. Texas","caseNameFull":"Mitchell v. Texas Cooper v. Florida Coleman v. Oklahoma","slug":"mitchell-v-texas","docketNumber":"No. 83-5387; No. 83-5737; No. 83-5776","dateFiled":"1984-01-16","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9282674,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":623,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AAWc\">Ct. Crim. App. Tex.; Sup. Ct. Fla.; and Ct. Crim. App. Okla. Certiorari denied. Reported below: No. 83-5387, <span class=\"citation\" data-id=\"9642271\"><a href=\"/opinion/1502707/mitchell-v-state/\" aria-description=\"Citation for case: Mitchell v. State\">650 S. W. 2d 801</a></span>; No. 83-5737, <span class=\"citation\" data-id=\"1668132\"><a href=\"/opinion/1668132/cooper-v-state/\" aria-description=\"Citation for case: Cooper v. State\">437 So. 2d 1070</a></span>; No. 83-5776, <span class=\"citation multiple-matches\"><a href=\"/c/P.%202d/668/1126/\">668 P. 2d 1126</a></span>.</p>\n</opinion>"},{"id":9282675,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":661,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b947-16\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Adm6\">dissenting.</p>\n<p id=\"b947-17\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth <page-number citation-index=\"1\" label=\"1074\">*1074</page-number>and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}