{"id":9047364,"docketId":66313606,"caseName":"Sawyer v. Louisiana","caseNameFull":"Sawyer v. Louisiana","slug":"sawyer-v-louisiana","docketNumber":"No. 83-6258","dateFiled":"1984-04-02","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":6,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9040753,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b925-14\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AGYd\">dissenting.</p>\n<p id=\"b925-15\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}