{"id":9024910,"docketId":66291131,"caseName":"Thigpen v. Alabama","caseNameFull":"Thigpen v. Alabama Roach v. South Carolina","slug":"thigpen-v-alabama","docketNumber":"No. 79-5552; No. 79-5632","dateFiled":"1980-01-07","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9018163,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":516,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AWY-\">Ct. Crim. App. Ala.; and</p>\n<p id=\"AdGR\">Sup. Ct. S. C. Certiorari denied. Reported below: No. 79-5552, <span class=\"citation\" data-id=\"1728061\"><a href=\"/opinion/1728061/thigpen-v-state/\" aria-description=\"Citation for case: Thigpen v. State\">372 So. 2d 385</a></span>; No. 79-5632, 273 S. C. 194, <span class=\"citation\" data-id=\"1304670\"><a href=\"/opinion/1304670/state-v-shaw/\" aria-description=\"Citation for case: State v. Shaw\">255 S. E. 2d 799</a></span>.</p>\n</opinion>"},{"id":9018164,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":605,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1096-8\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"Ao0N\">dissenting.</p>\n<p id=\"b1096-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}