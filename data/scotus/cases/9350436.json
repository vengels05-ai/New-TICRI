{"id":9350436,"docketId":66663807,"caseName":"Evans v. Texas","caseNameFull":"Evans v. Texas Coleman v. Virginia Dillon v. Indiana","slug":"evans-v-texas","docketNumber":"No. 83-5965; No. 83-6097; No. 83-6136","dateFiled":"1984-03-19","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":30,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9345903,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":904,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ANb8\">Ct. Crim. App. Tex.;</p>\n<p id=\"AF2J\">Sup. Ct. Va.; and</p>\n<p id=\"A4A\">Sup. Ct. Ind. Certiorari denied. Reported below: No. 83-5965, <span class=\"citation\" data-id=\"2383788\"><a href=\"/opinion/2383788/evans-v-state/\" aria-description=\"Citation for case: Evans v. State\">656 S. W. 2d 65</a></span>; No. 83-6097, <span class=\"citation\" data-id=\"1227505\"><a href=\"/opinion/1227505/coleman-v-commonwealth/\" aria-description=\"Citation for case: Coleman v. Commonwealth\">226 Va. 31</a></span>, <span class=\"citation\" data-id=\"1227505\"><a href=\"/opinion/1227505/coleman-v-commonwealth/\" aria-description=\"Citation for case: Coleman v. Commonwealth\">307 S. E. 2d 864</a></span>; No. 83-6136, <span class=\"citation\" data-id=\"9521456\"><a href=\"/opinion/2024431/dillon-v-state/\" aria-description=\"Citation for case: Dillon v. State\">454 N. E. 2d 845</a></span>.</p>\n</opinion>"},{"id":9345904,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":598,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1085-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Aa--\">dissenting.</p>\n<p id=\"b1085-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}