{"id":9020858,"docketId":66287075,"caseName":"Jackson v. Florida","caseNameFull":"Jackson v. Florida Westbrook v. Georgia","slug":"jackson-v-florida","docketNumber":"No. 78-5533; No. 78-5763","dateFiled":"1979-01-08","dateArgued":null,"dateCertGranted":null,"year":1979,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":27,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9014065,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":673,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AmS1\">Sup. Ct. Fla.; and</p>\n<p id=\"AQUG\">Sup. Ct. Ga. Cer-tiorari denied. Reported below: No. 78-5533, <span class=\"citation\" data-id=\"1853614\"><a href=\"/opinion/1853614/jackson-v-state/\" aria-description=\"Citation for case: Jackson v. State\">359 So. 2d 1190</a></span>; No. 78-5763, <span class=\"citation\" data-id=\"1247693\"><a href=\"/opinion/1247693/westbrook-v-state/\" aria-description=\"Citation for case: Westbrook v. State\">242 Ga. 151</a></span>, <span class=\"citation\" data-id=\"1247693\"><a href=\"/opinion/1247693/westbrook-v-state/\" aria-description=\"Citation for case: Westbrook v. State\">249 S. E. 2d 524</a></span>.</p>\n</opinion>"},{"id":9014066,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":668,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1046-8\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"Aa6\">dissenting.</p>\n<p id=\"b1046-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the <page-number citation-index=\"1\" label=\"1103\">*1103</page-number>Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}