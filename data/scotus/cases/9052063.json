{"id":9052063,"docketId":66318309,"caseName":"Watson v. Louisiana","caseNameFull":"Watson v. Louisiana Solomon v. Kemp, Warden Mann v. Florida Blanco v. Florida Gorham v. Florida","slug":"watson-v-louisiana","docketNumber":"No. 84-5538; No. 84-5625; No. 84-5632; No. 84-5659; No. 84-5776","dateFiled":"1985-01-14","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":174,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9045528,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1205,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A1A1\">Sup. Ct. La.;</p>\n<p id=\"Ampl\">C. A. 11th Cir.;</p>\n<p id=\"AEVk\">Sup. Ct. Fla.;</p>\n<p id=\"A52W\">Sup. Ct. Fla.; and</p>\n<p id=\"At3M\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 84-5538, <span class=\"citation\" data-id=\"1728307\"><a href=\"/opinion/1728307/state-v-watson/\" aria-description=\"Citation for case: State v. Watson\">449 So. 2d 1321</a></span>; No. 84-5625, <span class=\"citation\" data-id=\"436170\"><a href=\"/opinion/436170/van-roosevelt-solomon-v-ralph-kemp-warden-georgia-diagnostic/\" aria-description=\"Citation for case: Van Roosevelt Solomon v. Ralph Kemp, Warden, Georgia...\">735 F. 2d 395</a></span>; No. 84-5632, <span class=\"citation\" data-id=\"1592732\"><a href=\"/opinion/1592732/mann-v-state/\" aria-description=\"Citation for case: Mann v. State\">453 So. 2d 784</a></span>; No. 84-5659, <span class=\"citation\" data-id=\"1112702\"><a href=\"/opinion/1112702/blanco-v-state/\" aria-description=\"Citation for case: Blanco v. State\">452 So. 2d 520</a></span>; No. 84-5776, <span class=\"citation\" data-id=\"1088440\"><a href=\"/opinion/1088440/gorham-v-state/\" aria-description=\"Citation for case: Gorham v. State\">454 So. 2d 556</a></span>.</p>\n</opinion>"},{"id":9045529,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1115-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"ADkr\">dissenting.</p>\n<p id=\"ALNv\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}