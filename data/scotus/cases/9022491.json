{"id":9022491,"docketId":66288708,"caseName":"Morgan v. Georgia","caseNameFull":"Morgan v. Georgia","slug":"morgan-v-georgia","docketNumber":"No. 78-6140","dateFiled":"1979-05-21","dateArgued":null,"dateCertGranted":null,"year":1979,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":49,"judges":"Brennan, Certiorari, Set","jurisdictionType":"","opinions":[{"id":9015715,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":192,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Amn\">Sup. Ct. Ga. Certio-rari denied.</p>\n<judges id=\"Aspz\">Mr. Justice Marshall would grant certiorari and set the case for oral argument.</judges>\n</opinion>"},{"id":9015716,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennan","joinedBy":"","pageCount":null,"textLength":567,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b919-8\">Mr. Justice Brennan,</author>\n<p id=\"A8HD\">dissenting.</p>\n<p id=\"b919-9\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227</a></span> (1976), I would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}