{"id":9047637,"docketId":66313879,"caseName":"In re Disbarment of Goldstein","caseNameFull":"In re Disbarment of Goldstein","slug":"in-re-disbarment-of-goldstein","docketNumber":"No. D-413","dateFiled":"1984-04-30","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9041031,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":461,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A8z\">Charles H. Goldstein, of West Islip, N. Y., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on March 19, 1984 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./465/1096/\">465 U. S. 1096</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}