{"id":9039489,"docketId":66305715,"caseName":"Harris v. California","caseNameFull":"Harris v. California Drake v. Georgia Jent v. Florida","slug":"harris-v-california","docketNumber":"No. 81-6512; No. 81-6540; No. 81-6549","dateFiled":"1982-06-07","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":4,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9032824,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1243,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AKEy\">Ct. App. Cal., 2d App. Dist.;</p>\n<p id=\"ARe\">Sup. Ct. Ga.; and</p>\n<p id=\"A1-I\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 81-6540, <span class=\"citation\" data-id=\"9846763\"><a href=\"/opinion/1266593/drake-v-state/\" aria-description=\"Citation for case: Drake v. State\">248 Ga. 891</a></span>, <span class=\"citation\" data-id=\"9846763\"><a href=\"/opinion/1266593/drake-v-state/\" aria-description=\"Citation for case: Drake v. State\">287 S. E. 2d 180</a></span>; No. 81-6549, <span class=\"citation\" data-id=\"1843147\"><a href=\"/opinion/1843147/jent-v-state/\" aria-description=\"Citation for case: Jent v. State\">408 So. 2d 1024</a></span>.</p>\n<judges id=\"b1087-10\">Justice Brennan and Justice Marshall, dissenting.</judges>\n<p id=\"b1087-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}