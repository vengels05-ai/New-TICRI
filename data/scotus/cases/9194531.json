{"id":9194531,"docketId":66460844,"caseName":"In re Disbarment of Carlson","caseNameFull":"In re Disbarment of Carlson","slug":"in-re-disbarment-of-carlson","docketNumber":"No. D-2164","dateFiled":"2000-08-07","dateArgued":null,"dateCertGranted":null,"year":2000,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9189306,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":440,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AeJJ\">Robert Bent Carlson, of North Port, Fla., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on May 22, 2000 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./529/1127/\">529 U. S. 1127</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}