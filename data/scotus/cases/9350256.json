{"id":9350256,"docketId":66663627,"caseName":"Leatherwood v. Mississippi","caseNameFull":"Leatherwood v. Mississippi Moore v. Balkcom, Warden Tafero v. Florida","slug":"leatherwood-v-mississippi","docketNumber":"No. 83-5767; No. 83-6084; No. 83-6150","dateFiled":"1984-03-05","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan","jurisdictionType":"","opinions":[{"id":9345722,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1075,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AvEl\">Sup. Ct. Miss.;</p>\n<p id=\"AAO\">C. A. 11th Cir.; and</p>\n<p id=\"Ap1G\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 83-5767, <span class=\"citation\" data-id=\"1732251\"><a href=\"/opinion/1732251/leatherwood-v-state/\" aria-description=\"Citation for case: Leatherwood v. State\">435 So. 2d 645</a></span>; No. 83-6084, <span class=\"citation\" data-id=\"424762\"><a href=\"/opinion/424762/william-neal-moore-v-charles-balkcom-warden-arthur-k-bolton-attorney/\" aria-description=\"Citation for case: William Neal Moore v. Charles Balkcom, Warden, Arthur K....\">716 F. 2d 1511</a></span> and <span class=\"citation\" data-id=\"427759\"><a href=\"/opinion/427759/william-neal-moore-v-charles-balkcom-warden-arthur-k-bolton-attorney/\" aria-description=\"Citation for case: William Neal Moore v. Charles Balkcom, Warden, Arthur K....\">722 F. 2d 629</a></span>; No. 83-6150, <span class=\"citation\" data-id=\"1830631\"><a href=\"/opinion/1830631/tafero-v-state/\" aria-description=\"Citation for case: Tafero v. State\">440 So. 2d 350</a></span>.</p>\n</opinion>"},{"id":9345723,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennan","joinedBy":"","pageCount":null,"textLength":568,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1060-7\">Justice Brennan,</author>\n<p id=\"AmHL\">dissenting.</p>\n<p id=\"b1060-8\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}