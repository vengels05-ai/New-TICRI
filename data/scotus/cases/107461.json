{"id":107461,"docketId":1020660,"caseName":"Frazier v. Lane, Warden","caseNameFull":"Willie Frazier v. Ward Lane","slug":"frazier-v-lane-warden","docketNumber":"33, Misc","dateFiled":"1967-05-22","dateArgued":null,"dateCertGranted":null,"year":1967,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., John J. Dillon, Attorney General of Indiana, and Douglas B. McFadden, Deputy Attorney General, for respondent.","natureOfSuit":"","citationCount":1,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":107461,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":771,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"6\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b286-9\">\n  Per Curiam.\n </author>\n<p id=\"b286-10\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are granted. The judgment is vacated and the case is remanded to the United States Court of Appeals for the Seventh Circuit for further consideration in light of\n  <em>\n   Long\n  </em>\n  v.\n  <em>\n   District Court of Iowa in and for Lee County,\n  </em>\n  <span class=\"citation\" data-id=\"107307\"><a href=\"/opinion/107307/long-v-district-court-of-iowa-lee-cty/\" aria-description=\"Citation for case: Long v. District Court of Iowa, Lee Cty.\">385 U. S. 192</a></span>.\n </p>\n</opinion>"}],"citations":[]}