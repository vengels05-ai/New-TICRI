{"id":2358323,"docketId":1687292,"caseName":"Rosenberg v. United States","caseNameFull":"ROSENBERG Et Al. v. UNITED STATES","slug":"rosenberg-v-united-states","docketNumber":"","dateFiled":"1953-06-19","dateArgued":null,"dateCertGranted":null,"year":1953,"scdbId":"1952-116","direction":"Conservative","votesMajority":8,"votesMinority":1,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Fyke Farmer submitted the motion.","natureOfSuit":"","citationCount":7,"judges":"Black, Frankfurter","jurisdictionType":"","opinions":[{"id":2358323,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":1435,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b398-8\">\n  Per Curiam.\n </author>\n<p id=\"b398-9\">\n  The motion for reconsideration of the question of the Court\u2019s power to vacate Mr. Justice Douglas\u2019 stay order and hear oral argument is denied.\n </p>\n<judges id=\"b398-10\">\n  Mr. Justice Black dissents.\n </judges>\n<author id=\"b398-11\">\n  Mr. Justice Frankfurter\n </author>\n<p id=\"AlS\">\n  desires that it be noted that he too would deny the motion to reconsider the power of this Court to review Mr. Justice Douglas\u2019 order to stay the execution, but not because he thinks the matter is free from doubt. See his dissenting opinion in\n  <em>\n   Ex parte Peru,\n  </em>\n  <span class=\"citation\" data-id=\"9419326\"><a href=\"/opinion/103805/ex-parte-republic-of-peru/#590\" aria-description=\"Citation for case: Ex Parte Republic of Peru\">318 U. S. 578, 590</a></span>, in connection with\n  <em>\n   Lambert\n  </em>\n  v.\n  <em>\n   Barrett,\n  </em>\n  <span class=\"citation\" data-id=\"8140787\"><a href=\"/opinion/8178872/lambert-v-barrett/\" aria-description=\"Citation for case: Lambert v. Barrett\">157 U. S. 697</a></span>, and\n  <em>\n   Carper\n  </em>\n  v.\n  <em>\n   Fitzgerald,\n  </em>\n  <span class=\"citation\" data-id=\"91899\"><a href=\"/opinion/91899/carper-v-fitzgerald/\" aria-description=\"Citation for case: Carper v. Fitzgerald\">121 U. S. 87</a></span>.\n </p>\n</opinion>"}],"citations":[]}