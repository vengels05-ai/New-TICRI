{"id":9054110,"docketId":66320356,"caseName":"Gaskins v. South Carolina","caseNameFull":"Gaskins v. South Carolina Lawson v. North Carolina Stewart v. Illinois Hardwick v. Florida","slug":"gaskins-v-south-carolina","docketNumber":"No. 84-6453; No. 84-6498; No. 84-6508; No. 84-6522","dateFiled":"1985-05-20","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":88,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9047615,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1282,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ASh9\">Sup. Ct. S. C.;</p>\n<p id=\"AjYu\">Sup. Ct. N. C.;</p>\n<p id=\"A2Ij\">Sup. Ct. Ill.; and</p>\n<p id=\"AEE5\">Sup. Ct. Fla. Certio-rari denied. Reported below: No. 84-6453, 284 S. C. 105, <span class=\"citation\" data-id=\"1250523\"><a href=\"/opinion/1250523/state-v-gaskins/\" aria-description=\"Citation for case: State v. Gaskins\">326 S. E. 2d 132</a></span>; No. 84-6498, <span class=\"citation\" data-id=\"1257561\"><a href=\"/opinion/1257561/state-v-lawson/\" aria-description=\"Citation for case: State v. Lawson\">310 N. C. 632</a></span>, <span class=\"citation\" data-id=\"1257561\"><a href=\"/opinion/1257561/state-v-lawson/\" aria-description=\"Citation for case: State v. Lawson\">314 S. E. 2d 493</a></span>; No. 84-6508, <span class=\"citation\" data-id=\"9523868\"><a href=\"/opinion/2031898/people-v-stewart/\" aria-description=\"Citation for case: People v. Stewart\">104 Ill. 2d 463</a></span>, <span class=\"citation\" data-id=\"9523868\"><a href=\"/opinion/2031898/people-v-stewart/\" aria-description=\"Citation for case: People v. Stewart\">473 N. E. 2d 1227</a></span>; No. 84-6522, <span class=\"citation\" data-id=\"1104538\"><a href=\"/opinion/1104538/hardwick-v-state/\" aria-description=\"Citation for case: Hardwick v. State\">461 So. 2d 79</a></span>.</p>\n</opinion>"},{"id":9047616,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1054-5\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Avt9\">dissenting.</p>\n<p id=\"AU2_\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}