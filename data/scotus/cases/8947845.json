{"id":8947845,"docketId":66214060,"caseName":"In re Disbarment of Alker","caseNameFull":"In re Disbarment of Alker","slug":"in-re-disbarment-of-alker","docketNumber":"No. 23","dateFiled":"1960-06-13","dateArgued":null,"dateCertGranted":null,"year":1960,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Francis E. Walter and William J. Woolston on the motion.","natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":8938523,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":502,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AaW\">In view of the pendency of disbarment proceedings in the United States Court of Appeals and the United States District Court, the motion to vacate the order of disbarment (<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./362/985/\">362 U. S. 985</a></span>) and to reinstate the order of suspension (<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./360/908/\">360 U. S. 908</a></span>) is held until those matters are determined.</p>\n</opinion>"}],"citations":[]}