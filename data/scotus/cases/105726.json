{"id":105726,"docketId":667140,"caseName":"Rogers v. Richmond","caseNameFull":"Rogers v. Richmond, Warden","slug":"rogers-v-richmond","docketNumber":"755, Misc","dateFiled":"1958-06-16","dateArgued":null,"dateCertGranted":null,"year":1958,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Louis H. Poliak for petitioner., Abraham S. Ullman for respondent.","natureOfSuit":"","citationCount":42,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":105726,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":762,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"6\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b268-11\">\n  Per Curiam.\n </author>\n<p id=\"b268-12\">\n  The petition for writ of certiorari is denied. We read the opinion of the Court of Appeals as holding that while the District Judge may, unless he finds a vital flaw in the State Court proceedings, accept the determination in such proceedings, he need not deem such determination binding, and may take testimony. See\n  <em>\n   Brown\n  </em>\n  v.\n  <em>\n   Allen,\n  </em>\n  <span class=\"citation\" data-id=\"9420862\"><a href=\"/opinion/105074/brown-v-allen/#506\" aria-description=\"Citation for case: Brown v. Allen\">344 U. S. 443, 506</a></span>,\n  <em>\n   et seq.\n  </em>\n</p>\n</opinion>"}],"citations":[]}