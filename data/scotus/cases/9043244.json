{"id":9043244,"docketId":66309471,"caseName":"Jones v. Oklahoma","caseNameFull":"Jones v. Oklahoma Meeks v. Florida Parks v. Oklahoma","slug":"jones-v-oklahoma","docketNumber":"No. 82-788; No. 82-5744; No. 82-5789","dateFiled":"1983-01-17","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":135,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9036599,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":710,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AL2f\">Ct. Crim. App. Okla.;</p>\n<p id=\"ArCk\">Sup. Ct. Fla.; and</p>\n<p id=\"AxGq\">Ct. Crim. App. Okla. Certiorari denied. Reported below: No. 82-788, <span class=\"citation\" data-id=\"1185110\"><a href=\"/opinion/1185110/jones-v-state/\" aria-description=\"Citation for case: Jones v. State\">648 P. 2d 1251</a></span>; No. 82-5744, <span class=\"citation\" data-id=\"1701246\"><a href=\"/opinion/1701246/meeks-v-state/\" aria-description=\"Citation for case: Meeks v. State\">418 So. 2d 987</a></span>; No. 82-5789, <span class=\"citation\" data-id=\"1165559\"><a href=\"/opinion/1165559/parks-v-state/\" aria-description=\"Citation for case: Parks v. State\">651 P. 2d 686</a></span>.</p>\n</opinion>"},{"id":9036600,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":598,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1089-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AZm-\">dissenting.</p>\n<p id=\"b1089-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}