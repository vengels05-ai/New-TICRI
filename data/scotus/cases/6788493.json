{"id":6788493,"docketId":63769817,"caseName":"Harrington v. Richter","caseNameFull":"Kelly Harrington, Warden v. Joshua Richter","slug":"harrington-v-richter","docketNumber":"No. 09-587","dateFiled":"2010-02-22","dateArgued":null,"dateCertGranted":null,"year":2010,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":9,"judges":"","jurisdictionType":"","opinions":[{"id":6672803,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1147,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Aug\">Petition for writ of certiorari to the United States Court of Appeals for the Ninth Circuit granted. In addition to the question presented, parties are directed to brief and argue the following question: \u201cDoes AEDPA deference apply to a state court\u2019s summary disposition of a claim, including a claim under Strickland v. Washington, <span class=\"citation\" data-id=\"9429592\"><a href=\"/opinion/111170/strickland-v-washington/\" aria-description=\"Citation for case: Strickland v. Washington\">466 U.S. 668</a></span> [<span class=\"citation\" data-id=\"9429592\"><a href=\"/opinion/111170/strickland-v-washington/\" aria-description=\"Citation for case: Strickland v. Washington\">104 S. Ct. 2052</a></span>, <span class=\"citation\" data-id=\"9429592\"><a href=\"/opinion/111170/strickland-v-washington/\" aria-description=\"Citation for case: Strickland v. Washington\">80 L. Ed. 2d 674</a></span>] (1984)?\u201d</p>\n<p id=\"b196-16\">Same case below, <span class=\"citation\" data-id=\"9634010\"><a href=\"/opinion/1456437/richter-v-hickman/\" aria-description=\"Citation for case: Richter v. Hickman\">578 F.3d 944</a></span>.</p>\n</opinion>"}],"citations":[]}