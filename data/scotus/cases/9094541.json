{"id":9094541,"docketId":66360803,"caseName":"Messiah v. Louisiana","caseNameFull":"Messiah v. Louisiana Buchanan v. Virginia Klokoc v. Florida","slug":"messiah-v-louisiana","docketNumber":"No. 89-5580; No. 89-6107; No. 89-6244","dateFiled":"1990-01-22","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9088769,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":726,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ar0-\">Sup. Ct. La.;</p>\n<p id=\"AlHR\">Sup. Ct. Va.; and</p>\n<p id=\"AgBl\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 89-5580, <span class=\"citation\" data-id=\"1111173\"><a href=\"/opinion/1111173/state-v-messiah/\" aria-description=\"Citation for case: State v. Messiah\">538 So. 2d 175</a></span>; No. 89-6107, <span class=\"citation\" data-id=\"1203707\"><a href=\"/opinion/1203707/buchanan-v-commonwealth/\" aria-description=\"Citation for case: Buchanan v. Commonwealth\">238 Va. 389</a></span>, <span class=\"citation\" data-id=\"1203707\"><a href=\"/opinion/1203707/buchanan-v-commonwealth/\" aria-description=\"Citation for case: Buchanan v. Commonwealth\">384 S. E. 2d 757</a></span>.</p>\n</opinion>"},{"id":9088770,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":599,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1001-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AvPu\">dissenting.</p>\n<p id=\"b1001-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}