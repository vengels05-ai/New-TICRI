{"id":8957618,"docketId":66223833,"caseName":"Cox v. Kansas","caseNameFull":"COX v. KANSAS","slug":"cox-v-kansas","docketNumber":"No. 453, Misc.","dateFiled":"1964-02-17","dateArgued":null,"dateCertGranted":null,"year":1964,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., William M. Ferguson, Attorney General of Kansas, for respondent.","natureOfSuit":"","citationCount":1,"judges":"","jurisdictionType":"","opinions":[{"id":8948678,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":751,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b251-10\">Per Curiam.</author>\n<p id=\"b251-11\">The motion for leave to proceed <em>in forma pauperis </em>and the petition for a writ of certiorari are granted. The judgment is vacated and the case is remanded to the Supreme Court of Kansas for further consideration in light of <em>Douglas </em>v. <em>California, </em><span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U. S. 353</a></span>, and <em>Daegele </em>v. <em>Kansas, </em><span class=\"citation\" data-id=\"106676\"><a href=\"/opinion/106676/daegele-v-kansas/\" aria-description=\"Citation for case: Daegele v. Kansas\">375 U. S. 1</a></span>.</p>\n</opinion>"}],"citations":[]}