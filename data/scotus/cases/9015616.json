{"id":9015616,"docketId":66281833,"caseName":"Blake v. Georgia","caseNameFull":"Blake v. Georgia Spenkelink v. Florida","slug":"blake-v-georgia","docketNumber":"No. 77-5488; No. 77-5538","dateFiled":"1977-11-14","dateArgued":null,"dateCertGranted":null,"year":1977,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":6,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9008683,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":584,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ak8d\">Sup. Ct. Ga.; and</p>\n<p id=\"AdAm\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 77-5488, <span class=\"citation\" data-id=\"1365524\"><a href=\"/opinion/1365524/blake-v-state/\" aria-description=\"Citation for case: Blake v. State\">239 Ga. 292</a></span>, <span class=\"citation\" data-id=\"1365524\"><a href=\"/opinion/1365524/blake-v-state/\" aria-description=\"Citation for case: Blake v. State\">236 S. E. 2d 637</a></span>; No. 77-5538, <span class=\"citation multiple-matches\"><a href=\"/c/So.%202d/350/85/\">350 So. 2d 85</a></span>.</p>\n</opinion>"},{"id":9008684,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":603,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b940-8\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"A5dH\">dissenting.</p>\n<p id=\"b940-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}