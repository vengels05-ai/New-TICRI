{"id":7345176,"docketId":64333669,"caseName":"Amara v. CIGNA Corp.","caseNameFull":"Janice C. Amara, Individually and on Behalf of All Others Similarly Situated v. CIGNA Corporation","slug":"amara-v-cigna-corp","docketNumber":"No. 09-784","dateFiled":"2011-05-23","dateArgued":null,"dateCertGranted":null,"year":2011,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Consideration, Took","jurisdictionType":"","opinions":[{"id":7263136,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1068,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AuFo\">The Court vacated the judgment below in CIGNA Corp. v. Amara, <span class=\"citation\" data-id=\"9441561\"><a href=\"/opinion/216734/cigna-corp-v-amara/\" aria-description=\"Citation for case: CIGNA Corp. v. Amara\">563 U.S. 421</a></span>, <span class=\"citation\" data-id=\"9441561\"><a href=\"/opinion/216734/cigna-corp-v-amara/\" aria-description=\"Citation for case: CIGNA Corp. v. Amara\">131 S. Ct. 1866</a></span>, <span class=\"citation\" data-id=\"9441561\"><a href=\"/opinion/216734/cigna-corp-v-amara/\" aria-description=\"Citation for case: CIGNA Corp. v. Amara\">179 L. Ed. 2d 843</a></span> (2011). Therefore, the petition for a writ of certiorari is granted, and the case is remanded to the United States Court of Appeals for the Second Circuit for further proceedings.</p>\n<judges id=\"A79h\">Justice Sotomayor took no part in the consideration or decision of this petition.</judges>\n<p id=\"b1341-17\">Same case below, <span class=\"citation multiple-matches\"><a href=\"/c/Fed.%20Appx./348/627/\">348 Fed. Appx. 627</a></span>.</p>\n</opinion>"}],"citations":[]}