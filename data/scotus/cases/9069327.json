{"id":9069327,"docketId":66335579,"caseName":"Demouchette v. Texas","caseNameFull":"Demouchette v. Texas Tarver v. Alabama Schlup v. Missouri Terry v. Pennsylvania Jackson v. Florida","slug":"demouchette-v-texas","docketNumber":"No. 86-6216; No. 86-6711; No. 86-6731; No. 86-6747; No. 86-6795","dateFiled":"1987-06-08","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9063044,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1326,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AHg\">Ct. Crim. App. Tex.;</p>\n<p id=\"Acp\">Sup. Ct. Ala.;</p>\n<p id=\"A1vN\">Sup. Ct. Mo.;</p>\n<p id=\"Ao0\">Sup. Ct. Pa.; and</p>\n<p id=\"Axn\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 86-6216, <span class=\"citation\" data-id=\"1576225\"><a href=\"/opinion/1576225/demouchette-v-state/\" aria-description=\"Citation for case: Demouchette v. State\">731 S. W. 2d 75</a></span>; No. 86-6711, <span class=\"citation\" data-id=\"1708866\"><a href=\"/opinion/1708866/ex-parte-tarver/\" aria-description=\"Citation for case: Ex Parte Tarver\">500 So. 2d 1256</a></span>; No. 86-6731, <span class=\"citation\" data-id=\"2434039\"><a href=\"/opinion/2434039/state-v-schlup/\" aria-description=\"Citation for case: State v. Schlup\">724 S. W. 2d 236</a></span>; No. 86-6747, <span class=\"citation\" data-id=\"9729324\"><a href=\"/opinion/2166919/commonwealth-v-terry/\" aria-description=\"Citation for case: Commonwealth v. Terry\">513 Pa. 381</a></span>, <span class=\"citation\" data-id=\"9729324\"><a href=\"/opinion/2166919/commonwealth-v-terry/\" aria-description=\"Citation for case: Commonwealth v. Terry\">521 A. 2d 398</a></span>; No. 86-6795, <span class=\"citation\" data-id=\"1614844\"><a href=\"/opinion/1614844/jackson-v-state/\" aria-description=\"Citation for case: Jackson v. State\">502 So. 2d 409</a></span>.</p>\n</opinion>"},{"id":9063047,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b830-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AORc\">dissenting.</p>\n<p id=\"b830-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}