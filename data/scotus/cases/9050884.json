{"id":9050884,"docketId":66317130,"caseName":"Campbell v. Tennessee","caseNameFull":"Campbell v. Tennessee McCorquodale v. Kemp, Warden Stewart v. Illinois","slug":"campbell-v-tennessee","docketNumber":"No. 83-6898; No. 84-5238; No. 84-5249","dateFiled":"1984-10-15","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9044324,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":723,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AoR4\">Sup. Ct. Tenn.;</p>\n<p id=\"AnK\">Super. Ct. Ga., Butts County; and</p>\n<p id=\"AOuI\">Sup. Ct. Ill. Certiorari denied. Reported below: No. 83-6898, <span class=\"citation\" data-id=\"2446644\"><a href=\"/opinion/2446644/state-v-campbell/\" aria-description=\"Citation for case: State v. Campbell\">664 S. W. 2d 281</a></span>; No. 84-5249, <span class=\"citation\" data-id=\"9522328\"><a href=\"/opinion/2027457/people-v-stewart/\" aria-description=\"Citation for case: People v. Stewart\">101 Ill. 2d 470</a></span>, <span class=\"citation\" data-id=\"9522328\"><a href=\"/opinion/2027457/people-v-stewart/\" aria-description=\"Citation for case: People v. Stewart\">463 N. E. 2d 677</a></span>.</p>\n</opinion>"},{"id":9044325,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b854-13\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A5id\">dissenting.</p>\n<p id=\"b854-14\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}