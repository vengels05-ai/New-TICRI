{"id":9158938,"docketId":66425239,"caseName":"In re Disbarment of Berg","caseNameFull":"In re Disbarment of Berg","slug":"in-re-disbarment-of-berg","docketNumber":"No. D-1659","dateFiled":"1996-04-15","dateArgued":null,"dateCertGranted":null,"year":1996,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9153637,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":437,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ags0\">Howard M. Berg, of Boca Raton, Fla., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on March 18, 1996 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./516/1169/\">516 U. S. 1169</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}