{"id":107385,"docketId":1771470,"caseName":"ROY v. CALIFORNIA Et Al.","caseNameFull":"James Kinney Roy v. California","slug":"roy-v-california-et-al","docketNumber":"68, Misc","dateFiled":"1967-03-13","dateArgued":null,"dateCertGranted":null,"year":1967,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":"<p>Mise.</p>","headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Stewart, California","jurisdictionType":"","opinions":[{"id":107385,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":724,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b357-8\">\n  Per Curiam.\n </author>\n<p id=\"b357-9\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are granted. The judgment is vacated and' the .case remanded for further consideration in light of\n  <em>\n   Chapman\n  </em>\n  v.\n  <em>\n   California, ante,\n  </em>\n  p. 18.\n </p>\n<judges id=\"b357-11\">\n  Mr. Justice Stewart would grant certiorari and reverse the judgment for the reasons stated in his opinion concurring in the result in\n  <em>\n   Chapman\n  </em>\n  v.\n  <em>\n   California, ante,\n  </em>\n  at 42.\n </judges>\n</opinion>"}],"citations":[]}