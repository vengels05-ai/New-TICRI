{"id":9028946,"docketId":66295167,"caseName":"Quinones v. Texas","caseNameFull":"Quinones v. Texas","slug":"quinones-v-texas","docketNumber":"No. 80-5053","dateFiled":"1980-10-06","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":8,"judges":"Brennan, Certiorari, Marshall","jurisdictionType":"","opinions":[{"id":9022216,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":159,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Abja\">Ct. Crim. App. Tex. Certiorari denied.</p>\n<judges id=\"A5Pc\">Justice Stewart would grant certiorari.</judges>\n</opinion>"},{"id":9022217,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":588,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"A4f-\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Ajdb\">dissenting.</p>\n<p id=\"AEE7\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}