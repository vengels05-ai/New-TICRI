{"id":9035509,"docketId":66301731,"caseName":"Booker v. Florida","caseNameFull":"Booker v. Florida Funchess v. Florida Barfield v. North Carolina","slug":"booker-v-florida","docketNumber":"No. 81-5086; No. 81-5329; No. 81-5372","dateFiled":"1981-10-19","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":51,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9028817,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":531,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A03M\">Sup. Ct. Fla.;</p>\n<p id=\"AKeC\">Sup. Ct. Fla.; and</p>\n<p id=\"AMJZ\">Sup. Ct. N. C. Certiorari denied. Reported below: No. 81-5086, <span class=\"citation\" data-id=\"1763212\"><a href=\"/opinion/1763212/booker-v-state/\" aria-description=\"Citation for case: Booker v. State\">397 So. 2d 910</a></span>; No. 81-5329, <span class=\"citation\" data-id=\"1595939\"><a href=\"/opinion/1595939/funchess-v-state/\" aria-description=\"Citation for case: Funchess v. State\">399 So. 2d 356</a></span>.</p>\n</opinion>"},{"id":9028818,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b845-7\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AZQ5\">dissenting.</p>\n<p id=\"b845-8\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}