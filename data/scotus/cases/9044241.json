{"id":9044241,"docketId":66310468,"caseName":"Quintana v. Virginia","caseNameFull":"Quintana v. Virginia","slug":"quintana-v-virginia","docketNumber":"No. 82-6035","dateFiled":"1983-03-07","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9037603,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":589,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b959-6\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A11\">dissenting.</p>\n<p id=\"AqzQ\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}