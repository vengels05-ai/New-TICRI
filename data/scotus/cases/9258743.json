{"id":9258743,"docketId":66526165,"caseName":"In re Disbarment of Albanese","caseNameFull":"In re Disbarment of Albanese","slug":"in-re-disbarment-of-albanese","docketNumber":"No. D-2194","dateFiled":"2000-11-27","dateArgued":null,"dateCertGranted":null,"year":2000,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9253560,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":441,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AXM7\">Joseph P. Albanese, of New York, N. Y., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on August 28, 2000 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./530/1295/\">530 U. S. 1295</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}