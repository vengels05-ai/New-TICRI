{"id":8984426,"docketId":66250642,"caseName":"Quintana v. Texas","caseNameFull":"Quintana v. Texas Wigglesworth v. Ohio Crain v. Beto, Corrections Director Wilson v. Florida Pemberton v. Ohio Ladetto v. Massachusetts Turner v. Texas Bernette v. Illinois and Tajra v. Illinois Harris v. Texas","slug":"quintana-v-texas","docketNumber":"No. 5077; No. 5080; No. 5086; No. 5094; No. 5114; No. 5142; No. 5288; No. 5887; No. 6049; No. 6458","dateFiled":"1971-06-28","dateArgued":null,"dateCertGranted":null,"year":1971,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":22,"judges":"Black","jurisdictionType":"","opinions":[{"id":8976389,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2929,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AVd2\">Ct. Crim. App. Tex. Reported below: <span class=\"citation\" data-id=\"2405938\"><a href=\"/opinion/2405938/quintana-v-state/\" aria-description=\"Citation for case: Quintana v. State\">441 S. W. 2d 191</a></span>;</p>\n<p id=\"ANYb\">Sup. Ct. Ohio. Reported below: <span class=\"citation\" data-id=\"6754189\"><a href=\"/opinion/6864424/state-v-wigglesworth/\" aria-description=\"Citation for case: State v. Wigglesworth\">18 Ohio St. 2d 171</a></span>, <span class=\"citation\" data-id=\"6754189\"><a href=\"/opinion/6864424/state-v-wigglesworth/\" aria-description=\"Citation for case: State v. Wigglesworth\">248 N. E. 2d 607</a></span>;</p>\n<p id=\"AHE\">Ct. Crim. App. Tex. ;</p>\n<p id=\"AjhF\">Sup. Ct. Fla. Reported below: <span class=\"citation\" data-id=\"1840096\"><a href=\"/opinion/1840096/wilson-v-state/\" aria-description=\"Citation for case: Wilson v. State\">225 So. 2d 321</a></span>;</p>\n<p id=\"ABqm\">Sup. Ct. Ohio;</p>\n<p id=\"ARD9\">Sup. Jud. Ct. Mass. Reported below: <span class=\"citation\" data-id=\"2212773\"><a href=\"/opinion/2212773/ladetto-v-commonwealth/\" aria-description=\"Citation for case: Ladetto v. Commonwealth\">356 Mass. 541</a></span>, <span class=\"citation\" data-id=\"2212773\"><a href=\"/opinion/2212773/ladetto-v-commonwealth/\" aria-description=\"Citation for case: Ladetto v. Commonwealth\">254 N. E. 2d 415</a></span>;</p>\n<p id=\"AVJ\">Ct. Crim. App. Tex. Reported below: <span class=\"citation\" data-id=\"9673643\"><a href=\"/opinion/1724670/turner-v-state/\" aria-description=\"Citation for case: Turner v. State\">462 S. W. 2d 9</a></span>;</p>\n<p id=\"Akqo\">Sup. Ct., Ill. Reported below: <span class=\"citation\" data-id=\"9884741\"><a href=\"/opinion/2133915/the-people-v-bernette/\" aria-description=\"Citation for case: The People v. Bernette\">45 Ill. 2d 227</a></span>, <span class=\"citation\" data-id=\"9884741\"><a href=\"/opinion/2133915/the-people-v-bernette/\" aria-description=\"Citation for case: The People v. Bernette\">258 N. E. 2d 793</a></span>; and</p>\n<p id=\"A3o\">Ct. Crim. App. Tex. Motions for leave to proceed <em>in forma pauperis </em>and cer-tiorari granted. Judgments, insofar as they impose the death-sentence, reversed and cases remanded for further proceedings. <em>Witherspoon </em>v. <em>Illinois, </em><span class=\"citation\" data-id=\"9423729\"><a href=\"/opinion/107715/witherspoon-v-illinois/\" aria-description=\"Citation for case: Witherspoon v. Illinois\">391 U. S. 510</a></span> (1968); <em>Boulden </em>v. <em>Holman, </em><span class=\"citation\" data-id=\"9423981\"><a href=\"/opinion/107893/boulden-v-holman/\" aria-description=\"Citation for case: Boulden v. Holman\">394 U. S. 478</a></span> (1960); and <em>Maxwell </em>v. <em>Bishop, </em><span class=\"citation\" data-id=\"9424284\"><a href=\"/opinion/108155/maxwell-v-bishop/\" aria-description=\"Citation for case: Maxwell v. Bishop\">398 U. S. 262</a></span> (1970).</p>\n<judges id=\"AqgP\">Mr. Justice Black dissents.</judges>\n</opinion>"}],"citations":[]}