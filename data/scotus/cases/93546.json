{"id":93546,"docketId":2044073,"caseName":"In Re Schneider","caseNameFull":"","slug":"in-re-schneider","docketNumber":"","dateFiled":"1893-03-14","dateArgued":null,"dateCertGranted":null,"year":1893,"scdbId":"1892-135","direction":"Conservative","votesMajority":8,"votesMinority":0,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":6,"judges":"","jurisdictionType":"","opinions":[{"id":93546,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2505,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8140608\"><a href=\"/opinion/8178693/in-re-schneider/\" aria-description=\"Citation for case: In re Schneider\">148 U.S. 157</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"93552\"><a href=\"/opinion/93552/passavant-v-united-states/\" aria-description=\"Citation for case: Passavant v. United States\">13 S.Ct. 572</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">37 L.Ed. 404</span></p>\n    <p class=\"parties\">In re SCHNEIDER.</p>\n    <p class=\"docket\">No. ____.</p>\n    <p class=\"date\">March 14, 1893.</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Jeremiah M. Wilson, William F. Mattingly, and A. A. Hoehling, Jr., for petitioner.</p>\n      <p class=\"indent\">[Argument of Counsel from pages 158-162 intentionally omitted]</p>\n      <p class=\"indent\">Mr. Chief Justice FULLER.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The application for a writ of error or appeal is denied upon the authority of Cross v. Burke, <span class=\"citation\" data-id=\"93420\"><a href=\"/opinion/93420/cross-v-burke/\" aria-description=\"Citation for case: Cross v. Burke\">146 U. S. 82</a></span>, 13 Sup. Ct. Rep. 22; In re Heath, <span class=\"citation\" data-id=\"93301\"><a href=\"/opinion/93301/in-re-heath/\" aria-description=\"Citation for case: In Re Heath\">144 U. S. 92</a></span>, 12 Sup. Ct. Rep. 615; In re Cross, <span class=\"citation\" data-id=\"93438\"><a href=\"/opinion/93438/in-re-cross/\" aria-description=\"Citation for case: In Re Cross\">146 U. S. 271</a></span>, 13 Sup. Ct. Rep. 109; Cross v. U. S., <span class=\"citation\" data-id=\"93408\"><a href=\"/opinion/93408/cross-v-united-states/\" aria-description=\"Citation for case: Cross v. United States\">145 U. S. 571</a></span>, 12 Sup. Ct. Rep. 842. See, also, Railroad Co. v. Grant, <span class=\"citation\" data-id=\"89879\"><a href=\"/opinion/89879/railroad-co-v-grant/\" aria-description=\"Citation for case: Railroad Co. v. Grant\">98 U. S. 398</a></span>; Dennison v. Alexander, <span class=\"citation\" data-id=\"90355\"><a href=\"/opinion/90355/dennison-v-alexander/\" aria-description=\"Citation for case: Dennison v. Alexander\">103 U. S. 522</a></span>; U. S. v. Wanamaker, <span class=\"citation\" data-id=\"93479\"><a href=\"/opinion/93479/united-states-ex-rel-trask-v-wanamaker/\" aria-description=\"Citation for case: UNITED STATES Ex Rel. TRASK v. WANAMAKER\">147 U. S. 149</a></span>, 13 Sup. Ct. Rep. 279.</p>\n    </div>\n    "}],"citations":[]}