{"id":9165131,"docketId":66431436,"caseName":"In re Disbarment of Friedman","caseNameFull":"In re Disbarment of Friedman","slug":"in-re-disbarment-of-friedman","docketNumber":"No. D-1790","dateFiled":"1997-05-12","dateArgued":null,"dateCertGranted":null,"year":1997,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9159844,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":372,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Azsr\">Bruce Michael Friedman, of Los Angeles, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on March 24, 1997 <em>[ante, </em>p. 1141], is discharged.</p>\n</opinion>"}],"citations":[]}