{"id":8955648,"docketId":66221863,"caseName":"Dearhart v. Virginia","caseNameFull":"DEARHART v. VIRGINIA","slug":"dearhart-v-virginia","docketNumber":"No. 745, Misc.","dateFiled":"1963-06-17","dateArgued":null,"dateCertGranted":null,"year":1963,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., Reno S. Harp III, Assistant Attorney General of Virginia, for respondent.","natureOfSuit":"","citationCount":4,"judges":"Clark, Harlan","jurisdictionType":"","opinions":[{"id":8946631,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":801,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b554-9\">Per Curiam.</author>\n<p id=\"b554-10\">The motion for leave to proceed <em>in forma pauperis </em>and the petition for writ of certiorari are granted. The judgment is vacated and the case is remanded for further consideration in light of <em>Douglas </em>v. <em>California, </em><span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U. S. 353</a></span>, and <em>Burns </em>v. <em>Ohio, </em><span class=\"citation\" data-id=\"9421835\"><a href=\"/opinion/105911/burns-v-ohio/\" aria-description=\"Citation for case: Burns v. Ohio\">360 U. S. 252</a></span>.</p>\n<judges id=\"b554-11\">Mr. Justice Clark and Mr. Justice Harlan concur in the result.</judges>\n</opinion>"}],"citations":[]}