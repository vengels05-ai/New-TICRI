{"id":84657,"docketId":2042172,"caseName":"Shaw v. Wallace","caseNameFull":"","slug":"shaw-v-wallace","docketNumber":"","dateFiled":"1792-09-01","dateArgued":null,"dateCertGranted":null,"year":1792,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"","jurisdictionType":"","opinions":[{"id":84657,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1185,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8373551\"><a href=\"/opinion/8403213/shaw-v-wallace/\" aria-description=\"Citation for case: Shaw v. Wallace\">2 U.S. 179</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">2 Dall. 179</span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">1 L.Ed. 339</span></p>\n    <p class=\"parties\">Shaw<br>v.<br>Wallace</p>\n    <p class=\"court\">Supreme Court of Pennsylvania</p>\n    <p class=\"date\">September Term, 1792</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">This cause was set down for trial; but was afterwards continued by the plaintiff. The defendant's attorney, prayed a rule might be granted for security for costs, the plaintiff residing in New York. Moylan, objected, that the motion came too late, after the cause had been marked for trial.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">But, By the Court: It is never too late to grant the rule, when it will not delay the trial.</p>\n    </div>\n    <div class=\"num\" id=\"p3\">\n      <span class=\"num\">3</span>\n      <p>Rule granted.</p>\n    </div>\n    "}],"citations":[]}