{"id":9066931,"docketId":66333182,"caseName":"In re Disbarment of Tucker","caseNameFull":"In re Disbarment of Tucker","slug":"in-re-disbarment-of-tucker","docketNumber":"No. D-600","dateFiled":"1987-03-23","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9060612,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AAT2\">Robert L. Tucker, of Chicago, Ill., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on January 12, 1987 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./479/1026/\">479 U. S. 1026</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}