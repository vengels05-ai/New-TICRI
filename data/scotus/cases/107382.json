{"id":107382,"docketId":1771612,"caseName":"Otwell v. California","caseNameFull":"William Gerald Otwell v. California","slug":"otwell-v-california","docketNumber":"44, Misc","dateFiled":"1967-03-13","dateArgued":null,"dateCertGranted":null,"year":1967,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":"<p>Mise.</p>","headnotes":null,"proceduralHistory":null,"attorneys":"Alf Stavig for petitioner.","natureOfSuit":"","citationCount":1,"judges":"Stewart, California","jurisdictionType":"","opinions":[{"id":107382,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":722,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"5\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b354-8\">\n  Per Curiam.\n </author>\n<p id=\"b354-9\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are granted. The judgment is vacated and the case remanded for further consideration in light of\n  <em>\n   Chapman\n  </em>\n  v.\n  <em>\n   California, ante,\n  </em>\n  p. 18.\n </p>\n<judges id=\"b354-11\">\n  Mr. Justice Stewart would grant certiorari and reverse the judgment for the-reasons stated in his opinion concurring in the result in\n  <em>\n   Chapman\n  </em>\n  v.\n  <em>\n   California, ante,\n  </em>\n  at 42.\n </judges>\n</opinion>"}],"citations":[]}