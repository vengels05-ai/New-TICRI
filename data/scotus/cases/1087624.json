{"id":1087624,"docketId":441535,"caseName":"Mayberry v. Pennsylvania","caseNameFull":"Mayberry v. Pennsylvania","slug":"mayberry-v-pennsylvania","docketNumber":"11, Misc","dateFiled":"1965-12-13","dateArgued":null,"dateCertGranted":null,"year":1965,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":7,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":1087624,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":536,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b430-8\">\n  Per Curiam.\n </author>\n<p id=\"b430-9\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are granted. Upon consideration of the concessions of the State and an examination of the papers in the case, the judgment of the Supreme Court of Pennsylvania is vacated and the case remanded to that court for further proceedings.\n </p>\n</opinion>"}],"citations":[]}