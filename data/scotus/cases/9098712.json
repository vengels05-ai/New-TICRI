{"id":9098712,"docketId":66364981,"caseName":"In re Disbarment of Johnson","caseNameFull":"In re Disbarment of Johnson","slug":"in-re-disbarment-of-johnson","docketNumber":"No. D-896","dateFiled":"1990-06-18","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9093019,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":455,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AbDD\">Charles B. Johnson, of Pasadena, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on April 23, 1990 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./495/902/\">495 U. S. 902</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}