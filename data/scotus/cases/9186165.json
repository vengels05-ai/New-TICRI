{"id":9186165,"docketId":66452476,"caseName":"In re Disbarment of Martucci","caseNameFull":"In re Disbarment of Martucci","slug":"in-re-disbarment-of-martucci","docketNumber":"No. D-2018","dateFiled":"1999-04-26","dateArgued":null,"dateCertGranted":null,"year":1999,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9180914,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":438,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AnOb\">Joseph C. Martucei, of Miami, Fla., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on December 7, 1998 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./525/1039/\">525 U. S. 1039</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}