{"id":109346,"docketId":126256,"caseName":"Dove v. United States","caseNameFull":"Dove v. United States","slug":"dove-v-united-states","docketNumber":"75-543","dateFiled":"1976-01-19","dateArgued":null,"dateCertGranted":null,"year":1976,"scdbId":"1975-026","direction":"Conservative","votesMajority":8,"votesMinority":1,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":131,"judges":"White","jurisdictionType":"","opinions":[{"id":109346,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":917,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion type=\"majority\">\n<author id=\"b457-8\">\n  Per Curiam.\n </author>\n<p id=\"b457-9\">\n  The Court is advised that the petitioner died at New Bern, N. C., on November 14, 1975. The petition for certiorari is therefore dismissed. To the extent that\n  <em>\n   Durham\n  </em>\n  v.\n  <em>\n   United States,\n  </em>\n  <span class=\"citation\" data-id=\"9424482\"><a href=\"/opinion/108288/durham-v-united-states/\" aria-description=\"Citation for case: Durham v. United States\">401 U. S. 481</a></span> (1971), may be inconsistent with this ruling,\n  <em>\n   <span class=\"citation\" data-id=\"9424482\"><a href=\"/opinion/108288/durham-v-united-states/\" aria-description=\"Citation for case: Durham v. United States\">Durham</a></span>\n  </em>\n  is overruled.\n </p>\n<p id=\"b457-10\">\n<em>\n   It is so ordered.\n  </em>\n</p>\n<judges id=\"b457-11\">\n  Mr. Justice White dissents.\n </judges>\n</opinion>"}],"citations":[]}