{"id":9048641,"docketId":66314883,"caseName":"Evans v. Mississippi","caseNameFull":"Evans v. Mississippi Delap v. Florida","slug":"evans-v-mississippi","docketNumber":"No. 83-6213; No. 83-6419","dateFiled":"1984-06-25","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9042052,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":491,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ATp0\">Sup. Ct. Miss.; and</p>\n<p id=\"Aay\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 83-6213, <span class=\"citation\" data-id=\"9944289\"><a href=\"/opinion/1737546/evans-v-state/\" aria-description=\"Citation for case: Evans v. State\">441 So. 2d 520</a></span>; No. 83-6419, <span class=\"citation\" data-id=\"1830378\"><a href=\"/opinion/1830378/delap-v-state/\" aria-description=\"Citation for case: Delap v. State\">440 So. 2d 1242</a></span>.</p>\n</opinion>"},{"id":9042053,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":598,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1178-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A4Jp\">dissenting.</p>\n<p id=\"b1178-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}