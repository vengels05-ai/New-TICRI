{"id":9048186,"docketId":66314428,"caseName":"Clark v. Florida","caseNameFull":"Clark v. Florida Parks v. Oklahoma Cone v. Tennessee Barfield v. Harris, Superintendent, North Carolina Correctional Center for Women Laws v. Missouri","slug":"clark-v-florida","docketNumber":"No. 83-6421; No. 83-6453; No. 83-6490; No. 83-6610; No. 83-6625","dateFiled":"1984-05-21","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9041588,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1036,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AOlZ\">Sup. Ct. Fla.;</p>\n<p id=\"A31k\">Ct. Crim. App. Okla.;</p>\n<p id=\"AsCy\">Sup. Ct. Tenn.;</p>\n<p id=\"AqD\">C. A. 4th Cir.; and</p>\n<p id=\"ApZO\">Sup. Ct. Mo. Certiorari denied. Reported below: No. 83-6421, <span class=\"citation\" data-id=\"1889637\"><a href=\"/opinion/1889637/clark-v-state/\" aria-description=\"Citation for case: Clark v. State\">443 So. 2d 973</a></span>; No. 83-6490, <span class=\"citation\" data-id=\"1505581\"><a href=\"/opinion/1505581/state-v-cone/\" aria-description=\"Citation for case: State v. Cone\">665 S. W. 2d 87</a></span>; No. 83-6610, <span class=\"citation\" data-id=\"425985\"><a href=\"/opinion/425985/margie-bullard-barfield-v-kenneth-w-harris-supt-nc-correctional/\" aria-description=\"Citation for case: Margie Bullard Barfield v. Kenneth W. Harris, Supt., N.C....\">719 F. 2d 58</a></span>; No. 83-6625, <span class=\"citation\" data-id=\"1787600\"><a href=\"/opinion/1787600/state-v-laws/\" aria-description=\"Citation for case: State v. Laws\">661 S. W. 2d 526</a></span>.</p>\n</opinion>"},{"id":9041589,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":592,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1125-4\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A14\">dissenting.</p>\n<p id=\"Ale\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}