{"id":102417,"docketId":2045797,"caseName":"Anthony J. Drexel Biddle, Jr. v. Irving Trust Company, as Trustee, Etc.","caseNameFull":"","slug":"anthony-j-drexel-biddle-jr-v-irving-trust-company-as-trustee-etc","docketNumber":"589","dateFiled":"1935-02-04","dateArgued":null,"dateCertGranted":null,"year":1935,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":102417,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1701,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./294/708/\">294 U.S. 708</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./55/405/\">55 S.Ct. 405</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">79 L.Ed. 1243</span></p>\n    <p class=\"parties\">Anthony J. Drexel BIDDLE, Jr., petitioner,<br>v.<br>IRVING TRUST COMPANY, as Trustee, etc.<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a></p>\n    <p class=\"docket\">No. 589.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">January 21, 1935</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Messrs. Eldon Bisbee and Paul D. Miller, both of New York City, for petitioner.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">For opinion below, see Irving Trust Co. v. Deutsch, <span class=\"citation\" data-id=\"1547266\"><a href=\"/opinion/1547266/irving-trust-co-v-deutsch/\" aria-description=\"Citation for case: Irving Trust Co. v. Deutsch\">73 F.(2d) 121</a></span>.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"ind