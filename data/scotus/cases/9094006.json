{"id":9094006,"docketId":66360268,"caseName":"Alley v. Tennessee","caseNameFull":"Alley v. Tennessee Lesko v. Owens, Commissioner, Pennsylvania Department of Corrections Spencer v. Virginia Walton v. Florida Heidnik v. Pennsylvania","slug":"alley-v-tennessee","docketNumber":"No. 89-5697; No. 89-5935; No. 89-6068; No. 89-6078; No. 89-6191","dateFiled":"1990-01-08","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9088222,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1070,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A3h7\">Sup. Ct. Tenn.;</p>\n<p id=\"AjJq\">C. A. 3d Cir.;</p>\n<p id=\"AF80\">Sup. Ct. Va.;</p>\n<p id=\"Azsn\">Sup. Ct. Fla.; and</p>\n<p id=\"AtQ9\">Sup. Ct. Pa. Certiorari denied. Reported below: No. 89-5697, <span class=\"citation\" data-id=\"1775821\"><a href=\"/opinion/1775821/state-v-alley/\" aria-description=\"Citation for case: State v. Alley\">776 S. W. 2d 506</a></span>; No. 89-5935, <span class=\"citation multiple-matches\"><a href=\"/c/F.%202d/881/44/\">881 F. 2d 44</a></span>; No. 89-6068, <span class=\"citation\" data-id=\"1203667\"><a href=\"/opinion/1203667/spencer-v-commonwealth/\" aria-description=\"Citation for case: Spencer v. Commonwealth\">238 Va. 275</a></span>, <span class=\"citation\" data-id=\"1203667\"><a href=\"/opinion/1203667/spencer-v-commonwealth/\" aria-description=\"Citation for case: Spencer v. Commonwealth\">384 S. E. 2d 775</a></span>; No. 89-6078, <span class=\"citation\" data-id=\"1861522\"><a href=\"/opinion/1861522/walton-v-state/\" aria-description=\"Citation for case: Walton v. State\">547 So. 2d 622</a></span>.</p>\n</opinion>"},{"id":9088223,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b975-4\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AGyQ\">dissenting.</p>\n<p id=\"ATWJ\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}