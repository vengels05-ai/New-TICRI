{"id":9037229,"docketId":66303455,"caseName":"High v. Georgia","caseNameFull":"High v. Georgia Roach v. South Carolina Coppola v. Warden, Virginia State Penitentiary Morgan v. Montgomery, Warden, Georgia State Prison Wallace v. Georgia","slug":"high-v-georgia","docketNumber":"No. 80-6843; No. 81-5628; No. 81-5687; No. 81-5749; No. 81-5801","dateFiled":"1982-01-25","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":9,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9030546,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1251,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AAnV\">Sup. Ct. Ga.;</p>\n<p id=\"A3X\">Sup. Ct. S. C.;</p>\n<p id=\"Ao9x\">Sup. Ct. Va.;</p>\n<p id=\"Asyg\">Sup. Ct. Ga.; and</p>\n<p id=\"APm\">Sup. Ct. Ga. Cer-tiorari denied. Reported below: No. 80-6843, <span class=\"citation\" data-id=\"1252360\"><a href=\"/opinion/1252360/high-v-state/\" aria-description=\"Citation for case: High v. State\">247 Ga. 289</a></span>, <span class=\"citation\" data-id=\"1252360\"><a href=\"/opinion/1252360/high-v-state/\" aria-description=\"Citation for case: High v. State\">276 S. E. 2d 5</a></span>; No. 81-5687, <span class=\"citation\" data-id=\"6823882\"><a href=\"/opinion/6927621/coppola-v-warden-of-virginia-state-penitentiary/\" aria-description=\"Citation for case: Coppola v. Warden of Virginia State Penitentiary\">222 Va. 369</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20E.%202d/282/10/\">282 S. E. 2d 10</a></span>; No. 81-5801, <span class=\"citation\" data-id=\"1275581\"><a href=\"/opinion/1275581/wallace-v-state/\" aria-description=\"Citation for case: Wallace v. State\">248 Ga. 255</a></span>, <span class=\"citation\" data-id=\"1275581\"><a href=\"/opinion/1275581/wallace-v-state/\" aria-description=\"Citation for case: Wallace v. State\">282 S. E. 2d 325</a></span>.</p>\n</opinion>"},{"id":9030547,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":596,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b891-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AuAj\">dissenting.</p>\n<p id=\"b891-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}