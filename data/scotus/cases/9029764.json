{"id":9029764,"docketId":66295986,"caseName":"Scott v. Florida","caseNameFull":"Scott v. Florida Jones v. Mississippi Russell v. Texas","slug":"scott-v-florida","docketNumber":"No. 80-5216; No. 80-5335; No. 80-5495","dateFiled":"1980-11-17","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":90,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9023043,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":470,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AMeq\">Sup. Ct. Fla.;</p>\n<p id=\"AC8L\">Sup. Ct. Miss.; and</p>\n<p id=\"AxLk\">Ct. Crim. App. Tex. Certiorari denied. Reported below: No. 80-5335, <span class=\"citation multiple-matches\"><a href=\"/c/So.%202d/381/983/\">381 So. 2d 983</a></span>; No. 80-5495, <span class=\"citation\" data-id=\"9773072\"><a href=\"/opinion/2437550/russell-v-state/\" aria-description=\"Citation for case: Russell v. State\">598 S. W. 2d 238</a></span>.</p>\n</opinion>"},{"id":9023044,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1017-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A4lC\">dissenting.</p>\n<p id=\"b1017-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}