{"id":9138896,"docketId":66405191,"caseName":"In re Disbarment of Griffin","caseNameFull":"In re Disbarment of Griffin","slug":"in-re-disbarment-of-griffin","docketNumber":"No. D-1402","dateFiled":"1994-08-02","dateArgued":null,"dateCertGranted":null,"year":1994,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9133571,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AnVn\">James H. Griffin, of Los Angeles, Cal., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 6, 1994 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./511/1140/\">511 U. S. 1140</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}