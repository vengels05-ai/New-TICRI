{"id":9069127,"docketId":66335378,"caseName":"Griffith v. Illinois","caseNameFull":"Griffith v. Illinois","slug":"griffith-v-illinois","docketNumber":"No. 86-1096","dateFiled":"1987-06-08","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"White","jurisdictionType":"","opinions":[{"id":9062842,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":233,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Abf\">Appeal from App. Ct. Ill., 5th Dist., dismissed for want of jurisdiction. Treating the papers whereon the appeal was taken as a petition for writ of cer-tiorari, certiorari denied.</p>\n</opinion>"},{"id":9062843,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"White","joinedBy":"","pageCount":null,"textLength":596,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b820-19\">Justice White,</author>\n<p id=\"AgI\">dissenting.</p>\n<p id=\"b820-20\">I agree with the majority that this case is not a proper appeal but, for the reason stated in my dissent from denial of certiorari in <em>Nyflot </em>v. <em>Minnesota Commissioner of Public Safety, </em><span class=\"citation\" data-id=\"9430322\"><a href=\"/opinion/111585/nyflot-v-minnesota-commissioner-of-public-safety/\" aria-description=\"Citation for case: Nyflot v. Minnesota Commissioner of Public Safety\">474 U. S. 1027</a></span> (1985), I would grant certiorari.</p>\n</opinion>"}],"citations":[]}