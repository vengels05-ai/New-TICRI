{"id":9091221,"docketId":66357483,"caseName":"Hudson v. Florida","caseNameFull":"Hudson v. Florida","slug":"hudson-v-florida","docketNumber":"No. 88-7232","dateFiled":"1989-10-02","dateArgued":null,"dateCertGranted":null,"year":1989,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Certiorari, Marshall","jurisdictionType":"","opinions":[{"id":9085396,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":155,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AQF4m\">Sup. Ct. Fla. Certiorari denied.</p>\n<judges id=\"AYXP\">Justice Blackmun would grant certiorari.</judges>\n</opinion>"},{"id":9085397,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b813-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AmPt\">dissenting.</p>\n<p id=\"b813-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}