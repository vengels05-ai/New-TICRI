{"id":9349758,"docketId":66663129,"caseName":"In re Disbarment of Moushey","caseNameFull":"In re Disbarment of Moushey","slug":"in-re-disbarment-of-moushey","docketNumber":"No. D-393","dateFiled":"1984-02-21","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9345218,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":459,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Atp3\">Charles L. Moushey, of Alliance, Ohio, having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on January 16, 1984 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./464/1066/\">464 U. S. 1066</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}