{"id":93070,"docketId":2285582,"caseName":"Birdseye v. Shaeffer","caseNameFull":"","slug":"birdseye-v-shaeffer","docketNumber":"","dateFiled":"1891-04-27","dateArgued":null,"dateCertGranted":null,"year":1891,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"","jurisdictionType":"","opinions":[{"id":93070,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1542,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"2620985\"><a href=\"/opinion/2620985/birdseye-v-schaeffer/\" aria-description=\"Citation for case: Birdseye v. Schaeffer\">140 U.S. 117</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./11/885/\">11 S.Ct. 885</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"2620985\"><a href=\"/opinion/2620985/birdseye-v-schaeffer/\" aria-description=\"Citation for case: Birdseye v. Schaeffer\">35 L.Ed. 402</a></span></p>\n    <p class=\"parties\">BIRDSEYE<br>v.<br>SHAEFFER <i>et al</i>.</p>\n    <p class=\"date\">April 27, 1891.</p>\n    <div class=\"prelims\">\n      <p class=\"indent\"><i>Phil B. Thompson</i> and <i>J. M. Vale</i>, for motion.</p>\n      <p class=\"indent\"><i>Bethel Coopwood and John Hancock</i>, opposed.</p>\n      <p class=\"indent\">FULLER, C. J.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The writ of error is dismissed upon the authority of Gurnee v. County of Patrick, <span class=\"citation\" data-id=\"92865\"><a href=\"/opinion/92865/gurnee-v-patrick-county/\" aria-description=\"Citation for case: Gurnee v. Patrick County\">137 U. S. 141</a></span>, 11 Sup. Ct. Rep. 34; Railroad Co. v. Thouron, <span class=\"citation\" data-id=\"92706\"><a href=\"/opinion/92706/richmond-danville-railroad-v-thouron/\" aria-description=\"Citation for case: Richmond &amp; Danville Railroad v. Thouron\">134 U. S. 45</a></span>, 10 Sup. Ct. Rep. 517. Writ of error dismissed.</p>\n    </div>\n    "}],"citations":[]}