{"id":9043138,"docketId":66309365,"caseName":"Bolder v. Missouri","caseNameFull":"Bolder v. Missouri Melson v. Tennessee","slug":"bolder-v-missouri","docketNumber":"No. 82-5648; No. 82-5698","dateFiled":"1983-01-10","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9036491,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":498,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AvjE\">Sup. Ct. Mo.; and</p>\n<p id=\"AMbv\">Sup. Ct. Tenn. Certiorari denied. Reported below: No. 82-5648, <span class=\"citation\" data-id=\"9768357\"><a href=\"/opinion/2410074/state-v-bolder/\" aria-description=\"Citation for case: State v. Bolder\">635 S. W. 2d 673</a></span>; No. 82-5698, <span class=\"citation\" data-id=\"9774054\"><a href=\"/opinion/2442934/state-v-melson/\" aria-description=\"Citation for case: State v. Melson\">638 S. W. 2d 342</a></span>.</p>\n</opinion>"},{"id":9036492,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1071-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AnWK\">dissenting.</p>\n<p id=\"b1071-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}