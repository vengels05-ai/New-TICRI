{"id":7344187,"docketId":64332680,"caseName":"Wills v. Tilton","caseNameFull":"Dale Wills v. James Tilton","slug":"wills-v-tilton","docketNumber":"10-9028","dateFiled":"2011-04-18","dateArgued":null,"dateCertGranted":null,"year":2011,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":7262141,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1333,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Avou\">Motion of petitioner for leave to proceed in forma pauperis denied, and petition for writ of certiorari to the <page-number citation-index=\"1\" label=\"887\">*887</page-number>Court of Appeal of California, Fifth Appellate District, dismissed. See Rule 39.8. As the petitioner has repeatedly abused this Court\u2019s process, the Clerk is directed not to accept any further petitions in noncriminal matters from petitioner unless the docketing fee required by Rule 38(a) is paid and petition submitted in compliance with Rule 33.1. See Martin v. District of Columbia Court of Appeals, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">506 U.S. 1</a></span>, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">113 S. Ct. 397</a></span>, <span class=\"citation\" data-id=\"9432691\"><a href=\"/opinion/112790/martin-v-district-of-columbia-court-of-appeals/\" aria-description=\"Citation for case: Martin v. District of Columbia Court of Appeals\">121 L. Ed. 2d 305</a></span> (1992) (per curiam).</p>\n</opinion>"}],"citations":[]}