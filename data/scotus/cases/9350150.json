{"id":9350150,"docketId":66663521,"caseName":"Russell v. Texas","caseNameFull":"Russell v. Texas Gilbert v. New Mexico Williams v. Tennessee Smith v. Arizona Engle v. Florida Teffeteller v. Florida","slug":"russell-v-texas","docketNumber":"No. 83-5799; No. 83-5943; No. 83-6016; No. 83-6020; No. 83-6043; No. 83-6148","dateFiled":"1984-02-27","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":169,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9345613,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1923,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ADXQ\">Ct. Crim. App. Tex.;</p>\n<p id=\"AAI\">Sup. Ct. N. M.;</p>\n<p id=\"AAXr\">Sup. Ct. Tenn.;</p>\n<docketnumber id=\"AsUK\"><page-number citation-index=\"1\" label=\"1074\">*1074</page-number>No. 83-6020.</docketnumber>\n<docketnumber id=\"AOOM\">No. 83-6043.</docketnumber>\n<docketnumber id=\"ADf\">No. 83-6148.</docketnumber>\n<parties id=\"Arzt\">Smith <em>v. </em>Arizona.</parties>\n<parties id=\"ADPn\">Engle <em>v. </em>Florida.</parties>\n<parties id=\"A_qD\">Teffeteller <em>v. </em>Florida.</parties>\n<p id=\"Ake\">Sup. Ct. Ariz.;</p>\n<p id=\"A6MH\">Sup. Ct. Fla.; and</p>\n<p id=\"AWZ1\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 83-5799, <span class=\"citation\" data-id=\"5059778\"><a href=\"/opinion/5234651/state-v-turner/\" aria-description=\"Citation for case: State v. Turner\">655 S. W. 2d 711</a></span>; No. 83-5943, 100 N. M. 392, <span class=\"citation\" data-id=\"9790091\"><a href=\"/opinion/2605164/state-v-gilbert/\" aria-description=\"Citation for case: State v. Gilbert\">671 P. 2d 640</a></span>; No. 83-6016, <span class=\"citation\" data-id=\"9677807\"><a href=\"/opinion/1753160/state-v-williams/\" aria-description=\"Citation for case: State v. Williams\">657 S. W. 2d 405</a></span>; No. 83-6020, <span class=\"citation\" data-id=\"9587904\"><a href=\"/opinion/1259664/state-v-smith/\" aria-description=\"Citation for case: State v. Smith\">138 Ariz. 79</a></span>, <span class=\"citation\" data-id=\"9587904\"><a href=\"/opinion/1259664/state-v-smith/\" aria-description=\"Citation for case: State v. Smith\">673 P. 2d 17</a></span>; No. 83-6043, <span class=\"citation\" data-id=\"1840793\"><a href=\"/opinion/1840793/engle-v-state/\" aria-description=\"Citation for case: Engle v. State\">438 So. 2d 803</a></span>; No. 83-6148, <span class=\"citation\" data-id=\"1677294\"><a href=\"/opinion/1677294/teffeteller-v-state/\" aria-description=\"Citation for case: Teffeteller v. State\">439 So. 2d 840</a></span>.</p>\n</opinion>"},{"id":9345614,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":596,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1050-5\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AlP\">dissenting.</p>\n<p id=\"b1050-6\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}