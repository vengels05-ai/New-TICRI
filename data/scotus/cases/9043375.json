{"id":9043375,"docketId":66309602,"caseName":"Horton v. Georgia","caseNameFull":"Horton v. Georgia Blair v. Missouri Trimble v. Missouri","slug":"horton-v-georgia","docketNumber":"No. 82-5793; No. 82-5834; No. 82-5861","dateFiled":"1983-01-24","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":141,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9036731,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":869,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AoI8\">Sup. Ct. Ga.;</p>\n<p id=\"A6v2\">Sup. Ct. Mo.; and</p>\n<p id=\"AGap\">Sup. Ct. Mo. Certiorari denied. Reported below: No. 82-5793, <span class=\"citation\" data-id=\"1342169\"><a href=\"/opinion/1342169/horton-v-state/\" aria-description=\"Citation for case: Horton v. State\">249 Ga. 871</a></span>, <span class=\"citation\" data-id=\"1342169\"><a href=\"/opinion/1342169/horton-v-state/\" aria-description=\"Citation for case: Horton v. State\">295 S. E. 2d 281</a></span>; No. 82-5834, <span class=\"citation\" data-id=\"9774010\"><a href=\"/opinion/2442795/state-v-blair/\" aria-description=\"Citation for case: State v. Blair\">638 S. W. 2d 739</a></span>; No. 82-5861, <span class=\"citation\" data-id=\"9774037\"><a href=\"/opinion/2442868/state-v-trimble/\" aria-description=\"Citation for case: State v. Trimble\">638 S. W. 2d 726</a></span>.</p>\n</opinion>"},{"id":9036732,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1123-4\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A3bi\">dissenting.</p>\n<p id=\"b1123-5\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}