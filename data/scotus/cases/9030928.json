{"id":9030928,"docketId":66297150,"caseName":"In re Disbarment of Donnelly","caseNameFull":"In re Disbarment of Donnelly","slug":"in-re-disbarment-of-donnelly","docketNumber":"No. D-38","dateFiled":"1981-02-23","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9024214,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":463,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AnT\">John J. Donnelly, Jr., of Washington, D. C., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on February 24, 1975 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./420/941/\">420 U. S. 941</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}