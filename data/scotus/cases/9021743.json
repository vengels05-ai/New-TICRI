{"id":9021743,"docketId":66287960,"caseName":"Bodde v. Texas","caseNameFull":"Bodde v. Texas","slug":"bodde-v-texas","docketNumber":"No. 78-5535","dateFiled":"1979-03-19","dateArgued":null,"dateCertGranted":null,"year":1979,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":66,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9014958,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":111,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A4V58\">Ct. Crim. App. Tex. Cer-</p>\n<p id=\"A1F\">tiorari denied.</p>\n</opinion>"},{"id":9014959,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":600,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b910-8\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"AWfb\">dissenting.</p>\n<p id=\"b910-9\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}