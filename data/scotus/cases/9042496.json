{"id":9042496,"docketId":66308723,"caseName":"In re Disbarment of Fendler","caseNameFull":"In re Disbarment of Fendler","slug":"in-re-disbarment-of-fendler","docketNumber":"No. D-292","dateFiled":"1982-11-29","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9035845,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":527,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Atlt\">Robert Harold Fendler, of Phoenix, Ariz., having requested to resign as a member of the Bar of this Court, it is ordered that <page-number citation-index=\"1\" label=\"1028\">*1028</page-number>his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on September 9, 1982 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./458/1128/\">458 U. S. 1128</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}