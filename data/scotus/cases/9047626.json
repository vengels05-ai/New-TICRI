{"id":9047626,"docketId":66313868,"caseName":"Tomlin v. Alabama","caseNameFull":"Tomlin v. Alabama Williams v. Texas Putman v. Georgia McCorquodale v. Balkcom, Warden","slug":"tomlin-v-alabama","docketNumber":"No. 83-1533; No. 83-5995; No. 83-6334; No. 83-6350","dateFiled":"1984-04-23","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":38,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9041019,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1184,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AmiY\">Sup. Ct. Ala.;</p>\n<p id=\"AdM\">Ct. Crim. App. Tex.;</p>\n<p id=\"AIxF\">Sup. Ct. Ga.; and</p>\n<p id=\"Aho8\">C. A. 11th Cir. Certiorari denied. Reported below: No. 83-1533, <span class=\"citation\" data-id=\"1889713\"><a href=\"/opinion/1889713/ex-parte-tomlin/\" aria-description=\"Citation for case: Ex Parte Tomlin\">443 So. 2d 59</a></span>; No. 83-5995, <span class=\"citation\" data-id=\"2388985\"><a href=\"/opinion/2388985/williams-v-state/\" aria-description=\"Citation for case: Williams v. State\">668 S. W. 2d 692</a></span>; No. 83-6334, <span class=\"citation\" data-id=\"1295775\"><a href=\"/opinion/1295775/putman-v-state/\" aria-description=\"Citation for case: Putman v. State\">251 Ga. 605</a></span>, <span class=\"citation\" data-id=\"1295775\"><a href=\"/opinion/1295775/putman-v-state/\" aria-description=\"Citation for case: Putman v. State\">308 S. E. 2d 145</a></span>; No. 83-6350, <span class=\"citation\" data-id=\"9471462\"><a href=\"/opinion/427624/timothy-wesley-mccorquodale-v-charles-balkcom-warden-georgia-state/\" aria-description=\"Citation for case: Timothy Wesley McCorquodale v. Charles Balkcom, Warden,...\">721 F. 2d 1493</a></span>.</p>\n</opinion>"},{"id":9041020,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":591,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b948-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Ar-\">dissenting.</p>\n<p id=\"AjQ\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}