{"id":92536,"docketId":2449519,"caseName":"City of New Orleans v. United States Ex Rel. Christmas Same v. Same","caseNameFull":"","slug":"city-of-new-orleans-v-united-states-ex-rel-christmas-same-v-same","docketNumber":"","dateFiled":"1889-05-13","dateArgued":null,"dateCertGranted":null,"year":1889,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"","jurisdictionType":"","opinions":[{"id":92536,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1212,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"2466108\"><a href=\"/opinion/2466108/new-orleans-v-united-states-ex-rel-gainess-administrators/\" aria-description=\"Citation for case: New Orleans v. United States Ex Rel. Gaines&#x27;s Administrators\">131 U.S. 220</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./9/755/\">9 S.Ct. 755</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"92517\"><a href=\"/opinion/92517/kennon-v-gilmer/\" aria-description=\"Citation for case: Kennon v. Gilmer\">33 L.Ed. 110</a></span></p>\n    <p class=\"parties\">CITY OF NEW ORLEANS<br>v.<br>UNITED STATES <i>ex rel.</i> CHRISTMAS <i>et al.</i><br>SAME<br>v.<br>SAME.</p>\n    <p class=\"date\">May 13, 1889.</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">BRADLEY, J.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The decision just made in the case of City of New Orleans v. Myra Clark Gaines, ante, 745, renders it necessary that the judgment or decree in this case should be reversed, and it is reversed accordingly, and the cause remanded, with instructions to dismiss the petition.</p>\n    </div>\n    "}],"citations":[]}