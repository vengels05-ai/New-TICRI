{"id":9020975,"docketId":66287192,"caseName":"Jacobs v. Alabama","caseNameFull":"Jacobs v. Alabama Woodard v. Arkansas","slug":"jacobs-v-alabama","docketNumber":"No. 78-5696; No. 78-5759","dateFiled":"1979-01-15","dateArgued":null,"dateCertGranted":null,"year":1979,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9014184,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":664,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AW8a\">Sup. Ct. Ala.; and</p>\n<p id=\"A38y\">Sup. Ct. Ark. Cer-tiorari denied. Reported below: No. 78-5696, <span class=\"citation\" data-id=\"1700463\"><a href=\"/opinion/1700463/jacobs-v-state/\" aria-description=\"Citation for case: Jacobs v. State\">361 So. 2d 640</a></span>; No. 78-5759, <span class=\"citation\" data-id=\"2458140\"><a href=\"/opinion/2458140/woodard-v-state/\" aria-description=\"Citation for case: Woodard v. State\">261 Ark. 895</a></span>, <span class=\"citation\" data-id=\"2458140\"><a href=\"/opinion/2458140/woodard-v-state/\" aria-description=\"Citation for case: Woodard v. State\">553 S. W. 2d 259</a></span>.</p>\n</opinion>"},{"id":9014185,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":605,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1066-6\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"AWaU\">dissenting.</p>\n<p id=\"b1066-7\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}