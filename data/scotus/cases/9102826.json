{"id":9102826,"docketId":66369098,"caseName":"Stoker v. Texas","caseNameFull":"Stoker v. Texas Tyler v. Ohio Ventura v. Florida Clark v. Dugger, Secretary, Florida Department of Corrections","slug":"stoker-v-texas","docketNumber":"No. 89-7684; No. 90-5459; No. 90-5607; No. 90-5859","dateFiled":"1990-10-29","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9097190,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1116,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AzIK\">Ct. Crim. App. Tex.;</p>\n<p id=\"A-qv\">Sup. Ct. Ohio;</p>\n<p id=\"Ac-i\">Sup. Ct. Fla.; and</p>\n<p id=\"A1y-\">C. A. 11th Cir. Certiorari denied. Reported below: No. 89-7684, <span class=\"citation\" data-id=\"2464243\"><a href=\"/opinion/2464243/stoker-v-state/\" aria-description=\"Citation for case: Stoker v. State\">788 S. W. 2d 1</a></span>; No. 90-5459, <span class=\"citation\" data-id=\"6762309\"><a href=\"/opinion/6870401/state-v-tyler/\" aria-description=\"Citation for case: State v. Tyler\">50 Ohio St. 3d 24</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/N.%20E.%202d/553/576/\">553 N. E. 2d 576</a></span>; No. 90-5607, <span class=\"citation\" data-id=\"1864043\"><a href=\"/opinion/1864043/ventura-v-state/\" aria-description=\"Citation for case: Ventura v. State\">560 So. 2d 217</a></span>; No. 90-5859, <span class=\"citation\" data-id=\"540133\"><a href=\"/opinion/540133/raymond-robert-clark-v-richard-l-dugger-secretary-department-of/\" aria-description=\"Citation for case: Raymond Robert Clark v. Richard L. Dugger, Secretary,...\">901 F. 2d 908</a></span>.</p>\n</opinion>"},{"id":9097191,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":569,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b917-11\">Justice Marshall,</author>\n<p id=\"AsGL\">dissenting.</p>\n<p id=\"b917-12\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}