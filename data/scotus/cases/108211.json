{"id":108211,"docketId":2572662,"caseName":"Colombo v. New York","caseNameFull":"Colombo v. New York","slug":"colombo-v-new-york","docketNumber":"175","dateFiled":"1970-10-19","dateArgued":null,"dateCertGranted":null,"year":1970,"scdbId":"1970-003","direction":"Conservative","votesMajority":8,"votesMinority":1,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":18,"judges":"Black","jurisdictionType":"","opinions":[{"id":108211,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":801,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion type=\"majority\">\n<author id=\"b118-8\">\n  Per Curiam.\n </author>\n<p id=\"b118-9\">\n  The petition for a writ of certiorari is granted, the judgment is vacated, and the case is remanded to the Court of Appeals of New York for further consideration in light of\n  <em>\n   Waller\n  </em>\n  v.\n  <em>\n   Florida,\n  </em>\n  <span class=\"citation\" data-id=\"9424224\"><a href=\"/opinion/108112/waller-v-florida/\" aria-description=\"Citation for case: Waller v. Florida\">397 U. S. 387</a></span>.\n </p>\n<judges id=\"b118-10\">\n  Mr. Justice Black is of the opinion that certiorari should be granted and the judgmeht reversed on the ground that the state prosecution is barred by the Double Jeopardy Clause of the Fifth Amendment of the Constitution.\n </judges>\n</opinion>"}],"citations":[]}