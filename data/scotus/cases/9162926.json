{"id":9162926,"docketId":66429231,"caseName":"In re Disbarment of Rudd","caseNameFull":"In re Disbarment of Rudd","slug":"in-re-disbarment-of-rudd","docketNumber":"No. D-1778","dateFiled":"1997-03-17","dateArgued":null,"dateCertGranted":null,"year":1997,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9157635,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":436,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A6d\">Jeffrey D. Rudd, of Roanoke, Va., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on February 18, 1997 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./519/1105/\">519 U. S. 1105</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}