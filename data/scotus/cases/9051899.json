{"id":9051899,"docketId":66318145,"caseName":"Spivey v. Georgia","caseNameFull":"Spivey v. Georgia Burris v. Indiana Julius v. Alabama","slug":"spivey-v-georgia","docketNumber":"No. 84-5545; No. 84-5689; No. 84-5808","dateFiled":"1985-01-07","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":4,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9045362,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":870,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Admg\">Sup. Ct. Ga.;</p>\n<p id=\"Alab\">Sup. Ct. Ind.; and</p>\n<p id=\"AdDL\">Sup. Ct. Ala. Certiorari denied. Reported below: No. 84-5545, <span class=\"citation\" data-id=\"1350213\"><a href=\"/opinion/1350213/spivey-v-state/\" aria-description=\"Citation for case: Spivey v. State\">253 Ga. 187</a></span>, <span class=\"citation\" data-id=\"1350213\"><a href=\"/opinion/1350213/spivey-v-state/\" aria-description=\"Citation for case: Spivey v. State\">319 S. E. 2d 420</a></span>; No. 84-5689, <span class=\"citation\" data-id=\"2051350\"><a href=\"/opinion/2051350/burris-v-state/\" aria-description=\"Citation for case: Burris v. State\">465 N. E. 2d 171</a></span>; No. 84-5808, <span class=\"citation\" data-id=\"1718848\"><a href=\"/opinion/1718848/ex-parte-julius/\" aria-description=\"Citation for case: Ex Parte Julius\">455 So. 2d 984</a></span>.</p>\n</opinion>"},{"id":9045363,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":596,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1067-4\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A2z\">dissenting.</p>\n<p id=\"b1067-5\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}