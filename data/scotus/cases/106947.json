{"id":106947,"docketId":1484688,"caseName":"CROSS Et Al. v. BRUNING Et Al.","caseNameFull":"Nancy Jewell Cross v. John A. Bruning","slug":"cross-et-al-v-bruning-et-al","docketNumber":"436, Misc","dateFiled":"1964-12-14","dateArgued":null,"dateCertGranted":null,"year":1964,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":106947,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":466,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b302-8\">\n  Per Curiam.\n </author>\n<p id=\"b302-9\">\n  The appeal is dismissed for want of jurisdiction. Treating the papers whereon the appeal was taken as a petition for a writ of certiorari, certiorari is denied.\n </p>\n<judges id=\"b302-10\">\n  The Chief Justice took no part in the consideration or decision of this case.\n </judges>\n</opinion>"}],"citations":[]}