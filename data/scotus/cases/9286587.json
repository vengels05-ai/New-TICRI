{"id":9286587,"docketId":66554958,"caseName":"Lindsey v. Louisiana","caseNameFull":"Lindsey v. Louisiana LaRette v. Missouri Smith v. Missouri Hopkinson v. Wyoming Craig v. North Carolina James v. Louisiana","slug":"lindsey-v-louisiana","docketNumber":"No. 82-6973; No. 82-6979; No. 83-5077; No. 83-5124; No. 83-5146; No. 83-5366","dateFiled":"1983-10-11","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9281433,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1500,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A4D7\">Sup. Ct. La.;</p>\n<p id=\"Aie0\">Sup. Ct. Mo.;</p>\n<p id=\"AE__\">Sup. Ct. Mo.;</p>\n<p id=\"AiOY\">Sup. Ct. Wyo.;</p>\n<p id=\"AkQO\">Sup. Ct. N. C.; and</p>\n<p id=\"AWvm\">Sup. Ct. La. Certiorari denied. Reported below: No. 82-6973, <span class=\"citation\" data-id=\"1800652\"><a href=\"/opinion/1800652/state-v-lindsey/\" aria-description=\"Citation for case: State v. Lindsey\">428 So. 2d 420</a></span>; No. 82-6979, <span class=\"citation\" data-id=\"9768003\"><a href=\"/opinion/2407741/state-v-larette/\" aria-description=\"Citation for case: State v. LaRette\">648 S. W. 2d 96</a></span>; No. 83-5077, <span class=\"citation\" data-id=\"9638548\"><a href=\"/opinion/1485665/state-v-smith/\" aria-description=\"Citation for case: State v. Smith\">649 S. W. 2d 417</a></span>; No. 83-5124, <span class=\"citation\" data-id=\"9574311\"><a href=\"/opinion/1234408/hopkinson-v-state/\" aria-description=\"Citation for case: Hopkinson v. State\">664 P. 2d 43</a></span>; No. 83-5146, <span class=\"citation\" data-id=\"9588717\"><a href=\"/opinion/1341136/state-v-craig/\" aria-description=\"Citation for case: State v. Craig\">308 N. C. 446</a></span>, <span class=\"citation\" data-id=\"9588717\"><a href=\"/opinion/1341136/state-v-craig/\" aria-description=\"Citation for case: State v. Craig\">302 S. E. 2d 740</a></span>; No. 83-5366, <span class=\"citation\" data-id=\"1097863\"><a href=\"/opinion/1097863/state-v-james/\" aria-description=\"Citation for case: State v. James\">431 So. 2d 399</a></span>.</p>\n</opinion>"},{"id":9281434,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b782-13\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Asqz\">dissenting.</p>\n<p id=\"AhL\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}