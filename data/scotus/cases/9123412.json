{"id":9123412,"docketId":66389696,"caseName":"In re Disbarment of Kimura","caseNameFull":"In re Disbarment of Kimura","slug":"in-re-disbarment-of-kimura","docketNumber":"No. D-1134","dateFiled":"1992-10-05","dateArgued":null,"dateCertGranted":null,"year":1992,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9117975,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":455,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Ats8\">Robert Yutaka Kimura, of Honolulu, Haw., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 8, 1992 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./504/970/\">504 U. S. 970</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}