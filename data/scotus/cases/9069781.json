{"id":9069781,"docketId":66336032,"caseName":"In re Disbarment of Sisk","caseNameFull":"In re Disbarment of Sisk","slug":"in-re-disbarment-of-sisk","docketNumber":"No. D-580","dateFiled":"1987-06-26","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9063523,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":453,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AKF\">Mary Neal Sisk, of New York, N. Y., having requested to resign as a member of the Bar of this Court, it is ordered that her name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on October 20, 1986 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./479/912/\">479 U. S. 912</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}