{"id":9193854,"docketId":66460167,"caseName":"In re Disbarment of Tamer","caseNameFull":"In re Disbarment of Tamer","slug":"in-re-disbarment-of-tamer","docketNumber":"No. D-2165","dateFiled":"2000-06-26","dateArgued":null,"dateCertGranted":null,"year":2000,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9188629,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":443,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AtuO\">David Ferris Tamer, of Winston-Salem, N. C., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on May 22, 2000 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./529/1127/\">529 U. S. 1127</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}