{"id":6687884,"docketId":63668521,"caseName":"Gurvich v. United States","caseNameFull":"NICK GURVICH v. UNITED STATES","slug":"gurvich-v-united-states","docketNumber":"No. 435","dateFiled":"1905-05-01","dateArgued":null,"dateCertGranted":null,"year":1905,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"No appearance for Gurvich., The Attorney General for the United States.","natureOfSuit":"","citationCount":3,"judges":"","jurisdictionType":"","opinions":[{"id":6567440,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":730,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"b395-15\">On the authority of Rassmussen v. United States, <span class=\"citation\" data-id=\"9417986\"><a href=\"/opinion/96270/rassmussen-v-united-states/\" aria-description=\"Citation for case: Rassmussen v. United States\">197 U.S. 516</a></span>, <span class=\"citation\" data-id=\"9417986\"><a href=\"/opinion/96270/rassmussen-v-united-states/\" aria-description=\"Citation for case: Rassmussen v. United States\">25 S.Ct. 514</a></span>, the question is answered that the district court of the United States for the district of Alaska, division No. 1, erred in compelling the plaintiff in error to go to trial before a jury composed of only six persons. Announced by Mr. Chief Justice FULLER.</p>\n</opinion>"}],"citations":[]}