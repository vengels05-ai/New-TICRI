{"id":8955623,"docketId":66221838,"caseName":"Bentley v. Alaska","caseNameFull":"BENTLEY v. ALASKA","slug":"bentley-v-alaska","docketNumber":"No. 647, Misc.","dateFiled":"1963-06-10","dateArgued":null,"dateCertGranted":null,"year":1963,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., George N. Hayes, Attorney General of Alaska, and John K. Brubaker, Assistant Attorney General, for respondent.","natureOfSuit":"","citationCount":2,"judges":"","jurisdictionType":"","opinions":[{"id":8946606,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":947,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b156-10\">Per Curiam.</author>\n<p id=\"b156-11\">The motion for leave to proceed in <em>forma pauperis </em>and the petition for writ of certiorari are granted. The judgment is vacated and the case is remanded to the Supreme Court of Alaska for reconsideration in light of <em>Douglas </em>v. <em>California, </em><span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U. S. 353</a></span>, <em>Lane </em>v. <em>Brown, </em><span class=\"citation\" data-id=\"9422557\"><a href=\"/opinion/106549/lane-v-brown/\" aria-description=\"Citation for case: Lane v. Brown\">372 U. S. 477</a></span>, and <em>Draper </em>v. <em>Washington, </em><span class=\"citation\" data-id=\"9422559\"><a href=\"/opinion/106550/draper-v-washington/\" aria-description=\"Citation for case: Draper v. Washington\">372 U. S. 487</a></span>.</p>\n</opinion>"}],"citations":[]}