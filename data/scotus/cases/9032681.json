{"id":9032681,"docketId":66298903,"caseName":"Turner v. Virginia","caseNameFull":"Turner v. Virginia Jones v. Zant, Warden Solomon v. Georgia","slug":"turner-v-virginia","docketNumber":"No. 80-6366; No. 80-6368; No. 80-6375","dateFiled":"1981-05-18","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":4,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9025976,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":896,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AulO\">Sup. Ct. Va.;</p>\n<p id=\"Ap_y\">Super. Ct. Ga., Butts County; and</p>\n<p id=\"ANaq\">Sup. Ct. Ga. Cer-tiorari denied. Reported below: No. 80-6366, <span class=\"citation\" data-id=\"1368535\"><a href=\"/opinion/1368535/turner-v-commonwealth/\" aria-description=\"Citation for case: Turner v. Commonwealth\">221 Va. 513</a></span>, <span class=\"citation\" data-id=\"1368535\"><a href=\"/opinion/1368535/turner-v-commonwealth/\" aria-description=\"Citation for case: Turner v. Commonwealth\">273 S. E. 2d 36</a></span>; No. 80-6375, <span class=\"citation\" data-id=\"1309731\"><a href=\"/opinion/1309731/solomon-v-state/\" aria-description=\"Citation for case: Solomon v. State\">247 Ga. 27</a></span>, <span class=\"citation\" data-id=\"1309731\"><a href=\"/opinion/1309731/solomon-v-state/\" aria-description=\"Citation for case: Solomon v. State\">277 S. E. 2d 1</a></span>.</p>\n</opinion>"},{"id":9025977,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b971-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"ATtP\">dissenting.</p>\n<p id=\"AlCW\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}