{"id":9104067,"docketId":66370339,"caseName":"Mattson v. California","caseNameFull":"Mattson v. California Lott v. Ohio","slug":"mattson-v-california","docketNumber":"No. 90-5941; No. 90-6041","dateFiled":"1990-12-10","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9098456,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":830,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AuTW\">Sup. Ct. Cal.; and</p>\n<p id=\"AIYF\">Sup. Ct. Ohio. Certiorari denied. Reported below: No. 90-5941, <span class=\"citation\" data-id=\"9591448\"><a href=\"/opinion/1345979/people-v-mattson/\" aria-description=\"Citation for case: People v. Mattson\">50 Cal. 3d 826</a></span>, <span class=\"citation\" data-id=\"9591448\"><a href=\"/opinion/1345979/people-v-mattson/\" aria-description=\"Citation for case: People v. Mattson\">789 P. 2d 983</a></span>; No. 90-6041, <span class=\"citation\" data-id=\"6762452\"><a href=\"/opinion/6870505/state-v-lott/\" aria-description=\"Citation for case: State v. Lott\">51 Ohio St. 3d 160</a></span>, <span class=\"citation\" data-id=\"6762452\"><a href=\"/opinion/6870505/state-v-lott/\" aria-description=\"Citation for case: State v. Lott\">555 N. E. 2d 293</a></span>.</p>\n</opinion>"},{"id":9098458,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":567,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b983-7\">Justice Marshall,</author>\n<p id=\"AdYV\">dissenting.</p>\n<p id=\"b983-8\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}