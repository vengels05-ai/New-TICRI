{"id":9140722,"docketId":66407017,"caseName":"In re Disbarment of Kanaley","caseNameFull":"In re Disbarment of Kanaley","slug":"in-re-disbarment-of-kanaley","docketNumber":"No. D-1295","dateFiled":"1993-11-01","dateArgued":null,"dateCertGranted":null,"year":1993,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9135400,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":458,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AaB\">John Collins Kanaley, of Syracuse, N. Y., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on August 26, 1993 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./509/944/\">509 U. S. 944</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}