{"id":8954593,"docketId":66220808,"caseName":"Tiller v. California","caseNameFull":"TILLER v. CALIFORNIA","slug":"tiller-v-california","docketNumber":"No. 797","dateFiled":"1963-04-22","dateArgued":null,"dateCertGranted":null,"year":1963,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"California, Clark, Harlan, Opinions, Stated","jurisdictionType":"","opinions":[{"id":8945534,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":864,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b835-9\">Per Curiam.</author>\n<p id=\"b835-10\">The motion for leave to proceed <em>in forma pauperis </em>and the petition for writ of certiorari are granted. The judgment is vacated and the case is remanded for further consideration in light of <em>Douglas </em>v. <em>California, </em><span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U. S. 353</a></span>.</p>\n<judges id=\"b835-11\">Mr. Justice Clark and Mr. Justice Harlan dissent for the reasons stated in their opinions in <em>Douglas </em>v. <em>California, </em><span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/#358\" aria-description=\"Citation for case: Douglas v. California\">372 U. S., at 358, 360</a></span>.</judges>\n</opinion>"}],"citations":[]}