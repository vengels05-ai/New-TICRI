{"id":9057723,"docketId":66323974,"caseName":"Hance v. Georgia","caseNameFull":"Hance v. Georgia Conklin v. Georgia Bell v. Alabama McKague v. Nevada Brown v. Florida","slug":"hance-v-georgia","docketNumber":"No. 85-5642; No. 85-5663; No. 85-5665; No. 85-5694; No. 85-5701","dateFiled":"1985-12-16","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9051274,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1611,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AsZr\">Sup. Ct. Ga.;</p>\n<p id=\"ABZ\">Sup. Ct. Ga.;</p>\n<p id=\"ATmg\">Sup. Ct. Ala.;</p>\n<p id=\"A6xq\">Sup. Ct. Nev.; and</p>\n<p id=\"AkY7\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 85-5642, <span class=\"citation\" data-id=\"1321925\"><a href=\"/opinion/1321925/hance-v-state/\" aria-description=\"Citation for case: Hance v. State\">254 Ga. 575</a></span>, <span class=\"citation\" data-id=\"1321925\"><a href=\"/opinion/1321925/hance-v-state/\" aria-description=\"Citation for case: Hance v. State\">332 S. E. 2d 287</a></span>; No. 85-5663, <span class=\"citation\" data-id=\"1211075\"><a href=\"/opinion/1211075/conklin-v-state/\" aria-description=\"Citation for case: Conklin v. State\">254 Ga. 558</a></span>, <span class=\"citation\" data-id=\"1211075\"><a href=\"/opinion/1211075/conklin-v-state/\" aria-description=\"Citation for case: Conklin v. State\">331 S. E. 2d 532</a></span>; No. 85-5665, <span class=\"citation\" data-id=\"1772639\"><a href=\"/opinion/1772639/ex-parte-bell/\" aria-description=\"Citation for case: Ex Parte Bell\">475 So. 2d 609</a></span>; No. 85-5694, <span class=\"citation\" data-id=\"1116017\"><a href=\"/opinion/1116017/mckague-v-state/\" aria-description=\"Citation for case: McKague v. State\">101 Nev. 327</a></span>, <span class=\"citation\" data-id=\"1116017\"><a href=\"/opinion/1116017/mckague-v-state/\" aria-description=\"Citation for case: McKague v. State\">705 P. 2d 127</a></span>; No. 85-5701, <span class=\"citation\" data-id=\"1093890\"><a href=\"/opinion/1093890/brown-v-state/\" aria-description=\"Citation for case: Brown v. State\">473 So. 2d 1260</a></span>.</p>\n</opinion>"},{"id":9051276,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b904-11\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AlLT\">dissenting.</p>\n<p id=\"b904-12\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}