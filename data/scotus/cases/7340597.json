{"id":7340597,"docketId":64329089,"caseName":"United States v. Williams","caseNameFull":"United States v. Leon Williams","slug":"united-states-v-williams","docketNumber":"09-466","dateFiled":"2010-11-29","dateArgued":null,"dateCertGranted":null,"year":2010,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Consideration, Motion, Sotomayor, Took","jurisdictionType":"","opinions":[{"id":7258520,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1328,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AD1T7\">Motion of respondent for leave to proceed in forma pau-peris granted. On petition for writ of cer-tiorari to the United States Court of Appeals for the Second Circuit. Petition for writ of certiorari granted. Judgment vacated, and case remanded to the United States Court of Appeals for the Second Circuit for further consideration in light of Abbott v. United States, <span class=\"citation\" data-id=\"179213\"><a href=\"/opinion/179213/abbott-v-united-states/\" aria-description=\"Citation for case: Abbott v. United States\">562 U.S. 8</a></span>, <span class=\"citation\" data-id=\"179213\"><a href=\"/opinion/179213/abbott-v-united-states/\" aria-description=\"Citation for case: Abbott v. United States\">131 S. Ct. 18</a></span>, <span class=\"citation\" data-id=\"179213\"><a href=\"/opinion/179213/abbott-v-united-states/\" aria-description=\"Citation for case: Abbott v. United States\">178 L. Ed. 2d 348</a></span> (2010).</p>\n<judges id=\"AqiIV\">Justice Sotomayor and Justice Kagan took no part in the consideration or decision of this motion and this petition.</judges>\n<p id=\"b573-5\">Same case below, <span class=\"citation\" data-id=\"1354443\"><a href=\"/opinion/1354443/united-states-v-williams/\" aria-descripti