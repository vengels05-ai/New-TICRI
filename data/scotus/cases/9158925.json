{"id":9158925,"docketId":66425226,"caseName":"In re Disbarment of Wells","caseNameFull":"In re Disbarment of Wells","slug":"in-re-disbarment-of-wells","docketNumber":"No. D-1634","dateFiled":"1996-04-15","dateArgued":null,"dateCertGranted":null,"year":1996,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9153624,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":438,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A5zD\">Edward G. Wells, of Palatine, Ill., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on January 22, 1996 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./516/1090/\">516 U. S. 1090</a></span>], is discharged.</p>\n</opinion>"}],"citations":[]}