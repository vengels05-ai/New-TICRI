{"id":7346147,"docketId":64334641,"caseName":"United States v. Jones","caseNameFull":"United States v. Antoine Jones","slug":"united-states-v-jones","docketNumber":"No. 10-1259","dateFiled":"2011-06-27","dateArgued":null,"dateCertGranted":null,"year":2011,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":19,"judges":"","jurisdictionType":"","opinions":[{"id":7264125,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":795,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Az7S\">Petition for writ of cer-tiorari granted. In addition to the question presented by the petition, the parties are directed to brief and argue the following question: \u201cWhether the government violated respondent\u2019s Fourth Amendment rights by installing the GPS tracking device on his vehicle without a valid warrant and without his consent.\u201d</p>\n<p id=\"b927-9\">Same case below, <span class=\"citation\" data-id=\"152441\"><a href=\"/opinion/152441/united-states-v-maynard/\" aria-description=\"Citation for case: United States v. Maynard\">392 U.S. App. D.C. 291</a></span>, <span class=\"citation\" data-id=\"152441\"><a href=\"/opinion/152441/united-states-v-maynard/\" aria-description=\"Citation for case: United States v. Maynard\">615 F.3d 544</a></span>.</p>\n</opinion>"}],"citations":[]}