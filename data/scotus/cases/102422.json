{"id":102422,"docketId":1686230,"caseName":"Carl Green v. The Cleveland, Cincinnati, Chicago, and St. Louis Railway Company.","caseNameFull":"","slug":"carl-green-v-the-cleveland-cincinnati-chicago-and-st-louis-railway-company","docketNumber":"688","dateFiled":"1935-02-18","dateArgued":null,"dateCertGranted":null,"year":1935,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":102422,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2446,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./294/715/\">294 U.S. 715</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./55/516/\">55 S.Ct. 516</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"8151244\"><a href=\"/opinion/8189313/green-v-cleveland-cincinnati-chicago-st-louis-ry-co/\" aria-description=\"Citation for case: Green v. Cleveland, Cincinnati, Chicago &amp; St. Louis Ry. Co.\">79 L.Ed. 1249</a></span></p>\n    <p class=\"parties\">Carl GREEN, petitioner,<br>v.<br>The CLEVELAND, CINCINNATI, CHICAGO, and ST. LOUIS  RAILWAY COMPANY.<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a></p>\n    <p class=\"docket\">No. 688.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">February 18, 1935</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">Mr. Carl Green, pro se.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">For opinion below, see <span class=\"citation\" data-id=\"3784857\"><a href=\"/opinion/4028120/cleveland-cincinnati-chicago-st-louis-ry-co-v-green/\" aria-description=\"Citation for case: Cleveland, Cincinnati, Chicago &amp; St. Louis, Ry. Co. v. Green\">126 Ohio St. 512</a></span>, <span class=\"citation\" data-id=\"3784857\"><a href=\"/opinion/4028120/cleveland-cincinnati-chicago-st-louis-ry-co-v-green/\" aria-description=\"Citation for case: Cleveland, Cincinnati, Chicago &amp; St. Louis, Ry. Co. v. Green\">186 N. E. 365</a></span>, 87 A. L. R. 1268.</p>\n    </div>\n    <div class=\"num\" id=\"p3\">\n      <span class=\"num\">3</span>\n      <p class=\"indent\">On petition for writ of certiorari to the Supreme Court of the State of Ohio. The motion for leave to proceed further herein in forma pauperis is denied for the reason that the Court, upon examination of the papers herein submitted, finds no ground upon which a writ of certiorari should be issued. The petition for writ of certiorari is therefore also denied.</p>\n    </div>\n    <div class=\"footnotes\">\n      <div class=\"footnote\" id=\"fn-s\">\n        <a class=\"footnote\" href=\"#fn-s_ref\">*</a>\n        <p> Rehearing denied <span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./294/734/\">294 U. S. 734</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.%20Ct./55/551/\">55 S. Ct. 551</a></span>, 79 L. Ed.</p>\n      </div>\n    </div>\n    "}],"citations":[]}