{"id":9038770,"docketId":66304996,"caseName":"Baldwin v. Blackburn","caseNameFull":"Baldwin v. Blackburn, Warden, Louisiana State Penitentiary Collins v. Zant, Warden","slug":"baldwin-v-blackburn","docketNumber":"No. 81-6301; No. 81-6304","dateFiled":"1982-04-26","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":52,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9032098,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":405,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A-gd\">C. A. 5th Cir.; and</p>\n<p id=\"A6Qp\">Sup. Ct. Ga. Certiorari denied. Reported below: No. 81-6301, <span class=\"citation\" data-id=\"392205\"><a href=\"/opinion/392205/timothy-george-baldwin-v-frank-c-blackburn-warden-louisiana-state/\" aria-description=\"Citation for case: Timothy George Baldwin v. Frank C. Blackburn, Warden,...\">653 F. 2d 942</a></span>.</p>\n</opinion>"},{"id":9032099,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":594,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b994-7\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AKK\">dissenting.</p>\n<p id=\"b994-8\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}