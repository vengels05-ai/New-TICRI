{"id":9076758,"docketId":66343011,"caseName":"In re Disbarment of Dozoryst","caseNameFull":"In re Disbarment of Dozoryst","slug":"in-re-disbarment-of-dozoryst","docketNumber":"No. D-674","dateFiled":"1988-04-18","dateArgued":null,"dateCertGranted":null,"year":1988,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9070659,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":467,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AAXo\">Nicholas George Dozoryst II, of Chicago, 111., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on January 25, 1988 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./484/1040/\">484 U. S. 1040</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}