{"id":9033036,"docketId":66299258,"caseName":"Fleming v. Austin","caseNameFull":"Fleming v. Austin, Warden","slug":"fleming-v-austin","docketNumber":"No. 80-6506","dateFiled":"1981-06-01","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":29,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9026336,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":590,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b812-8\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AzYf\">dissenting.</p>\n<p id=\"Aycb\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}