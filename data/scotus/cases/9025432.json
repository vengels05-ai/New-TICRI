{"id":9025432,"docketId":66291653,"caseName":"Stanley v. Zant","caseNameFull":"Stanley v. Zant, Superintendent, Georgia Diagnostic and Classification Center Thomas v. Zant, Warden Alderman v. Balkcom, Warden Bowden v. Zant, Warden Coppola v. Virginia","slug":"stanley-v-zant","docketNumber":"No. 79-5705; No. 79-5714; No. 79-5744; No. 79-5830; No. 79-5861","dateFiled":"1980-02-19","dateArgued":null,"dateCertGranted":null,"year":1980,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":44,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9018687,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":942,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AjoJ\">Sup. Ct. Ga.;</p>\n<p id=\"A2ov\">Sup. Ct. Ga.;</p>\n<p id=\"Anf1\">Sup. Ct. Ga.;</p>\n<p id=\"AYqX\">Sup. Ct. Ga.; and</p>\n<p id=\"AAn7\">Sup. Ct. Va. Cer-tiorari denied. Reported below: No. 79-5830, <span class=\"citation\" data-id=\"9585670\"><a href=\"/opinion/1334503/bowden-v-zant/\" aria-description=\"Citation for case: Bowden v. Zant\">244 Ga. 260</a></span>, <span class=\"citation\" data-id=\"9585670\"><a href=\"/opinion/1334503/bowden-v-zant/\" aria-description=\"Citation for case: Bowden v. Zant\">260 S. E. 2d 465</a></span>; No. 79-5861, <span class=\"citation\" data-id=\"1310456\"><a href=\"/opinion/1310456/coppola-v-commonwealth/\" aria-description=\"Citation for case: Coppola v. Commonwealth\">220 Va. 243</a></span>, <span class=\"citation\" data-id=\"1310456\"><a href=\"/opinion/1310456/coppola-v-commonwealth/\" aria-description=\"Citation for case: Coppola v. Commonwealth\">257 S. E. 2d 797</a></span>.</p>\n</opinion>"},{"id":9018688,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":606,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1173-9\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"A0zj\">dissenting.</p>\n<p id=\"b1173-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}