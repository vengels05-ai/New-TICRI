{"id":9048292,"docketId":66314534,"caseName":"In re Disbarment of Roundtree","caseNameFull":"In re Disbarment of Roundtree","slug":"in-re-disbarment-of-roundtree","docketNumber":"No. D-416","dateFiled":"1984-06-04","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9041699,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ALt\">Dovey J. Roundtree, of Washington, D. C., having requested to resign as a member of the Bar of this Court, it is ordered that her name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on April 2, 1984 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./466/921/\">466 U. S. 921</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}