{"id":8998932,"docketId":66265148,"caseName":"Boyd v. Ohio","caseNameFull":"Boyd v. Ohio","slug":"boyd-v-ohio","docketNumber":"No. 73-1339","dateFiled":"1974-07-25","dateArgued":null,"dateCertGranted":null,"year":1974,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":2,"judges":"","jurisdictionType":"","opinions":[{"id":8991378,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":660,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AkUM\">Ct. App. Ohio, Allen County. Certiorari denied. Mr. Justice Douglas, being of the view that any state ban on obscenity is pro<page-number citation-index=\"1\" label=\"955\">*955</page-number>hibited by the First Amendment, made applicable to the States by the Fourteenth (see <em>Paris Adult Theatre I </em>v. <em>Slaton, </em><span class=\"citation\" data-id=\"9425382\"><a href=\"/opinion/108839/paris-adult-theatre-i-v-slaton/#70\" aria-description=\"Citation for case: Paris Adult Theatre I v. Slaton\">413 U. S. 49, 70</a></span> (1973) (Douglas, J., dissenting)), would grant certiorari and reyerse the judgment.</p>\n</opinion>"}],"citations":[]}