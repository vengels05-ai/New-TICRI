{"id":9035394,"docketId":66301616,"caseName":"Demps v. Florida","caseNameFull":"Demps v. Florida Jacobs v. Florida Dicks v. Tennessee Swindler v. Arkansas Martin v. North Carolina","slug":"demps-v-florida","docketNumber":"No. 81-5038; No. 81-5169; No. 81-5192; No. 81-5271; No. 81-5336","dateFiled":"1981-10-13","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":150,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9028700,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1462,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AGYl\">Sup. Ct. Fla.;</p>\n<p id=\"Acxe\">Sup. Ct. Fla.;</p>\n<p id=\"AKF7\">Sup. Ct. Tenn.;</p>\n<p id=\"A5PZ\">Sup. Ct. Ark.; and</p>\n<p id=\"ACqf\">Sup. Ct. N. C. Certiorari denied. Reported below: No. 81-5038, <span class=\"citation\" data-id=\"1720534\"><a href=\"/opinion/1720534/demps-v-state/\" aria-description=\"Citation for case: Demps v. State\">395 So. 2d 501</a></span>; No. 81-5169, <span class=\"citation\" data-id=\"1842074\"><a href=\"/opinion/1842074/jacobs-v-state/\" aria-description=\"Citation for case: Jacobs v. State\">396 So. 2d 1113</a></span>; No. 81-5192, <span class=\"citation\" data-id=\"9775273\"><a href=\"/opinion/2449451/state-v-dicks/\" aria-description=\"Citation for case: State v. Dicks\">615 S. W. 2d 126</a></span>; No. 81-5271, <span class=\"citation\" data-id=\"1739126\"><a href=\"/opinion/1739126/swindler-v-state/\" aria-description=\"Citation for case: Swindler v. State\">272 Ark. 340</a></span>, <span class=\"citation\" data-id=\"1739126\"><a href=\"/opinion/1739126/swindler-v-state/\" aria-description=\"Citation for case: Swindler v. State\">617 S. W. 2d 1</a></span>; No. 81-5336, <span class=\"citation\" data-id=\"1235295\"><a href=\"/opinion/1235295/state-v-martin/\" aria-description=\"Citation for case: State v. Martin\">303 N. C. 246</a></span>, <span class=\"citation\" data-id=\"1235295\"><a href=\"/opinion/1235295/state-v-martin/\" aria-description=\"Citation for case: State v. Martin\">278 S. E. 2d 214</a></span>.</p>\n</opinion>"},{"id":9028701,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":596,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b821-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"ARVy\">dissenting.</p>\n<p id=\"b821-10\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}