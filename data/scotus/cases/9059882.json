{"id":9059882,"docketId":66326133,"caseName":"Blanks v. Georgia","caseNameFull":"Blanks v. Georgia Guzmon v. Texas Collins v. Georgia Curry v. Georgia Roman v. Florida Laney v. Tennessee Jones v. Illinois","slug":"blanks-v-georgia","docketNumber":"No. 85-5375; No. 85-6145; No. 85-6229; No. 85-6259; No. 85-6268; No. 85-6270; No. 85-6275","dateFiled":"1986-03-24","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":6,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9053452,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1708,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AtLc\">Sup. Ct. Ga.;</p>\n<p id=\"AcVR\">Ct. Crim. App. Tex.;</p>\n<p id=\"AHMy\">Super. Ct. Ga., Houston County;</p>\n<p id=\"Asf-\">Sup. Ct. Ga.;</p>\n<p id=\"AanM\">Sup. Ct. Fla.;</p>\n<p id=\"AEHu\">Ct. Crim. App. Tenn.; and</p>\n<p id=\"Alol\">Sup. Ct. Ill. Certiorari denied. Reported below: No. 85-5375, <span class=\"citation\" data-id=\"1345918\"><a href=\"/opinion/1345918/blanks-v-state/\" aria-description=\"Citation for case: Blanks v. State\">254 Ga. 420</a></span>, <span class=\"citation\" data-id=\"1345918\"><a href=\"/opinion/1345918/blanks-v-state/\" aria-description=\"Citation for case: Blanks v. State\">330 S. E. 2d 575</a></span>; No. 85-6145, <span class=\"citation\" data-id=\"1714508\"><a href=\"/opinion/1714508/guzmon-v-state/\" aria-description=\"Citation for case: Guzmon v. State\">697 S. W. 2d 404</a></span>; No. 85-6259, <span class=\"citation\" data-id=\"1290688\"><a href=\"/opinion/1290688/curry-v-state/\" aria-description=\"Citation for case: Curry v. State\">255 Ga. 215</a></span>, <span class=\"citation\" data-id=\"1290688\"><a href=\"/opinion/1290688/curry-v-state/\" aria-description=\"Citation for case: Curry v. State\">336 S. E. 2d 762</a></span>; No. 85-6268, <span class=\"citation\" data-id=\"1773177\"><a href=\"/opinion/1773177/roman-v-state/\" aria-description=\"Citation for case: Roman v. State\">475 So. 2d 1228</a></span>; No. 85-6275, <span class=\"citation\" data-id=\"9522380\"><a href=\"/opinion/2027693/people-v-jones/\" aria-description=\"Citation for case: People v. Jones\">109 Ill. 2d 19</a></span>, <span class=\"citation\" data-id=\"9522380\"><a href=\"/opinion/2027693/people-v-jones/\" aria-description=\"Citation for case: People v. Jones\">485 N. E. 2d 363</a></span>.</p>\n</opinion>"},{"id":9053453,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":599,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1064-16\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AxhZ\">dissenting.</p>\n<p id=\"b1064-17\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}