{"id":107511,"docketId":2583476,"caseName":"Fox v. Oregon","caseNameFull":"Fox v. Oregon","slug":"fox-v-oregon","docketNumber":"1421, Misc","dateFiled":"1967-06-12","dateArgued":null,"dateCertGranted":null,"year":1967,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":23,"judges":"Black, Harlan, Stewart","jurisdictionType":"","opinions":[{"id":107511,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":822,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b502-8\">\n  Per Curiam.\n </author>\n<p id=\"b502-9\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are- granted. The judgment is vacated and the case is remanded to the Supreme Court of Oregon for further consideration in light of\n  <em>\n   Anders\n  </em>\n  v.\n  <em>\n   California,\n  </em>\n  <span class=\"citation\" data-id=\"9423399\"><a href=\"/opinion/107423/anders-v-california/\" aria-description=\"Citation for case: Anders v. California\">386 U. S. 738</a></span>.\n </p>\n<judges id=\"b502-10\">\n  Mr. Justice Black, Mr. Justice Harlan, and Mr. Justice Stewart are of the opinion that certiorari should be denied.\n </judges>\n</opinion>"}],"citations":[]}