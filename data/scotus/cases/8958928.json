{"id":8958928,"docketId":66225143,"caseName":"Smith v. Crouse","caseNameFull":"SMITH v. CROUSE, WARDEN","slug":"smith-v-crouse","docketNumber":"No. 915, Misc.","dateFiled":"1964-06-22","dateArgued":null,"dateCertGranted":null,"year":1964,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., William M. Ferguson, Attorney General of Kansas, and J. Richard Foth, Assistant Attorney General, for respondent.","natureOfSuit":"","citationCount":70,"judges":"Harlan","jurisdictionType":"","opinions":[{"id":8950015,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":452,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b614-10\">Per Curiam.</author>\n<p id=\"b614-11\">The motion for leave to proceed <em>in forma pauperis </em>and the petition for writ of certiorari are granted. The judgment is reversed. <em>Douglas </em>v. <em>California, </em><span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U. S. 353</a></span>.</p>\n</opinion>"},{"id":8950016,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Harlan","joinedBy":"","pageCount":null,"textLength":707,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b614-12\">Mr. Justice Harlan,</author>\n<p id=\"AXUG\">dissenting.</p>\n<p id=\"b614-13\">In my opinion the question whether <em>Douglas </em>v. <em>California, </em><span class=\"citation\" data-id=\"9422548\"><a href=\"/opinion/106546/douglas-v-california/\" aria-description=\"Citation for case: Douglas v. California\">372 U. S. 353</a></span>, should be given retroactive application is deserving of plenary consideration. Cf. my dissenting opinion in <em>LaVallee </em>v. <em>Durocher, </em><span class=\"citation\" data-id=\"8949829\"><a href=\"/opinion/8958756/lavallee-v-durocher/\" aria-description=\"Citation for case: LaVallee v. Durocher\">377 U. S. 998</a></span>.</p>\n</opinion>"}],"citations":[]}