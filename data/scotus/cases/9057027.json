{"id":9057027,"docketId":66323276,"caseName":"Edmonds v. Virginia","caseNameFull":"Edmonds v. Virginia Martinez-Villareal v. Arizona Booker v. Wainwright, Secretary, Florida Department of Corrections Kennedy v. Alabama","slug":"edmonds-v-virginia","docketNumber":"No. 85-5417; No. 85-5478; No. 85-5486; No. 85-5548","dateFiled":"1985-11-04","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":261,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9050564,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1411,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A4g\">Sup. Ct. Va.;</p>\n<p id=\"AGxj\">Sup. Ct. Ariz.;</p>\n<p id=\"AVqbf\">C. A. 11th Cir.; and</p>\n<p id=\"AV1t\">Sup. Ct. Ala. Certiorari denied. Reported below: No. 85-5417, <span class=\"citation\" data-id=\"1158359\"><a href=\"/opinion/1158359/edmonds-v-commonwealth/\" aria-description=\"Citation for case: Edmonds v. Commonwealth\">229 Va. 303</a></span>, <span class=\"citation\" data-id=\"1158359\"><a href=\"/opinion/1158359/edmonds-v-commonwealth/\" aria-description=\"Citation for case: Edmonds v. Commonwealth\">329 S. E. 2d 807</a></span>; No. 85-5478, <span class=\"citation\" data-id=\"1153801\"><a href=\"/opinion/1153801/state-v-martinez-villareal/\" aria-description=\"Citation for case: State v. Martinez-Villareal\">145 Ariz. 441</a></span>, <span class=\"citation\" data-id=\"1153801\"><a href=\"/opinion/1153801/state-v-martinez-villareal/\" aria-description=\"Citation for case: State v. Martinez-Villareal\">702 P. 2d 670</a></span>; No. 85-5486, <span class=\"citation\" data-id=\"453564\"><a href=\"/opinion/453564/stephen-todd-booker-v-louie-l-wainwright-secretary-dept-of/\" aria-description=\"Citation for case: Stephen Todd Booker v. Louie L. Wainwright, Secretary,...\">764 F. 2d 1371</a></span>; No. 85-5548, <span class=\"citation\" data-id=\"9937632\"><a href=\"/opinion/1946592/ex-parte-kennedy/\" aria-description=\"Citation for case: Ex Parte Kennedy\">472 So. 2d 1106</a></span>.</p>\n</opinion>"},{"id":9050565,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":659,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b841-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AFgQ\">dissenting.</p>\n<p id=\"b841-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, <page-number citation-index=\"1\" label=\"976\">*976</page-number>227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}