{"id":9001973,"docketId":66268189,"caseName":"In re Disbarment of Siegel","caseNameFull":"In re Disbarment of Siegel","slug":"in-re-disbarment-of-siegel","docketNumber":"No. D-41","dateFiled":"1975-02-24","dateArgued":null,"dateCertGranted":null,"year":1975,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Consideration, Matter, Took","jurisdictionType":"","opinions":[{"id":8994537,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":484,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AdTr\">It is ordered that George J. Siegel, of New York, N. Y., be suspended from the practice of law in this Court and that a rule issue, returnable within 40 days, requiring him to <page-number citation-index=\"1\" label=\"942\">*942</page-number>show cause why he should not be disbarred from the practice of law in this Court.</p>\n<judges id=\"AR85\">Mr. Justice Marshall took no part in the consideration or decision of this matter.*</judges>\n</opinion>"}],"citations":[]}