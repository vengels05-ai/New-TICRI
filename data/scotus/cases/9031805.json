{"id":9031805,"docketId":66298027,"caseName":"Amadeo v. Russeau","caseNameFull":"Amadeo v. Russeau, Sheriff Miller v. Arkansas Jackson v. California","slug":"amadeo-v-russeau","docketNumber":"No. 80-5942; No. 80-5969; No. 80-6155","dateFiled":"1981-03-30","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":24,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9025095,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":790,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AL_n\">Sup. Ct. Ga.;</p>\n<p id=\"AyYp\">Sup. Ct. Ark.; and</p>\n<p id=\"Anks\">Sup. Ct. Cal. Certiorari denied. Reported below: No. 80-5969, <span class=\"citation\" data-id=\"9642054\"><a href=\"/opinion/1501778/miller-v-state/\" aria-description=\"Citation for case: Miller v. State\">269 Ark. 341</a></span>, <span class=\"citation\" data-id=\"9642054\"><a href=\"/opinion/1501778/miller-v-state/\" aria-description=\"Citation for case: Miller v. State\">605 S. W. 2d 430</a></span>; No. 80-6155, <span class=\"citation\" data-id=\"9616925\"><a href=\"/opinion/1391736/people-v-jackson/\" aria-description=\"Citation for case: People v. Jackson\">28 Cal. 3d 264</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/P.%202d/618/149/\">618 P. 2d 149</a></span>.</p>\n</opinion>"},{"id":9025096,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":599,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1011-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"ApqO\">dissenting.</p>\n<p id=\"b1011-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}