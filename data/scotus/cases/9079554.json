{"id":9079554,"docketId":66345810,"caseName":"In re Disbarment of Ezrin","caseNameFull":"In re Disbarment of Ezrin","slug":"in-re-disbarment-of-ezrin","docketNumber":"No. D-719","dateFiled":"1988-10-03","dateArgued":null,"dateCertGranted":null,"year":1988,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9073523,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A96\">Herbert Stanley Ezrin, of Potomac, Md., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on June 20, 1988 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./487/1203/\">487 U. S. 1203</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}