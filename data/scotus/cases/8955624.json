{"id":8955624,"docketId":66221839,"caseName":"Bentley v. Alaska","caseNameFull":"BENTLEY v. ALASKA","slug":"bentley-v-alaska","docketNumber":"No. 648, Misc.","dateFiled":"1963-06-10","dateArgued":null,"dateCertGranted":null,"year":1963,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., George N. Hayes, Attorney General of Alaska, and John K. Brubaker, Assistant Attorney General, for - respondent.","natureOfSuit":"","citationCount":2,"judges":"","jurisdictionType":"","opinions":[{"id":8946607,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":732,"isHtml":true,"text":"<opinion type=\"majority\">\n<author id=\"b157-11\">Per Curiam.</author>\n<p id=\"b157-12\">The motion for leave to proceed <em>in forma pauperis </em>and the petition for writ of certiorari are granted. The judgment is vacated and the case is remanded to the Supreme Court of Alaska for reconsideration in light of <em>Brady </em>v. <em>Maryland, </em><span class=\"citation\" data-id=\"9422583\"><a href=\"/opinion/106598/brady-v-maryland/\" aria-description=\"Citation for case: Brady v. Maryland\">373 U. S. 83</a></span>, and <em>Mooney </em>v. <em>Holohan, </em><span class=\"citation\" data-id=\"102372\"><a href=\"/opinion/102372/mooney-v-holohan/\" aria-description=\"Citation for case: Mooney v. Holohan\">294 U. S. 103</a></span>.</p>\n</opinion>"}],"citations":[]}