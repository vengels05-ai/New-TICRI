{"id":9138331,"docketId":66404626,"caseName":"Hughes v. Texas","caseNameFull":"Hughes v. Texas","slug":"hughes-v-texas","docketNumber":"No. 93-8109","dateFiled":"1994-06-06","dateArgued":null,"dateCertGranted":null,"year":1994,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Blackmun","jurisdictionType":"","opinions":[{"id":9132990,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":155,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AnMD\">Ct. Grim. App. Tex. Motion of petitioner to strike the brief in opposition denied. Certiorari denied.</p>\n</opinion>"},{"id":9132991,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Blackmun","joinedBy":"","pageCount":null,"textLength":637,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1112-7\">Justice Blackmun,</author>\n<p id=\"AEtK\">dissenting.</p>\n<p id=\"b1112-8\">Adhering to my view that the death penalty cannot be imposed fairly within the constraints of our Constitution, see my dissent in <em>Callins </em>v. <em>Collins, </em><span class=\"citation\" data-id=\"9432964\"><a href=\"/opinion/117187/callins-v-collins-director-texas-department-of-criminal-justice/#1143\" aria-description=\"Citation for case: Callins v. Collins, Director, Texas Department of...\">510 U. S. 1141, 1143</a></span> (1994), I would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}