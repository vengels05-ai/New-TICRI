{"id":2620903,"docketId":46803,"caseName":"Hudgins v. California","caseNameFull":"Hudgins v. California","slug":"hudgins-v-california","docketNumber":"37, Misc","dateFiled":"1967-03-13","dateArgued":null,"dateCertGranted":null,"year":1967,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":"<p>Mise.</p>","headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Stewart","jurisdictionType":"","opinions":[{"id":2620903,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":631,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"4\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b343-16\">\n  Per Curiam.\n </author>\n<p id=\"b343-17\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are granted. The judgment is vacated and the case is remanded for further consideration in light of\n  <em>\n   Chapman\n  </em>\n  v.\n  <em>\n   California, ante,\n  </em>\n  p. 18.\n </p>\n<judges id=\"b343-19\">\n  Mr. Justice Stewart is of the opinion that certiorari should be denied because the petition was not timely filed.\n </judges>\n</opinion>"}],"citations":[]}