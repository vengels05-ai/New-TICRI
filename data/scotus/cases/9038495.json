{"id":9038495,"docketId":66304721,"caseName":"Chaney v. Oklahoma","caseNameFull":"Chaney v. Oklahoma Godfrey v. Georgia","slug":"chaney-v-oklahoma","docketNumber":"No. 81-6016; No. 81-6224","dateFiled":"1982-04-05","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":13,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9031821,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":416,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AtDf\">Ct. Crim. App. Okla.; and</p>\n<p id=\"AaD0\">Sup. Ct. Ga. Certiorari denied. Reported below: No. 81-6224, <span class=\"citation multiple-matches\"><a href=\"/c/Ga./248/616/\">248 Ga. 616</a></span>, <span class=\"citation\" data-id=\"5597621\"><a href=\"/opinion/5745777/godfrey-v-state/\" aria-description=\"Citation for case: Godfrey v. State\">284 S. E. 2d 422</a></span>.</p>\n</opinion>"},{"id":9031822,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b963-12\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AqNy\">dissenting.</p>\n<p id=\"A5H\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}