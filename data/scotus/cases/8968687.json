{"id":8968687,"docketId":66234903,"caseName":"In re Werner","caseNameFull":"In re Werner","slug":"in-re-werner","docketNumber":"","dateFiled":"1967-10-09","dateArgued":null,"dateCertGranted":null,"year":1967,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Matter, Took","jurisdictionType":"","opinions":[{"id":8960143,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":333,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AXu\">James Lee Werner, Esquire, of Cincinnati, Ohio, having resigned as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice in this Court.</p>\n<judges id=\"AR0\">Mr. Justice Marshall took no part in this matter.</judges>\n</opinion>"}],"citations":[]}