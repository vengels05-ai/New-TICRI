{"id":9045375,"docketId":66311603,"caseName":"Evans v. Mississippi","caseNameFull":"Evans v. Mississippi Bolander v. Florida Aldridge v. Florida McCrae v. Florida","slug":"evans-v-mississippi","docketNumber":"No. 82-6267; No. 82-6423; No. 82-6433; No. 82-6555","dateFiled":"1983-05-16","dateArgued":null,"dateCertGranted":null,"year":1983,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":3,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9038744,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":930,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A28\">Sup. Ct. Miss.;</p>\n<p id=\"AKor\">Sup. Ct. Fla.;</p>\n<p id=\"AEx0\">Sup. Ct. Fla.; and</p>\n<p id=\"Apj\">Sup. Ct. Fla. Certiorari denied. Reported below: No. 82-6267, <span class=\"citation\" data-id=\"1866240\"><a href=\"/opinion/1866240/evans-v-state/\" aria-description=\"Citation for case: Evans v. State\">422 So. 2d 737</a></span>; No. 82-6423, <span class=\"citation\" data-id=\"1865882\"><a href=\"/opinion/1865882/bolender-v-state/\" aria-description=\"Citation for case: Bolender v. State\">422 So. 2d 833</a></span>; No. 82-6433, <span class=\"citation\" data-id=\"1615730\"><a href=\"/opinion/1615730/aldridge-v-state/\" aria-description=\"Citation for case: Aldridge v. State\">425 So. 2d 1132</a></span>; No. 82-6555, <span class=\"citation\" data-id=\"1865753\"><a href=\"/opinion/1865753/mccrae-v-wainwright/\" aria-description=\"Citation for case: McCrae v. Wainwright\">422 So. 2d 824</a></span>.</p>\n</opinion>"},{"id":9038745,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":598,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b893-11\">Justice Brennan and Justice Marshall,</author>\n<p id=\"A22X\">dissenting.</p>\n<p id=\"b893-12\">Adhering to our views that the death penalty is in all cir-cumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}