{"id":105758,"docketId":2046985,"caseName":"National Biscuit Company v. Commonwealth of Pennsylvania","caseNameFull":"","slug":"national-biscuit-company-v-commonwealth-of-pennsylvania","docketNumber":"990","dateFiled":"1958-06-30","dateArgued":null,"dateCertGranted":null,"year":1958,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":48,"judges":"","jurisdictionType":"","opinions":[{"id":105758,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1178,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8933925\"><a href=\"/opinion/8943405/national-biscuit-co-v-pennsylvania/\" aria-description=\"Citation for case: National Biscuit Co. v. Pennsylvania\">357 U.S. 571</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">78 S.Ct. 1383</span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/L.Ed.2d/2/1547/\">2 L.Ed.2d 1547</a></span></p>\n    <p class=\"parties\">NATIONAL BISCUIT COMPANY, appellant,<br>v.<br>COMMONWEALTH OF PENNSYLVANIA.</p>\n    <p class=\"docket\">No. 990.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">June 30, 1958</p>\n    <div class=\"prelims\">\n      <p class=\"indent\">Messrs. Roy J. Keefer and Leslie M. Swope, for appellant.</p>\n      <p class=\"indent\">Messrs. Thomas D. McBride, Atty.Gen. of Pennsylvania and George W. Keitel, Deputy Atty.Gen., for appellee.</p>\n      <p class=\"indent\">PER CURIAM.</p>\n    </div>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">The motion to dismiss is granted and the appeal is dismissed for want of a substantial federal question.</p>\n    </div>\n    "}],"citations":[]}