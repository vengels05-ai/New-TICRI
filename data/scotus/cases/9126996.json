{"id":9126996,"docketId":66393280,"caseName":"In re Disbarment of Jones","caseNameFull":"In re Disbarment of Jones","slug":"in-re-disbarment-of-jones","docketNumber":"No. D-1161","dateFiled":"1992-11-02","dateArgued":null,"dateCertGranted":null,"year":1992,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9121573,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":464,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A_0O\">Curtis Larenzo Jones, Jr., of Miami, Fla., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on September 4, 1992 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./505/1242/\">505 U. S. 1242</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}