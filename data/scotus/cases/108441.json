{"id":108441,"docketId":2531860,"caseName":"Bradley v. United States","caseNameFull":"Bradley v. United States","slug":"bradley-v-united-states","docketNumber":"71-5431","dateFiled":"1972-01-24","dateArgued":null,"dateCertGranted":null,"year":1972,"scdbId":"1971-051","direction":"Liberal","votesMajority":7,"votesMinority":2,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":16,"judges":"Blackmun, Durham","jurisdictionType":"","opinions":[{"id":108441,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":1127,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion type=\"majority\">\n<author id=\"b707-8\">\n  Per Curiam.\n </author>\n<p id=\"b707-9\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for writ of certiorari are granted.\n </p>\n<p id=\"b707-10\">\n  The judgment is vacated and the case is remanded to the United States District Court for the Southern District of Iowa with directions to dismiss the indictment.\n  <em>\n   Durham\n  </em>\n  v.\n  <em>\n   United States,\n  </em>\n  <span class=\"citation\" data-id=\"9424482\"><a href=\"/opinion/108288/durham-v-united-states/\" aria-description=\"Citation for case: Durham v. United States\">401 U. S. 481</a></span> (1971).\n </p>\n<judges id=\"b707-11\">\n  The Chief Justice and Mr. Justice Blackmun dissent for the reasons stated in Mr. Justice Blackmun\u2019s dissenting opinion in\n  <em>\n   Durham\n  </em>\n  v.\n  <em>\n   United States,\n  </em>\n  <span class=\"citation\" data-id=\"9424482\"><a href=\"/opinion/108288/durham-v-united-states/#483\" aria-description=\"Citation for case: Durham v. United States\">401 U. S. 481, 483-485</a></span> (1971).\n </judges>\n</opinion>"}],"citations":[]}