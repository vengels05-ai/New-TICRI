{"id":9103287,"docketId":66369559,"caseName":"In re Disbarment of Kalk","caseNameFull":"In re Disbarment of Kalk","slug":"in-re-disbarment-of-kalk","docketNumber":"No. D-692","dateFiled":"1990-11-26","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9097672,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":448,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AToT\">Joseph Kalk, of Cleveland, Ohio, having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on April 4, 1988 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./485/984/\">485 U. S. 984</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}