{"id":107462,"docketId":2048608,"caseName":"Barnett v. Nevada","caseNameFull":"Douglas Fred Barnett v. Nevada","slug":"barnett-v-nevada","docketNumber":"48, Misc","dateFiled":"1967-05-22","dateArgued":null,"dateCertGranted":null,"year":1967,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":"Petitioner pro se., Harvey Dickerson, Attorney General of Nevada, for respondent.","natureOfSuit":"","citationCount":2,"judges":"Per Curiam","jurisdictionType":"","opinions":[{"id":107462,"type":"majority","typeCode":"010combined","perCuriam":true,"author":"","joinedBy":"","pageCount":null,"textLength":980,"isHtml":true,"text":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<opinion data-order=\"6\" data-type=\"opinion\" id=\"x999-1\" type=\"majority\">\n<author id=\"b287-11\">\n  Per Curiam.\n </author>\n<p id=\"b287-12\">\n  The motion for leave to proceed\n  <em>\n   in forma pauperis\n  </em>\n  and the petition for a writ of certiorari are granted. The judgment is vacated and the case is remanded to the Supreme Court of Nevada for further consideration in light of\n  <em>\n   Anders\n  </em>\n  v.\n  <em>\n   California,\n  </em>\n  <span class=\"citation\" data-id=\"9423399\"><a href=\"/opinion/107423/anders-v-california/\" aria-description=\"Citation for case: Anders v. California\">386 U. S. 738</a></span>, and\n  <em>\n   Long\n  </em>\n  v.\n  <em>\n   District Court of Iowa in and for Lee County,\n  </em>\n  <span class=\"citation\" data-id=\"107307\"><a href=\"/opinion/107307/long-v-district-court-of-iowa-lee-cty/\" aria-description=\"Citation for case: Long v. District Court of Iowa, Lee Cty.\">385 U. S. 192</a></span>.\n </p>\n</opinion>"}],"citations":[]}