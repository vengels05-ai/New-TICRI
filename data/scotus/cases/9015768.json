{"id":9015768,"docketId":66281985,"caseName":"House v. Stynchcombe","caseNameFull":"House v. Stynchcombe, Sheriff Ceja v. Arizona McCorquodale v. Stynchcombe, Sheriff","slug":"house-v-stynchcombe","docketNumber":"No. 77-5439; No. 77-5450; No. 77-5482","dateFiled":"1977-11-28","dateArgued":null,"dateCertGranted":null,"year":1977,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9008836,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1256,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A5Uo\">Sup. Ct. Ga.;</p>\n<p id=\"A3n9n\">Sup. Ct. Ariz.; and</p>\n<p id=\"APzl\">Sup. Ct. Ga. Certiorari denied. Reported below: No. 77-5439, <span class=\"citation\" data-id=\"1365367\"><a href=\"/opinion/1365367/house-v-stynchcombe/\" aria-description=\"Citation for case: House v. Stynchcombe\">239 Ga. 222</a></span>, <span class=\"citation\" data-id=\"1365367\"><a href=\"/opinion/1365367/house-v-stynchcombe/\" aria-description=\"Citation for case: House v. Stynchcombe\">236 S. E. 2d 353</a></span>; No. 77-5450, <span class=\"citation\" data-id=\"1198586\"><a href=\"/opinion/1198586/state-v-ceja/\" aria-description=\"Citation for case: State v. Ceja\">115 Ariz. 413</a></span>, <span class=\"citation\" data-id=\"1198586\"><a href=\"/opinion/1198586/state-v-ceja/\" aria-description=\"Citation for case: State v. Ceja\">565 P. 2d 1274</a></span>; No. 77-5482, <span class=\"citation\" data-id=\"1365438\"><a href=\"/opinion/1365438/mccorquodale-v-stynchcombe/\" aria-description=\"Citation for case: McCorquodale v. Stynchcombe\">239 Ga. 138</a></span>, <span class=\"citation\" data-id=\"1365438\"><a href=\"/opinion/1365438/mccorquodale-v-stynchcombe/\" aria-description=\"Citation for case: McCorquodale v. Stynchcombe\">236 S. E. 2d 486</a></span>.</p>\n</opinion>"},{"id":9008837,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":605,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b955-11\">Mr. Justice Brennan and Mr. Justice Marshall,</author>\n<p id=\"A1qK\">dissenting.</p>\n<p id=\"b955-12\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}