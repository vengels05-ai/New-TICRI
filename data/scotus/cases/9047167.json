{"id":9047167,"docketId":66313409,"caseName":"In re Disbarment of Young","caseNameFull":"In re Disbarment of Young","slug":"in-re-disbarment-of-young","docketNumber":"No. D-402","dateFiled":"1984-03-26","dateArgued":null,"dateCertGranted":null,"year":1984,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9040551,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AGUh\">Nancy J. Young, of Cos Cob, Conn., having requested to resign as a member of the Bar of this Court, it is ordered that her name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on February 27, 1984 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./465/1063/\">465 U. S. 1063</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}