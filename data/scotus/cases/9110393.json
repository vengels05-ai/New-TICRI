{"id":9110393,"docketId":66376666,"caseName":"Spence v. Texas","caseNameFull":"Spence v. Texas Williams v. Texas","slug":"spence-v-texas","docketNumber":"No. 90-5950; No. 90-8175","dateFiled":"1991-06-24","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9104861,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":117,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AIWG\">Ct. Crim. App. Tex.; and Ct. Crim. App. Tex. Certiorari denied.</p>\n</opinion>"},{"id":9104862,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":569,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1233-7\">Justice Marshall,</author>\n<p id=\"A31c\">dissenting.</p>\n<p id=\"b1233-8\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}