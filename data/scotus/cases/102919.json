{"id":102919,"docketId":2410778,"caseName":"David F. Mitchell, Edith C. Worley v. The Supreme Court of the State of Florida","caseNameFull":"","slug":"david-f-mitchell-edith-c-worley-v-the-supreme-court-of-the-state-of-florida","docketNumber":"495","dateFiled":"1937-10-25","dateArgued":null,"dateCertGranted":null,"year":1937,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":102919,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":2047,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/U.S./302/733/\">302 U.S. 733</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./58/124/\">58 S.Ct. 124</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">82 L.Ed. 566</span></p>\n    <p class=\"parties\">David F. MITCHELL, Edith C. Worley et al., petitioners,<br>v.<br>The SUPREME COURT OF THE STATE OF FLORIDA et al.<a class=\"footnote\" href=\"#fn-s\" id=\"fn-s_ref\">*</a></p>\n    <p class=\"docket\">No. 495.</p>\n    <p class=\"court\">Supreme Court of the United States</p>\n    <p class=\"date\">October 25, 1937</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">Mr. David F. Mitchell, pro se.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">On petition for writ of certiorari to the Supreme Court of the State of Florida.</p>\n    </div>\n    <div class=\"num\" id=\"p3\">\n      <span class=\"num\">3</span>\n      <p class=\"indent\">For opinion below, see Mitchell v. Shields, <span class=\"citation\" data-id=\"3386357\"><a href=\"/opinion/3393679/mitchell-v-shields/\" aria-description=\"Citation for case: Mitchell v. Shields\">175 So. 524</a></span>.</p>\n    </div>\n    <div class=\"num\" id=\"p4\">\n      <span class=\"num\">4</span>\n      <p class=\"indent\">The motion for leave to proceed further herein in forma pauperis is denied for the reason that the Court upon examination of the papers herein submitted finds no ground upon which writs of certiorari should be issued. The petition for writ of certiorari is therefore also denied.</p>\n    </div>\n    <div class=\"footnotes\">\n      <div class=\"footnote\" id=\"fn-s\">\n        <a class=\"footnote\" href=\"#fn-s_ref\">*</a>\n        <p> Rehearing denied <span class=\"citation multiple-matches\"><a href=\"/c/U.S./302/778/\">302 U.S. 778</a></span>, <span class=\"citation multiple-matches\"><a href=\"/c/S.Ct./58/270/\">58 S.Ct. 270</a></span>, 82 L.Ed. &#8212;&#8212;.</p>\n      </div>\n    </div>\n    "}],"citations":[]}