{"id":9040922,"docketId":66307149,"caseName":"Williams v. Indiana","caseNameFull":"Williams v. Indiana","slug":"williams-v-indiana","docketNumber":"No. 81-6779","dateFiled":"1982-10-04","dateArgued":null,"dateCertGranted":null,"year":1982,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":5,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9034259,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":130,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Aiv\">Appeal from Sup. Ct. Ind. dismissed for want of substantial federal question.</p>\n</opinion>"},{"id":9034260,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":568,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b742-9\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AYg\">dissenting.</p>\n<p id=\"AWeY\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}