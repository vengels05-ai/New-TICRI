{"id":9032130,"docketId":66298352,"caseName":"In re Disbarment of Long","caseNameFull":"In re Disbarment of Long","slug":"in-re-disbarment-of-long","docketNumber":"No. D-215","dateFiled":"1981-04-20","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9025421,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":456,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"ApD\">George Wayne Long, of Bayside, Tex., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on January 19, 1981 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./449/1107/\">449 U. S. 1107</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}