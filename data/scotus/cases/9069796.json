{"id":9069796,"docketId":66336047,"caseName":"In re Disbarment of Whitted","caseNameFull":"In re Disbarment of Whitted","slug":"in-re-disbarment-of-whitted","docketNumber":"No. D-632","dateFiled":"1987-06-26","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9063537,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":454,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"Anq\">Earl Whitted, Jr., of Goldsboro, N. C., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to practice before the Bar of this Court. The rule to show cause, heretofore issued on May 4, 1987 [<span class=\"citation multiple-matches\"><a href=\"/c/U.%20S./481/1035/\">481 U. S. 1035</a></span>], is hereby discharged.</p>\n</opinion>"}],"citations":[]}