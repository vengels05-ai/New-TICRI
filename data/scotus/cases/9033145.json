{"id":9033145,"docketId":66299367,"caseName":"Crawford v. Texas","caseNameFull":"Crawford v. Texas Skillern v. Texas Bullock v. Mississippi Young v. Zant, Warden","slug":"crawford-v-texas","docketNumber":"No. 80-5693; No. 80-6322; No. 80-6345; No. 80-6401","dateFiled":"1981-06-08","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":57,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9026445,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":772,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AUT9\">Ct. Crim. App. Tex.;</p>\n<p id=\"AMbq\">Ct. Crim. App. Tex.;</p>\n<p id=\"Axt\">Sup. Ct. Miss.; and</p>\n<p id=\"AqJ6\">Super. Ct. Ga., Butts County. Certiorari denied. Reported below: No. 80-5693, <span class=\"citation\" data-id=\"9675682\"><a href=\"/opinion/1739490/crawford-v-state/\" aria-description=\"Citation for case: Crawford v. State\">617 S. W. 2d 925</a></span>; No. 80-6322, <span class=\"citation\" data-id=\"9660291\"><a href=\"/opinion/1622967/sanne-v-state/\" aria-description=\"Citation for case: Sanne v. State\">609 S. W. 2d 762</a></span>; No. 80-6345, <span class=\"citation\" data-id=\"1600734\"><a href=\"/opinion/1600734/bullock-v-state/\" aria-description=\"Citation for case: Bullock v. State\">391 So. 2d 601</a></span>.</p>\n</opinion>"},{"id":9026446,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":597,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b833-11\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AYh9\">dissenting.</p>\n<p id=\"b833-12\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}