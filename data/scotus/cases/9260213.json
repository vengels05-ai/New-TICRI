{"id":9260213,"docketId":66527646,"caseName":"In re Disbarment of Goldstein","caseNameFull":"In re Disbarment of Goldstein","slug":"in-re-disbarment-of-goldstein","docketNumber":"No. D-2209","dateFiled":"2001-02-20","dateArgued":null,"dateCertGranted":null,"year":2001,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":9255034,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":366,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AUbJr\">Morton B. Goldstein, of Havre, Mont., having requested to resign as a member of the Bar of this Court, it is ordered that his name be stricken from the roll of attorneys admitted to the practice of law before this Court. The rule to show cause, issued on November 6, 2000 <em>[ante, </em>p. 976], is discharged.</p>\n</opinion>"}],"citations":[]}