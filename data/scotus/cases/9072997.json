{"id":9072997,"docketId":66339249,"caseName":"Brooks v. Louisiana","caseNameFull":"Brooks v. Louisiana","slug":"brooks-v-louisiana","docketNumber":"No. 87-5077","dateFiled":"1987-11-09","dateArgued":null,"dateCertGranted":null,"year":1987,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":66,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9066809,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":592,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b867-6\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AYdx\">dissenting.</p>\n<p id=\"b867-7\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}