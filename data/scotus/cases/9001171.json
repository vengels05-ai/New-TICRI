{"id":9001171,"docketId":66267387,"caseName":"Louisiana State Board of Medical Examiners v. Rosen","caseNameFull":"Louisiana State Board of Medical Examiners v. Rosen","slug":"louisiana-state-board-of-medical-examiners-v-rosen","docketNumber":"No. 74-380","dateFiled":"1975-01-13","dateArgued":null,"dateCertGranted":null,"year":1975,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Rehnquist, White, Whom","jurisdictionType":"","opinions":[{"id":8993695,"type":"concurrence","typeCode":"030concurrence","perCuriam":false,"author":"White","joinedBy":"","pageCount":null,"textLength":689,"isHtml":true,"text":"<opinion type=\"concurrence\">\n<author id=\"b1052-8\">Mr. Justice White,</author>\n<judges id=\"AhHt\">with whom Mr. Justice Rehnquist joins,</judges>\n<p id=\"ASH8\">concurring.</p>\n<p id=\"b1052-9\">Under the compulsion of <em>Roe </em>v. <em>Wade, </em><span class=\"citation\" data-id=\"9425157\"><a href=\"/opinion/108713/roe-v-wade/\" aria-description=\"Citation for case: Roe v. Wade\">410 U. S. 113</a></span> (1973), and <em>Doe </em>v. <em>Bolton, </em><span class=\"citation\" data-id=\"9425160\"><a href=\"/opinion/108714/doe-v-bolton/\" aria-description=\"Citation for case: Doe v. Bolton\">410 U. S. 179</a></span> (1973), which in my view were erroneously decided, I join the affirmance.</p>\n</opinion>"}],"citations":[]}