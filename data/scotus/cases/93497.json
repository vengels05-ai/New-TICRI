{"id":93497,"docketId":1004607,"caseName":"Keels v. Central R. Co. Of South Carolina","caseNameFull":"","slug":"keels-v-central-r-co-of-south-carolina","docketNumber":"1,207","dateFiled":"1893-01-23","dateArgued":null,"dateCertGranted":null,"year":1893,"scdbId":"1892-086","direction":"Conservative","votesMajority":7,"votesMinority":0,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"","jurisdictionType":"","opinions":[{"id":93497,"type":"majority","typeCode":"010combined","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":1514,"isHtml":true,"text":"<p class=\"case_cite\"><span class=\"citation\" data-id=\"8140605\"><a href=\"/opinion/8178690/keels-v-central-railroad/\" aria-description=\"Citation for case: Keels v. Central Railroad\">147 U.S. 374</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation\" data-id=\"93495\"><a href=\"/opinion/93495/glenn-v-garth/\" aria-description=\"Citation for case: Glenn v. Garth\">13 S.Ct. 350</a></span></p>\n    <p class=\"case_cite\"><span class=\"citation no-link\">37 L.Ed. 208</span></p>\n    <p class=\"parties\">KEELS et al.<br>v.<br>CENTRAL R. CO. OF SOUTH CAROLINA.</p>\n    <p class=\"docket\">No. 1,207.</p>\n    <p class=\"date\">January 23, 1893.</p>\n    <div class=\"num\" id=\"p1\">\n      <span class=\"num\">1</span>\n      <p class=\"indent\">As the facts of this case are substantially the same as the one just decided, (13 Sup. Ct. Rep. 348,) the decision must be the same.</p>\n    </div>\n    <div class=\"num\" id=\"p2\">\n      <span class=\"num\">2</span>\n      <p class=\"indent\">The decree of the court below will therefore be reversed, and the case remanded, with directions to dismiss the bill.</p>\n    </div>\n    <div class=\"num\" id=\"p3\">\n      <span class=\"num\">3</span>\n      <p class=\"indent\">Samuel Lord and Ira B. Jones, for appellants.</p>\n    </div>\n    <div class=\"num\" id=\"p4\">\n      <span class=\"num\">4</span>\n      <p class=\"indent\">J. T. Barron and Henry A. M. Smith, for appellee.</p>\n    </div>\n    <div class=\"num\" id=\"p5\">\n      <span class=\"num\">5</span>\n      <p class=\"indent\">Mr. Justice BROWN.</p>\n    </div>\n    "}],"citations":[]}