{"id":9033395,"docketId":66299617,"caseName":"Thomas v. Georgia","caseNameFull":"Thomas v. Georgia Collins v. Arkansas","slug":"thomas-v-georgia","docketNumber":"No. 80-6604; No. 80-6623","dateFiled":"1981-06-22","dateArgued":null,"dateCertGranted":null,"year":1981,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9026696,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":826,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A4fS\">Sup. Ct. Ga.; and</p>\n<p id=\"AtG\">Sup. Ct. Ark. Cer-tiorari denied. Reported below: No. 80-6604, <span class=\"citation\" data-id=\"1250148\"><a href=\"/opinion/1250148/thomas-v-state/\" aria-description=\"Citation for case: Thomas v. State\">247 Ga. 233</a></span>, <span class=\"citation\" data-id=\"1250148\"><a href=\"/opinion/1250148/thomas-v-state/\" aria-description=\"Citation for case: Thomas v. State\">275 S. E. 2d 318</a></span>; No. 80-6623, <span class=\"citation\" data-id=\"1679599\"><a href=\"/opinion/1679599/collins-v-state/\" aria-description=\"Citation for case: Collins v. State\">271 Ark. 825</a></span>, <span class=\"citation\" data-id=\"1679599\"><a href=\"/opinion/1679599/collins-v-state/\" aria-description=\"Citation for case: Collins v. State\">611 S. W. 2d 182</a></span>.</p>\n</opinion>"},{"id":9026697,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":595,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b875-6\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AUIE\">dissenting.</p>\n<p id=\"b875-7\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}