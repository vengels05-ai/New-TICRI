{"id":9065630,"docketId":66331881,"caseName":"Garcia v. Florida","caseNameFull":"Garcia v. Florida","slug":"garcia-v-florida","docketNumber":"No. 86-5707","dateFiled":"1986-12-15","dateArgued":null,"dateCertGranted":null,"year":1986,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9059286,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":592,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b960-5\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AMxv\">dissenting.</p>\n<p id=\"b960-6\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentence in this case.</p>\n</opinion>"}],"citations":[]}