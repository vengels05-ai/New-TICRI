{"id":9056648,"docketId":66322897,"caseName":"Cape v. Francis","caseNameFull":"Cape v. Francis, Warden Alderman v. Georgia Wilson v. Louisiana","slug":"cape-v-francis","docketNumber":"No. 84-6962; No. 84-6975; No. 85-5171","dateFiled":"1985-10-15","dateArgued":null,"dateCertGranted":null,"year":1985,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":1,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9050179,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":937,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A_7U\">C. A. 11th Cir.;</p>\n<p id=\"AC9z2\">Sup. Ct. Ga.; and</p>\n<p id=\"AqzO\">Sup. Ct. La. Certiorari denied. Reported below: No. 84-6962, <span class=\"citation\" data-id=\"9472516\"><a href=\"/opinion/440204/garnett-william-cape-v-robert-francis-warden/\" aria-description=\"Citation for case: Garnett William Cape v. Robert Francis, Warden\">741 F. 2d 1287</a></span>; No. 84-6975, <span class=\"citation\" data-id=\"1240421\"><a href=\"/opinion/1240421/alderman-v-state/\" aria-description=\"Citation for case: Alderman v. State\">254 Ga. 206</a></span>, <span class=\"citation\" data-id=\"1240421\"><a href=\"/opinion/1240421/alderman-v-state/\" aria-description=\"Citation for case: Alderman v. State\">327 S. E. 2d 168</a></span>; No. 85-5171, <span class=\"citation\" data-id=\"1685879\"><a href=\"/opinion/1685879/state-v-wilson/\" aria-description=\"Citation for case: State v. Wilson\">467 So. 2d 503</a></span>.</p>\n</opinion>"},{"id":9050180,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":596,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b777-10\">Justice Brennan and Justice Marshall,</author>\n<p id=\"AGs\">dissenting.</p>\n<p id=\"b777-11\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}