{"id":9104661,"docketId":66370933,"caseName":"Miller v. California","caseNameFull":"Miller v. California Baxter v. Kemp, Warden Correll v. Thompson, Warden","slug":"miller-v-california","docketNumber":"No. 90-5932; No. 90-6044; No. 90-6111","dateFiled":"1991-01-07","dateArgued":null,"dateCertGranted":null,"year":1991,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Marshall","jurisdictionType":"","opinions":[{"id":9099054,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":853,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"AnYb\">Sup. Ct. Cal.;</p>\n<p id=\"AQzl\">Sup. Ct. Ga.; and</p>\n<p id=\"ACro\">Sup. Ct. Va. Certiorari denied. Reported below: No. 90-5932, <span class=\"citation\" data-id=\"1425642\"><a href=\"/opinion/1425642/people-v-miller/\" aria-description=\"Citation for case: People v. Miller\">50 Cal. 3d 954</a></span>, <span class=\"citation\" data-id=\"1425642\"><a href=\"/opinion/1425642/people-v-miller/\" aria-description=\"Citation for case: People v. Miller\">790 P. 2d 1289</a></span>; No. 90-6044, <span class=\"citation\" data-id=\"1267889\"><a href=\"/opinion/1267889/baxter-v-kemp/\" aria-description=\"Citation for case: Baxter v. Kemp\">260 Ga. 184</a></span>, <span class=\"citation\" data-id=\"1267889\"><a href=\"/opinion/1267889/baxter-v-kemp/\" aria-description=\"Citation for case: Baxter v. Kemp\">391 S. E. 2d 754</a></span>.</p>\n</opinion>"},{"id":9099055,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Marshall","joinedBy":"","pageCount":null,"textLength":567,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"A842\">Justice Marshall,</author>\n<p id=\"Au2P\">dissenting.</p>\n<p id=\"b1007-14\">Adhering to my view that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#231\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 231</a></span> (1976), I would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}