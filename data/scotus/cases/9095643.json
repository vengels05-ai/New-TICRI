{"id":9095643,"docketId":66361905,"caseName":"Byrd v. Armontrout","caseNameFull":"Byrd v. Armontrout, Warden Townsend v. Indiana Starr v. Arkansas","slug":"byrd-v-armontrout","docketNumber":"No. 89-6219; No. 89-6404; No. 89-6405","dateFiled":"1990-03-05","dateArgued":null,"dateCertGranted":null,"year":1990,"scdbId":"","direction":"","votesMajority":null,"votesMinority":null,"disposition":"","posture":"","syllabus":null,"summary":null,"headnotes":null,"proceduralHistory":null,"attorneys":null,"natureOfSuit":"","citationCount":0,"judges":"Brennan, Marshall","jurisdictionType":"","opinions":[{"id":9089878,"type":"majority","typeCode":"020lead","perCuriam":false,"author":"","joinedBy":"","pageCount":null,"textLength":354,"isHtml":true,"text":"<opinion type=\"majority\">\n<p id=\"A2t\"><page-number citation-index=\"1\" label=\"1019\">*1019</page-number>C. A. 8th Cir.; <page-number citation-index=\"1\" label=\"1020\">*1020</page-number>Sup. Ct. Ind.; and Sup. Ct. Ark. Certiorari denied.</p>\n<docketnumber id=\"b1026-4\">No. 89-6404.</docketnumber>\n<docketnumber id=\"Auh\">No. 89-6405.</docketnumber>\n</opinion>"},{"id":9089879,"type":"dissent","typeCode":"040dissent","perCuriam":false,"author":"Brennanmarshall","joinedBy":"","pageCount":null,"textLength":593,"isHtml":true,"text":"<opinion type=\"dissent\">\n<author id=\"b1026-5\">Justice Brennan and Justice Marshall,</author>\n<p id=\"Ai1d\">dissenting.</p>\n<p id=\"Atr\">Adhering to our views that the death penalty is in all circumstances cruel and unusual punishment prohibited by the Eighth and Fourteenth Amendments, <em>Gregg </em>v. <em>Georgia, </em><span class=\"citation\" data-id=\"9426555\"><a href=\"/opinion/109532/gregg-v-georgia/#227\" aria-description=\"Citation for case: Gregg v. Georgia\">428 U. S. 153, 227, 231</a></span> (1976), we would grant certiorari and vacate the death sentences in these cases.</p>\n</opinion>"}],"citations":[]}